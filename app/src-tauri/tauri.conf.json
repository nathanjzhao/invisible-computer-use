{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Copilot",
  "version": "0.1.0",
  "identifier": "com.nathanzhao.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash scripts/check-icons.sh && npm run build && bash scripts/stage-driver.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Copilot",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": ["resources/audio-client.mjs"],
    "externalBin": [
      "binaries/cua-driver"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.mac.plist",
      "signingIdentity": "Developer ID Application: Nathan Zhao (G7P6939437)"
    },
    "linux": {
      "deb": {
        "depends": ["at-spi2-core"]
      },
      "rpm": {
        "depends": ["at-spi2-core"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/nathanjzhao/invisible-computer-use/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5REQ2OTgyMDg2NkQ0RTAKUldUZzFHWUlnbW5kaWM0YlE2VWErQzFHMXFLbXl3TGVKcCs0eHI5dWVRVDA3RHhwZTB5K1ZBU0IK",
      "requireSignedVersion": true
    }
  }
}
