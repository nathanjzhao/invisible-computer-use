@@ -0,0 +1,438 @@
+//! Cross-turn element identity + accessibility-tree diff for `get_window_state`
+//! on every platform (invisible-computer-use spec 02, steps 2-6; Codex
+//! `UIElementTreeRevision` / `UIElementRenderDifference` parity).
+//!
+//! The per-snapshot `element_index` / `element_token` contract is untouched —
+//! actions still address the CURRENT snapshot. This module adds a per-(pid,
+//! window) LINEAGE over a platform-neutral projection of the actionable tree
+//! ([`RevisionNode`]): matched nodes inherit a monotonic stable id, new nodes
+//! draw the next id, and each turn after the first renders as a diff (`~`
+//! changed / `+` added / `-` removed) with the verbatim Codex headers (engine:
+//! the `axdiff` crate, validated against `conformance/golden/ax-diff-format.md`).
+//! Each platform maps its node type (macOS `AXNode`, Windows `UiaNode`, Linux
+//! `AtspiNode`) to [`RevisionNode`] and calls [`step`]; the stable id is reported
+//! per element as `stable_id` and the diff text speaks in stable ids.
+//!
+//! The lineage lives in process memory (daemon lifetime = session) and must be
+//! [`reset`] whenever a window's walk is unresolved or refused, so a
+//! mis-grounded tree never becomes a baseline and closed windows do not
+//! accumulate.
+
+use axdiff::{render_cumulative, render_diff, DiffOptions, DiffOutput, RawNode, Revision};
+use std::collections::HashMap;
+use std::sync::{Mutex, OnceLock};
+
+/// Platform-neutral projection of one walked node.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct RevisionNode {
+    /// `Some` for actionable rows; display-only rows have no input handle.
+    pub element_index: Option<usize>,
+    /// `element_index` of the nearest actionable ancestor.
+    pub parent_element_index: Option<usize>,
+    /// Role / control type.
+    pub role: String,
+    /// Human label WITHOUT the value (title/name → description → identifier), so a
+    /// value change renders as `~` rather than remove+add.
+    pub label: String,
+    pub value: Option<String>,
+    pub selected: bool,
+    /// Native property values retain unknown rather than inventing false.
+    pub selected_state: Option<bool>,
+    pub enabled: Option<bool>,
+    pub in_web_content: bool,
+    pub identity: Option<String>,
+    /// Window-relative bounds `[x, y, w, h]` in whole points, when the platform
+    /// reports them. Lets an unchanged anonymous control keep its stable id
+    /// (see axdiff's "unchanged in place" pass); never part of the diff text.
+    pub frame: Option<[i64; 4]>,
+    /// Extra per-row fields the platform reports verbatim on `passive_elements`
+    /// (macOS: `title`, `description`, `help`, `subrole`). Never part of the
+    /// diff text or identity.
+    pub attrs: serde_json::Map<String, serde_json::Value>,
+}
+
+/// Lineage key: pid + the platform's window handle (CGWindowID / HWND / XID).
+pub type LineageKey = (i32, u64);
+
+struct Lineage {
+    prev: Revision,
+    /// The lineage's first snapshot — baseline of the cumulative variant.
+    initial: Revision,
+    /// Codex `accessibilityRevision`: 1 for the first snapshot, +1 per changed snapshot.
+    revision: u64,
+    /// Codex `accessibilitySnapshotCount`: number of snapshots taken.
+    snapshot_count: u64,
+}
+
+static STORE: OnceLock<Mutex<HashMap<LineageKey, Lineage>>> = OnceLock::new();
+
+fn store() -> &'static Mutex<HashMap<LineageKey, Lineage>> {
+    STORE.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+/// Diff baseline: the previous turn (incremental, `-` rows) or the lineage's
+/// initial snapshot (cumulative header, removed ids summarised as ranges).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Baseline { Previous, Initial }
+
+impl Baseline {
+    pub fn name(self) -> &'static str { match self { Baseline::Previous => "previous", Baseline::Initial => "initial" } }
+    /// From the tool args: `cumulative_diff: true` selects the initial baseline.
+    pub fn from_args(args: &serde_json::Value) -> Baseline {
+        if args.get("cumulative_diff").and_then(|v| v.as_bool()).unwrap_or(false) { Baseline::Initial } else { Baseline::Previous }
+    }
+}
+
+/// `disable_diff` (cua spelling) / `disableDiff` (Codex/Sky window API spelling).
+pub fn disable_diff_from_args(args: &serde_json::Value) -> bool {
+    args.get("disable_diff").or_else(|| args.get("disableDiff")).and_then(|v| v.as_bool()).unwrap_or(false)
+}
+
+/// The three schema properties every platform's `get_window_state` advertises.
+pub fn schema_properties() -> serde_json::Value {
+    serde_json::json!({
+        "disable_diff": {
+            "type": "boolean",
+            "description": "Default false. After the first get_window_state for a (pid, window_id), the structured `diff` field carries the accessibility tree as a diff from the previous accessibility tree, listing only the elements that were removed, added, or changed (`~`, `+`, `-`), with stable ids that persist across turns (`elements[].stable_id`). Prefer this default diff output; pass true only when you need a fresh full accessibility tree in `diff.text`."
+        },
+        "disableDiff": { "type": "boolean", "description": "Alias of disable_diff (the Codex/Sky window API spelling)." },
+        "cumulative_diff": {
+            "type": "boolean",
+            "description": "Default false (diff from the PREVIOUS accessibility tree, removed elements as `-` rows). Set true for the cumulative diff from the INITIAL accessibility tree of this window's lineage, with removed elements summarized by stable-id range."
+        }
+    })
+}
+
+/// Nest controls and passive observations without inventing input identities.
+pub fn forest_from_nodes(nodes: &[RevisionNode]) -> Vec<RawNode> {
+    axdiff::cua::nest_flat_nodes(nodes.iter().filter(|n| n.element_index.is_some() || has_passive_content(n)).map(|n| (
+        n.parent_element_index.map(|i| i as i64), RawNode {
+            role: n.role.clone(),
+            label: n.label.clone(),
+            value: n.value.clone(),
+            selected: n.selected,
+            identity: n.identity.clone(),
+            frame: n.frame,
+            source: n.element_index.map(|i| i as i64),
+            children: Vec::new(),
+        }
+    )).collect())
+}
+
+fn has_passive_content(node: &RevisionNode) -> bool {
+    !node.label.is_empty() || node.value.as_ref().is_some_and(|value| !value.is_empty()) || node.selected
+}
+
+/// Typed read-only observations for consumers that use the structured array.
+/// Preserve `elements` as the input-addressable contract. Passive rows never
+/// carry element_index, element_token, or a fabricated handle.
+pub fn passive_elements(nodes: &[RevisionNode], query: Option<&str>) -> Vec<serde_json::Value> {
+    let query = query.map(str::to_lowercase);
+    nodes.iter().filter(|n| n.element_index.is_none())
+        .filter(|n| has_passive_content(n))
+        .filter(|n| query.as_ref().is_none_or(|q| {
+            n.role.to_lowercase().contains(q) || n.label.to_lowercase().contains(q)
+                || n.value.as_ref().is_some_and(|v| v.to_lowercase().contains(q))
+        }))
+        .map(|n| {
+            let mut entry = serde_json::json!({"role":n.role,"label":n.label,"read_only":true});
+            if let Some(selected) = n.selected_state { entry["selected"] = serde_json::json!(selected); }
+            if let Some(enabled) = n.enabled { entry["enabled"] = serde_json::json!(enabled); }
+            if n.in_web_content { entry["in_web_content"] = serde_json::json!(true); }
+            if let Some(value) = &n.value { entry["value"] = serde_json::json!(value); }
+            if let Some(parent) = n.parent_element_index { entry["parent_index"] = serde_json::json!(parent); }
+            if let Some(identity) = &n.identity { entry["identifier"] = serde_json::json!(identity); }
+            for (k, v) in &n.attrs { entry[k.as_str()] = v.clone(); }
+            entry
+        }).collect()
+}
+
+/// One turn's diff result.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct DiffStep {
+    /// `full_first` (lineage established), `full` (`disable_diff`), `diff`, `no_change`, `full_fallback`.
+    pub kind: &'static str,
+    pub baseline: Baseline,
+    /// Full tree (stable ids), the `~ + -` diff with the verbatim header + legend, or the no-change line.
+    pub text: String,
+    /// `element_index -> stable_id` for the CURRENT snapshot.
+    pub index_to_stable: HashMap<i64, u64>,
+    pub revision: u64,
+    pub snapshot_count: u64,
+}
+
+impl DiffStep {
+    /// The structured `diff` field.
+    pub fn to_json(&self) -> serde_json::Value {
+        serde_json::json!({
+            "baseline": self.baseline.name(),
+            "kind": self.kind,
+            "text": self.text,
+            "accessibility_revision": self.revision,
+            "accessibility_snapshot_count": self.snapshot_count,
+            "_note": "Stable ids persist across get_window_state calls for this (pid, window_id); `elements[].stable_id` maps them to the current element_index. Pass disable_diff:true for a full tree in `text`, cumulative_diff:true for the diff from the initial tree."
+        })
+    }
+    /// Attach `stable_id` to every structured element row that has a mapping.
+    pub fn attach_stable_ids(&self, elements: &mut [serde_json::Value]) {
+        for e in elements.iter_mut() {
+            if let Some(idx) = e.get("element_index").and_then(|v| v.as_i64()) {
+                if let Some(sid) = self.index_to_stable.get(&idx) {
+                    e["stable_id"] = serde_json::json!(sid);
+                }
+            }
+        }
+    }
+}
+
+/// Advance the lineage for `key` with this snapshot's nodes. `disable_diff`
+/// renders the full tree (stable ids) but still advances the lineage.
+pub fn step(key: LineageKey, nodes: &[RevisionNode], app_name: &str, disable_diff: bool, baseline: Baseline) -> DiffStep {
+    let forest = forest_from_nodes(nodes);
+    let opts = DiffOptions { disable_diff, line_budget: axdiff::DEFAULT_LINE_BUDGET, app_name: app_name.to_string() };
+    let mut map = store().lock().unwrap();
+    let (rev, initial, out, kind, revision, count) = match map.remove(&key) {
+        None => {
+            let rev = Revision::initial(&forest);
+            let out = render_diff(&rev, false, &opts);
+            let initial = Revision::restore(rev.state().0.to_vec(), rev.state().1);
+            (rev, initial, out, "full_first", 1u64, 1u64)
+        }
+        Some(l) => {
+            let rev = l.prev.next(&forest);
+            let out = match baseline {
+                Baseline::Previous => render_diff(&rev, true, &opts),
+                Baseline::Initial => render_cumulative(&rev, &l.initial, &opts),
+            };
+            let kind = match (&out, disable_diff) {
+                (_, true) => "full",
+                (DiffOutput::Diff(_), _) => "diff",
+                (DiffOutput::NoChange(_), _) => "no_change",
+                (DiffOutput::FullFallback(_), _) => "full_fallback",
+                (DiffOutput::Full(_), _) => "full",
+            };
+            let revision = l.revision + if rev.any_change() { 1 } else { 0 };
+            (rev, l.initial, out, kind, revision, l.snapshot_count + 1)
+        }
+    };
+    let index_to_stable = rev.index_map();
+    let text = out.text().to_string();
+    map.insert(key, Lineage { prev: rev, initial, revision, snapshot_count: count });
+    DiffStep { kind, baseline, text, index_to_stable, revision, snapshot_count: count }
+}
+
+/// Drop the lineage for a window (unresolved / refused / closed).
+pub fn reset(key: LineageKey) {
+    store().lock().unwrap().remove(&key);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn node(idx: Option<usize>, parent: Option<usize>, role: &str, label: &str, value: Option<&str>) -> RevisionNode {
+        RevisionNode { element_index: idx, parent_element_index: parent, role: role.into(), label: label.into(), value: value.map(str::to_string), selected: false, selected_state: None, enabled: None, in_web_content: false, identity: None, frame: None, attrs: Default::default() }
+    }
+    fn fresh_key() -> LineageKey {
+        static N: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+        (-(std::process::id() as i32), N.fetch_add(1, std::sync::atomic::Ordering::SeqCst))
+    }
+
+    #[test]
+    fn forest_nests_controls_and_retains_display_only_rows_without_targets() {
+        let nodes = vec![
+            node(Some(0), None, "Window", "W", None),
+            node(None, None, "Text", "label only", None),
+            node(Some(1), Some(0), "Edit", "f", Some("x")),
+            node(Some(2), Some(1), "Button", "b", None),
+            node(Some(3), Some(3), "Button", "self-parent", None),
