+struct DragRelease<'a,T,P:Fn(&T)> { up:&'a T, post:&'a P, armed:bool }
+impl<T,P:Fn(&T)> Drop for DragRelease<'_,T,P> {
+    fn drop(&mut self) { if self.armed { (self.post)(self.up); } }
+}
+fn drag_event_subtype(event_type: CGEventType) -> i64 {
+    match event_type {
+        CGEventType::LeftMouseDragged|CGEventType::RightMouseDragged|CGEventType::OtherMouseDragged=>0,
+        _=>3, // match the proven AppKit-targeted mouse-down/up encoding
+    }
+}
+fn emit_drag_sequence<T,P:Fn(&T),A:FnMut(&T)>(events:&[T],post:P,mut after:A) {
+    let (up,body)=events.split_last().expect("drag must contain a release");
+    let mut release=DragRelease {up,post:&post,armed:false};
+    for event in body { release.armed=true; post(event); after(event); }
+    post(up); release.armed=false; after(up);
+}
