+fn two_window_pixel_tool_cell(tool: &str) {
+    let action = format!("two_window_{tool}");
+    let case = native_foreground_case("gtk3", &action, Targeting::Px, DriverRoute::LinuxXTest);
+    let cell_id = case.cell_id.clone();
+    let tool = tool.to_owned();
+    execute_case(case, |evidence| {
+        let mut driver = McpDriver::spawn_named(&cell_id).expect("start source-built Linux driver");
+        *evidence = recording_evidence(driver.recording_dir());
+        let fixture = Receiver::spawn(&mut driver, "two-windows", &[], &[]);
+        let pid = fixture.pid;
+        let window_b = window_titled(&mut driver, pid, "Review Grid B");
+        let state = snapshot(&mut driver, pid, window_b);
+        let rect = element_rect(&mut driver, pid, window_b, &state, "B-4");
+        driver.start_behavior_recording();
+        let before = fixture.events().len();
+        let response = pixel_tool_call(&mut driver, &tool, pid, window_b, rect, "foreground");
+        assert!(!response.is_error(), "{tool} to window B was refused: {}", response.text());
+        std::thread::sleep(Duration::from_millis(700));
+        let presses = fixture.buttons_since(before, "press");
+        let releases = fixture.buttons_since(before, "release");
+        // GTK reports a double click as press, release, press, 2button-press,
+        // release: three press signals for two physical presses.
+        let (expected, count) = match tool.as_str() {
+            "double_click" => ("B:B-4:1", 2),
+            "right_click" => ("B:B-4:3", 1),
+            _ => ("B:B-4:1", 1),
+        };
+        assert!(
+            presses.len() >= count && presses.iter().all(|press| press == expected),
+            "{tool} presses {presses:?}"
+        );
+        assert_eq!(releases, vec![expected.to_owned(); count], "{tool} releases");
+        if tool == "double_click" {
+            assert_eq!(fixture.clicks_since(before), vec!["B:B-4".to_owned(); 2]);
+        }
+        Observation::delivered_with_fixture_state(Vec::new())
+    });
+}
