+        FocusSpec {
+            native_hwnd: 0x1234,
+            automation_id: "txt".into(),
+            name: "ICU-TEXT".into(),
+            control_type: "Edit".into(),
+            class_name: "WindowsForms10.EDIT".into(),
+            x: 100,
+            y: 200,
+            click_fallback: true,
+        }
+    }
+
+    #[test]
+    fn requests_are_one_line_json_with_the_handle() {
+        let key = key_request(197_000, "a", &["ctrl", "shift"], None);
+        assert!(key.ends_with('\n') && key.matches('\n').count() == 1);
+        let v: serde_json::Value = serde_json::from_str(key.trim()).unwrap();
+        assert_eq!(v["method"], "key");
+        assert_eq!(v["hwnd"], 197_000);
+        assert_eq!(v["modifiers"], serde_json::json!(["ctrl", "shift"]));
+        assert!(v.get("focus").is_none());
+        // Text with a newline and quotes stays one line.
+        let text = text_request(7, "line1\n\"two\"", None);
