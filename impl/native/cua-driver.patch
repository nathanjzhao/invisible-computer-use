+/// Capture a window for a caller and record the frame. The returned id names
+/// this exact capture for later pixel actions (`screenshot_id`).
+fn screenshot_window_framed(
+    hwnd: u64,
+) -> Result<(Vec<u8>, bool, Option<FrameGeometry>, Option<u64>)> {
+    let (png, occluded, geometry) = screenshot_window_mapped_uncached(hwnd)?;
+    let identity = window_identity(hwnd, true);
+    let id = window_rect_size(hwnd).map(|size| {
+        CAPTURES.lock().unwrap().get_or_insert_with(Default::default).record(hwnd, identity, size)
+    });
+    Ok((png, occluded, geometry, id))
+}
