+fn wayland_target_matches(windows: &[crate::x11::WindowInfo], pid: u32, xid: u64) -> bool {
+    let mut matches = windows.iter().filter(|window| window.xid == xid);
+    matches.next().is_some_and(|window| window.pid == Some(pid)) && matches.next().is_none()
