+/// What the worker puts on the wire for one step of a gesture, after the plan is resolved to the
+/// device's own coordinates.
+#[derive(Debug, Clone, Copy, PartialEq)]
+enum Emit {
+    /// Absolute motion to a device-region point, then a frame.
+    Motion(f32, f32),
+    /// The button goes down (`true`) or up, then a frame.
+    Button(bool),
+    Pause(u64),
+}
+
+/// The wire script for a gesture: each `Move` is a motion in the device's coordinates (`local`
+/// maps a desktop point into them), a `Press` is a button down, a `Release` a button up, a
+/// `Sleep` a pause. A press right behind a motion waits 15 ms first (it can outrun the motion and
+/// be dropped), and every press is followed by 20 ms. A button still down at the end is released,
+/// so a script never leaves the button held.
+fn gesture_emits(ops: &[GestureOp], local: impl Fn(f64, f64) -> (f32, f32)) -> Vec<Emit> {
+    let mut out = Vec::with_capacity(ops.len() + 4);
+    let mut down = false;
+    for (i, op) in ops.iter().enumerate() {
+        match *op {
+            GestureOp::Move(x, y) => {
+                let (rx, ry) = local(x, y);
+                out.push(Emit::Motion(rx, ry));
+                if matches!(ops.get(i + 1), Some(GestureOp::Press)) {
+                    out.push(Emit::Pause(15));
+                }
+            }
+            GestureOp::Press => {
+                out.push(Emit::Button(true));
+                down = true;
+                out.push(Emit::Pause(20));
+            }
+            GestureOp::Release => {
+                out.push(Emit::Button(false));
+                down = false;
+            }
+            GestureOp::Sleep(ms) => {
+                if ms > 0 {
+                    out.push(Emit::Pause(ms));
+                }
+            }
+        }
+    }
+    if down {
+        out.push(Emit::Button(false));
+    }
+    out
+}
