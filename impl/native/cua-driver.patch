+/// Split `text` into runs whose distinct characters fit one keymap, each with
+/// the keymap source and the XKB keycode sequence that types the run.
+fn text_keymaps(text: &str) -> Vec<(String, Vec<u32>)> {
+    let mut out = Vec::new();
+    let mut assigned: Vec<char> = Vec::new();
+    let mut codes = Vec::new();
+    for ch in text.chars() {
