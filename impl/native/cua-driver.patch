+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Misrouted {
+    window_id: u32,
+    /// The app's key window when it is another window.
+    key_window: Option<u32>,
+    /// The addressed element did not take focus; another element has it.
+    focus_elsewhere: bool,
+}
+
+impl std::fmt::Display for Misrouted {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self.key_window {
+            Some(key) => write!(
+                f,
+                "type_text refused: window {} did not become the key window after it was \
+                 fronted; window {key} is, and the keystrokes would have gone there. Nothing \
+                 was typed.",
+                self.window_id
+            ),
+            None => write!(
+                f,
+                "type_text refused: the addressed element in window {} did not take keyboard \
+                 focus; another element has it, and the keystrokes would have gone there. \
