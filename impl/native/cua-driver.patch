+/// Turn the calling thread's CFRunLoop for the rest of the process. For the
+/// main thread of a daemon with no AppKit UI (`serve --no-overlay`): AppKit
+/// delivers NSWorkspace notifications, including the activations
+/// `focus_steal` observes, only while the main run loop turns. Measured on
+/// macOS 15.7: a background-queue observer saw 0 of 3 app activations with
+/// the main thread parked in a join, and 3 of 3 with it in its run loop.
+pub fn run_main_run_loop_forever() -> ! {
+    become_accessory_app();
+    use core_foundation::date::CFAbsoluteTimeGetCurrent;
+    use core_foundation::runloop::{
+        kCFRunLoopDefaultMode, CFRunLoop, CFRunLoopTimer, CFRunLoopTimerRef,
+    };
+    extern "C" fn keep_alive(_: CFRunLoopTimerRef, _: *mut std::ffi::c_void) {}
+    // A run loop with no sources returns at once; a far-off timer keeps it waiting.
+    let far = 1.0e9;
+    let timer = CFRunLoopTimer::new(
+        unsafe { CFAbsoluteTimeGetCurrent() } + far,
+        far,
+        0,
+        0,
+        keep_alive,
+        std::ptr::null_mut(),
+    );
+    CFRunLoop::get_current().add_timer(&timer, unsafe { kCFRunLoopDefaultMode });
+    loop {
+        CFRunLoop::run_in_mode(
+            unsafe { kCFRunLoopDefaultMode },
+            std::time::Duration::from_secs(3600),
+            false,
+        );
+    }
+}
