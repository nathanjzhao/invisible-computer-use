+            let fields = outcome.structured_content.unwrap();
+            assert_eq!(fields["effect"], "unverifiable");
+            assert_eq!(fields["status"], "uncertain");
+        }
+    }
+
+    #[test]
+    fn effect_then_ax_error_is_not_replayed_or_declared_confirmed() {
+        let calls = std::cell::Cell::new(0);
+        let error = perform_ax_action_once("AXPress", || {
+            calls.set(calls.get() + 1); // the receiver applied the effect
+            -25204 // AXCannotComplete is still an unknown outcome
+        }).unwrap_err();
+        assert_eq!(calls.get(), 1);
+        let result = element_action_failure(error);
+        let outcome = result.structured_content.unwrap();
+        assert_eq!(outcome["effect"], "unverifiable");
+        assert_eq!(outcome["verified"], false);
+    }
+
+    #[test]
+    fn attempted_click_errors_never_claim_no_effect() {
+        for error in [anyhow::anyhow!("AXUIElementPerformAction returned -25204"),
+            TextFocusUnavailable("focus write readback unavailable".into()).into()] {
+            let result = element_action_failure(error);
+            let outcome = result.structured_content.unwrap_or_default();
+            assert_eq!(outcome["effect"], "unverifiable");
+            assert_eq!(outcome["status"], "uncertain");
+            assert_eq!(outcome["verified"], false);
+            assert_eq!(result.is_error, Some(true));
+        }
+    }
+}
