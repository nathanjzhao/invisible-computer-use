+/// One action policy, shared by every route. The renderer is the only detached
+/// work; the caller still awaits actual input delivery and focus restoration.
+pub async fn animate_cursor_for_action(registry: &super::state::CursorRegistry, key: CursorKey, x: f64, y: f64) {
+    motion_for_action(registry.is_detached(&key),
+        || animate_cursor_detached(key.clone(), x, y),
+        || animate_cursor_to(key.clone(), x, y)).await;
