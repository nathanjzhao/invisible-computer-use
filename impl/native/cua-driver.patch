+/// How the app's focused element relates to `element_ptr`: the same element,
+/// a descendant of it, or an ancestor of it are all `Related`.
+fn focus_relation(pid: i32, element_ptr: usize) -> FocusRelation {
+    use core_foundation::base::{CFEqual, CFTypeRef};
+    const MAX_DEPTH: usize = 64;
+    // Whether `needle` is `start` or one of its ancestors.
+    unsafe fn chain_contains(start: AXUIElementRef, needle: AXUIElementRef) -> bool {
+        if CFEqual(start as CFTypeRef, needle as CFTypeRef) != 0 {
+            return true;
+        }
+        let mut current = crate::ax::bindings::copy_element_attr(start, "AXParent");
+        for _ in 0..MAX_DEPTH {
+            let Some(node) = current else { return false };
+            let same = CFEqual(node as CFTypeRef, needle as CFTypeRef) != 0;
+            current = if same { None } else { crate::ax::bindings::copy_element_attr(node, "AXParent") };
+            CFRelease(node as CFTypeRef);
+            if same {
+                return true;
+            }
+        }
+        if let Some(node) = current {
+            CFRelease(node as CFTypeRef);
+        }
+        false
+    }
+    unsafe {
+        let Some(focused) = focused_element_of_pid(pid) else {
+            return FocusRelation::Unknown;
+        };
+        let target = element_ptr as AXUIElementRef;
+        let related = chain_contains(focused, target) || chain_contains(target, focused);
+        CFRelease(focused as CFTypeRef);
+        if related {
+            FocusRelation::Related
+        } else {
+            FocusRelation::Other
+        }
+    }
