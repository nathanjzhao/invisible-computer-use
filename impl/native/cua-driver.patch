+// ── Native Wayland: nested sway and mutter ───────────────────────────────────
+
+/// A compositor nested in the runner's X display, with its own runtime dir.
+struct Nested {
+    runtime: tempfile::TempDir,
+    wayland_display: String,
+    swaysock: Option<String>,
+    xwayland_display: Option<String>,
+    _reaper: cua_driver_testkit::ChildReaper,
+}
+
+impl Nested {
+    fn runtime_path(&self) -> &str {
+        self.runtime.path().to_str().unwrap()
+    }
+
+    fn sway() -> Self {
+        let runtime = tempfile::Builder::new().prefix("cua-sway-").tempdir_in("/tmp").unwrap();
+        std::fs::set_permissions(runtime.path(), std::os::unix::fs::PermissionsExt::from_mode(0o700)).unwrap();
+        let config = runtime.path().join("sway.conf");
+        std::fs::write(
+            &config,
+            "output X11-1 resolution 1280x720 position 0 0\nxwayland force\nfocus_on_window_activation none\n",
+        )
+        .unwrap();
+        let mut reaper = cua_driver_testkit::ChildReaper::new();
+        reaper
+            .spawn(
+                Command::new("sway")
+                    .arg("-c")
+                    .arg(&config)
+                    .env("XDG_RUNTIME_DIR", runtime.path())
+                    .env("WLR_BACKENDS", "x11")
+                    .env("WLR_RENDERER", "pixman")
+                    .env("WLR_LIBINPUT_NO_DEVICES", "1")
+                    .env_remove("WAYLAND_DISPLAY")
+                    .env_remove("SWAYSOCK")
+                    .stdout(Stdio::null())
+                    .stderr(Stdio::inherit()),
+            )
+            .expect("start nested sway");
+        let mut sock = None;
+        wait_until("the sway IPC socket", Duration::from_secs(15), || {
+            sock = std::fs::read_dir(runtime.path()).ok().and_then(|entries| {
+                entries.flatten().find_map(|entry| {
+                    let name = entry.file_name().to_string_lossy().into_owned();
+                    (name.starts_with("sway-ipc.") && name.ends_with(".sock"))
+                        .then(|| entry.path().to_string_lossy().into_owned())
+                })
+            });
+            sock.is_some()
+        });
+        let env_file = runtime.path().join("session-env");
+        let mut nested = Self {
+            wayland_display: "wayland-1".to_owned(),
+            swaysock: sock,
+            xwayland_display: None,
+            _reaper: reaper,
+            runtime,
+        };
+        wait_until("sway to run a session command", Duration::from_secs(15), || {
+            nested
+                .swaymsg(&["exec", &format!("env > {0}.tmp && mv {0}.tmp {0}", env_file.display())])
+                .is_ok()
+                && env_file.exists()
+        });
+        let session = std::fs::read_to_string(&env_file).unwrap();
+        for line in session.lines() {
+            if let Some(value) = line.strip_prefix("WAYLAND_DISPLAY=") {
+                nested.wayland_display = value.to_owned();
+            }
+            if let Some(value) = line.strip_prefix("DISPLAY=") {
+                nested.xwayland_display = Some(value.to_owned());
+            }
+        }
+        nested
+    }
+
+    fn mutter() -> Self {
+        let runtime = tempfile::Builder::new().prefix("cua-mutter-").tempdir_in("/tmp").unwrap();
+        std::fs::set_permissions(runtime.path(), std::os::unix::fs::PermissionsExt::from_mode(0o700)).unwrap();
+        let mut reaper = cua_driver_testkit::ChildReaper::new();
+        reaper
+            .spawn(
+                Command::new("mutter")
+                    .args(["--nested", "--wayland", "--no-x11"])
+                    .env("XDG_RUNTIME_DIR", runtime.path())
+                    .env_remove("WAYLAND_DISPLAY")
+                    .stdout(Stdio::null())
+                    .stderr(Stdio::inherit()),
+            )
+            .expect("start nested mutter");
+        wait_until("the mutter Wayland socket", Duration::from_secs(20), || {
+            runtime.path().join("wayland-0").exists()
+        });
+        std::thread::sleep(Duration::from_millis(1500));
+        Self {
+            wayland_display: "wayland-0".to_owned(),
+            swaysock: None,
+            xwayland_display: None,
+            _reaper: reaper,
+            runtime,
+        }
+    }
+
+    fn swaymsg(&self, args: &[&str]) -> Result<String, String> {
+        let output = Command::new("swaymsg")
+            .arg("-s")
+            .arg(self.swaysock.as_deref().ok_or("not sway")?)
+            .args(args)
+            .output()
+            .map_err(|error| error.to_string())?;
+        if output.status.success() {
+            Ok(String::from_utf8_lossy(&output.stdout).into_owned())
+        } else {
+            Err(String::from_utf8_lossy(&output.stderr).into_owned())
+        }
+    }
+
+    /// Environment of a native Wayland client of this compositor.
+    fn client_env(&self) -> Vec<(&str, &str)> {
+        vec![
+            ("XDG_RUNTIME_DIR", self.runtime_path()),
+            ("WAYLAND_DISPLAY", self.wayland_display.as_str()),
+            ("XDG_SESSION_TYPE", "wayland"),
+            ("GDK_BACKEND", "wayland"),
+        ]
+    }
+
+    /// A driver whose session is this compositor. `opt_in` sets the native
+    /// Wayland backend switch; XWayland's DISPLAY is kept when there is one,
+    /// as a login session exports it.
+    fn driver(&self, opt_in: bool) -> McpDriver {
+        let mut env = vec![
+            ("XDG_RUNTIME_DIR", self.runtime_path()),
+            ("WAYLAND_DISPLAY", self.wayland_display.as_str()),
+            ("XDG_SESSION_TYPE", "wayland"),
+        ];
+        if let Some(sock) = &self.swaysock {
+            env.push(("SWAYSOCK", sock.as_str()));
+        }
+        if let Some(display) = &self.xwayland_display {
+            env.push(("DISPLAY", display.as_str()));
+        }
+        if opt_in {
+            env.push(("CUA_DRIVER_RS_ENABLE_WAYLAND", "1"));
+        }
+        let remove: &[&str] = if self.xwayland_display.is_some() {
+            &["CUA_DRIVER_RS_ENABLE_WAYLAND"]
+        } else {
+            &["DISPLAY", "CUA_DRIVER_RS_ENABLE_WAYLAND"]
+        };
+        McpDriver::spawn_in_session(&env, remove).expect("start the compositor-session driver")
+    }
+
+    /// Sway container rectangle of `pid`'s view.
+    fn container_rect(&self, pid: u32) -> (i64, i64, i64, i64) {
+        let tree: serde_json::Value =
+            serde_json::from_str(&self.swaymsg(&["-t", "get_tree"]).expect("sway tree")).unwrap();
+        let mut stack = vec![&tree];
+        while let Some(node) = stack.pop() {
+            if node["pid"].as_u64() == Some(u64::from(pid)) {
+                let rect = &node["rect"];
+                return (
+                    rect["x"].as_i64().unwrap(),
+                    rect["y"].as_i64().unwrap(),
+                    rect["width"].as_i64().unwrap(),
+                    rect["height"].as_i64().unwrap(),
+                );
+            }
+            for key in ["nodes", "floating_nodes"] {
+                if let Some(children) = node[key].as_array() {
+                    stack.extend(children);
+                }
+            }
+        }
+        panic!("no sway container for pid {pid}");
+    }
+
+    fn grim(&self, rect: (i64, i64, i64, i64), path: &Path) {
+        let status = Command::new("grim")
+            .arg("-g")
+            .arg(format!("{},{} {}x{}", rect.0, rect.1, rect.2, rect.3))
+            .arg(path)
+            .env("XDG_RUNTIME_DIR", self.runtime_path())
+            .env("WAYLAND_DISPLAY", &self.wayland_display)
+            .status()
+            .expect("run grim");
+        assert!(status.success(), "grim failed");
+    }
+}
+
+fn wayland_case(cell_id: &str, action: &str, route: DriverRoute, oracles: Vec<OracleKind>) -> CaseSpec {
+    let mut case = CaseSpec::delivered(
+        cell_id,
+        "gtk3",
+        "gtk3",
+        action,
+        Targeting::Ax,
+        Delivery::NotApplicable,
+        cua_driver_testkit::e2e::Scope::Window,
+        route,
+        oracles,
+    );
+    case.display_server = DisplayServer::Wayland;
+    case
+}
+
+/// Run a nested-compositor cell: the video is recorded by a driver on the
+/// runner's display, where the nested compositor's window is.
+fn run_nested(case: CaseSpec, nested: impl FnOnce() -> Nested, test: impl FnOnce(&Nested, &mut McpDriver) -> Observation) {
+    let cell_id = case.cell_id.clone();
+    execute_case(case, |evidence| {
+        let mut recorder = McpDriver::spawn_named(&cell_id).expect("start the recording driver");
+        *evidence = recording_evidence(recorder.recording_dir());
+        let session = nested();
+        recorder.start_behavior_recording();
+        test(&session, &mut recorder)
+    });
+}
+
+fn wl_window(driver: &mut McpDriver, pid: u32) -> Option<u64> {
+    let windows = driver.call("list_windows", serde_json::json!({}));
+    windows.structured()["windows"].as_array().and_then(|windows| {
+        windows
+            .iter()
+            .find(|window| window["pid"].as_u64() == Some(u64::from(pid)))
+            .and_then(|window| window["window_id"].as_u64())
+    })
+}
+
+fn wayland_backend_check(driver: &mut McpDriver) -> serde_json::Value {
+    let health = driver.call("health_report", serde_json::json!({}));
+    health.structured()["checks"]
+        .as_array()
+        .and_then(|checks| checks.iter().find(|check| check["name"] == "wayland_backend").cloned())
+        .unwrap_or_else(|| panic!("health_report has no wayland_backend check: {}", health.structured()))
+}
+
+fn capture(driver: &mut McpDriver, pid: u32, window_id: u64, out: &Path) -> ToolResponse {
+    driver.call(
+        "get_window_state",
+        serde_json::json!({
+            "pid": pid as i64, "window_id": window_id, "include_screenshot": true,
+            "include_accessibility_tree": false, "screenshot_out_file": out.to_string_lossy()
+        }),
+    )
+}
