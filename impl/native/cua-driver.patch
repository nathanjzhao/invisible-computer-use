--- /dev/null
+++ b/libs/cua-driver/rust/crates/cua-driver-core/src/capture_log.rs
@@ -0,0 +1,1194 @@
+//! Screenshot pixels are only meaningful for the frame they were taken from.
+//!
+//! `get_window_state` records each window capture here and returns its
+//! `screenshot_id`. Pixel actions (`click`, `double_click`, `right_click`,
+//! `drag`, `scroll` and the hold tools) accept the id back and are checked
+//! against THAT frame's window size, scale and identity, and scaled by that
+//! frame's own downscale ratio. Any consumer (the agent, a live preview tile
+//! polling the same daemon, a second MCP client) can capture the same window,
+//! so "the window's latest capture" is not the frame the caller read.
+//!
+//! Without an id (review C9, one rule for every platform) a pixel is read
+//! against the CALLING SESSION's own latest capture of that exact window,
+//! and nothing else:
+//!
+//! - The session is the call's `_session_id`: an explicit `session` argument,
+//!   else the transport's id for the connection (the MCP proxy's or HTTP
+//!   session, the in-process stdio server's, a one-shot CLI call's own). A
+//!   call with neither has no session, and its unbound pixels are refused.
+//! - Each session's latest capture per window is kept in a map apart from
+//!   the frame log, so captures of other windows by anyone cannot evict it.
+//!   The map is bounded least recently used: [`SESSIONS_KEPT`] sessions of
+//!   [`WINDOWS_PER_SESSION`] windows. A forgotten entry refuses; it is never
+//!   replaced by another caller's capture.
+//! - A capture enters the map only when it is recorded, and platforms record
+//!   a frame once its size, scale, ratio and identity are all known, so a
+//!   capture still in flight is never used.
+//! - Other sessions' captures, previews and tiles included, never change the
+//!   scale of this session's pixel and never make it refuse.
+//! - No capture of the window by this session: `ambiguous_capture`. The
+//!   window resized, changed scale or is another window under the same id
+//!   since that capture: `stale_capture`, as for a bound id.
+//! - A capture is filed under the session its call had when the capture
+//!   STARTED ([`CaptureSession::begin`]). A session that ends while one of
+//!   its captures is in flight does not get that capture back, even if it is
+//!   revived before the capture finishes (review windows-final C6).
+//!
+//! `from_zoom` pixels follow the same rule for zoom images: each session's
+//! latest zoom of each window is kept next to its captures, with the window's
+//! size, scale and identity at zoom time. A `from_zoom` pixel is read through
+//! the calling session's own zoom of that exact window and nothing else; no
+//! such zoom refuses, and a window resized or replaced since refuses
+//! `stale_capture` (reviews final-mac F2, final-linux F1 and F3,
+//! windows-final D5).
+
+use std::collections::{HashMap, VecDeque};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Mutex, OnceLock};
+
+use serde_json::{json, Value};
+
+use crate::protocol::ToolResult;
+
+/// Frames kept for `screenshot_id` lookups. A live preview polling a handful
+/// of windows several times a second must not evict the agent's frame before
+/// its next action; older ids fail closed as unknown.
+pub const CAPTURE_LOG_FRAMES: usize = 4096;
+
+/// Sessions whose latest captures are kept for unbound pixels. Past it the
+/// least recently used session is forgotten and its unbound pixels refuse.
+pub const SESSIONS_KEPT: usize = 256;
+
+/// Windows kept per session for unbound pixels, least recently used first out.
+/// Zooms are kept apart from captures, with the same bound.
+pub const WINDOWS_PER_SESSION: usize = 256;
+
+/// Ended sessions remembered so a capture started before the end cannot bring
+/// the session's entry back when it finishes. Past it the oldest end is
+/// forgotten; a capture would have to stay in flight across this many later
+/// session ends to slip through.
+pub const ENDED_KEPT: usize = 4096;
+
+/// Orders capture starts and session ends.
+static EPOCH: AtomicU64 = AtomicU64::new(1);
+
+fn tick() -> u64 {
+    EPOCH.fetch_add(1, Ordering::SeqCst)
+}
+
+/// The session a capture is filed under, and when the capture started. Take
+/// it before the capture begins: the session's unbound pixels are read
+/// against the capture once it is recorded, unless the session ended after
+/// this was taken.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct CaptureSession {
+    name: String,
+    started: u64,
+}
+
+impl CaptureSession {
+    /// The capturing call's session ([`session_of`]), stamped now. `None`
+    /// when the call has no session.
+    pub fn begin(args: &Value) -> Option<Self> {
+        session_of(args).map(Self::named)
+    }
+
+    /// `name`, stamped now (a direct call that names its session).
+    pub fn named(name: &str) -> Self {
+        Self { name: name.to_owned(), started: tick() }
+    }
+
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+}
+
+/// Which window a platform handle named when a frame was taken, for handles
+/// that can be reused (an X11 XID, a Windows HWND).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum WindowIdentity {
+    /// The platform's ids are not reused while the daemon runs (macOS), or it
+    /// has no mark for this surface (Wayland): nothing to compare.
+    Unchecked,
+    /// The platform tried to mark the window and could not, so no later check
+    /// can prove the handle still names it. Pixels read from it refuse.
+    Unproven,
+    /// The platform's mark at capture time (X11 capture generation, Windows
+    /// process start time and window tag).
+    Mark(u64),
+}
+
+/// One window capture: the window's size and scale when it was taken and the
+/// ratio from its returned (possibly downscaled) PNG pixels to capture pixels.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct CapturedFrame {
+    pub id: u64,
+    pub pid: u32,
+    pub window_id: u64,
+    /// Window size in the platform's window units (X11/Wayland pixels, macOS points).
+    pub size: (f64, f64),
+    /// Capture pixels per window unit (the macOS backing scale; 1 elsewhere).
+    pub scale: f64,
+    /// Returned PNG pixels to capture pixels; `None` when not downscaled.
+    pub ratio: Option<f64>,
+    pub identity: WindowIdentity,
+}
+
+/// A finished capture to record: everything a pixel needs is known.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Capture {
+    pub pid: u32,
+    pub window_id: u64,
+    pub size: (f64, f64),
+    pub scale: f64,
+    pub ratio: Option<f64>,
+    pub identity: WindowIdentity,
+}
+
+/// A window's geometry at action time, in the same units as [`CapturedFrame`].
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct CurrentGeometry {
+    pub size: (f64, f64),
+    /// `None` when the platform cannot measure it without a capture.
+    pub scale: Option<f64>,
+}
+
+/// Where a zoom image's pixels sit in the window: the padded crop's origin in
+/// full-window pixels and the inverse of its resize (`1.0`: not resized).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ZoomCrop {
+    pub origin_x: f64,
+    pub origin_y: f64,
+    pub scale_inv: f64,
+}
+
+impl ZoomCrop {
+    /// A zoom-image pixel as a full-window pixel.
+    pub fn to_window(&self, x: f64, y: f64) -> (f64, f64) {
+        (self.origin_x + x * self.scale_inv, self.origin_y + y * self.scale_inv)
+    }
+}
+
+/// One session's latest capture and latest zoom of each window, with use stamps.
+#[derive(Default)]
+struct SessionFrames {
+    used: u64,
+    windows: HashMap<(u32, u64), (u64, CapturedFrame, ())>,
+    zooms: HashMap<(u32, u64), (u64, CapturedFrame, ZoomCrop)>,
+}
+
+/// Insert into a per-session window map, evicting its least recently used
+/// window when full. `id` orders the entries: a platform that finishes
+/// captures out of order (Windows) must not let an older one replace a newer.
+fn insert_window<T>(
+    map: &mut HashMap<(u32, u64), (u64, CapturedFrame, T)>,
+    key: (u32, u64),
+    clock: u64,
+    frame: CapturedFrame,
+    extra: T,
+) {
+    if !map.contains_key(&key) && map.len() >= WINDOWS_PER_SESSION {
+        let oldest = map.iter().min_by_key(|(_, (used, ..))| *used).map(|(k, _)| *k);
+        if let Some(oldest) = oldest {
+            map.remove(&oldest);
+        }
+    }
+    if map.get(&key).is_some_and(|(_, newer, _)| newer.id > frame.id) {
+        return;
+    }
+    map.insert(key, (clock, frame, extra));
+}
+
+#[derive(Default)]
+struct Log {
+    frames: VecDeque<CapturedFrame>,
+    sessions: HashMap<String, SessionFrames>,
+    /// Ended sessions and the [`EPOCH`] tick of their end.
+    ended: HashMap<String, u64>,
+    next: u64,
+    /// Use stamps for the session map's least-recently-used order.
+    clock: u64,
+}
+
+impl Log {
+    fn record(&mut self, session: Option<CaptureSession>, capture: Capture) -> u64 {
+        self.next += 1;
+        let frame = CapturedFrame {
+            id: self.next,
+            pid: capture.pid,
+            window_id: capture.window_id,
+            size: capture.size,
+            scale: capture.scale,
+            ratio: capture.ratio,
+            identity: capture.identity,
+        };
+        if self.frames.len() == CAPTURE_LOG_FRAMES {
+            self.frames.pop_front();
+        }
+        self.frames.push_back(frame);
+        self.note_session(session, frame);
+        self.next
+    }
+
+    /// `session`'s entry for a frame it started capturing, made the most
+    /// recently used; `None` when the call had no session, or the session
+    /// ended after the capture started.
+    fn session_entry(&mut self, session: Option<&CaptureSession>) -> Option<(&mut SessionFrames, u64)> {
+        let session = session?;
+        if self.ended.get(&session.name).is_some_and(|&end| session.started < end) {
+            return None;
+        }
+        self.clock += 1;
+        let clock = self.clock;
+        if !self.sessions.contains_key(&session.name) && self.sessions.len() >= SESSIONS_KEPT {
+            let oldest = self.sessions.iter().min_by_key(|(_, s)| s.used).map(|(k, _)| k.clone());
+            if let Some(oldest) = oldest {
+                self.sessions.remove(&oldest);
+            }
+        }
+        let entry = self.sessions.entry(session.name.clone()).or_default();
+        entry.used = clock;
+        Some((entry, clock))
+    }
+
+    /// Make `frame` `session`'s latest capture of its window.
+    fn note_session(&mut self, session: Option<CaptureSession>, frame: CapturedFrame) {
+        if let Some((entry, clock)) = self.session_entry(session.as_ref()) {
+            insert_window(&mut entry.windows, (frame.pid, frame.window_id), clock, frame, ());
+        }
+    }
+
+    /// Make `crop` `session`'s latest zoom of the window `capture` describes.
+    fn note_zoom(&mut self, session: Option<CaptureSession>, capture: Capture, crop: ZoomCrop) {
+        self.next += 1;
+        let frame = CapturedFrame {
+            id: self.next,
+            pid: capture.pid,
+            window_id: capture.window_id,
+            size: capture.size,
+            scale: capture.scale,
+            ratio: None,
+            identity: capture.identity,
+        };
+        if let Some((entry, clock)) = self.session_entry(session.as_ref()) {
+            insert_window(&mut entry.zooms, (frame.pid, frame.window_id), clock, frame, crop);
+        }
+    }
+
+    /// Forget `session`'s captures and zooms, and refuse any capture it
+    /// started before now.
+    fn forget(&mut self, session: &str) {
+        self.sessions.remove(session);
+        if !self.ended.contains_key(session) && self.ended.len() >= ENDED_KEPT {
+            let oldest = self.ended.iter().min_by_key(|(_, end)| **end).map(|(k, _)| k.clone());
+            if let Some(oldest) = oldest {
+                self.ended.remove(&oldest);
+            }
+        }
+        self.ended.insert(session.to_owned(), tick());
+    }
+
+    fn frame(&self, id: u64) -> Option<CapturedFrame> {
+        self.frames.iter().rev().find(|frame| frame.id == id).copied()
+    }
+
+    /// `session`'s latest capture of `(pid, window_id)`; a lookup counts as a use.
+    fn session_frame(&mut self, session: &str, pid: u32, window_id: u64) -> Option<CapturedFrame> {
+        self.clock += 1;
+        let clock = self.clock;
+        let entry = self.sessions.get_mut(session)?;
+        entry.used = clock;
+        let (used, frame, ()) = entry.windows.get_mut(&(pid, window_id))?;
+        *used = clock;
+        Some(*frame)
+    }
+
+    /// `session`'s latest zoom of `(pid, window_id)`; a lookup counts as a use.
+    fn session_zoom(&mut self, session: &str, pid: u32, window_id: u64) -> Option<(CapturedFrame, ZoomCrop)> {
+        self.clock += 1;
+        let clock = self.clock;
+        let entry = self.sessions.get_mut(session)?;
+        entry.used = clock;
+        let (used, frame, crop) = entry.zooms.get_mut(&(pid, window_id))?;
+        *used = clock;
+        Some((*frame, *crop))
+    }
+
+    /// The unbound half of [`resolve`](Self::resolve): the session's own
+    /// frame, or for a `from_zoom` pixel the session's own zoom.
+    fn unbound(&mut self, args: &Value, pid: u32, window_id: u64) -> Result<PixelBinding, ToolResult> {
+        let session = session_of(args);
+        if is_from_zoom(args) {
+            return match session.and_then(|s| self.session_zoom(s, pid, window_id)) {
+                Some((frame, crop)) => Ok(PixelBinding::Zoom(frame, crop)),
+                None => Err(no_session_zoom_refusal(pid, window_id, session.is_some())),
+            };
+        }
+        match session.and_then(|s| self.session_frame(s, pid, window_id)) {
+            Some(frame) => Ok(PixelBinding::Session(frame)),
+            None => Err(no_session_capture_refusal(pid, window_id, session.is_some())),
+        }
+    }
+
+    fn resolve(&mut self, args: &Value, pid: u32, window_id: u64) -> Result<PixelBinding, ToolResult> {
+        // A zoom pixel was read from a zoom image, never from a screenshot, so
+        // it is read through the session's zoom whatever id comes with it.
+        if is_from_zoom(args) {
+            return self.unbound(args, pid, window_id);
+        }
+        let Some(id) = args.get("screenshot_id").filter(|v| !v.is_null()) else {
+            return self.unbound(args, pid, window_id);
+        };
+        let Some(id) = id.as_str() else {
+            return Err(ToolResult::error("screenshot_id must be a string from get_window_state.")
+                .with_structured(json!({ "code": "invalid_arguments" })));
+        };
+        let Some(frame) = parse_id(id).and_then(|n| self.frame(n)) else {
+            return Err(stale_capture_refusal(
+                window_id,
+                format!(
+                    "screenshot_id {id} is not a capture this driver still holds, so its pixels \
+                     cannot be checked against the window. Re-snapshot with get_window_state and \
+                     pass the new screenshot_id."
+                ),
+            ));
+        };
+        if (frame.pid, frame.window_id) != (pid, window_id) {
+            return Err(ToolResult::error(format!(
+                "screenshot_id {id} is a capture of pid {} window {}, not pid {pid} window {window_id}.",
+                frame.pid, frame.window_id
+            ))
+            .with_structured(json!({ "code": "invalid_arguments" })));
+        }
+        Ok(PixelBinding::Bound(frame))
+    }
+}
+
+fn is_from_zoom(args: &Value) -> bool {
+    args.get("from_zoom").and_then(Value::as_bool) == Some(true)
+}
+
+fn log() -> &'static Mutex<Log> {
+    static LOG: OnceLock<Mutex<Log>> = OnceLock::new();
+    LOG.get_or_init(Default::default)
+}
+
+/// Ids are `f<daemon nonce>-<sequence>`, so an id from an earlier daemon
+/// cannot name a frame of this one.
+fn nonce() -> u32 {
+    static NONCE: OnceLock<u32> = OnceLock::new();
+    *NONCE.get_or_init(|| {
+        let nanos = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|d| d.subsec_nanos())
+            .unwrap_or(0);
+        nanos ^ std::process::id().rotate_left(16)
+    })
+}
+
+fn id_string(id: u64) -> String {
+    format!("f{:08x}-{id}", nonce())
+}
+
+fn parse_id(text: &str) -> Option<u64> {
+    let (daemon, sequence) = text.strip_prefix('f')?.split_once('-')?;
+    (u32::from_str_radix(daemon, 16).ok()? == nonce()).then_some(())?;
+    sequence.parse().ok()
+}
+
+/// The lifecycle id the registry gives a call that names no session and
+/// arrives on no transport session (a raw daemon socket request without
+/// `session_id`), after its runtime prefix. Every such call shares it.
+pub const IMPLICIT_DIRECT_SESSION: &str = "implicit-direct";
+
+/// The session a tool call belongs to: the daemon's resolved `_session_id`,
+/// else an explicit `session` argument (a direct in-process call). `None`
+/// when the call carries neither, or only the shared
+/// [`IMPLICIT_DIRECT_SESSION`], which cannot tell two callers apart.
+pub fn session_of(args: &Value) -> Option<&str> {
+    ["_session_id", "session"]
+        .into_iter()
+        .find_map(|key| args.get(key).and_then(Value::as_str).filter(|s| !s.is_empty()))
+        .filter(|s| !s.ends_with(IMPLICIT_DIRECT_SESSION))
+}
+
+/// Forget an ended session's captures and zooms. Its later unbound pixels
+/// (after an explicit revival) refuse until it captures again, and a capture
+/// it started before the end is not filed under it when that finishes: only
+/// a capture started after the revival counts.
+pub fn forget_session(session: &str) {
+    log().lock().unwrap_or_else(|e| e.into_inner()).forget(session);
+}
+
+/// Record a finished capture and return its `screenshot_id`. `session` is the
+/// capturing call's [`CaptureSession::begin`], taken before the capture
+/// started; the frame becomes that session's latest capture of the window.
+/// Call this only once the frame's ratio and identity are known, and only
+/// for a capture whose caller gets the result: a recorded frame is
+/// immediately what the session's unbound pixels are read against.
+pub fn record(session: Option<CaptureSession>, capture: Capture) -> String {
+    id_string(log().lock().unwrap_or_else(|e| e.into_inner()).record(session, capture))
+}
+
+/// Make a finished capture `session`'s latest capture of its window without
+/// adding it to this log: for a platform that keeps its own frame log and ids
+/// for `screenshot_id` (Windows). The frame's `id` is that platform's.
+pub fn note_session_capture(session: Option<CaptureSession>, id: u64, capture: Capture) {
+    let frame = CapturedFrame {
+        id,
+        pid: capture.pid,
+        window_id: capture.window_id,
+        size: capture.size,
+        scale: capture.scale,
+        ratio: capture.ratio,
+        identity: capture.identity,
+    };
+    log().lock().unwrap_or_else(|e| e.into_inner()).note_session(session, frame);
+}
+
+/// Record a finished zoom of the window `capture` describes (its size, scale
+/// and identity when the zoom was taken; `ratio` is not used) as `session`'s
+/// latest zoom of it. `from_zoom` pixels of that session on that window are
+/// read through `crop`. A zoom with no session is nobody's.
+pub fn record_zoom(session: Option<CaptureSession>, capture: Capture, crop: ZoomCrop) {
+    log().lock().unwrap_or_else(|e| e.into_inner()).note_zoom(session, capture, crop);
+}
+
+/// Which capture a pixel action's coordinates are read from.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum PixelBinding {
+    /// The caller named this frame with `screenshot_id`.
+    Bound(CapturedFrame),
+    /// No id: the calling session's own latest capture of the window.
+    Session(CapturedFrame),
+    /// `from_zoom`: the calling session's own latest zoom of the window. The
+    /// frame is the window as it was when zoomed (its `ratio` is `None`).
+    Zoom(CapturedFrame, ZoomCrop),
+    /// A window pixel the driver computed itself (an element's point from
+    /// the accessibility tree, for a focus click), inside
+    /// [`with_driver_window_point`]. Not a caller's screenshot pixel: it is not
+    /// scaled and not read against any capture (review windows-final C8).
+    DriverPoint,
+    /// No frame: the pixel is not window-local (no window).
+    Unobserved,
+}
+
+tokio::task_local! {
+    static DRIVER_WINDOW_POINT: ();
+}
+
+/// Run `action` (a nested pixel tool call) with its x/y read as window pixels
+/// the driver computed itself, such as an element's point from the tree: the
+/// pixel resolves to [`PixelBinding::DriverPoint`] instead of the calling
+/// session's capture. Only driver code can set this; no argument can.
+pub async fn with_driver_window_point<F: std::future::Future>(action: F) -> F::Output {
+    DRIVER_WINDOW_POINT.scope((), action).await
+}
+
+fn is_driver_window_point() -> bool {
+    DRIVER_WINDOW_POINT.try_with(|_| ()).is_ok()
+}
+
+impl PixelBinding {
+    /// Resolve the capture a pixel action on `(pid, window_id)` was read from:
+    /// `args.screenshot_id` when given, else the calling session's own latest
+    /// capture of the window. Refuses `ambiguous_capture` when there is no id
+    /// and the session has none (or the call has no session). A `from_zoom`
+    /// pixel resolves to the calling session's own latest zoom of the window,
+    /// and refuses when the session has none.
+    pub fn resolve(args: &Value, pid: u32, window_id: u64) -> Result<Self, ToolResult> {
+        if is_driver_window_point() {
+            return Ok(Self::DriverPoint);
+        }
+        log().lock().unwrap_or_else(|e| e.into_inner()).resolve(args, pid, window_id)
+    }
+
+    /// [`resolve`](Self::resolve) for a pixel sent without an id (or a
+    /// `from_zoom` pixel), for a platform that resolves its own ids (Windows).
+    pub fn resolve_unbound(args: &Value, pid: u32, window_id: u64) -> Result<Self, ToolResult> {
+        if is_driver_window_point() {
+            return Ok(Self::DriverPoint);
+        }
+        log().lock().unwrap_or_else(|e| e.into_inner()).unbound(args, pid, window_id)
+    }
+
+    pub fn frame(&self) -> Option<&CapturedFrame> {
+        match self {
+            Self::Bound(frame) | Self::Session(frame) | Self::Zoom(frame, _) => Some(frame),
+            Self::DriverPoint | Self::Unobserved => None,
+        }
+    }
+
+    /// The session's own zoom a `from_zoom` pixel is read through. `None`
+    /// for any other binding.
+    pub fn zoom(&self) -> Option<ZoomCrop> {
+        match self {
+            Self::Zoom(_, crop) => Some(*crop),
+            _ => None,
+        }
+    }
+
+    /// A `from_zoom` pixel as a full-window pixel, through the session's own
+    /// zoom. `None` for any other binding.
+    pub fn zoom_to_window(&self, x: f64, y: f64) -> Option<(f64, f64)> {
+        self.zoom().map(|crop| crop.to_window(x, y))
+    }
+
+    /// The downscale ratio of the frame the pixel is read against
+    /// (`Some(None)`: not scaled, as for a driver point). `None` only without
+    /// a frame.
+    pub fn bound_ratio(&self) -> Option<Option<f64>> {
+        match self {
+            Self::DriverPoint => Some(None),
+            _ => self.frame().map(|frame| frame.ratio),
+        }
+    }
+
+    fn which(&self) -> String {
+        match self {
+            Self::Bound(frame) => format!("screenshot {}", id_string(frame.id)),
+            Self::Zoom(..) => "this session's latest zoom of it".to_string(),
+            _ => "this session's latest screenshot of it".to_string(),
+        }
+    }
+
+    /// Refuse with `stale_capture` when the window's size or scale is not the
+    /// one the frame was taken at. An unmeasurable current geometry is not
+    /// checked (the platform's own liveness guards refuse a closed window).
+    pub fn verify(&self, current: Option<CurrentGeometry>) -> Result<(), ToolResult> {
+        let (Some(frame), Some(current)) = (self.frame(), current) else {
+            return Ok(());
+        };
+        let Some(change) = frame_change(frame, &current) else {
+            return Ok(());
+        };
+        Err(stale_capture_refusal(
+            frame.window_id,
+            format!(
+                "window {} {change} in {}, so that screenshot's pixels no longer name the \
+                 same place. Re-snapshot with get_window_state before retrying.",
+                frame.window_id,
+                self.which()
+            ),
+        ))
+    }
+
+    /// Refuse with `stale_capture` when the handle no longer names the window
+    /// the frame was taken of. `current` reads the platform's mark now; it is
+    /// only called for a frame with a [`WindowIdentity::Mark`].
+    pub fn verify_identity(&self, current: impl FnOnce() -> Option<u64>) -> Result<(), ToolResult> {
+        let Some(frame) = self.frame() else {
+            return Ok(());
+        };
+        let message = match frame.identity {
+            WindowIdentity::Unchecked => return Ok(()),
+            WindowIdentity::Unproven => format!(
+                "this driver could not mark window {} when it took {}, so it cannot tell whether \
+                 the id still names the same window. Re-snapshot with get_window_state before \
+                 retrying.",
+                frame.window_id,
+                self.which()
+            ),
+            WindowIdentity::Mark(mark) if current() != Some(mark) => format!(
+                "window {} is not the window {} was taken of: it was destroyed and its id now \
+                 names a newer window. Re-snapshot with get_window_state before retrying.",
+                frame.window_id,
+                self.which()
+            ),
+            WindowIdentity::Mark(_) => return Ok(()),
+        };
+        Err(stale_capture_refusal(frame.window_id, message))
+    }
+}
+
+/// How the window differs from `frame`, or `None` when it has the same size
+/// and (when measurable) the same scale. Sizes compare to half a unit so
+/// fractional macOS points do not flap.
+fn frame_change(frame: &CapturedFrame, current: &CurrentGeometry) -> Option<String> {
+    let ((cw, ch), (w, h)) = (frame.size, current.size);
+    if (cw - w).abs() > 0.5 || (ch - h).abs() > 0.5 {
+        return Some(format!("is {w}x{h} now but was {cw}x{ch}"));
+    }
+    match current.scale {
+        Some(scale) if (scale - frame.scale).abs() > 0.01 => {
+            Some(format!("is at scale {scale} now but was at scale {}", frame.scale))
+        }
+        _ => None,
+    }
+}
+
+/// The refusal for an unbound pixel on a window the calling session has no
+/// capture of. Same shape as the other capture refusals.
+fn no_session_capture_refusal(pid: u32, window_id: u64, has_session: bool) -> ToolResult {
+    let why = if has_session {
+        format!(
+            "this session has no capture of window {window_id} (pid {pid}) that the driver still \
+             holds"
+        )
+    } else {
+        "this call carries no session, so the driver cannot tell which capture it read".to_owned()
+    };
+    let message = format!(
+        "{why}, and pixels without screenshot_id are read only against the calling session's \
+         own latest capture of the window. Pass the screenshot_id of the get_window_state your \
+         x/y were read from, capture the window with get_window_state in this session first, or \
+         act on an element (element_index or element_token) instead, which needs no capture. A \
+         client that opens a new session for every call (a one-shot `cua-driver call`) has to \
+         pass screenshot_id, or keep one session (`cua-driver mcp`)."
+    );
+    ToolResult::error(format!("refused (ambiguous_capture): {message}")).with_structured(json!({
+        "status": "refused",
+        "code": "ambiguous_capture",
+        "effect": "refused",
+        "refusal": {
+            "code": "ambiguous_capture",
+            "message": message,
+            "window_id": window_id,
+        }
+    }))
+}
+
+/// The refusal for a `from_zoom` pixel on a window the calling session has no
+/// zoom of. Another session's zoom of the window is not this caller's image.
+fn no_session_zoom_refusal(pid: u32, window_id: u64, has_session: bool) -> ToolResult {
+    let why = if has_session {
+        format!("this session has no zoom of window {window_id} (pid {pid})")
+    } else {
+        "this call carries no session, so the driver cannot tell which zoom it read".to_owned()
+    };
+    let message = format!(
+        "from_zoom=true but {why}. from_zoom pixels are read only through the calling \
+         session's own latest zoom of that window. Call zoom on that window (with its pid) in \
+         this session first."
+    );
+    ToolResult::error(format!("refused (invalid_arguments): {message}")).with_structured(json!({
+        "status": "refused",
+        "code": "invalid_arguments",
+        "effect": "refused",
+        "detail": message,
+        "refusal": {
+            "code": "invalid_arguments",
+            "message": message,
+            "window_id": window_id,
+        }
+    }))
+}
+
+/// The typed refusal for a pixel whose frame no longer matches the window.
+/// Same shape as the Windows driver's.
+pub fn stale_capture_refusal(window_id: u64, message: String) -> ToolResult {
+    ToolResult::error(format!("refused (stale_capture): {message}")).with_structured(json!({
+        "status": "refused",
+        "code": "stale_capture",
+        "effect": "refused",
+        "refusal": {
+            "code": "stale_capture",
+            "message": message,
+            "window_id": window_id,
+        }
+    }))
+}
+
+/// Schema for the `screenshot_id` argument of a pixel action.
+pub fn schema_property() -> Value {
+    json!({
+        "type": "string",
+        "description": "screenshot_id from the get_window_state whose screenshot x/y were read from. Binds the pixel to that capture: the action is refused with stale_capture if the window changed size (or, on macOS, backing scale) since, and the pixel is scaled by that capture's own downscale ratio. Without it, this session's own latest capture of the window is used, and the action is refused with ambiguous_capture if this session has none."
+    })
+}
