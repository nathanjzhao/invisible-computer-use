+    /// Structural guard: every window-pixel tool resolves the binding before
+    /// scaling, scales by the bound frame's ratio, and verifies the binding
+    /// against the live frame before translating the point.
+    #[test]
+    fn pixel_tools_bind_scale_and_verify() {
+        for (name, source, zooms) in [
+            ("click", include_str!("click.rs"), true),
+            ("double_click", include_str!("double_click.rs"), false),
+            ("right_click", include_str!("right_click.rs"), false),
+            ("drag", include_str!("drag.rs"), true),
+            ("scroll", include_str!("scroll.rs"), false),
+        ] {
+            assert!(source.contains("\"screenshot_id\": cua_driver_core::capture_log::schema_property()"), "{name} schema");
+            let call = if zooms { "super::px_frame::pixel_binding(&args, pid, window_id)" } else { "super::px_frame::pixel_binding_without_zoom(&args, pid, window_id)" };
+            let bound = source.find(call).unwrap_or_else(|| panic!("{name} never binds"));
+            // final-mac F2: a zoom pixel goes through the binding's own zoom
+            // (this session's, of this window), never a per-pid registry
+            assert!(!source.contains("zoom_registry"), "{name} reads a shared zoom");
+            assert_eq!(source.contains("binding.zoom_to_window("), zooms, "{name} zoom translation");
+            let scaled = source.find(".bound_ratio()").unwrap_or_else(|| panic!("{name} never scales by the bound frame"));
+            let verified = source.find("super::px_frame::verify_binding(&binding, &frame)").unwrap_or_else(|| panic!("{name} never verifies"));
+            let translated = source[verified..].find("frame.to_screen(").map(|at| at + verified);
+            assert!(bound < scaled && scaled < verified, "{name} order");
+            assert!(translated.is_some(), "{name} translates nothing after verifying");
+        }
+    }
