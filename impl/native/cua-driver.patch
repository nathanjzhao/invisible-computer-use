index 00000000..1fd070e4
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-windows/src/uia_worker.rs
@@ -0,0 +1,245 @@
+//! Daemon side of the UIAccess worker: start it on demand and ask it to bring
+//! one window to the foreground (vendor #1602, the forwarding the upstream
+//! daemon leaves out).
+//!
+//! Only `force_foreground_assisted` calls this, and only after its own
+//! attempts failed, so a session where the plain swap works never starts the
+//! worker. The worker is launched with `ShellExecuteExW` (Windows grants
+//! UIAccess to a signed binary in a secure path only on that route) with
+//! `--authorized-parent-pid <this process>`; it rejects any pipe client that is
+//! not this process and exits when this process does. Any failure here returns
+//! an error and the caller keeps today's `foreground_unavailable` refusal.
+
+use std::io::{BufRead, BufReader, Write};
+use std::os::windows::ffi::OsStrExt;
+use std::os::windows::io::AsRawHandle;
+use std::sync::mpsc;
+use std::sync::Mutex;
+use std::time::{Duration, Instant};
+
+use windows::core::{PCWSTR, PWSTR};
+use windows::Win32::Foundation::{CloseHandle, HANDLE};
+use windows::Win32::System::Threading::{
+    OpenProcess, QueryFullProcessImageNameW, PROCESS_NAME_FORMAT, PROCESS_QUERY_LIMITED_INFORMATION,
+};
+use windows::Win32::UI::Shell::{
+    ShellExecuteExW, SEE_MASK_NOASYNC, SEE_MASK_NOCLOSEPROCESS, SHELLEXECUTEINFOW,
+};
+use windows::Win32::UI::WindowsAndMessaging::SW_HIDE;
+
+use crate::uia_protocol::{
+    parse_reply_value, worker_exe_name, worker_pipe_path, FailureMemo, RemoteSnapshot, ReplyError,
+};
+
+static MEMO: Mutex<Option<FailureMemo>> = Mutex::new(None);
+/// One attempt at a time, so two concurrent foreground failures cannot start two workers.
+static ATTEMPT: Mutex<()> = Mutex::new(());
+
+#[link(name = "kernel32")]
+extern "system" {
+    fn GetNamedPipeServerProcessId(pipe: *mut core::ffi::c_void, server_pid: *mut u32) -> i32;
+}
+
+fn wide(text: &std::ffi::OsStr) -> Vec<u16> {
+    text.encode_wide().chain(std::iter::once(0)).collect()
+}
+
+fn process_image(pid: u32) -> Option<std::path::PathBuf> {
+    unsafe {
+        let process = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false, pid).ok()?;
+        let mut buffer = vec![0u16; 1024];
+        let mut length = buffer.len() as u32;
+        let ok = QueryFullProcessImageNameW(
+            process,
+            PROCESS_NAME_FORMAT(0),
+            PWSTR(buffer.as_mut_ptr()),
+            &mut length,
+        )
+        .is_ok();
+        let _ = CloseHandle(process);
+        ok.then(|| std::path::PathBuf::from(String::from_utf16_lossy(&buffer[..length as usize])))
+    }
+}
+
+fn same_path(a: &std::path::Path, b: &std::path::Path) -> bool {
+    let a = std::fs::canonicalize(a).unwrap_or_else(|_| a.to_path_buf());
+    let b = std::fs::canonicalize(b).unwrap_or_else(|_| b.to_path_buf());
+    a.to_string_lossy().eq_ignore_ascii_case(&b.to_string_lossy())
+}
+
+fn launch(worker: &std::path::Path) -> Result<(), String> {
+    let file = wide(worker.as_os_str());
+    let parameters = wide(std::ffi::OsStr::new(&format!(
+        "--authorized-parent-pid {}",
+        std::process::id()
+    )));
+    let verb = wide(std::ffi::OsStr::new("open"));
+    let mut info = SHELLEXECUTEINFOW {
+        cbSize: std::mem::size_of::<SHELLEXECUTEINFOW>() as u32,
+        fMask: SEE_MASK_NOCLOSEPROCESS | SEE_MASK_NOASYNC,
+        lpVerb: PCWSTR(verb.as_ptr()),
+        lpFile: PCWSTR(file.as_ptr()),
+        lpParameters: PCWSTR(parameters.as_ptr()),
+        nShow: SW_HIDE.0,
+        ..Default::default()
+    };
+    unsafe {
+        ShellExecuteExW(&mut info).map_err(|e| {
+            format!(
+                "ShellExecuteEx {} failed: {e} (UIAccess needs an Authenticode-signed worker under Program Files)",
+                worker.display()
+            )
+        })?;
+        if info.hProcess != HANDLE::default() {
+            let _ = CloseHandle(info.hProcess);
+        }
+    }
+    Ok(())
+}
+
+enum Connect {
+    /// No pipe of that name yet: the worker is not running.
+    Absent(String),
+    Failed(String),
+}
+
+fn connect(pipe: &str, worker: &std::path::Path, wait: Duration) -> Result<std::fs::File, Connect> {
+    let deadline = Instant::now() + wait;
+    loop {
+        match std::fs::OpenOptions::new().read(true).write(true).open(pipe) {
+            Ok(file) => {
+                // The pipe name is not reserved: only trust the process that
+                // serves it if it is the worker binary beside this daemon.
+                let mut server = 0u32;
+                let got = unsafe {
+                    GetNamedPipeServerProcessId(file.as_raw_handle().cast(), &mut server)
+                };
+                if got == 0 {
+                    return Err(Connect::Failed("could not read the pipe server's process id".into()));
+                }
+                return match process_image(server) {
+                    Some(image) if same_path(&image, worker) => Ok(file),
+                    Some(image) => Err(Connect::Failed(format!(
+                        "{pipe} is served by {}, not the worker {}",
+                        image.display(),
+                        worker.display()
+                    ))),
+                    None => Err(Connect::Failed(format!(
+                        "could not read the image of pipe server pid {server}"
+                    ))),
+                };
+            }
+            Err(error) => {
+                let absent = error.kind() == std::io::ErrorKind::NotFound;
+                if Instant::now() >= deadline {
+                    let text = format!("worker pipe {pipe} unavailable: {error}");
+                    return Err(if absent { Connect::Absent(text) } else { Connect::Failed(text) });
+                }
+                std::thread::sleep(Duration::from_millis(50));
+            }
+        }
+    }
+}
+
+/// The daemon waits this long for the worker's reply. A click or typed text waits on the target's
+/// foreground change (up to about 2 s with a focus step), so the old 3 s was too close.
+const REPLY_TIMEOUT: Duration = Duration::from_secs(10);
+
+fn exchange(file: std::fs::File, request: String) -> Result<serde_json::Value, ReplyError> {
+    let (sender, receiver) = mpsc::channel();
+    // A blocking pipe read has no timeout; a stuck worker must not hold the
+    // daemon, so the exchange runs on a thread that is abandoned on timeout.
+    std::thread::spawn(move || {
+        let result = (|| {
+            let mut writer = file.try_clone().map_err(|e| ReplyError::Transport(e.to_string()))?;
+            writer
+                .write_all(request.as_bytes())
+                .map_err(|e| ReplyError::Transport(format!("write to worker: {e}")))?;
+            let mut line = String::new();
+            let read = BufReader::new(file)
+                .read_line(&mut line)
+                .map_err(|e| ReplyError::Transport(format!("read from worker: {e}")))?;
+            if read == 0 {
+                return Err(ReplyError::Transport("worker closed the pipe without a reply (it rejects clients that are not its launching daemon)".to_owned()));
+            }
+            parse_reply_value(&line)
+        })();
+        let _ = sender.send(result);
+    });
+    receiver
+        .recv_timeout(REPLY_TIMEOUT)
+        .unwrap_or_else(|_| Err(ReplyError::Transport("worker did not reply within 10 s".into())))
+}
+
+fn try_request(request: &str) -> Result<serde_json::Value, ReplyError> {
+    let exe = std::env::current_exe().map_err(|e| ReplyError::Transport(format!("current_exe: {e}")))?;
+    let name = exe
+        .file_name()
+        .and_then(|n| n.to_str())
+        .unwrap_or("cua-driver.exe")
+        .to_owned();
+    let worker = exe.with_file_name(worker_exe_name(&name));
+    if !worker.is_file() {
+        return Err(ReplyError::Transport(format!("no UIAccess worker at {}", worker.display())));
+    }
+    let pipe = worker_pipe_path(&name);
+    let file = match connect(pipe, &worker, Duration::from_millis(0)) {
+        Ok(file) => file,
+        Err(Connect::Absent(_)) => {
+            launch(&worker).map_err(ReplyError::Transport)?;
+            connect(pipe, &worker, Duration::from_secs(5)).map_err(|e| match e {
+                Connect::Absent(m) | Connect::Failed(m) => ReplyError::Transport(m),
+            })?
+        }
+        Err(Connect::Failed(reason)) => return Err(ReplyError::Transport(reason)),
+    };
+    exchange(file, request.to_owned())
+}
+
+/// Send one request line (see `uia_protocol`) to the UIAccess worker, starting
+/// it if needed, and return the reply's `result`. Every failure is an error and
+/// the caller refuses (or reads locally) as it did before.
+fn request_value(line: &str) -> Result<serde_json::Value, String> {
+    let _one_at_a_time = ATTEMPT.lock().unwrap_or_else(|e| e.into_inner());
+    let now = Instant::now();
+    {
+        let memo = MEMO.lock().unwrap();
+        if let Some(reason) = memo.as_ref().and_then(|m| m.suppressed(now)) {
+            return Err(format!("worker unavailable (retry later): {reason}"));
+        }
+    }
+    let outcome = try_request(line);
+    MEMO.lock().unwrap().get_or_insert_with(FailureMemo::default).observe(now, &outcome.as_ref().map(|_| ()).map_err(Clone::clone));
+    tracing::debug!(target: "uia_worker", ok = outcome.is_ok(), "worker request");
+    outcome.map_err(|e| e.to_string())
+}
+
+/// Send one input request line to the UIAccess worker. `Ok` only when the worker reports the
+/// input was delivered.
+pub fn request(line: &str) -> Result<(), String> {
+    request_value(line).map(|_| ())
+}
+
+/// Ask the UIAccess worker to act on an element through UIA patterns (see `uia_protocol::ActKind`).
+pub fn act(
+    hwnd: u64,
+    spec: &crate::uia_protocol::FocusSpec,
+    act: &crate::uia_protocol::ActKind,
+) -> Result<crate::uia_protocol::ActOutcome, String> {
+    let value = request_value(&crate::uia_protocol::act_request(hwnd, spec, act))?;
+    let outcome: crate::uia_protocol::ActOutcome = serde_json::from_value(value)
+        .map_err(|e| format!("worker act reply is malformed: {e}"))?;
+    outcome.validate_for(act)?;
+    Ok(outcome)
+}
+
+/// Ask the UIAccess worker to read a window's UIA tree (the daemon cannot: see `uia_protocol`).
+pub fn remote_snapshot(
+    hwnd: u64,
+    query: Option<&str>,
+    max_elements: usize,
+    max_depth: usize,
+) -> Result<RemoteSnapshot, String> {
+    let value = request_value(&crate::uia_protocol::snapshot_request(hwnd, query, max_elements, max_depth))?;
+    serde_json::from_value(value).map_err(|e| format!("worker snapshot is malformed: {e}"))
+}
