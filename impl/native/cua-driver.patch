+/// have changed focus, opened menu hops, or dispatched the final command.
+fn uncertain_menu_outcome(message: String) -> ToolResult {
+    ToolResult::error(message).with_structured(serde_json::json!({
+        "status": "uncertain", "code": "action_outcome_unknown",
+        "effect": "unverifiable", "verified": false,
+    })).with_action_record(
+        ActionExecutionRecord::builder(
+            ActionEffect::Unverifiable, ActionTransport::MacosAxAction,
+            RequestedDelivery::Foreground,
+        ).actual_delivery(ActualDelivery::Unknown).build()
+            .expect("uncertain menu outcome is valid"),
