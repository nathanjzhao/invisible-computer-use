+        };
+        for keys in [&["ctrl", "cmd", "q"][..], &["Control+Command+Q"], &["q", "cmd", "ctrl"], &["opt", "cmd", "esc"]] {
+            let result = hotkey.invoke(serde_json::json!({"pid": 4242, "keys": keys})).await;
