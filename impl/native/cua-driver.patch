+/// What decides each route in an opted-in session, read without side effects.
+#[derive(Debug, Clone, Default)]
+struct RouteFacts {
+    inject_mode: bool,
+    hyprland: bool,
+    /// The GNOME shell helper can attest a window's rendered rect.
+    attested_geometry: bool,
+    /// Sway IPC answers, so window capture is always refused, for this reason
+    /// (`crate::wayland::SWAY_WINDOW_CAPTURE_REFUSED`).
+    sway_capture_refused: Option<&'static str>,
+    /// A compositor adapter can focus an exact window and restore focus after.
+    target_activation: bool,
+    virtual_keyboard: bool,
+    portal_input: bool,
+}
+
+fn wayland_routes(facts: &RouteFacts) -> cua_driver_core::health_report::WaylandRoutes {
+    let foreground_keys = if facts.inject_mode {
+        "cua_compositor"
+    } else if !facts.target_activation {
+        "foreground_unavailable"
+    } else if facts.virtual_keyboard {
+        "zwp_virtual_keyboard"
+    } else if facts.portal_input {
+        "libei"
+    } else {
+        "foreground_unavailable"
+    };
+    cua_driver_core::health_report::WaylandRoutes {
+        window_capture: if facts.hyprland {
+            "hyprland_toplevel_export"
+        } else if facts.attested_geometry && facts.sway_capture_refused.is_none() {
+            "compositor_attested_output_crop"
+        } else {
+            "surface_identity_unproven"
+        }
+        .to_owned(),
+        background_element_click: "atspi_action".to_owned(),
+        background_text: if facts.inject_mode { "cua_compositor" } else { "atspi_editable_text" }.to_owned(),
+        background_keys: if facts.inject_mode { "cua_compositor" } else { "background_unavailable" }.to_owned(),
+        foreground_keys: foreground_keys.to_owned(),
+    }
+}
+
+fn with_routes(entry: CheckEntry, routes: cua_driver_core::health_report::WaylandRoutes) -> CheckEntry {
+    let summary = format!(
+        " Routes: window capture {}; background element click {}; background text {}; \
+         background keys {}; foreground keys {}.",
+        routes.window_capture,
+        routes.background_element_click,
+        routes.background_text,
+        routes.background_keys,
+        routes.foreground_keys
+    );
+    let mut entry = entry;
+    entry.message.push_str(&summary);
+    let mut data = entry.data.take().unwrap_or_default();
+    data.wayland_routes = Some(routes);
+    entry.with_data(data)
+}
