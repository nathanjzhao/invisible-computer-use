+#[cfg(target_os = "windows")]
+fn is_top_level_window(hwnd: u64) -> bool {
+    #[link(name = "user32")]
+    extern "system" {
+        fn IsWindow(hwnd: *mut std::ffi::c_void) -> i32;
+        fn IsWindowVisible(hwnd: *mut std::ffi::c_void) -> i32;
+        fn GetAncestor(hwnd: *mut std::ffi::c_void, flags: u32) -> *mut std::ffi::c_void;
+    }
+    const GA_ROOT: u32 = 2;
+    let handle = hwnd as usize as *mut std::ffi::c_void;
+    unsafe { IsWindow(handle) != 0 && IsWindowVisible(handle) != 0 && GetAncestor(handle, GA_ROOT) == handle }
+}
