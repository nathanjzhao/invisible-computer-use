+mod drawn_window_tests {
+    use super::topmost_containing;
+    use windows::Win32::Foundation::{POINT, RECT};
+
+    fn rect(left: i32, top: i32, right: i32, bottom: i32) -> RECT {
+        RECT { left, top, right, bottom }
+    }
+
+    fn all(_: u32) -> bool {
+        true
+    }
+
+    /// The panels fixture at 150%: a form (0) with cell panels 1..=9, each
+    /// 150x90 physical pixels on a 157.5 px pitch.
+    fn panels(node: u32) -> Vec<(u32, RECT)> {
+        if node != 0 {
+            return Vec::new();
+        }
+        (0..9)
+            .map(|i| {
+                let (left, top) = (15 + (i % 3) * 158, 15 + (i / 3) * 98);
+                (i as u32 + 1, rect(left, top, left + 150, top + 90))
+            })
+            .collect()
+    }
+
+    #[test]
+    fn a_cell_centroid_is_drawn_by_that_cell_not_the_form() {
+        // E's centroid. A hit test in the wrong space returned the form here.
+        assert_eq!(topmost_containing(0, POINT { x: 248, y: 158 }, 16, panels, all, all), 5);
+        assert_eq!(topmost_containing(0, POINT { x: 406, y: 256 }, 16, panels, all, all), 9);
+    }
+
+    #[test]
+    fn a_gap_between_cells_is_drawn_by_the_parent() {
+        assert_eq!(topmost_containing(0, POINT { x: 168, y: 60 }, 16, panels, all, all), 0);
+    }
+
+    #[test]
+    fn the_topmost_of_overlapping_siblings_wins_and_descent_follows_it() {
+        // 1 overlaps 2 and is listed first (topmost); 3 is a child of 2 under 1.
+        let tree = |node: u32| match node {
+            0 => vec![(1, rect(0, 0, 100, 100)), (2, rect(50, 0, 200, 100))],
+            2 => vec![(3, rect(50, 0, 120, 50))],
+            _ => Vec::new(),
+        };
+        assert_eq!(topmost_containing(0, POINT { x: 60, y: 10 }, 16, tree, all, all), 1);
+        assert_eq!(topmost_containing(0, POINT { x: 110, y: 10 }, 16, tree, all, all), 3);
+        assert_eq!(topmost_containing(0, POINT { x: 150, y: 80 }, 16, tree, all, all), 2);
+    }
+
+    #[test]
+    fn rect_edges_are_half_open() {
+        assert_eq!(topmost_containing(0, POINT { x: 164, y: 60 }, 16, panels, all, all), 1);
+        assert_eq!(topmost_containing(0, POINT { x: 165, y: 60 }, 16, panels, all, all), 0);
+        assert_eq!(topmost_containing(0, POINT { x: 15, y: 15 }, 16, panels, all, all), 1);
+        assert_eq!(topmost_containing(0, POINT { x: 14, y: 15 }, 16, panels, all, all), 0);
+    }
+
+    #[test]
+    fn a_window_that_passes_the_point_on_is_skipped_for_the_one_beneath() {
+        // Review R3-3: a group box (10) created after the cells and raised
+        // above them encloses the whole grid. It answers HTTRANSPARENT, so
+        // real input reaches the cell under it.
+        let tree = |node: u32| match node {
+            0 => {
+                let mut children = vec![(10, rect(3, 3, 490, 310))];
+                children.extend(panels(0));
+                children
+            }
+            _ => Vec::new(),
+        };
+        assert_eq!(topmost_containing(0, POINT { x: 248, y: 158 }, 16, tree, all, all), 10);
+        assert_eq!(topmost_containing(0, POINT { x: 248, y: 158 }, 16, tree, all, |n| n != 10), 5);
+        // Between cells, the point goes past the group box to the form.
+        assert_eq!(topmost_containing(0, POINT { x: 168, y: 60 }, 16, tree, all, |n| n != 10), 0);
+    }
+
+    #[test]
+    fn a_point_outside_a_childs_region_reaches_its_parent() {
+        // E (5) has an elliptic region: its rect's corner is the form's.
+        assert_eq!(topmost_containing(0, POINT { x: 175, y: 115 }, 16, panels, |n| n != 5, all), 0);
+        assert_eq!(topmost_containing(0, POINT { x: 248, y: 158 }, 16, panels, all, all), 5);
+    }
+
+    #[test]
+    fn a_child_inside_a_window_that_passes_the_point_on_still_takes_it() {
+        // Final review D1: E (5) under a static or group box (10) raised over
+        // it, which holds an opaque panel N (11). Real input reaches N; beside
+        // N, inside 10, it passes through 10 to E.
+        let tree = |node: u32| match node {
+            0 => {
+                let mut children = vec![(10, rect(170, 110, 330, 210))];
+                children.extend(panels(0));
+                children
+            }
+            10 => vec![(11, rect(200, 130, 300, 190))],
+            _ => Vec::new(),
+        };
+        let opaque = |n: u32| n != 10;
+        assert_eq!(topmost_containing(0, POINT { x: 248, y: 158 }, 16, tree, all, opaque), 11);
+        assert_eq!(topmost_containing(0, POINT { x: 180, y: 158 }, 16, tree, all, opaque), 5);
+        // Outside 10's region, its child is not reached either.
+        assert_eq!(topmost_containing(0, POINT { x: 248, y: 158 }, 16, tree, |n| n != 10, all), 5);
+        // N's own transparent child (12) passes the point to N; with N
+        // transparent too, the whole subtree passes it to E.
+        let nested = |node: u32| match node {
+            11 => vec![(12, rect(200, 130, 300, 190))],
+            other => tree(other),
+        };
+        assert_eq!(
+            topmost_containing(0, POINT { x: 248, y: 158 }, 16, nested, all, |n| n != 10 && n != 12),
+            11
+        );
+        assert_eq!(
+            topmost_containing(0, POINT { x: 248, y: 158 }, 16, nested, all, |n| n < 10),
+            5
+        );
+    }
+}
