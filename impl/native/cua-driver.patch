diff --git a/libs/cua-driver/rust/crates/cursor-overlay/build.rs b/libs/cua-driver/rust/crates/cursor-overlay/build.rs
new file mode 100644
index 00000000..eacf21a2
--- /dev/null
+++ b/libs/cua-driver/rust/crates/cursor-overlay/build.rs
@@ -0,0 +1,48 @@
+// Embeds Codex's SkyLens glow frames at build time, if they are present.
+//
+// The 45 loose PNG frames are OpenAI's art. They are NOT committed to the tree
+// (see .gitignore and assets/codex-assets-manifest.json). This machine has them
+// under assets/codex/lens/ (extracted from the installed Codex app); a clean or
+// distributable checkout will not, and then the SkyLens glow degrades to nothing
+// and a distributable build is expected to redraw the frames. Either way the
+// crate compiles: absence just sets SKYLENS_BUILT_WITH_FRAMES = false.
+
+use std::{env, fs, path::PathBuf};
+
+const FRAME_COUNT: usize = 45;
+
+fn main() {
+    let manifest_dir = env::var("CARGO_MANIFEST_DIR").expect("CARGO_MANIFEST_DIR");
+    let lens_dir = PathBuf::from(&manifest_dir).join("assets/codex/lens");
+    println!("cargo:rerun-if-changed=assets/codex/lens");
+    println!("cargo:rerun-if-changed=build.rs");
+
+    let mut frames: Vec<PathBuf> = Vec::with_capacity(FRAME_COUNT);
+    for i in 0..FRAME_COUNT {
+        let path = lens_dir.join(format!("Lens_frame_{i:02}.png"));
+        if path.is_file() {
+            frames.push(path);
+        } else {
+            frames.clear();
+            break;
+        }
+    }
+
+    let mut code = String::new();
+    if frames.len() == FRAME_COUNT {
+        code.push_str("pub const SKYLENS_BUILT_WITH_FRAMES: bool = true;\n");
+        code.push_str("pub(crate) static SKYLENS_FRAME_PNGS: &[&[u8]] = &[\n");
+        for path in &frames {
+            // Absolute path; the frames are gitignored so they cannot live in OUT_DIR-relative
+            // committed space. Any path change reruns this script (rerun-if-changed above).
+            code.push_str(&format!("    include_bytes!(r\"{}\"),\n", path.display()));
+        }
+        code.push_str("];\n");
+    } else {
+        code.push_str("pub const SKYLENS_BUILT_WITH_FRAMES: bool = false;\n");
+        code.push_str("pub(crate) static SKYLENS_FRAME_PNGS: &[&[u8]] = &[];\n");
+    }
+
+    let out = PathBuf::from(env::var("OUT_DIR").expect("OUT_DIR")).join("skylens_frames.rs");
+    fs::write(&out, code).expect("write skylens_frames.rs");
+}
diff --git a/libs/cua-driver/rust/crates/cursor-overlay/examples/render_codex_ab.rs b/libs/cua-driver/rust/crates/cursor-overlay/examples/render_codex_ab.rs
new file mode 100644
index 00000000..ac003ee0
--- /dev/null
+++ b/libs/cua-driver/rust/crates/cursor-overlay/examples/render_codex_ab.rs
@@ -0,0 +1,74 @@
+//! Render the Codex-matched `codex.sky` cursor (pointer + SkyLens glow) at a few
+//! points in the glow loop, plus the unchanged `cua.default` cursor for contrast.
+//! Used to place our render beside a real Codex LensSequence frame for the visual
+//! A/B check (there is no golden for "looks like Codex").
+//!
+//!   cargo run --example render_codex_ab -p cursor-overlay -- <output-dir>
+
+use cursor_overlay::{
+    render_frame, CursorConfig, RenderStateCore, CODEX_THEME_ID, DEFAULT_THEME_ID,
+};
+use std::path::Path;
+
+const SIZE: u32 = 220;
+const SCALE: f32 = 2.0;
+
+fn render(theme_id: &str, elapsed_secs: f64, out: &Path) {
+    let mut config = CursorConfig::default();
+    config.theme_id = theme_id.to_string();
+    config.cursor_id = "default".into();
+    let mut core = RenderStateCore::new(config);
+    core.motion.idle_hide_ms = 0.0; // keep the cursor fully opaque for the still
+    core.pos = (
+        f64::from(SIZE) / (2.0 * f64::from(SCALE)),
+        f64::from(SIZE) / (2.0 * f64::from(SCALE)),
+    );
+    core.heading = f64::from(std::f32::consts::FRAC_PI_4);
+    core.visual.elapsed_secs = elapsed_secs;
+    let pixmap = render_frame(&core, SIZE, SIZE, 0.0, 0.0, None, SCALE);
+    let pixels = unpremultiply_rgba(pixmap.data().to_vec());
+    image::save_buffer_with_format(
+        out,
+        &pixels,
+        SIZE,
+        SIZE,
+        image::ColorType::Rgba8,
+        image::ImageFormat::Png,
+    )
+    .expect("write frame");
+}
+
+fn main() {
+    let dir = std::env::args()
+        .nth(1)
+        .expect("usage: render_codex_ab <output-directory>");
+    let dir = Path::new(&dir);
+    std::fs::create_dir_all(dir).expect("create output dir");
+
+    // Four points spread across the 45-frame / 30 fps SkyLens loop.
+    for (i, frame) in [0u32, 11, 22, 33].iter().enumerate() {
+        render(
+            CODEX_THEME_ID,
+            f64::from(*frame) / 30.0,
+            &dir.join(format!("codex-{i}.png")),
+        );
+    }
+    render(DEFAULT_THEME_ID, 0.2, &dir.join("cua-default.png"));
+    println!("wrote codex A/B frames to {}", dir.display());
+}
+
+fn unpremultiply_rgba(mut pixels: Vec<u8>) -> Vec<u8> {
+    for pixel in pixels.chunks_exact_mut(4) {
+        let alpha = u16::from(pixel[3]);
+        if alpha == 0 {
+            pixel[0] = 0;
+            pixel[1] = 0;
+            pixel[2] = 0;
+            continue;
+        }
+        pixel[0] = ((u16::from(pixel[0]) * 255 + alpha / 2) / alpha).min(255) as u8;
+        pixel[1] = ((u16::from(pixel[1]) * 255 + alpha / 2) / alpha).min(255) as u8;
+        pixel[2] = ((u16::from(pixel[2]) * 255 + alpha / 2) / alpha).min(255) as u8;
+    }
+    pixels
+}
diff --git a/libs/cua-driver/rust/crates/cursor-overlay/src/skylens.rs b/libs/cua-driver/rust/crates/cursor-overlay/src/skylens.rs
new file mode 100644
index 00000000..deb5b12b
--- /dev/null
+++ b/libs/cua-driver/rust/crates/cursor-overlay/src/skylens.rs
@@ -0,0 +1,166 @@
+//! Codex "SkyLens" glow: a 45-frame animated halo drawn around the acting
+//! cursor for the `codex.sky` theme, in place of `cua.default`'s single static
+//! focus rectangle.
+//!
+//! The frames are OpenAI's `LensSequence` art. They are embedded at build time
+//! from a gitignored source directory (see `build.rs` and
+//! `assets/codex-assets-manifest.json`); a build without them degrades to no
+//! glow. This module is rendering only: it never touches input, focus, or the
+//! detach/speed behaviour.
+
+use std::sync::OnceLock;
+use tiny_skia::{BlendMode, FilterQuality, Pixmap, PixmapPaint, PremultipliedColorU8, Transform};
+
+// Generated by build.rs: `SKYLENS_BUILT_WITH_FRAMES: bool` and
+// `SKYLENS_FRAME_PNGS: &[&[u8]]` (empty when the source art was absent).
+include!(concat!(env!("OUT_DIR"), "/skylens_frames.rs"));
+
+/// Loop rate for the sequence. Codex ships the frames loose with no timing
+/// metadata, so this is inferred: 30 fps gives a 1.5 s cycle over 45 frames,
+/// matching the rate the rest of this crate animates at. Documented as
+/// approximated in the asset manifest.
+const SKYLENS_FPS: f64 = 30.0;
+
+/// Glow diameter in logical points, sized to surround the ~42 pt pointer.
+const GLOW_LOGICAL_SIZE: f32 = 62.0;
+
+/// How many SkyLens frames were embedded (0 when the source art was absent).
+pub fn frame_count() -> usize {
+    SKYLENS_FRAME_PNGS.len()
+}
+
+/// Whether the SkyLens glow can render (its source art was embedded).
+pub fn available() -> bool {
+    !SKYLENS_FRAME_PNGS.is_empty()
+}
+
+fn frames() -> &'static [Pixmap] {
+    static FRAMES: OnceLock<Vec<Pixmap>> = OnceLock::new();
+    FRAMES.get_or_init(|| SKYLENS_FRAME_PNGS.iter().filter_map(|bytes| decode(bytes)).collect())
+}
+
+fn decode(png: &[u8]) -> Option<Pixmap> {
+    let rgba = image::load_from_memory(png).ok()?.to_rgba8();
+    let (w, h) = rgba.dimensions();
+    let mut pm = Pixmap::new(w, h)?;
+    for (src, dst) in rgba.pixels().zip(pm.pixels_mut()) {
+        let [r, g, b, a] = src.0;
+        let premul = |c: u8| ((c as u16 * a as u16 + 127) / 255) as u8;
+        *dst = PremultipliedColorU8::from_rgba(premul(r), premul(g), premul(b), a)?;
+    }
+    Some(pm)
+}
+
+/// Draw the glow behind the pointer, centred on the cursor anchor.
+///
+/// `cx`/`cy` are pixmap-pixel coordinates (the cursor hotspot); `backing_scale`
+/// maps logical points to device pixels; `alpha` is the idle fade already
+/// applied to the pointer, so the glow appears and fades with the acting cursor.
+pub fn draw_glow(pm: &mut Pixmap, cx: f32, cy: f32, elapsed_secs: f64, alpha: f32, backing_scale: f32) {
+    let frames = frames();
+    if frames.is_empty() || alpha <= 0.004 {
+        return;
+    }
+    let index = ((elapsed_secs.max(0.0) * SKYLENS_FPS).floor() as usize) % frames.len();
+    let frame = &frames[index];
+    let display = GLOW_LOGICAL_SIZE * backing_scale.max(1.0);
+    let frame_scale = display / frame.width() as f32;
+    let paint = PixmapPaint {
+        opacity: alpha.clamp(0.0, 1.0),
+        blend_mode: BlendMode::SourceOver,
+        quality: FilterQuality::Bilinear,
+    };
+    let transform =
+        Transform::from_scale(frame_scale, frame_scale).post_translate(cx - display / 2.0, cy - display / 2.0);
+    pm.draw_pixmap(0, 0, frame.as_ref(), &paint, transform, None);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    // Guard: with the source art present, the SkyLens sequence embeds all 45
+    // Codex frames and each one decodes to a non-empty premultiplied bitmap.
+    #[test]
+    fn skylens_embeds_all_forty_five_codex_frames() {
+        assert!(
+            SKYLENS_BUILT_WITH_FRAMES,
+            "build without the gitignored Codex LensSequence frames; run --prepare/extract first"
+        );
+        assert_eq!(frame_count(), 45, "SkyLens must load the full 45-frame Codex sequence");
+        assert_eq!(frames().len(), 45, "every embedded SkyLens frame must decode");
+        for frame in frames() {
+            assert!(frame.width() > 0 && frame.height() > 0);
+        }
+    }
+
+    // Guard: the Codex theme is a distinct id derived from the default's
+    // artwork, and adding it leaves `cua.default` (id, silhouette, hotspot)
+    // untouched, so the raw-cua contrast is preserved.
+    #[test]
+    fn codex_theme_is_distinct_and_leaves_cua_default_unchanged() {
+        let default = crate::embedded_default_theme();
+        let codex = crate::embedded_codex_theme();
+        assert_eq!(default.id, crate::DEFAULT_THEME_ID);
+        assert_eq!(codex.id, crate::CODEX_THEME_ID);
+        assert_ne!(default.id, codex.id, "codex theme must not shadow cua.default");
+        // Shared silhouette (same lineage as Codex's pointer), so the pointer
+        // shape matches while only the id/name differ; the render path applies
+        // the Codex tint and glow.
+        assert_eq!(default.actions, codex.actions, "codex must reuse the default silhouette");
+        assert_eq!(default.hotspot, codex.hotspot);
+        assert_eq!(default.source_hash, codex.source_hash);
+    }
+
+    // Guard: `codex.sky` resolves at runtime through the same entry point the
+    // `set_agent_cursor_theme` tool and the `SetTheme` overlay command use, so
+    // it is runtime-selectable and not merely embedded.
+    #[test]
+    fn codex_theme_is_runtime_selectable_via_resolve() {
+        let resolved = crate::resolve_theme_selection(crate::CODEX_THEME_ID)
+            .expect("resolve_theme_selection must not error for codex.sky");
+        let theme = resolved.expect("codex.sky must resolve to a theme, not None");
+        assert_eq!(theme.id, crate::CODEX_THEME_ID);
+    }
+
+    // Guard (cross-OS cursor graphics parity): render_frame is the exact entry point
+    // platform-windows and platform-linux call. It is pure tiny-skia with no platform
+    // cfg, so the Codex cursor graphics render identically on every OS; only the window
+    // that shows the pixmap is platform-specific. This asserts the codex.sky glow reaches
+    // that shared render path, adding the SkyLens orb over the bare pointer.
+    #[test]
+    fn codex_theme_renders_the_glow_through_render_frame_on_every_platform() {
+        if !available() {
+            return;
+        }
+        let opaque = |theme: &str| {
+            let mut config = crate::CursorConfig::default();
+            config.theme_id = theme.into();
+            let mut core = crate::RenderStateCore::new(config);
+            core.motion.idle_hide_ms = 0.0;
+            core.pos = (64.0, 64.0);
+            core.visual.elapsed_secs = 0.2;
+            let pm = crate::render_frame(&core, 128, 128, 0.0, 0.0, None, 2.0);
+            pm.pixels().iter().filter(|p| p.alpha() > 0).count()
+        };
+        let codex = opaque(crate::CODEX_THEME_ID);
+        let default = opaque(crate::DEFAULT_THEME_ID);
+        assert!(
+            codex > default + 500,
+            "codex.sky must add the SkyLens glow over the bare pointer through render_frame: codex={codex} default={default}"
+        );
+    }
+
+    // Guard: the glow actually paints opaque pixels around the anchor at the
+    // start of the loop, and stays inside the pixmap.
+    #[test]
+    fn glow_paints_around_the_anchor() {
+        if !available() {
+            return;
+        }
+        let mut pm = Pixmap::new(128, 128).unwrap();
+        draw_glow(&mut pm, 64.0, 64.0, 0.0, 1.0, 2.0);
+        let painted = pm.pixels().iter().filter(|p| p.alpha() > 0).count();
+        assert!(painted > 0, "SkyLens glow drew nothing");
+    }
+}
diff --git a/libs/cua-driver/rust/crates/platform-linux/src/host_state.rs b/libs/cua-driver/rust/crates/platform-linux/src/host_state.rs
new file mode 100644
index 00000000..acbedb70
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-linux/src/host_state.rs
@@ -0,0 +1,197 @@
+//! Linux adapter for `cua_driver_core::host_state`.
+//!
+//! Lock state comes from what desktop lockers actually publish, not from the X
+//! server: the session-bus screen-saver services (`org.freedesktop.ScreenSaver`
+//! for KDE and shims, `org.gnome/mate/cinnamon/xfce.ScreenSaver`) answer
+//! `GetActive`, and logind publishes `LockedHint` / `Active` for the session on
+//! the system bus. Only names that already have an owner are queried, so the
+//! probe never D-Bus-activates a locker. When no locker and no logind answer,
+//! `screen_locked` is `None` (unknown never refuses); a locker that keeps no
+//! D-Bus presence (bare i3lock/slock) is therefore a published limitation.
+//!
+//! X11 adds the display facts: the MIT-SCREEN-SAVER blank and DPMS power level
+//! both mean the display is dark (`display_asleep`), RandR active monitors are
+//! the display count. The lid is `/proc/acpi/button/lid/*/state` (absent on
+//! desktops and VMs). Wayland keeps display state compositor-private.
+use cua_driver_core::host_state::HostState;
+
+pub fn lid_closed() -> Option<bool> {
+    let dir = std::fs::read_dir("/proc/acpi/button/lid").ok()?;
+    for entry in dir.flatten() {
+        if let Ok(text) = std::fs::read_to_string(entry.path().join("state")) {
+            if text.contains("closed") { return Some(true); }
+            if text.contains("open") { return Some(false); }
+        }
+    }
+    None
+}
+
+/// (screen_locked, on_console, detail) from the session-bus lockers and logind.
+#[derive(Debug, Default, Clone)]
+pub struct SessionFacts {
+    pub screen_locked: Option<bool>,
+    pub on_console: Option<bool>,
+    pub detail: Vec<String>,
+}
+
+/// Screen-saver services that publish `GetActive`: (bus name, object path, interface).
+pub const LOCKER_SERVICES: &[(&str, &str, &str)] = &[
+    ("org.freedesktop.ScreenSaver", "/org/freedesktop/ScreenSaver", "org.freedesktop.ScreenSaver"),
+    ("org.gnome.ScreenSaver", "/org/gnome/ScreenSaver", "org.gnome.ScreenSaver"),
+    ("org.mate.ScreenSaver", "/org/mate/ScreenSaver", "org.mate.ScreenSaver"),
+    ("org.cinnamon.ScreenSaver", "/org/cinnamon/ScreenSaver", "org.cinnamon.ScreenSaver"),
+    ("org.xfce.ScreenSaver", "/org/xfce/ScreenSaver", "org.xfce.ScreenSaver"),
+];
+
+#[cfg(target_os = "linux")]
+fn dbus_session_facts() -> SessionFacts {
+    use zbus::blocking::{fdo::DBusProxy, Connection};
+    let mut facts = SessionFacts::default();
+    match Connection::session() {
+        Ok(conn) => {
+            let owned = |name: &str| DBusProxy::new(&conn).ok().and_then(|d| d.name_has_owner(name.try_into().ok()?).ok()).unwrap_or(false);
+            for (name, path, iface) in LOCKER_SERVICES {
+                if !owned(name) { continue; }
+                match conn.call_method(Some(*name), *path, Some(*iface), "GetActive", &()) {
+                    Ok(reply) => match reply.body().deserialize::<bool>() {
+                        Ok(active) => { facts.screen_locked = Some(facts.screen_locked.unwrap_or(false) || active); facts.detail.push(format!("{name}.GetActive={active}")); }
+                        Err(e) => facts.detail.push(format!("{name}.GetActive: {e}")),
+                    },
+                    Err(e) => facts.detail.push(format!("{name}.GetActive: {e}")),
+                }
+            }
+        }
+        Err(e) => facts.detail.push(format!("session bus: {e}")),
+    }
+    match Connection::system() {
+        Ok(conn) => {
+            let get = |prop: &str| -> Result<bool, String> {
+                let reply = conn.call_method(Some("org.freedesktop.login1"), "/org/freedesktop/login1/session/auto", Some("org.freedesktop.DBus.Properties"), "Get", &("org.freedesktop.login1.Session", prop)).map_err(|e| e.to_string())?;
+                let v: zbus::zvariant::OwnedValue = reply.body().deserialize().map_err(|e| e.to_string())?;
+                bool::try_from(v).map_err(|e| e.to_string())
+            };
+            match get("LockedHint") {
+                Ok(locked) => { facts.screen_locked = Some(facts.screen_locked.unwrap_or(false) || locked); facts.detail.push(format!("logind.LockedHint={locked}")); }
+                Err(e) => facts.detail.push(format!("logind.LockedHint: {e}")),
+            }
+            match get("Active") {
+                Ok(active) => facts.on_console = Some(active),
+                Err(e) => facts.detail.push(format!("logind.Active: {e}")),
+            }
+        }
+        Err(e) => facts.detail.push(format!("system bus: {e}")),
+    }
+    facts
+}
+
+/// The D-Bus round trips run on their own thread so the probe never blocks or
+/// nests inside the driver's async runtime. zbus has no per-call timeout and
+/// `GetActive` is answered by the locker process itself, so a wedged locker
+/// can hold the thread; at most one probe thread exists at a time and while it
+/// is stuck every probe reports "unknown" instead of spawning another.
+#[cfg(target_os = "linux")]
+pub fn session_facts() -> SessionFacts {
+    use std::sync::atomic::{AtomicBool, Ordering};
+    static BUSY: AtomicBool = AtomicBool::new(false);
+    if BUSY.compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire).is_err() {
+        return SessionFacts { detail: vec!["D-Bus probe still running from an earlier call".to_owned()], ..Default::default() };
+    }
+    let (tx, rx) = std::sync::mpsc::channel();
+    std::thread::spawn(move || {
+        let facts = dbus_session_facts();
+        BUSY.store(false, Ordering::Release);
+        let _ = tx.send(facts);
+    });
+    rx.recv_timeout(std::time::Duration::from_millis(1500)).unwrap_or_else(|_| SessionFacts { detail: vec!["D-Bus probe timed out".to_owned()], ..Default::default() })
+}
+
+/// Lockers with no D-Bus presence (i3lock, slock, xsecurelock) all do the same
+/// two things: map a fullscreen override-redirect window on top of the stack
+/// and hold the keyboard grab, so XTEST keystrokes would go to their password
+/// prompt. Both together are the signature. Overlays that sit on top but take
+/// no input (this driver's own ghost-cursor window, a compositor's overlay
+/// window) have an empty input shape and are skipped, so the "top" window is
+/// the topmost one that would actually receive a keystroke; a menu popup is
+/// never fullscreen and a fullscreen game window is managed, not
+/// override-redirect. The grab test releases a successful grab immediately
+/// (two round trips, on a fresh connection that is dropped afterwards).
+#[cfg(target_os = "linux")]
+fn accepts_input(conn: &x11rb::rust_connection::RustConnection, window: x11rb::protocol::xproto::Window) -> bool {
+    use x11rb::protocol::shape;
+    match shape::get_rectangles(conn, window, shape::SK::INPUT).ok().and_then(|c| c.reply().ok()) {
+        Some(reply) => reply.rectangles.iter().any(|r| r.width > 0 && r.height > 0),
+        None => true,
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn x11_locker_signature(conn: &x11rb::rust_connection::RustConnection, screen: &x11rb::protocol::xproto::Screen) -> Option<bool> {
+    use x11rb::protocol::xproto::{self, ConnectionExt as _, GrabMode, GrabStatus, MapState};
+    let root = screen.root;
+    let tree = xproto::query_tree(conn, root).ok()?.reply().ok()?;
+    let top = tree.children.iter().rev().find_map(|&w| {
+        let attrs = xproto::get_window_attributes(conn, w).ok()?.reply().ok()?;
+        (attrs.map_state == MapState::VIEWABLE && accepts_input(conn, w)).then_some((w, attrs.override_redirect))
+    });
+    let Some((top, override_redirect)) = top else { return Some(false) };
+    let geo = xproto::get_geometry(conn, top).ok()?.reply().ok()?;
+    let fullscreen = geo.x <= 0 && geo.y <= 0 && u32::from(geo.width) >= u32::from(screen.width_in_pixels) && u32::from(geo.height) >= u32::from(screen.height_in_pixels);
+    // Only a fullscreen override-redirect top window can be a locker. Probing
+    // the grab otherwise sends the user's focused window FocusOut/FocusIn
+    // (mode Grab/Ungrab) on every input call, which toolkits act on.
+    if !(override_redirect && fullscreen) {
+        return Some(false);
+    }
+    let grab = xproto::grab_keyboard(conn, false, root, x11rb::CURRENT_TIME, GrabMode::ASYNC, GrabMode::ASYNC).ok()?.reply().ok()?.status;
+    if grab == GrabStatus::SUCCESS {
+        let _ = conn.ungrab_keyboard(x11rb::CURRENT_TIME);
+        let _ = x11rb::connection::Connection::flush(conn);
+    }
+    Some(override_redirect && fullscreen && grab == GrabStatus::ALREADY_GRABBED)
+}
+
+/// (locker signature, display dark, active monitors) from X11.
+#[cfg(target_os = "linux")]
+fn x11_display_facts() -> Result<(Option<bool>, Option<bool>, Option<u32>), String> {
+    use x11rb::connection::Connection;
+    use x11rb::protocol::{dpms, randr, screensaver};
+    let (conn, screen_num) = x11rb::rust_connection::RustConnection::connect(None).map_err(|e| format!("X11 connect: {e}"))?;
+    let screen = &conn.setup().roots[screen_num];
+    let root = screen.root;
+    let locker = x11_locker_signature(&conn, screen);
+    let blanked = screensaver::query_info(&conn, root).ok().and_then(|c| c.reply().ok()).map(|r| r.state == u8::from(screensaver::State::ON));
+    let dpms_off = dpms::info(&conn).ok().and_then(|c| c.reply().ok()).map(|r| r.state && r.power_level != dpms::DPMSMode::ON);
+    let dark = match (blanked, dpms_off) { (None, None) => None, (a, b) => Some(a.unwrap_or(false) || b.unwrap_or(false)) };
+    let monitors = randr::get_monitors(&conn, root, true).ok().and_then(|c| c.reply().ok()).map(|r| r.monitors.len() as u32);
+    Ok((locker, dark, monitors))
+}
+
+#[cfg(target_os = "linux")]
+pub fn probe() -> HostState {
+    let lid = lid_closed();
+    let session = session_facts();
+    let mut detail = session.detail.clone();
+    let (locker, display_asleep, active_displays) = if crate::wayland::is_wayland() {
+        detail.push("Wayland: display state is compositor-private".to_owned());
+        (None, None, None)
+    } else {
+        match x11_display_facts() { Ok(f) => f, Err(e) => { detail.push(e); (None, None, None) } }
+    };
+    let screen_locked = match (session.screen_locked, locker) {
+        (None, None) => None,
+        (a, b) => Some(a.unwrap_or(false) || b.unwrap_or(false)),
+    };
+    HostState {
+        screen_locked,
+        on_console: session.on_console,
+        display_asleep,
+        lid_closed: lid,
+        active_displays,
+        probe_error: (screen_locked.is_none() || display_asleep.is_none()).then(|| detail.join("; ")).filter(|d| !d.is_empty()),
+    }
+}
+
+#[cfg(not(target_os = "linux"))]
+pub fn probe() -> HostState {
+    HostState { probe_error: Some("not a Linux host".to_owned()), ..Default::default() }
+}
diff --git a/libs/cua-driver/rust/crates/platform-linux/src/pointer_plan.rs b/libs/cua-driver/rust/crates/platform-linux/src/pointer_plan.rs
new file mode 100644
index 00000000..f834e040
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-linux/src/pointer_plan.rs
@@ -0,0 +1,328 @@
+//! Desktop pointer gestures as a flat list of operations.
+//!
+//! The Sky full-desktop client (`specs/10-linux-mechanism.md`) has a click with a hold duration, a
+//! drag through an ordered path of two or more points, and a move, each optionally under a held key
+//! chord. The X11 (XTest) and Wayland (virtual-pointer) executors both need the same sequence, so
+//! it is planned once here, with no I/O, and each backend replays it. OS-independent on purpose so
+//! the plan is unit-testable on any host.
+
+/// Most points a path may carry. Past this the call is refused, not clipped.
+pub const MAX_PATH_POINTS: usize = 256;
+/// Longest hold or total gesture duration the planner accepts, in milliseconds.
+pub const MAX_MS: u64 = 10_000;
+/// Interpolated pointer motions per segment of a drag path.
+pub const STEPS_PER_SEGMENT: usize = 8;
+/// Gap between the clicks of a multi-click.
+pub const MULTI_CLICK_GAP_MS: u64 = 50;
+/// Default time a drag path takes end to end.
+pub const DEFAULT_DRAG_MS: u64 = 400;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Op {
+    /// Warp the pointer to desktop pixel (x, y).
+    Move(i32, i32),
+    Press,
+    Release,
+    /// Let the server see everything so far, then wait this long.
+    Sleep(u64),
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PlanError(pub String);
+
+impl std::fmt::Display for PlanError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(&self.0)
+    }
+}
+
+fn err<T>(m: impl Into<String>) -> Result<T, PlanError> {
+    Err(PlanError(m.into()))
+}
+
+/// The plan for one gesture.
+///
+/// - `button: None`: a move through `points` (one or more), nothing pressed.
+/// - `button: Some`, one point: `count` clicks, each holding the button `hold_ms`.
+/// - `button: Some`, two or more points: press at the first, glide through every point in order
+///   (`STEPS_PER_SEGMENT` motions per segment, spread over `duration_ms`), hold `hold_ms` at the
+///   last, release. `count` must be 1.
+pub fn plan(
+    points: &[(i32, i32)],
+    button_held: bool,
+    count: usize,
+    hold_ms: u64,
+    duration_ms: Option<u64>,
+) -> Result<Vec<Op>, PlanError> {
+    if points.is_empty() {
+        return err("path needs at least one point");
+    }
+    if points.len() > MAX_PATH_POINTS {
+        return err(format!("path has {} points; at most {MAX_PATH_POINTS}", points.len()));
+    }
+    if hold_ms > MAX_MS {
+        return err(format!("hold_ms {hold_ms} is over {MAX_MS}"));
+    }
+    if duration_ms.is_some_and(|d| d > MAX_MS) {
+        return err(format!("duration_ms is over {MAX_MS}"));
+    }
+    if !(1..=3).contains(&count) {
+        return err(format!("count {count} is outside 1..=3"));
+    }
+    let mut ops = Vec::new();
+    if !button_held {
+        if hold_ms > 0 {
+            return err("hold_ms needs a mouse button");
+        }
+        if count != 1 {
+            return err("count needs a mouse button");
+        }
+        let gap = duration_ms.map(|d| d / points.len() as u64).unwrap_or(0);
+        for &(x, y) in points {
+            ops.push(Op::Move(x, y));
+            if gap > 0 {
+                ops.push(Op::Sleep(gap));
+            }
+        }
+        return Ok(ops);
+    }
+    if points.len() == 1 {
+        let (x, y) = points[0];
+        ops.push(Op::Move(x, y));
+        for i in 0..count {
+            ops.push(Op::Press);
+            ops.push(Op::Sleep(hold_ms));
+            ops.push(Op::Release);
+            if i + 1 < count {
+                ops.push(Op::Sleep(MULTI_CLICK_GAP_MS));
+            }
+        }
+        return Ok(ops);
+    }
+    if count != 1 {
+        return err("a drag path takes count 1");
+    }
+    let segments = points.len() - 1;
+    let total_steps = (segments * STEPS_PER_SEGMENT) as u64;
+    let delay = duration_ms.unwrap_or(DEFAULT_DRAG_MS) / total_steps;
+    let (x0, y0) = points[0];
+    ops.push(Op::Move(x0, y0));
+    ops.push(Op::Press);
+    let mut last = (x0, y0);
+    for pair in points.windows(2) {
+        let ((ax, ay), (bx, by)) = (pair[0], pair[1]);
+        for step in 1..=STEPS_PER_SEGMENT {
+            let t = step as f64 / STEPS_PER_SEGMENT as f64;
+            let at = (
+                (ax as f64 + (bx - ax) as f64 * t).round() as i32,
+                (ay as f64 + (by - ay) as f64 * t).round() as i32,
+            );
+            if at != last {
+                ops.push(Op::Move(at.0, at.1));
+                last = at;
+            }
+            if delay > 0 {
+                ops.push(Op::Sleep(delay));
+            }
+        }
+    }
+    if hold_ms > 0 {
+        ops.push(Op::Sleep(hold_ms));
+    }
+    ops.push(Op::Release);
+    Ok(ops)
+}
+
+/// Pointer motions per `move_to` of a held desktop button, and how long they take together.
+pub const HOLD_GLIDE_STEPS: usize = 8;
+pub const HOLD_GLIDE_MS: u64 = 160;
+
+/// A held desktop button (Sky `drag_handle`): the point it is at.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Held {
+    pub at: (i32, i32),
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum HoldAction {
+    Start,
+    MoveTo,
+    End,
+}
+
+/// What one `drag_handle` step does, given what is held now.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum HoldEffect {
+    /// Press at the point, then hold.
+    Press,
+    /// Glide the held button from where it is to the point.
+    Glide,
+    /// Release where the button is.
+    Release,
+    /// An `end` with nothing held: nothing to release, and not an error, so a caller that lost track
+    /// of the driver can clear its own state.
+    NothingHeld,
+}
+
+/// The state machine of the handle: one button at a time, moved and released only after a press.
+pub fn hold_transition(held: Option<Held>, action: HoldAction) -> Result<HoldEffect, PlanError> {
+    match (held, action) {
+        (None, HoldAction::Start) => Ok(HoldEffect::Press),
+        (Some(h), HoldAction::Start) => err(format!(
+            "a mouse button is already held at ({}, {}): move_to and end it before starting another",
+            h.at.0, h.at.1
+        )),
+        (Some(_), HoldAction::MoveTo) => Ok(HoldEffect::Glide),
+        (None, HoldAction::MoveTo) => err("no mouse button is held: start the drag first"),
+        (Some(_), HoldAction::End) => Ok(HoldEffect::Release),
+        (None, HoldAction::End) => Ok(HoldEffect::NothingHeld),
+    }
+}
+
+/// The motions that carry a held button from `from` to `to`: `steps` evenly spaced positions ending
+/// exactly at `to`, spread over `duration_ms`. The same point twice is one motion.
+pub fn glide(from: (i32, i32), to: (i32, i32), steps: usize, duration_ms: u64) -> Result<Vec<Op>, PlanError> {
+    if !(1..=200).contains(&steps) {
+        return err(format!("steps {steps} is outside 1..=200"));
+    }
+    if duration_ms > MAX_MS {
+        return err(format!("duration_ms is over {MAX_MS}"));
+    }
+    let delay = duration_ms / steps as u64;
+    let mut ops = Vec::new();
+    let mut last = from;
+    for step in 1..=steps {
+        let t = step as f64 / steps as f64;
+        let at = (
+            (from.0 as f64 + (to.0 - from.0) as f64 * t).round() as i32,
+            (from.1 as f64 + (to.1 - from.1) as f64 * t).round() as i32,
+        );
+        if at != last || step == steps {
+            ops.push(Op::Move(at.0, at.1));
+            last = at;
+            if delay > 0 && step < steps {
+                ops.push(Op::Sleep(delay));
+            }
+        }
+    }
+    Ok(ops)
+}
+
+/// Every point a plan moves to, in order (the executors and the tests read the visit order here).
+pub fn visited(ops: &[Op]) -> Vec<(i32, i32)> {
+    ops.iter()
+        .filter_map(|op| match op {
+            Op::Move(x, y) => Some((*x, *y)),
+            _ => None,
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_click_holds_the_button_for_the_requested_time_each_time() {
+        let ops = plan(&[(10, 20)], true, 2, 120, None).unwrap();
+        assert_eq!(
+            ops,
+            vec![
+                Op::Move(10, 20),
+                Op::Press,
+                Op::Sleep(120),
+                Op::Release,
+                Op::Sleep(MULTI_CLICK_GAP_MS),
+                Op::Press,
+                Op::Sleep(120),
+                Op::Release,
+            ]
+        );
+    }
+
+    #[test]
+    fn a_drag_visits_every_point_of_the_path_in_order_with_one_press_and_one_release() {
+        let path = [(0, 0), (100, 0), (100, 100), (0, 100)];
+        let ops = plan(&path, true, 1, 0, Some(240)).unwrap();
+        assert_eq!(ops.iter().filter(|o| **o == Op::Press).count(), 1);
+        assert_eq!(ops.iter().filter(|o| **o == Op::Release).count(), 1);
+        assert_eq!(ops.first(), Some(&Op::Move(0, 0)));
+        assert_eq!(ops[1], Op::Press);
+        assert_eq!(ops.last(), Some(&Op::Release));
+        let visits = visited(&ops);
+        for corner in &path {
+            assert!(visits.contains(corner), "the path corner {corner:?} is visited");
+        }
+        let at = |p: (i32, i32)| visits.iter().position(|v| *v == p).unwrap();
+        assert!(at(path[1]) < at(path[2]) && at(path[2]) < at(path[3]), "corners in path order");
+        // the press comes before every move after the first, the release after the last
+        let press = ops.iter().position(|o| *o == Op::Press).unwrap();
+        let release = ops.iter().position(|o| *o == Op::Release).unwrap();
+        assert!(ops[press + 1..release].iter().any(|o| matches!(o, Op::Move(..))));
+        assert!(ops[release..].iter().all(|o| !matches!(o, Op::Move(..))), "nothing moves after the release");
+    }
+
+    #[test]
+    fn a_two_point_drag_is_the_straight_segment() {
+        let ops = plan(&[(0, 0), (80, 0)], true, 1, 0, Some(80)).unwrap();
+        let visits = visited(&ops);
+        assert_eq!(visits.len(), 1 + STEPS_PER_SEGMENT);
+        assert_eq!(visits.last(), Some(&(80, 0)));
+        assert!(visits.windows(2).all(|w| w[0].0 <= w[1].0 && w[0].1 == w[1].1), "monotonic along the line");
+    }
+
+    #[test]
+    fn a_move_presses_nothing() {
+        let ops = plan(&[(5, 6), (7, 8)], false, 1, 0, None).unwrap();
+        assert_eq!(ops, vec![Op::Move(5, 6), Op::Move(7, 8)]);
+    }
+
+    #[test]
+    fn hold_at_the_end_of_a_drag_comes_before_the_release() {
+        let ops = plan(&[(0, 0), (10, 0)], true, 1, 300, Some(0)).unwrap();
+        let n = ops.len();
+        assert_eq!(&ops[n - 2..], &[Op::Sleep(300), Op::Release]);
+    }
+
+    #[test]
+    fn bad_gestures_are_refused_not_clipped() {
+        assert!(plan(&[], true, 1, 0, None).is_err());
+        assert!(plan(&vec![(0, 0); MAX_PATH_POINTS + 1], true, 1, 0, None).is_err());
+        assert!(plan(&[(0, 0)], true, 1, MAX_MS + 1, None).is_err());
+        assert!(plan(&[(0, 0)], true, 4, 0, None).is_err());
+        assert!(plan(&[(0, 0)], true, 0, 0, None).is_err());
+        assert!(plan(&[(0, 0), (1, 1)], true, 2, 0, None).is_err(), "no double drag");
+        assert!(plan(&[(0, 0)], false, 1, 50, None).is_err(), "a hold needs a button");
+        assert!(plan(&[(0, 0)], false, 2, 0, None).is_err());
+    }
+
+    #[test]
+    fn a_held_button_is_pressed_once_moved_only_while_held_and_released_where_it_is() {
+        let at = Some(Held { at: (5, 5) });
+        assert_eq!(hold_transition(None, HoldAction::Start), Ok(HoldEffect::Press));
+        assert!(hold_transition(at, HoldAction::Start).is_err(), "one button at a time");
+        assert_eq!(hold_transition(at, HoldAction::MoveTo), Ok(HoldEffect::Glide));
+        assert!(hold_transition(None, HoldAction::MoveTo).is_err(), "nothing to move");
+        assert_eq!(hold_transition(at, HoldAction::End), Ok(HoldEffect::Release));
+        assert_eq!(hold_transition(None, HoldAction::End), Ok(HoldEffect::NothingHeld));
+    }
+
+    #[test]
+    fn a_glide_ends_exactly_at_the_target_and_never_overshoots() {
+        let ops = glide((0, 0), (100, 40), HOLD_GLIDE_STEPS, HOLD_GLIDE_MS).unwrap();
+        let visits = visited(&ops);
+        assert_eq!(visits.len(), HOLD_GLIDE_STEPS);
+        assert_eq!(visits.last(), Some(&(100, 40)));
+        assert!(visits.windows(2).all(|w| w[0].0 <= w[1].0 && w[0].1 <= w[1].1), "monotonic toward the target");
+        assert!(visits.iter().all(|p| (0..=100).contains(&p.0) && (0..=40).contains(&p.1)));
+        assert_eq!(ops.iter().filter(|o| matches!(o, Op::Sleep(_))).count(), HOLD_GLIDE_STEPS - 1);
+        assert!(!ops.iter().any(|o| matches!(o, Op::Press | Op::Release)), "a glide neither presses nor releases");
+    }
+
+    #[test]
+    fn a_glide_to_where_it_already_is_is_one_motion_and_a_bad_glide_is_refused() {
+        assert_eq!(glide((7, 9), (7, 9), 8, 160).unwrap(), vec![Op::Move(7, 9)]);
+        assert!(glide((0, 0), (1, 1), 0, 10).is_err() && glide((0, 0), (1, 1), 201, 10).is_err());
+        assert!(glide((0, 0), (1, 1), 4, MAX_MS + 1).is_err());
+    }
+}
diff --git a/libs/cua-driver/rust/crates/platform-macos/src/ax/recovery.rs b/libs/cua-driver/rust/crates/platform-macos/src/ax/recovery.rs
