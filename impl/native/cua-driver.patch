+/// A structured refusal for an index whose object changed after observation.
+/// Returned before any fallback route, so no other control is actuated.
+fn stale_target_refusal(error: &anyhow::Error) -> Option<ToolResult> {
+    let message = format!("{error:#}");
+    message.contains(crate::atspi::STALE_TARGET).then(|| {
+        ToolResult::error(message.clone()).with_structured(json!({
+            "status": "refused",
+            "refusal": { "code": crate::atspi::STALE_TARGET, "message": message },
+        }))
+    })
