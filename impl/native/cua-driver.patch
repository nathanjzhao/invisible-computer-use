+/// Code for a desktop capture that cannot work in this session, as opposed to
+/// one that failed transiently.
+pub const DESKTOP_CAPTURE_UNAVAILABLE: &str = "desktop_capture_unavailable";
+
+/// XWayland under a Wayland compositor with the native backend off: X clients
+/// and per-window capture work, but the X root window has no framebuffer, so
+/// every root read fails with BadMatch.
+pub fn is_rootless_xwayland() -> bool {
+    std::env::var_os("WAYLAND_DISPLAY").is_some()
+        && std::env::var_os("DISPLAY").is_some()
+        && !crate::wayland::is_wayland()
+}
+
+/// Read one root pixel over X11: the same request desktop capture makes, at
+/// the smallest size. Readiness uses it instead of a bare connect.
+pub fn x11_root_read_probe() -> Result<()> {
+    use x11rb::connection::Connection;
+    use x11rb::protocol::xproto::*;
+    use x11rb::rust_connection::RustConnection;
+    let (conn, screen_num) = RustConnection::connect(None)?;
+    let root = conn.setup().roots[screen_num].root;
+    let geometry = conn.get_geometry(root)?.reply()?;
+    if geometry.width == 0 || geometry.height == 0 {
+        anyhow::bail!("X11 root window reports a 0x0 geometry");
+    }
+    conn.get_image(ImageFormat::Z_PIXMAP, root, 0, 0, 1, 1, !0u32)?
+        .reply()?;
+    Ok(())
+}
