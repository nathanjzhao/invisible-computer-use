@@ -0,0 +1,83 @@
+//! In-process daemon drain test. No desktop preparation or native input.
+use super::{run_serve, send_request, DaemonRequest};
+use async_trait::async_trait;
+use cua_driver_core::{protocol::ToolResult, tool::{Tool, ToolDef, ToolRegistry}};
+use serde_json::{json, Value};
+use std::sync::{Arc, Mutex, atomic::{AtomicBool, Ordering}};
+use std::time::Duration;
+
+#[derive(Default)]
+struct ProbeState {
+    started: tokio::sync::Notify,
+    release: tokio::sync::Notify,
+    finished: AtomicBool,
+    aborted: AtomicBool,
+}
+static STATE: Mutex<Option<Arc<ProbeState>>> = Mutex::new(None);
+struct Probe { def: ToolDef, state: Arc<ProbeState> }
+struct Completion(Arc<ProbeState>);
+impl Drop for Completion {
+    fn drop(&mut self) {
+        if !self.0.finished.load(Ordering::SeqCst) { self.0.aborted.store(true, Ordering::SeqCst); }
+    }
+}
+#[async_trait]
+impl Tool for Probe {
+    fn def(&self) -> &ToolDef { &self.def }
+    async fn invoke(&self, _: Value) -> ToolResult {
+        let _completion = Completion(self.state.clone());
+        self.state.started.notify_one();
+        self.state.release.notified().await;
+        self.state.finished.store(true, Ordering::SeqCst);
+        ToolResult::text("admitted operation completed")
+    }
+}
+fn register(registry: &mut ToolRegistry) {
+    registry.register(Box::new(Probe {
+        def: ToolDef { name: "health_report".into(), description: "held test operation".into(),
+            input_schema: json!({"type":"object"}), read_only: true, destructive: false,
+            idempotent: true, open_world: false },
+        state: STATE.lock().unwrap().as_ref().unwrap().clone(),
+    }));
+}
+fn request(method: &str, name: Option<&str>) -> DaemonRequest {
+    DaemonRequest { method: method.into(), name: name.map(str::to_owned), args: Some(json!({})),
+        session_id: None, observation_origin: None, client_kind: None }
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn shutdown_drains_admitted_daemon_work_before_aborting_connections() {
+    let _guard = crate::test_runtime_lock().lock().await;
+    let state = Arc::new(ProbeState::default());
+    *STATE.lock().unwrap() = Some(state.clone());
+    let driver = cua_driver_sdk::CuaDriver::create_for_host(cua_driver_sdk::DriverHostOptions {
+        cursor: cursor_overlay::CursorConfig { enabled: false, ..Default::default() },
+        host_owns_permission_ux: false, host_bundle_id: None, claude_code_compatibility: false,
+        prepare_desktop_environment: false, register_host_tools: Some(register),
+        authorization_host: None, activity_observer: None,
+    });
+    let sdk = crate::sdk_adapter::SdkAdapter::load(driver).await.unwrap();
+    let directory = tempfile::tempdir().unwrap();
+    let path = directory.path().join("drain.sock").to_string_lossy().into_owned();
+    let server_path = path.clone();
+    let mut server = tokio::spawn(async move { run_serve(sdk, &server_path, None).await });
+    tokio::time::timeout(Duration::from_secs(3), async {
+        while !std::path::Path::new(&path).exists() { tokio::time::sleep(Duration::from_millis(10)).await; }
+    }).await.unwrap();
+    let call_path = path.clone();
+    let call = tokio::task::spawn_blocking(move || send_request(&call_path, &request("call", Some("health_report"))));
+    tokio::time::timeout(Duration::from_secs(3), state.started.notified()).await.unwrap();
+    let response = tokio::task::spawn_blocking(move || send_request(&path, &request("shutdown", None))).await.unwrap().unwrap();
+    assert!(response.ok);
+    let early = tokio::time::timeout(Duration::from_millis(100), &mut server).await;
+    let drained = early.is_err();
+    state.release.notify_one();
+    if drained { tokio::time::timeout(Duration::from_secs(3), server).await.unwrap().unwrap().unwrap(); }
+    else { early.unwrap().unwrap().unwrap(); }
+    // Shutdown can close the response socket after the work drains. The native
+    // operation's cleanup, not delivery of a final RPC reply, is the invariant.
+    let _ = tokio::time::timeout(Duration::from_secs(3), call).await.unwrap();
+    assert!(drained, "daemon shutdown completed while admitted work was still held");
+    assert!(state.finished.load(Ordering::SeqCst), "admitted work was cancelled before completion");
+    assert!(!state.aborted.load(Ordering::SeqCst), "transport shutdown aborted the operation future");
+}
