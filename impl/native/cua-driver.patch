+        let hotkey = key_input_tool("hotkey", HotkeyTool::new(state.clone()), &no_windows);
+        let typing = key_input_tool("type_text", TypeTextTool::new(state.clone()), &no_windows);
+        let click = key_input_tool("click", ClickTool::new(state.clone()), &no_windows);
+        let drag = key_input_tool("drag", DragTool::new(state), &no_windows);
+        let code = |result: ToolResult| {
+            let s = result.structured_content.unwrap_or_default();
