+pub fn screenshot_transient_region(window_id: u32, expected: &crate::windows::WindowBounds)
+    -> anyhow::Result<(Vec<u8>, crate::windows::WindowBounds)> {
+    let identity = current_window_capture_identity(window_id)?;
+    let expected_frame = WindowCaptureIdentity::new(identity.pid, identity.layer,
+        expected.x, expected.y, expected.width, expected.height);
+    if identity != expected_frame { anyhow::bail!("transient moved before capture"); }
+    let result = capture_transient_with(window_id, expected, |args| {
+        let capture = SecureCapturePath::new("transient.png")?;
+        let mut child = Command::new("/usr/sbin/screencapture").args(args).arg("-x")
+            .arg(&capture.file).stdout(std::process::Stdio::null()).stderr(std::process::Stdio::null()).spawn()?;
+        let deadline = Instant::now() + Duration::from_secs(2);
+        loop {
+            if let Some(status) = child.try_wait()? {
+                if !status.success() { anyhow::bail!("transient region capture failed: {status}"); }
+                break;
+            }
+            if Instant::now() >= deadline {
+                let _ = child.kill(); let _ = child.wait();
+                anyhow::bail!("transient region capture deadline exceeded");
+            }
+            std::thread::sleep(Duration::from_millis(5));
+        }
+        Ok(std::fs::read(&capture.file)?)
