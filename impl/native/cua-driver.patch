+    let mut symbols = String::from("key <P0> {[ NoSymbol ]};\n");
+    for (index, ch) in chars.iter().enumerate() {
+        let code = FIRST_TEXT_KEYCODE + index as u32;
+        keycodes.push_str(&format!("<K{code}> = {code};\n"));
+        symbols.push_str(&format!("key <K{code}> {{[ {} ]}};\n", keysym_name(*ch)));
+    }
