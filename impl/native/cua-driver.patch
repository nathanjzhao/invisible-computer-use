+// ── Stale and relabelled element targets ─────────────────────────────────────
+
+/// Take a token for `label`, apply `change`, click the token in the
+/// background: it must be refused as `stale_element_target` with no click.
+/// Afterwards a fresh snapshot's token for `fresh` must click it, so the
+/// refusal is not a blanket one.
+fn stale_target_cell(action: &str, label: &str, change: &str, fresh: &str) {
+    let case = native_background_case("gtk3", action, Targeting::Ax, DriverRoute::LinuxAtSpiAction)
+        .expecting_refusal(vec![RefusalCode::StaleElementTarget]);
+    let cell_id = case.cell_id.clone();
+    let (label, change, fresh) = (label.to_owned(), change.to_owned(), fresh.to_owned());
+    execute_case(case, |evidence| {
+        let mut driver = McpDriver::spawn_named(&cell_id).expect("start source-built Linux driver");
+        *evidence = recording_evidence(driver.recording_dir());
+        let fixture = Receiver::spawn(&mut driver, "stale", &[], &[]);
+        let pid = fixture.pid;
+        let window = window_titled(&mut driver, pid, "Review Stale");
+        let state = snapshot(&mut driver, pid, window);
+        let token = token_for(&state, &label);
+        fixture.send(&change);
+        let before = fixture.events().len();
+        let (response, mut passed) = run_with_background_oracles(
+            &mut driver,
+            TargetWindow { pid, native_id: window },
+            |driver| {
+                driver.call(
+                    "click",
+                    serde_json::json!({
+                        "pid": pid as i64, "window_id": window,
+                        "element_token": token, "delivery_mode": "background"
+                    }),
+                )
+            },
+        )
+        .unwrap_or_else(|error| panic!("background desktop contract failed: {error}"));
+        std::thread::sleep(Duration::from_millis(500));
+        let fired = fixture.clicks_since(before);
+        assert!(
+            response.is_error() && refusal_code(&response).as_deref() == Some("stale_element_target"),
+            "token for {label:?} after {change:?} was not refused as stale: {} (clicks {fired:?})",
+            response.text()
+        );
+        assert_eq!(fired, Vec::<String>::new(), "a click fired");
+
+        let fresh_state = snapshot(&mut driver, pid, window);
+        let fresh_token = token_for(&fresh_state, &fresh);
+        let before = fixture.events().len();
+        let clicked = driver.call(
+            "click",
+            serde_json::json!({ "pid": pid as i64, "window_id": window, "element_token": fresh_token }),
+        );
+        assert!(!clicked.is_error(), "fresh token for {fresh:?} failed: {}", clicked.text());
+        wait_until(&format!("{fresh:?} to be clicked"), Duration::from_secs(3), || {
+            fixture.clicks_since(before) == vec![format!("S:{fresh}")]
+        });
+        passed.push(OracleKind::FixtureState);
+        Observation::refused(
+            RefusalCode::StaleElementTarget,
+            passed,
+            format!("token for {label:?} refused after {change:?}; fresh token for {fresh:?} clicked"),
+            Evidence::default(),
+        )
+    });
+}
