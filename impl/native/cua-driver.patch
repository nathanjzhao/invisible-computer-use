+/// The `element_index` of the actionable row that is the app's focused element,
+/// when that element is in `window_id`. Compared by AX identity (CFEqual)
+/// against the walk's retained actionable elements only.
+fn focused_element_index(pid: i32, window_id: u32, nodes: &[crate::ax::tree::AXNode]) -> Option<usize> {
+    use core_foundation::base::{CFEqual, CFRelease, CFTypeRef};
+    unsafe {
+        let focused = crate::ax::bindings::focused_element_of_pid(pid)?;
+        let hit = if crate::ax::exact_target::element_window_id(focused) == Some(window_id) {
+            nodes.iter().filter(|n| n.element_index.is_some() && n.element_ptr != 0)
+                .find(|n| CFEqual(n.element_ptr as CFTypeRef, focused as CFTypeRef) != 0)
+                .and_then(|n| n.element_index)
+        } else {
+            None
+        };
+        CFRelease(focused as CFTypeRef);
+        hit
+    }
+}
