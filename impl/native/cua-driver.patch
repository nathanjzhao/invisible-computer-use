+/// Prefer a scroll area's own page action. Its children can contain arbitrary
+/// buttons, so the text-area scrollbar-button heuristic must not be applied to
+/// the area itself. An attempted AX action never falls through to wheel replay.
+unsafe fn scroll_native_control(
+    element: AXUIElementRef,
+    direction: &str,
+    by: &str,
+    amount: usize,
+) -> anyhow::Result<bool> {
+    if copy_string_attr(element, "AXRole").as_deref() == Some("AXScrollArea") {
+        // AppKit can advertise AXScrollDownByPage yet return attributeUnsupported.
+        // Its scrollbar exposes concrete pressable page/arrow controls instead.
+        // Scope the search to AXVerticalScrollBar so document buttons cannot be
+        // mistaken for scrollbar controls.
+        if let Some(bar) = copy_element_attr(element, "AXVerticalScrollBar") {
+            // Messaging timeouts belong to each AX object, not its parent.
+            let _ = crate::ax::bindings::AXUIElementSetMessagingTimeout(bar, 2.0);
+            let buttons = copy_children(bar);
+            CFRelease(bar as CFTypeRef);
+            let wanted = match (direction, by) {
+                ("down", "page") => "AXIncrementPage",
+                ("up", "page") => "AXDecrementPage",
+                ("down", _) => "AXIncrementArrow",
+                ("up", _) => "AXDecrementArrow",
+                _ => "",
+            };
+            let target = buttons.iter().copied().find(|button| {
+                let _ = crate::ax::bindings::AXUIElementSetMessagingTimeout(*button, 2.0);
+                copy_string_attr(*button, "AXSubrole").as_deref() == Some(wanted)
+                    && crate::ax::bindings::copy_action_names(*button).iter().any(|a| a == "AXPress")
+            });
+            let result = (|| -> anyhow::Result<bool> {
+                let Some(target) = target else { return Ok(false); };
+                for _ in 0..amount.max(1) {
+                    let status = perform_action(target, "AXPress");
+                    if status != kAXErrorSuccess {
+                        anyhow::bail!("scrollbar AXPress returned AX error {status}; refresh state before another action");
+                    }
+                    std::thread::sleep(std::time::Duration::from_millis(30));
+                }
+                Ok(true)
+            })();
+            for button in buttons { CFRelease(button as CFTypeRef); }
+            match result { Ok(false) => {}, other => return other }
+        }
+        if by != "page" { return Ok(false); }
+        let action = match direction {
+            "down" => "AXScrollDownByPage",
+            "up" => "AXScrollUpByPage",
+            _ => return Ok(false),
+        };
+        if !crate::ax::bindings::copy_action_names(element).iter().any(|a| a == action) {
+            return Ok(false);
+        }
+        for _ in 0..amount.max(1) {
+            let status = perform_action(element, action);
+            if status != kAXErrorSuccess {
+                anyhow::bail!("{action} returned AX error {status}; refresh state before another action");
+            }
+            std::thread::sleep(std::time::Duration::from_millis(30));
+        }
+        return Ok(true);
+    }
+    Ok(scroll_native_text_area(element, direction, by, amount))
+}
