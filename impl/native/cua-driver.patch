+#[cfg(test)]
+mod thread_rule_tests {
+    use super::topmost_containing_by_thread;
+    use windows::Win32::Foundation::{POINT, RECT};
+
+    fn rect(left: i32, top: i32, right: i32, bottom: i32) -> RECT {
+        RECT { left, top, right, bottom }
+    }
+
+    fn all(_: u32) -> bool {
+        true
+    }
+
+    /// A form (0) holding cell E (5) with a transparent window (10) raised over it.
+    fn tree(node: u32) -> Vec<(u32, RECT)> {
+        match node {
+            0 => vec![(10, rect(3, 3, 490, 310)), (5, rect(173, 113, 323, 203))],
+            _ => Vec::new(),
+        }
+    }
+
+    fn at_e(threads: impl Fn(u32) -> u32) -> u32 {
+        topmost_containing_by_thread(0, POINT { x: 248, y: 158 }, 16, tree, all, |n| n != 10, threads)
+    }
+
+    #[test]
+    fn a_transparent_window_passes_the_point_to_a_sibling_on_its_own_thread() {
+        assert_eq!(at_e(|_| 1), 5);
+    }
+
+    #[test]
+    fn a_transparent_window_on_another_thread_than_its_parent_takes_the_point() {
+        // Real input: nothing gets the click.
+        assert_eq!(at_e(|n| if n == 10 { 2 } else { 1 }), 10);
+        // Even with the sibling beneath it on that same other thread.
+        assert_eq!(at_e(|n| if n == 0 { 1 } else { 2 }), 10);
+    }
+
+    #[test]
+    fn a_transparent_window_does_not_pass_the_point_to_another_threads_sibling() {
+        assert_eq!(at_e(|n| if n == 5 { 2 } else { 1 }), 10);
+    }
+
+    #[test]
+    fn a_transparent_window_with_nothing_beneath_it_on_its_thread_still_lets_the_parent_have_the_point() {
+        // Between cells the point goes past the transparent window to the form, one thread or not.
+        let between = |threads: fn(u32) -> u32| {
+            topmost_containing_by_thread(0, POINT { x: 100, y: 60 }, 16, tree, all, |n| n != 10, threads)
+        };
+        assert_eq!(between(|_| 1), 0);
+    }
+}
