+/// The window that owns the scroll position for a window-scoped scroll: the
+/// focused control inside `hwnd` or its nearest scrollable ancestor below
+/// `hwnd`; otherwise the largest visible descendant with a scroll bar. A
+/// top-level frame rarely scrolls itself, so posting WM_VSCROLL there reports
+/// success while the list or editor stays put. A background thread usually
+/// has no focus window at all, so the focus route alone is not enough. Falls
+/// back to `hwnd` when no scrollable region is inside that window.
+pub fn scroll_message_target(hwnd: u64) -> u64 {
+    use windows::Win32::Foundation::RECT;
+    use windows::Win32::UI::WindowsAndMessaging::{GetWindowRect, IsWindowVisible};
+    let parent = HWND(hwnd as *mut _);
+    if let Some(mut current) = focused_descendant(parent) {
+        for _ in 0..64 {
+            if current == parent {
+                break;
+            }
+            if has_scroll_bar(current) {
+                return current.0 as usize as u64;
+            }
+            match unsafe { GetParent(current) } {
+                Ok(next) if !next.0.is_null() => current = next,
+                _ => break,
+            }
+        }
+    }
+    unsafe extern "system" fn collect(child: HWND, lparam: LPARAM) -> BOOL {
+        let found = &mut *(lparam.0 as *mut Vec<(i64, HWND)>);
+        if IsWindowVisible(child).as_bool() && has_scroll_bar(child) {
+            let mut rect = RECT::default();
+            if GetWindowRect(child, &mut rect).is_ok() {
+                let area = (rect.right - rect.left) as i64 * (rect.bottom - rect.top) as i64;
+                found.push((area, child));
+            }
+        }
+        TRUE
+    }
+    let mut found: Vec<(i64, HWND)> = Vec::new();
+    unsafe {
+        let _ = EnumChildWindows(
+            parent,
+            Some(collect),
+            LPARAM(&mut found as *mut Vec<(i64, HWND)> as isize),
+        );
+    }
+    found
+        .into_iter()
+        .max_by_key(|(area, _)| *area)
+        .map(|(_, child)| child.0 as usize as u64)
+        .unwrap_or(hwnd)
+}
