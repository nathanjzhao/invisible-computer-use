+//! Screenshot resize state belongs to the captured window, not its process.
+use std::collections::HashMap;
+use std::sync::Mutex;
+
+#[derive(Default)]
+pub struct ResizeRegistry {
+    ratios: Mutex<HashMap<(u32, u64), f64>>,
+}
+
+impl ResizeRegistry {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    pub fn set_ratio(&self, pid: u32, window_id: u64, ratio: f64) {
+        self.ratios.lock().unwrap().insert((pid, window_id), ratio);
+    }
+
+    pub fn clear_ratio(&self, pid: u32, window_id: u64) {
+        self.ratios.lock().unwrap().remove(&(pid, window_id));
+    }
+
+    /// Callers resolve their actual target before looking up its image scale.
+    /// A windowless point must not inherit another window's resize state.
+    pub fn ratio(&self, pid: u32, window_id: Option<u64>) -> Option<f64> {
+        self.ratios.lock().unwrap().get(&(pid, window_id?)).copied()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::ResizeRegistry;
+
+    #[test]
+    fn unscaled_sibling_does_not_clear_the_target_scale() {
+        let registry = ResizeRegistry::new();
+        registry.set_ratio(10, 101, 2.0);
+        registry.clear_ratio(10, 102);
+        assert_eq!(registry.ratio(10, Some(101)), Some(2.0));
+        assert_eq!(registry.ratio(10, Some(102)), None);
+    }
+
+    #[test]
+    fn captures_and_clear_are_isolated_by_process_and_window() {
+        let registry = ResizeRegistry::new();
+        registry.set_ratio(10, 101, 2.0);
+        registry.set_ratio(10, 102, 3.0);
+        registry.set_ratio(11, 101, 4.0);
+        assert_eq!(registry.ratio(10, Some(101)), Some(2.0));
+        assert_eq!(registry.ratio(10, Some(102)), Some(3.0));
+        assert_eq!(registry.ratio(11, Some(101)), Some(4.0));
+        registry.clear_ratio(10, 101);
+        assert_eq!(registry.ratio(10, Some(101)), None);
+        assert_eq!(registry.ratio(10, Some(102)), Some(3.0));
+        assert_eq!(registry.ratio(11, Some(101)), Some(4.0));
+    }
+
+    #[test]
+    fn windowless_points_do_not_borrow_a_scale() {
+        let registry = ResizeRegistry::new();
+        registry.set_ratio(10, 101, 2.0);
+        assert_eq!(registry.ratio(10, None), None);
+    }
+}
diff --git a/libs/cua-driver/rust/crates/cua-driver-testkit/src/linux_x11.rs b/libs/cua-driver/rust/crates/cua-driver-testkit/src/linux_x11.rs
