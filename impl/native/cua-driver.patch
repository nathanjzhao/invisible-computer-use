+/// Hold `<socket>.lock` for the standalone daemon's lifetime. Two `serve`s started
+/// together both pass `run_serve_cmd`'s listening check; without this the later one
+/// would unlink the earlier one's socket below and bind its own, leaving a live
+/// daemon on an unlinked path. The loser now exits as already running.
+#[cfg(unix)]
+fn lock_standalone_socket(socket_path: &str) -> anyhow::Result<std::fs::File> {
+    let lock_path = format!("{socket_path}.lock");
+    let file = std::fs::OpenOptions::new()
+        .create(true)
+        .truncate(false)
+        .write(true)
+        .open(&lock_path)
+        .map_err(|e| anyhow::anyhow!("daemon lock {lock_path}: {e}"))?;
+    match file.try_lock() {
+        Ok(()) => Ok(file),
+        Err(std::fs::TryLockError::WouldBlock) => anyhow::bail!(
+            "Cua Driver daemon is already running on {socket_path} ({lock_path} is held)"
+        ),
+        Err(std::fs::TryLockError::Error(e)) => Err(anyhow::anyhow!("daemon lock {lock_path}: {e}")),
+    }
+}
+
+/// This process's hold on `<socket>.lock`, kept until the process exits.
+#[cfg(unix)]
+static STANDALONE_SOCKET_LOCK: std::sync::Mutex<Option<(String, std::fs::File)>> =
+    std::sync::Mutex::new(None);
+
+/// Take `<socket>.lock` for the rest of this process's life, or confirm that this
+/// process already holds it. The `serve` entry points call this before they build the
+/// driver and load the SDK, the slow part of a start, and `run_serve` calls it again
+/// before binding. Taken only in `run_serve`, two `serve`s could both pass the
+/// listening check and load side by side; then one refused only once its load was
+/// done, and a start that outlived its launcher's deadline let the launcher's next
+/// attempt load a second daemon. Now the second `serve` exits at once as already
+/// running, and the kernel drops the lock if the holder dies.
+#[cfg(unix)]
+pub fn hold_standalone_socket_lock(socket_path: &str) -> anyhow::Result<()> {
+    let mut held = STANDALONE_SOCKET_LOCK
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner());
+    if held.as_ref().is_some_and(|(path, _)| path == socket_path) {
+        return Ok(());
+    }
+    if let Some(dir) = std::path::Path::new(socket_path).parent() {
+        std::fs::create_dir_all(dir)?;
+    }
+    *held = Some((socket_path.to_owned(), lock_standalone_socket(socket_path)?));
+    Ok(())
+}
+
+/// Whether the standalone daemon on `socket_path` has exited: nothing holds
+/// `<socket>.lock`. A daemon stops listening before it exits and keeps the lock
+/// until it does, so a `serve` started in between refuses as already running.
+#[cfg(unix)]
+pub fn standalone_socket_lock_free(socket_path: &str) -> bool {
+    match std::fs::OpenOptions::new()
+        .write(true)
+        .open(format!("{socket_path}.lock"))
+    {
+        Ok(file) => file.try_lock().is_ok(),
+        Err(_) => true,
+    }
+}
+
+#[cfg(not(unix))]
+pub fn standalone_socket_lock_free(_socket_path: &str) -> bool {
+    true
