+/// The other pixel tools on the same two fixtures. GTK3 refuses background
+/// pointer input for these three (`background_unavailable`), so delivery runs
+/// in the foreground, where the XTest route delivers. The closed-window
+/// refusal runs in the background: the window check comes before any route's
+/// availability.
+fn pixel_tool_call(driver: &mut McpDriver, tool: &str, pid: u32, window: u64, rect: (f64, f64, f64, f64), mode: &str) -> ToolResponse {
+    let (x, y, width, height) = rect;
+    let mut args = serde_json::json!({ "pid": pid as i64, "window_id": window, "delivery_mode": mode });
+    if tool == "drag" {
+        // From B-4's center to the next button's: the press and its grabbed
+        // release both belong to B-4.
+        args["from_x"] = serde_json::json!(x + width / 2.0);
+        args["from_y"] = serde_json::json!(y + height / 2.0);
+        args["to_x"] = serde_json::json!(x + width * 1.5);
+        args["to_y"] = serde_json::json!(y + height / 2.0);
+        args["duration_ms"] = serde_json::json!(400);
+        args["steps"] = serde_json::json!(20);
+    } else {
+        args["x"] = serde_json::json!(x + width / 2.0);
+        args["y"] = serde_json::json!(y + height / 2.0);
+    }
+    driver.call(tool, args)
+}
