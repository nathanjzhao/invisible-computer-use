+#[cfg(test)]
+mod revision_projection_tests {
+    use super::*;
+    fn n(idx: usize, role: &str, name: Option<&str>, value: Option<&str>) -> crate::atspi::AtspiNode {
+        crate::atspi::AtspiNode {
+            element_index: Some(idx), role: role.into(), name: name.map(str::to_string), value: value.map(str::to_string),
+            name_from_text: false,
+            checked: None, enabled: None, selected: None, description: None, actions: vec![], element_key: idx as u64, accessible_id: None,
+            depth: 1, parent_element_index: None, in_web_content: false,
+        }
+    }
+    #[test]
+    fn entry_text_surfaced_as_name_becomes_the_value_so_typing_is_a_change() {
+        let mut fallback = n(1, "text", Some("lineage ok"), None);
+        fallback.name_from_text = true;
+        let p = revision_nodes(&[fallback, n(2, "push button", Some("Press me"), None), n(3, "spin button", Some("Qty"), Some("3"))]);
+        assert_eq!((p[0].label.as_str(), p[0].value.as_deref()), ("", Some("lineage ok")));
+        assert_eq!((p[1].label.as_str(), p[1].value.as_deref()), ("Press me", None));
+        assert_eq!((p[2].label.as_str(), p[2].value.as_deref()), ("Qty", Some("3")));
+        // and through the lineage: typing renders as `~`, not remove+add
+        let key = (-(std::process::id() as i32), 424242u64);
+        use cua_driver_core::element_revision::{step, Baseline};
+        step(key, &revision_nodes(&[n(1, "text", None, None)]), "app", false, Baseline::Previous);
+        let mut typed = n(1, "text", Some("typed"), Some("typed"));
+        typed.name_from_text = true;
+        let s = step(key, &revision_nodes(&[typed]), "app", false, Baseline::Previous);
+        assert!(s.text.contains("~ ") && !s.text.contains("+ ") && !s.text.contains("- ["), "{}", s.text);
+    }
+
+    #[test]
+    fn accessible_id_is_the_only_linux_cross_turn_identity() {
+        use cua_driver_core::element_revision::{step, Baseline};
+        // A toolkit-supplied accessible id keeps a relabel as one change.
+        let key = (-(std::process::id() as i32), 434343u64);
+        let mut keep = n(1, "push button", Some("Keep"), None);
+        keep.accessible_id = Some("btn-keep".into());
+        let other = n(2, "push button", Some("Other"), None);
+        let first = step(key, &revision_nodes(&[keep.clone(), other.clone()]), "app", false, Baseline::Previous);
+        let mut kept = keep.clone();
+        kept.name = Some("Kept".into());
+        let second = step(key, &revision_nodes(&[kept, other.clone()]), "app", false, Baseline::Previous);
+        assert_eq!(first.index_to_stable[&1], second.index_to_stable[&1], "{}", second.text);
+        assert!(second.text.contains("~ [") && !second.text.contains("+ ["), "{}", second.text);
+        assert_eq!(build_element_entry(&keep, None, None).unwrap()["identifier"], "btn-keep");
+        // Without an id, the same relabel is an honest removal plus addition;
+        // neither the snapshot position nor the object key invents identity.
+        let key = (-(std::process::id() as i32), 434344u64);
+        let plain = n(1, "push button", Some("Alpha"), None);
+        let first = step(key, &revision_nodes(&[plain.clone(), other.clone()]), "app", false, Baseline::Previous);
+        let mut relabeled = plain.clone();
+        relabeled.name = Some("Play".into());
+        let second = step(key, &revision_nodes(&[relabeled, other]), "app", false, Baseline::Previous);
+        assert_ne!(first.index_to_stable[&1], second.index_to_stable[&1], "{}", second.text);
+        assert!(second.text.contains("+ [") && second.text.contains("- ["), "{}", second.text);
+        assert!(build_element_entry(&plain, None, None).unwrap().get("identifier").is_none());
