+async fn motion_for_action<F, W, Fut>(detached: bool, queue: F, wait: W)
+where F: FnOnce(), W: FnOnce() -> Fut, Fut: std::future::Future<Output = ()> {
+    if detached { queue(); } else { wait().await; }
+}
