index 00000000..d5b23298
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/ax/recovery.rs
@@ -0,0 +1,282 @@
+//! Bounded, exact-window semantic recovery. The shared matcher is reconstructed from Sky;
+//! this adapter revalidates on each action rather than depending on AX notification delivery.
+use super::{bindings::*, cache::RetainedElement, exact_target::element_window_id};
+use axdiff::recovery::{self, Fingerprint};
+use core_foundation::{array::{CFArray, CFArrayRef}, base::{CFEqual, CFGetTypeID, CFRelease, CFType, CFTypeRef, TCFType}, string::{CFString, CFStringRef}, number::CFNumber, boolean::CFBoolean, url::CFURL};
+use std::{sync::Arc, time::{Duration, Instant}};
+
+const ATTRIBUTES: [&str; 12] = ["AXRole", "AXSubrole", "AXRoleDescription", "AXTitle", "AXDescription", "AXValue", "AXValueDescription", "AXPlaceholderValue", "AXHelp", "AXIdentifier", "AXURL", "AXChildren"];
+const MAX_NODES: usize = 2000;
+const MAX_DEPTH: usize = 40;
+const BUDGET: Duration = Duration::from_secs(2);
+const CALL_TIMEOUT: f32 = 0.15;
+
+#[link(name = "ApplicationServices", kind = "framework")]
+extern "C" {
+    fn AXUIElementCopyMultipleAttributeValues(element: AXUIElementRef, attributes: CFArrayRef, options: u32, values: *mut CFArrayRef) -> AXError;
+}
+
+/// All pointers are owned; no raw proxy outlives a retain. Fingerprints stay in memory only.
+pub struct Capture {
+    pub entries: Vec<(RetainedElement, Fingerprint, u16)>,
+    pub complete: bool,
+}
+
+#[derive(Clone)]
+pub struct Anchor {
+    pub element: RetainedElement,
+    pub fingerprint: Fingerprint,
+    /// Failed optional reads are usable only on this same native handle.
+    pub unknown_fields: u16,
+    pub baseline: Arc<Vec<Fingerprint>>,
+    pub complete: bool,
+    pub revision: u64,
+}
+
+fn refusal(reason: &str) -> cua_driver_core::protocol::ToolResult {
+    cua_driver_core::protocol::ToolResult::error(format!("Element recovery refused ({reason}); call get_window_state again"))
+        .with_structured(serde_json::json!({"code":"stale_element_target", "effect":"refused", "reason":reason}))
+}
+
+pub fn stale(reason: &str) -> cua_driver_core::protocol::ToolResult { refusal(reason) }
+
+unsafe fn optional_value(value: CFTypeRef) -> Result<Option<String>, ()> {
+    if value.is_null() { return Err(()); }
+    let kind = CFGetTypeID(value);
+    if kind == CFString::type_id() {
+        return Ok(Some(format!("string:{}", CFString::wrap_under_get_rule(value as CFStringRef))));
+    }
+    if kind == CFNumber::type_id() {
+        let number = CFNumber::wrap_under_get_rule(value as _);
+        if let Some(integer) = number.to_i64() { return Ok(Some(format!("integer:{integer}"))); }
+        return number.to_f64().filter(|v| v.is_finite()).map(|v| Some(format!("float:{:016x}", v.to_bits()))).ok_or(());
+    }
+    if kind == CFBoolean::type_id() {
+        let v: bool = CFBoolean::wrap_under_get_rule(value as _).into();
+        return Ok(Some(format!("boolean:{v}")));
+    }
+    if kind == CFURL::type_id() {
+        return Ok(Some(format!("url:{}", CFURL::wrap_under_get_rule(value as _).get_string())));
+    }
+    // AXCopyMultiple uses an AXValue(kAXValueAXErrorType) for absent attributes.
+    // Other errors are unknown observations, never absence that can match another failure.
+    if kind == AXValueGetTypeID() && AXValueGetType(value as AXValueRef) == 5 {
+        let mut error = 0i32;
+        if AXValueGetValue(value as AXValueRef, 5, &mut error as *mut _ as *mut _) && (error == kAXErrorAttributeUnsupported || error == kAXErrorNoValue) {
+            return Ok(None);
+        }
+    }
+    Err(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn recovery_absence_is_distinct_from_unreadable_attributes() {
+        unsafe {
+            for (error, absent) in [(kAXErrorAttributeUnsupported, true), (kAXErrorNoValue, true), (kAXErrorInvalidUIElement, false), (kAXErrorFailure, false)] {
+                let value = AXValueCreate(5, &error as *const _ as *const _);
+                assert!(!value.is_null());
+                let result = optional_value(value as CFTypeRef);
+                CFRelease(value as CFTypeRef);
+                if absent { assert_eq!(result, Ok(None)); } else { assert!(result.is_err()); }
+            }
+        }
+    }
+    #[test]
+    fn recovery_numeric_and_string_values_cannot_alias() {
+        let text = CFString::new("integer:1"); let number = CFNumber::from(1i64);
+        unsafe { assert_ne!(optional_value(text.as_CFTypeRef()).unwrap(), optional_value(number.as_CFTypeRef()).unwrap()); }
+        let big = CFNumber::from(9007199254740993i64); let next = CFNumber::from(9007199254740992i64);
+        unsafe { assert_ne!(optional_value(big.as_CFTypeRef()).unwrap(), optional_value(next.as_CFTypeRef()).unwrap()); }
+    }
+
+    #[test]
+    fn optional_failures_are_unknown_not_absent_or_invalid_handles() {
+        unsafe {
+            for (error, expected) in [(kAXErrorFailure, Ok((None, true))),
+                (kAXErrorNoValue, Ok((None, false))), (kAXErrorInvalidUIElement, Err(()))] {
+                let value = AXValueCreate(5, &error as *const _ as *const _);
+                assert_eq!(read_field(value as CFTypeRef), expected);
+                CFRelease(value as CFTypeRef);
+            }
+        }
+    }
+
+    #[test]
+    fn a_partial_fingerprint_only_validates_an_unchanged_handle() {
+        let before = Fingerprint { role: "AXTextArea".into(), description: Some("string:Draft".into()),
+            value: Some("string:seed".into()), ..Default::default() };
+        let unknown_id = 1 << 9;
+        assert!(same_handle_matches(&before, unknown_id, &before, unknown_id, false));
+        let mut after = before.clone(); after.value = Some("string:replacement".into());
+        assert!(!same_handle_matches(&before, unknown_id, &after, unknown_id, false));
+        assert!(same_handle_matches(&before, unknown_id, &after, unknown_id, true));
+        after.description = Some("string:Other".into());
+        assert!(!same_handle_matches(&before, unknown_id, &after, unknown_id, true));
+        assert!(!same_handle_matches(&before, 0, &before, unknown_id, false), "losing a known property must refuse");
+        assert!(!same_handle_matches(&before, unknown_id, &before, 0, false), "unknown is not absence");
+        assert_eq!(recovery::recover(&before, &[before.clone()], &[before.clone()], false, false), Err(recovery::Refusal::Incomplete));
+    }
+}
+
+#[link(name = "ApplicationServices", kind = "framework")]
+extern "C" { fn AXValueGetTypeID() -> usize; }
+
+// AppKit NSTextView reports AXErrorFailure for unset identifiers. Keep that
+// uncertainty explicit: it never establishes absence or permits replacement search.
+unsafe fn read_field(value: CFTypeRef) -> Result<(Option<String>, bool), ()> {
+    match optional_value(value) {
+        Ok(field) => Ok((field, false)),
+        Err(()) if !value.is_null() && CFGetTypeID(value) == AXValueGetTypeID()
+            && AXValueGetType(value as AXValueRef) == 5 => {
+            let mut error = 0i32;
+            if AXValueGetValue(value as AXValueRef, 5, &mut error as *mut _ as *mut _) && error == kAXErrorFailure {
+                Ok((None, true))
+            } else { Err(()) }
+        }
+        Err(()) => Err(()),
+    }
+}
+
+fn same_handle_matches(before: &Fingerprint, unknown_before: u16, after: &Fingerprint, unknown_after: u16, after_edit: bool) -> bool {
+    unknown_before == unknown_after && before.matches(after, after_edit && unknown_before != 0)
+}
+
+unsafe fn read(element: &RetainedElement, children: bool) -> Result<(Fingerprint, Vec<RetainedElement>, u16), ()> {
+    let pointer = element.as_ptr() as AXUIElementRef;
+    AXUIElementSetMessagingTimeout(pointer, CALL_TIMEOUT);
+    let keys: Vec<_> = ATTRIBUTES[..if children { 12 } else { 11 }].iter().map(|name| CFString::new(name)).collect();
+    let attributes = CFArray::from_CFTypes(&keys);
+    let mut values = std::ptr::null();
+    let error = AXUIElementCopyMultipleAttributeValues(pointer, attributes.as_concrete_TypeRef(), 0, &mut values);
+    if error != kAXErrorSuccess || values.is_null() { if !values.is_null() { CFRelease(values as CFTypeRef); } return Err(()); }
+    let array = CFArray::<CFType>::wrap_under_create_rule(values);
+    if array.len() != keys.len() as isize { return Err(()); }
+    let mut fields = Vec::new();
+    let mut unknown_fields = 0u16;
+    for i in 0..11 {
+        let (field, unknown) = read_field(array.get(i).ok_or(())?.as_CFTypeRef())?;
+        if unknown {
+            // Role and value must remain readable to validate the observed control.
+            if i == 0 || i == 5 { return Err(()); }
+            unknown_fields |= 1 << i;
+        }
+        fields.push(field);
+    }
+    let role = fields[0].as_ref().and_then(|s| s.strip_prefix("string:")).filter(|s| !s.is_empty()).ok_or(())?.to_string();
+    let fingerprint = Fingerprint { role, subrole: fields[1].clone(),
+        role_description: fields[2].clone(), title: fields[3].clone(), description: fields[4].clone(), value: fields[5].clone(),
+        value_description: fields[6].clone(), placeholder: fields[7].clone(), help: fields[8].clone(), identifier: fields[9].clone(), url: fields[10].clone() };
+    let mut descendants = Vec::new();
+    if children {
+        let children = array.get(11).ok_or(())?;
+        if CFGetTypeID(children.as_CFTypeRef()) == CFArray::<CFType>::type_id() {
+            let children = CFArray::<CFType>::wrap_under_get_rule(children.as_CFTypeRef() as CFArrayRef);
+            if children.len() > MAX_NODES as isize { return Err(()); }
+            for child in children.iter() {
+                if CFGetTypeID(child.as_CFTypeRef()) != AXUIElementGetTypeID() { return Err(()); }
+                descendants.push(RetainedElement::retain(child.as_CFTypeRef() as usize));
+            }
+        } else if optional_value(children.as_CFTypeRef())?.is_some() { return Err(()); }
+    }
+    Ok((fingerprint, descendants, unknown_fields))
+}
+
+pub fn capture(pid: i32, window: u32) -> Capture {
+    let deadline = Instant::now() + BUDGET;
+    let mut result = Capture { entries: Vec::new(), complete: true };
+    if !matches!(crate::windows::resolve_window_owner(pid, window), crate::windows::WindowOwner::SamePid) {
+        result.complete = false; return result;
+    }
+    unsafe {
+        let app = RetainedElement::from_owned(AXUIElementCreateApplication(pid) as usize);
+        if app.as_ptr() == 0 { result.complete = false; return result; }
+        AXUIElementSetMessagingTimeout(app.as_ptr() as AXUIElementRef, CALL_TIMEOUT);
+        let attribute = CFString::new("AXWindows");
+        let mut raw: CFTypeRef = std::ptr::null();
+        let error = AXUIElementCopyAttributeValue(app.as_ptr() as AXUIElementRef, attribute.as_concrete_TypeRef(), &mut raw);
+        if error != kAXErrorSuccess || raw.is_null() {
+            if !raw.is_null() { CFRelease(raw); }
+            result.complete = false; return result;
+        }
+        let owned = CFType::wrap_under_create_rule(raw);
+        if CFGetTypeID(raw) != CFArray::<CFType>::type_id() { result.complete = false; return result; }
+        let windows = CFArray::<CFType>::wrap_under_get_rule(raw as CFArrayRef);
+        if windows.len() > MAX_NODES as isize { result.complete = false; return result; }
+        let mut roots = Vec::new();
+        for raw in windows.iter() {
+            if Instant::now() >= deadline || CFGetTypeID(raw.as_CFTypeRef()) != AXUIElementGetTypeID() { result.complete = false; return result; }
+            let root = RetainedElement::retain(raw.as_CFTypeRef() as usize);
+            if ax_get_window_id(root.as_ptr() as AXUIElementRef) == Some(window) && !roots.iter().any(|other: &RetainedElement| CFEqual(root.as_ptr() as _, other.as_ptr() as _) != 0) { roots.push(root); }
+        }
+        drop(windows); drop(owned);
+        if roots.len() != 1 { result.complete = false; return result; }
+        let mut pending = vec![(roots.pop().unwrap(), 0usize)];
+        while let Some((element, depth)) = pending.pop() {
+            if Instant::now() >= deadline || result.entries.len() >= MAX_NODES || depth > MAX_DEPTH {
+                result.complete = false; break;
+            }
+            if result.entries.iter().any(|(seen, _, _)| CFEqual(element.as_ptr() as _, seen.as_ptr() as _) != 0) { continue; }
+            match read(&element, true) {
+                Ok((fingerprint, children, unknown_fields)) => {
+                    if unknown_fields != 0 { result.complete = false; }
+                    if pending.len() + children.len() > MAX_NODES { result.complete = false; break; }
+                    result.entries.push((element, fingerprint, unknown_fields));
+                    pending.extend(children.into_iter().map(|child| (child, depth + 1)));
+                }
+                Err(()) => { result.complete = false; }
+            }
+        }
+        if Instant::now() >= deadline { result.complete = false; }
+    }
+    result
+}
+
+fn observed_matches(node: &super::tree::AXNode, fingerprint: &Fingerprint) -> bool {
+    let displayed = |field: &Option<String>| field.as_deref().and_then(|value| value.strip_prefix("string:"))
+        .map(str::trim).filter(|value| !value.is_empty()).map(str::to_string);
+    let value = match fingerprint.value.as_deref() {
+        Some(v) if v.starts_with("string:") => displayed(&fingerprint.value).or_else(|| displayed(&fingerprint.placeholder)),
+        Some(v) if v.starts_with("integer:") => Some(v[8..].to_string()),
+        Some("boolean:true") => Some("1".into()), Some("boolean:false") => Some("0".into()),
+        Some(v) if v.starts_with("float:") => u64::from_str_radix(&v[6..], 16).ok().map(f64::from_bits).filter(|v| v.is_finite()).map(|v| v.to_string()),
+        Some(_) => return false, // unsupported display conversion cannot prove the observed value
+        None => displayed(&fingerprint.placeholder),
+    };
+    node.role == fingerprint.role && node.title == displayed(&fingerprint.title)
+        && node.description == displayed(&fingerprint.description)
+        && node.value_state == value
+        && node.identifier == fingerprint.identifier.as_deref().and_then(|s| s.strip_prefix("string:")).map(str::to_string)
+}
+
+pub fn anchors(capture: &Capture, nodes: &[super::tree::AXNode]) -> Vec<Option<Anchor>> {
+    let baseline: Arc<Vec<Fingerprint>> = Arc::new(capture.entries.iter().map(|(_, f, _)| f.clone()).collect());
+    let deadline = Instant::now() + BUDGET;
+    nodes.iter().filter(|node| node.element_index.is_some()).map(|node| {
+        if Instant::now() >= deadline { return None; }
+        capture.entries.iter().find(|(element, fingerprint, _)| unsafe {
+        node.element_ptr != 0 && CFEqual(node.element_ptr as _, element.as_ptr() as _) != 0 && observed_matches(node, fingerprint)
+    }).map(|(element, fingerprint, unknown_fields)| Anchor { unknown_fields: *unknown_fields, element: element.clone(), fingerprint: fingerprint.clone(),
+        baseline: baseline.clone(), complete: capture.complete, revision: 0 }) }).collect()
+}
+
+pub fn resolve(anchor: &Anchor, pid: i32, window: u32, after_edit: bool) -> Result<Anchor, cua_driver_core::protocol::ToolResult> {
+    if !matches!(crate::windows::resolve_window_owner(pid, window), crate::windows::WindowOwner::SamePid) { return Err(refusal("window_owner_changed")); }
+    // Never turn a secure field into a search fingerprint. A fresh observation is required.
+    let current = unsafe { read(&anchor.element, false) };
+    if let Ok((fingerprint, _, unknown_fields)) = &current {
+        if same_handle_matches(&anchor.fingerprint, anchor.unknown_fields, fingerprint, *unknown_fields, after_edit) && unsafe { element_window_id(anchor.element.as_ptr() as AXUIElementRef) } == Some(window) {
+            return Ok(Anchor { fingerprint: fingerprint.clone(), ..anchor.clone() });
+        }
+    }
+    if anchor.fingerprint.subrole.as_deref() == Some("string:AXSecureTextField") { return Err(refusal("secure_target_requires_observation")); }
+    let fresh = capture(pid, window);
+    let fingerprints: Vec<_> = fresh.entries.iter().map(|(_, f, _)| f.clone()).collect();
+    let index = recovery::recover(&anchor.fingerprint, &anchor.baseline, &fingerprints, anchor.complete && fresh.complete, after_edit)
+        .map_err(|reason| refusal(match reason { recovery::Refusal::Incomplete => "incomplete_tree", recovery::Refusal::MissingBefore => "missing_before", recovery::Refusal::AmbiguousBefore => "ambiguous_before", recovery::Refusal::MissingAfter => "missing_after", recovery::Refusal::AmbiguousAfter => "ambiguous_after" }))?;
+    let (element, fingerprint, unknown_fields) = &fresh.entries[index];
+    if unsafe { element_window_id(element.as_ptr() as AXUIElementRef) } != Some(window) { return Err(refusal("outside_target_window")); }
+    Ok(Anchor { element: element.clone(), fingerprint: fingerprint.clone(), unknown_fields: *unknown_fields, baseline: Arc::new(fingerprints), complete: true, revision: anchor.revision + 1 })
+}
diff --git a/libs/cua-driver/rust/crates/platform-macos/src/ax/revision.rs b/libs/cua-driver/rust/crates/platform-macos/src/ax/revision.rs
new file mode 100644
index 00000000..08f6dde4
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/ax/revision.rs
@@ -0,0 +1,129 @@
+//! macOS adapter for the shared lineage in `cua_driver_core::element_revision`
+//! (spec 02 steps 2-6). Maps `AXNode` to the platform-neutral projection:
+//! label = AXTitle → AXDescription → AXIdentifier (the `elements[].label` chain
+//! minus the value), value = CF-coerced `value_state` falling back to `value`.
+
+use super::tree::AXNode;
+pub use cua_driver_core::element_revision::{reset as reset_key, Baseline, DiffStep, RevisionNode};
+
+pub fn project(nodes: &[AXNode]) -> Vec<RevisionNode> {
+    // Frames are made window-relative so moving the window is not a change of
+    // position within it.
+    let origin = nodes.iter().find(|n| n.role == "AXWindow").and_then(|n| n.frame).map(|f| (f[0], f[1]));
+    nodes.iter().enumerate().map(|(tree_order, n)| RevisionNode {
+        element_index: n.element_index,
+        parent_element_index: n.parent_element_index,
+        role: n.role.clone(),
+        label: n.title.clone().filter(|s| !s.is_empty())
+            .or_else(|| n.description.clone().filter(|s| !s.is_empty()))
+            .or_else(|| n.identifier.clone().filter(|s| !s.is_empty()))
+            .unwrap_or_default(),
+        value: n.value_state.clone().or_else(|| n.value.clone()).filter(|s| !s.is_empty()),
+        selected: n.selected == Some(true),
+        selected_state: n.selected,
+        enabled: n.enabled,
+        in_web_content: n.in_web_content,
+        identity: n.identifier.clone().filter(|s| !s.is_empty()),
+        frame: window_relative(n.frame, origin),
+        attrs: row_attrs(n, tree_order),
+    }).collect()
+}
+
+/// The unmerged name fields for `passive_elements` (see `AXNode::add_row_attrs`) and its walk position..
+/// `tree_order` is the row's position in the walk, which `elements[]` carries too,
+/// so a consumer can interleave the two arrays in tree order.
+fn row_attrs(n: &AXNode, tree_order: usize) -> serde_json::Map<String, serde_json::Value> {
+    let mut entry = serde_json::json!({"tree_order": tree_order});
+    n.add_row_attrs(&mut entry);
+    match entry { serde_json::Value::Object(m) => m, _ => Default::default() }
+}
+
+fn window_relative(frame: Option<[f64; 4]>, origin: Option<(f64, f64)>) -> Option<[i64; 4]> {
+    let (f, (ox, oy)) = (frame?, origin?);
+    f.iter().all(|v| v.is_finite()).then(|| {
+        [(f[0] - ox).round() as i64, (f[1] - oy).round() as i64, f[2].round() as i64, f[3].round() as i64]
+    })
+}
+
+pub fn step(pid: i32, window_id: u32, nodes: &[AXNode], app_name: &str, disable_diff: bool, baseline: Baseline) -> DiffStep {
+    cua_driver_core::element_revision::step((pid, window_id as u64), &project(nodes), app_name, disable_diff, baseline)
+}
+
+pub fn reset(pid: i32, window_id: u32) {
+    reset_key((pid, window_id as u64));
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn node(idx: Option<usize>, parent: Option<usize>, role: &str, title: Option<&str>, desc: Option<&str>, value: Option<&str>, selected: Option<bool>) -> AXNode {
+AXNode {
+                            container_identifier: None,
+                inherited_actions: Vec::new(),
+element_index: idx, role: role.into(), title: title.map(str::to_string), value: value.map(str::to_string),
+            description: desc.map(str::to_string), identifier: None, help: None, actions: vec!["AXPress".into()], element_ptr: 0,
+            depth: if parent.is_some() { 1 } else { 0 }, parent_element_index: parent, frame: None,
+            value_state: value.map(str::to_string), value_description: None, min_value: None, max_value: None,
+            enabled: None, selected, in_web_content: false, subrole: None, settable: false,
+        }
+    }
+
+    #[test]
+    fn projection_uses_the_label_chain_without_the_value_and_carries_selected() {
+        let p = project(&[
+            node(Some(0), None, "AXWindow", Some("W"), None, None, None),
+            node(Some(1), Some(0), "AXButton", Some(""), Some("2"), None, Some(true)),
+            node(Some(2), Some(0), "AXTextField", None, None, Some("hello"), None),
+            node(None, None, "AXStaticText", Some("display only"), None, None, None),
+        ]);
+        assert_eq!(p[1].label, "2", "empty title falls back to description");
+        assert!(p[1].selected);
+        assert_eq!((p[2].label.as_str(), p[2].value.as_deref()), ("", Some("hello")), "value is not part of the label");
+        assert_eq!(p[3].element_index, None);
+        let passive = cua_driver_core::element_revision::passive_elements(&p, None);
+        assert_eq!(passive.len(), 1);
+        assert_eq!(passive[0]["label"], "display only");
+        assert!(passive[0].get("element_index").is_none());
+        assert!(passive[0].get("element_token").is_none());
+    }
+
+    #[test]
+    fn mac_step_renumbering_keeps_stable_ids() {
+        static N: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(1);
+        let wid = N.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+        let pid = -(std::process::id() as i32);
+        let t1 = vec![node(Some(0), None, "AXWindow", Some("W"), None, None, None), node(Some(1), Some(0), "AXRow", Some("a"), None, None, None)];
+        let t2 = vec![node(Some(0), None, "AXWindow", Some("W"), None, None, None), node(Some(1), Some(0), "AXRow", Some("z"), None, None, None), node(Some(2), Some(0), "AXRow", Some("a"), None, None, None)];
+        let s1 = step(pid, wid, &t1, "App", false, Baseline::Previous);
+        let s2 = step(pid, wid, &t2, "App", false, Baseline::Previous);
+        assert_eq!((s1.kind, s2.kind), ("full_first", "diff"));
+        assert_eq!(s2.index_to_stable[&2], s1.index_to_stable[&1]);
+        reset(pid, wid);
+        assert_eq!(step(pid, wid, &t1, "App", false, Baseline::Previous).kind, "full_first");
+    }
+
+    #[test]
+    fn frames_are_window_relative_and_need_a_window_origin() {
+        let mut w = node(Some(0), None, "AXWindow", Some("W"), None, None, None);
+        w.frame = Some([100.0, 200.0, 300.0, 400.0]);
+        let mut b = node(Some(1), Some(0), "AXButton", None, None, None, None);
+        b.frame = Some([130.4, 203.6, 14.0, 16.0]);
+        let p = project(&[w.clone(), b.clone()]);
+        assert_eq!(p[1].frame, Some([30, 4, 14, 16]));
+        assert_eq!(project(&[b])[0].frame, None, "no window, no frame evidence");
+        w.frame = Some([500.0, 50.0, 300.0, 400.0]);
+        let mut moved = node(Some(1), Some(0), "AXButton", None, None, None, None);
+        moved.frame = Some([530.4, 53.6, 14.0, 16.0]);
+        assert_eq!(project(&[w, moved])[1].frame, Some([30, 4, 14, 16]), "a window move is not a move within it");
+    }
+
+    #[test]
+    fn passive_web_text_retains_its_untrusted_origin() {
+        let mut text = node(None, None, "AXStaticText", Some("Result"), None, Some("42"), None);
+        text.in_web_content = true;
+        let passive = cua_driver_core::element_revision::passive_elements(&project(&[text]), None);
+        assert_eq!(passive[0]["in_web_content"], true);
+        assert!(passive[0].get("selected").is_none());
+    }
+}
diff --git a/libs/cua-driver/rust/crates/platform-macos/src/ax/system_menu.rs b/libs/cua-driver/rust/crates/platform-macos/src/ax/system_menu.rs
