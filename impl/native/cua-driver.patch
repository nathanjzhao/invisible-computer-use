+        "linux-sway-list-windows-coverage-ax-not-applicable",
+        "list_windows_coverage",
+        DriverRoute::AxRead,
+        vec![OracleKind::AxState, OracleKind::ReadinessAgrees],
+    );
+    run_nested(case, Nested::sway, |sway, recorder| {
