+#[derive(Clone, Copy, Debug)]
+enum PixelAxAttempt { NotAttempted, Dispatched }
+
+/// `None` authorizes the coordinate route only when AX did not mutate anything.
+fn pixel_ax_outcome(
+    result: Result<anyhow::Result<PixelAxAttempt>, tokio::task::JoinError>,
+    focus_only: bool,
+) -> Option<ToolResult> {
+    match result {
+        Ok(Ok(PixelAxAttempt::NotAttempted)) if !focus_only => None,
+        Ok(Ok(PixelAxAttempt::NotAttempted)) => Some(ToolResult::error(
+            "Background PX focus has no eligible target; no focus write was attempted."
+        ).with_structured(serde_json::json!({
+            "status": "refused", "code": "background_unavailable", "effect": "refused"
+        }))),
+        Ok(Ok(PixelAxAttempt::Dispatched)) => {
+            let label = if focus_only { "focused" } else { "pressed" };
+            Some(ToolResult::text(format!("✅ PX hit-test {label} the background element via AX."))
+                .with_structured(serde_json::json!({
+                    "path": "ax", "verified": false, "effect": "unverifiable"
+                })))
+        }
+        Ok(Err(error)) => Some(uncertain_click_outcome(format!("PX AX attempt failed: {error}"))),
+        Err(error) => Some(uncertain_click_outcome(format!("PX AX worker failed: {error}"))),
+    }
+}
+
+fn desktop_click_outcome(
+    result: Result<anyhow::Result<()>, tokio::task::JoinError>,
+    success: impl FnOnce() -> ToolResult,
+) -> ToolResult {
+    match result {
+        Ok(Ok(())) => success(),
+        Ok(Err(error)) => uncertain_click_outcome(format!("desktop-scope click failed: {error}")),
+        Err(error) => uncertain_click_outcome(format!("task error: {error}")),
+    }
+}
+
+fn perform_ax_action_once(action: &str, dispatch: impl FnOnce() -> i32) -> anyhow::Result<()> {
+    let error = dispatch();
+    if error != kAXErrorSuccess {
+        anyhow::bail!("AXUIElementPerformAction({action}) returned {error}; inspect fresh state before continuing");
+    }
+    Ok(())
+}
+
+fn element_action_failure(error: anyhow::Error) -> ToolResult {
+    // This boundary can follow an AX action, a focus write, or a pixel fallback.
+    // Failure or missing readback does not establish that nothing happened.
+    // In particular, AXCannotComplete can arrive after the app applied an effect.
+    let message = match error.downcast_ref::<TextFocusUnavailable>() {
+        Some(error) => error.0.clone(),
+        None => format!("AX action failed: {error}"),
+    };
+    uncertain_click_outcome(message)
+}
+
+fn uncertain_click_outcome(message: String) -> ToolResult {
+    ToolResult::error(message).with_structured(serde_json::json!({
+        "status": "uncertain", "code": "action_outcome_unknown",
+        "effect": "unverifiable", "verified": false,
+    }))
+}
