+/// Opt-in: a layer-shell notification (mako) over the native window, which
+/// grim shows inside the window's rect: the capture is refused and no frame
+/// is written. Red at e4601b1.
+#[test]
+#[ignore]
+fn harness_sway_layer_shell_capture() {
