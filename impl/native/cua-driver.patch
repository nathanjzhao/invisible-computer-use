+/// The capture a pixel action's x/y were read from: the `screenshot_id` frame
+/// when given, else the calling session's own latest capture of the window
+/// (`cua_driver_core::capture_log`, review C9). Without an id and without such
+/// a capture the action is refused `ambiguous_capture`. An id needs a window.
+/// macOS window ids are not reused while WindowServer runs, so frames carry no
+/// identity mark.
+pub fn pixel_binding(
+    args: &serde_json::Value,
+    pid: i32,
+    window_id: Option<u32>,
+) -> Result<PixelBinding, ToolResult> {
+    match window_id {
+        Some(wid) => PixelBinding::resolve(args, pid as u32, u64::from(wid)),
+        None if args.get("from_zoom").and_then(serde_json::Value::as_bool) == Some(true) => Err(ToolResult::error(
+            "from_zoom reads this session's zoom of one window; pass that window_id too.",
+        )
+        .with_structured(serde_json::json!({ "code": "invalid_arguments" }))),
+        None if args.get("screenshot_id").is_some_and(|v| !v.is_null()) => Err(ToolResult::error(
+            "screenshot_id binds pixels to one window's capture; pass that window_id too.",
+        )
+        .with_structured(serde_json::json!({ "code": "invalid_arguments" }))),
+        None => Ok(PixelBinding::Unobserved),
+    }
+}
+
+/// [`pixel_binding`] for a tool with no `from_zoom` (double_click,
+/// right_click, scroll): a zoom pixel would otherwise be read through the
+/// session's zoom and sent untranslated, so it is refused.
+pub fn pixel_binding_without_zoom(
+    args: &serde_json::Value,
+    pid: i32,
+    window_id: Option<u32>,
+) -> Result<PixelBinding, ToolResult> {
+    if args.get("from_zoom").and_then(serde_json::Value::as_bool) == Some(true) {
+        return Err(ToolResult::error("from_zoom is supported by click and drag only.")
+            .with_structured(serde_json::json!({ "code": "invalid_arguments" })));
+    }
+    pixel_binding(args, pid, window_id)
+}
+
+/// The native window pixel a caller's x,y name once the binding is applied: a
+/// `from_zoom` pixel through its zoom, any other through the bound capture's
+/// downscale ratio (`fallback_ratio` when the binding has no frame). This is
+/// what `click` does inline before it translates to the screen; a check that
+/// reads the same point back (`focus_by_pixel`'s landing check) has to use the
+/// same pixel, or it looks at a different point whenever the capture was
+/// downscaled.
+pub fn native_window_pixel(binding: &PixelBinding, fallback_ratio: Option<f64>, x: f64, y: f64) -> (f64, f64) {
+    if let Some(point) = binding.zoom_to_window(x, y) {
+        return point;
+    }
+    match binding.bound_ratio().unwrap_or(fallback_ratio) {
+        Some(ratio) => (x * ratio, y * ratio),
+        None => (x, y),
+    }
+}
