+// ── X11 locker versus a bare menu grab ───────────────────────────────────────
+
+fn keyboard_already_grabbed() -> bool {
+    // Independent host oracle: another client holds the keyboard.
+    cua_driver_testkit::toolkit_focus::grab_canary()
+        .is_err_and(|error| error.contains("AlreadyGrabbed") || error.contains("ALREADY_GRABBED"))
+}
+
+fn host_cell(cell_id: &str, locker: bool) {
+    let mut case = CaseSpec::delivered(
+        cell_id,
+        "gtk3",
+        "gtk3",
+        "type_text",
+        Targeting::Ax,
+        Delivery::Background,
+        cua_driver_testkit::e2e::Scope::Window,
+        DriverRoute::LinuxAtSpiValue,
+        vec![
+            OracleKind::FixtureState,
+            OracleKind::Focus,
+            OracleKind::ZOrder,
+            OracleKind::NoLeakedInput,
+            OracleKind::Cursor,
+            OracleKind::HostState,
+        ],
+    );
+    case.oracles
+        .extend(cua_driver_testkit::e2e::linux_x11_background_oracles());
+    let case = if locker {
+        case.expecting_refusal(vec![RefusalCode::HostNotInteractive])
+    } else {
+        case
+    };
+    execute_case(case, |evidence| {
+        let mut driver = McpDriver::spawn_named(cell_id).expect("start source-built Linux driver");
+        *evidence = recording_evidence(driver.recording_dir());
+        let (pid, window_id) = launch(&mut driver);
+        let state = snapshot(&mut driver, pid, window_id);
+        let token = token_for(&state, "txt-input");
+        let target = TargetWindow { pid, native_id: window_id };
+        let sentinel = ForegroundSentinel::launch(&mut driver);
+        sentinel
+            .assert_background_posture(target)
+            .expect("background posture before recording");
+        driver.start_behavior_recording();
+        sentinel
+            .prepare_background_observation(&mut driver, target)
+            .expect("background posture after recording setup");
+
+        // The locker (or menu grab) starts after the guard is focused: input
+        // tools are gated while it is up, so the guard cannot be activated
+        // under it. Its own focus events are setup, not the action.
+        let ready = tempfile::NamedTempFile::new().unwrap();
+        let mut helper = if locker {
+            Command::new("i3lock")
+                .args(["-n", "-c", "000000"])
+                .stdout(Stdio::null())
+                .stderr(Stdio::inherit())
+                .spawn()
+                .expect("start i3lock")
+        } else {
+            Command::new("python3")
+                .arg(review_dir().join("grab_keyboard.py"))
+                .arg(ready.path())
+                .spawn()
+                .expect("start the keyboard grab helper")
+        };
+        std::thread::sleep(Duration::from_millis(1000));
+        wait_until("the host to hold a keyboard grab", Duration::from_secs(6), keyboard_already_grabbed);
+        if locker {
+            wait_until("i3lock's fullscreen override-redirect window", Duration::from_secs(6), || {
+                linux_x11::override_redirect_windows()
+                    .unwrap_or_default()
+                    .iter()
+                    .any(|(_, _, rect)| rect.x <= 0 && rect.y <= 0 && rect.width >= 1024 && rect.height >= 700)
+            });
+        }
+        sentinel.rebaseline().expect("rebaseline the guard after host setup");
+        let result = sentinel.observe_background(target, || {
+            driver.call(
+                "type_text",
+                serde_json::json!({
+                    "pid": pid as i64, "window_id": window_id,
+                    "element_token": token, "text": "review", "delivery_mode": "background"
+                }),
+            )
+        });
+        let host_held = keyboard_already_grabbed();
+        let _ = helper.kill();
+        let _ = helper.wait();
+        let (response, mut passed) =
+            result.unwrap_or_else(|error| panic!("background desktop contract failed: {error}"));
+        assert!(host_held, "the host grab ended before the action finished");
+        passed.push(OracleKind::HostState);
+        std::thread::sleep(Duration::from_millis(500));
+        let tree = snapshot(&mut driver, pid, window_id).tree_text().to_owned();
+        if locker {
+            assert!(response.is_error(), "type_text under i3lock succeeded: {}", response.text());
+            assert_eq!(refusal_code(&response).as_deref(), Some("host_not_interactive"), "{}", response.text());
+            assert!(tree.contains("mirror=") && !tree.contains("mirror=review"), "text reached the entry under a locker");
+            passed.push(OracleKind::FixtureState);
+            Observation::refused(
+                RefusalCode::HostNotInteractive,
+                passed,
+                "i3lock recognised; type_text refused",
+                Evidence::default(),
+            )
+        } else {
+            assert!(!response.is_error(), "type_text under a bare grab was refused: {}", response.text());
+            assert!(tree.contains("mirror=review"), "text did not reach the entry under a bare grab");
+            Observation::delivered_with_fixture_state(passed)
+        }
+    });
+}
