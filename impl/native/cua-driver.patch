+        assert_eq!(focus.structured_content.unwrap()["effect"], "refused");
+        let dispatched = pixel_ax_outcome(Ok(Ok(PixelAxAttempt::Dispatched)), false).unwrap();
+        assert_eq!(dispatched.is_error, None);
+        assert_eq!(dispatched.structured_content.unwrap()["effect"], "unverifiable");
+    }
+
+    #[tokio::test]
