+#[cfg(test)]
+mod c9_final_structure_tests {
+    fn section<'a>(source: &'a str, start: &str, end: &str) -> &'a str {
+        let at = source.find(start).unwrap_or_else(|| panic!("{start}"));
+        let rest = &source[at..];
+        &rest[..rest.find(end).unwrap_or_else(|| panic!("{end}"))]
+    }
+
+    /// windows-final C7: the capture is finished (its id binds) inside the
+    /// blocking task, but becomes the session's frame only after the walk
+    /// timeout (4 s, 15 s when the UIAccess worker reads the tree) resolved with the result, so a timed-out call's frame never
+    /// scales the session's unbound pixels.
+    #[test]
+    fn get_window_state_notes_the_session_frame_only_once_returned() {
+        // The Windows checkout of the vendor tree has CRLF files.
+        let source = &include_str!("impl_.rs").replace("\r\n", "\n");
+        let body = section(source, concat!("impl Tool for ", "GetWindowStateTool"), concat!("\nimpl Tool for ", "LaunchAppTool"));
+        let begun = body.find(concat!("CaptureSession::", "begin(&args)")).expect("session taken");
+        let blocking = body.find(concat!("let blocking = tokio::task::", "spawn_blocking(move ||")).expect("blocking task");
+        let finished = body.find(concat!("crate::capture::", "finish_frame(")).expect("finished");
+        let timeout = body.find(concat!("tokio::time::timeout(", "walk_timeout, blocking)")).expect("timeout");
+        let noted = body.find(concat!("crate::capture::", "note_session_frame(")).expect("noted");
+        assert!(begun < blocking && blocking < finished && finished < timeout && timeout < noted);
+        assert!(!source.contains(concat!("set_frame", "_ratio(")));
+    }
+
+    /// windows-final C8: the element focus click of a background press_key on
+    /// a WebView host is the element's own point, read against no capture.
+    #[test]
+    fn press_key_element_focus_is_a_driver_point() {
+        // The Windows checkout of the vendor tree has CRLF files.
+        let source = &include_str!("impl_.rs").replace("\r\n", "\n");
+        let body = section(source, concat!("let background_webview_focus ", "= elem_idx.is_some()"), concat!("} else if let Some(idx) = elem_idx.filter(|_| ", "delivery != DeliveryMode::Foreground)"));
+        assert!(body.contains(concat!("with_driver_window_point(", "focus_by_pixel(")));
+        assert!(!body.contains(concat!("resize_", "registry")), "scaled by another caller's capture");
+    }
+
+    /// windows-final D5: zooms are per session and window in the core; the
+    /// zoom region is scaled by the session's own capture; nothing reads a
+    /// per-pid zoom or the window's latest capture by anyone for a pixel.
+    #[test]
+    fn zoom_pixels_read_the_sessions_own_zoom() {
+        // The Windows checkout of the vendor tree has CRLF files.
+        let source = &include_str!("impl_.rs").replace("\r\n", "\n");
+        assert!(!source.contains(concat!("zoom_", "registry")));
+        let zoom = section(source, concat!("impl Tool for ", "ZoomTool"), concat!("// ── type_text_", "chars"));
+        assert!(!zoom.contains(concat!("resize_", "registry")));
+        let begun = zoom.find(concat!("CaptureSession::", "begin(&args)")).unwrap();
+        let captured = zoom.find(concat!("screenshot_window_", "bytes(hwnd)")).unwrap();
+        assert!(begun < captured && zoom.contains(concat!("record_", "zoom(")));
+        let ratio = section(source, concat!("fn pixel_", "ratio("), "\n}\n");
+        assert!(!ratio.contains(concat!("resize_", "registry")), "a frameless pixel borrows another capture's ratio");
+    }
