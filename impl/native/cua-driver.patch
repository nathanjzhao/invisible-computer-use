+
+    #[test]
+    fn passive_result_change_advances_revision_without_creating_a_target() {
+        let key = fresh_key();
+        let snapshot = |value| vec![node(Some(0), None, "Button", "=", None), node(None, None, "Text", "Result", Some(value))];
+        let first = step(key, &snapshot("0"), "Calculator", false, Baseline::Previous);
+        let next = step(key, &snapshot("42"), "Calculator", false, Baseline::Previous);
+        assert_eq!(next.kind, "diff");
+        assert!(next.text.contains("42"));
+        assert_eq!(next.revision, first.revision + 1);
+        assert_eq!(next.index_to_stable, first.index_to_stable);
+        reset(key);
+    }
+
+    #[test]
+    fn passive_protocol_rows_preserve_values_and_never_expose_input_handles() {
+        let nodes = vec![
+            node(Some(0), None, "Button", "Run", None),
+            node(None, Some(0), "Text", "Result", Some("42")),
+            node(None, None, "Text", "Other", Some("7")),
+        ];
+        let rows = passive_elements(&nodes, Some("42"));
+        assert_eq!(rows.len(), 1);
+        assert_eq!(rows[0]["value"], "42");
+        assert_eq!(rows[0]["parent_index"], 0);
+        assert_eq!(rows[0]["read_only"], true);
+        assert!(rows[0].get("element_index").is_none());
+        assert!(rows[0].get("element_token").is_none());
+        assert!(rows[0].get("selected").is_none(), "unknown selection was fabricated as false");
+        assert_eq!(passive_elements(&nodes, Some("rEsUlT")).len(), 1);
+        assert!(passive_elements(&nodes, Some("missing")).is_empty());
+        assert_eq!(passive_elements(&nodes, None).len(), 2);
+        let snapshot = serde_json::json!({"elements":[{"element_index":0,"role":"Button","label":"Run"}],"passive_elements":rows});
+        let revision = axdiff::Revision::initial(&axdiff::cua::forest_from_gws(&snapshot));
+        assert_eq!(revision.index_map().len(), 1);
+        assert!(axdiff::render_diff(&revision, false, &axdiff::DiffOptions::default()).text().contains("42"));
+    }
+
+    #[test]
+    fn first_turn_is_full_then_diff_then_no_change_with_stable_ids() {
+        let key = fresh_key();
+        let t1 = vec![node(Some(0), None, "Window", "W", None), node(Some(1), Some(0), "Row", "a", None)];
+        let s1 = step(key, &t1, "App", false, Baseline::Previous);
+        assert_eq!((s1.kind, s1.revision, s1.snapshot_count), ("full_first", 1, 1));
+        assert!(s1.text.starts_with("[1] Window \"W\""));
+        assert_eq!(s1.index_to_stable[&1], 2);
+        let t2 = vec![node(Some(0), None, "Window", "W", None), node(Some(1), Some(0), "Row", "z", None), node(Some(2), Some(0), "Row", "a", None)];
+        let s2 = step(key, &t2, "App", false, Baseline::Previous);
+        assert_eq!((s2.kind, s2.revision, s2.snapshot_count), ("diff", 2, 2));
+        assert!(s2.text.starts_with(axdiff::HDR_INCREMENTAL) && s2.text.contains(axdiff::LEGEND_INCREMENTAL), "{}", s2.text);
+        assert!(s2.text.contains("+ ") && s2.text.contains("[3] Row \"z\""), "{}", s2.text);
+        assert_eq!(s2.index_to_stable[&2], 2, "`a` keeps stable id 2 although its element_index moved 1 -> 2");
+        assert_eq!(s2.index_to_stable[&1], 3);
+        let s3 = step(key, &t2, "App", false, Baseline::Previous);
+        assert_eq!((s3.kind, s3.revision, s3.snapshot_count), ("no_change", 2, 3));
+        assert_eq!(s3.text, format!("{}App", axdiff::NO_CHANGE_PREFIX));
+        let s4 = step(key, &t2, "App", true, Baseline::Previous);
+        assert_eq!((s4.kind, s4.revision, s4.snapshot_count), ("full", 2, 4));
+        assert!(s4.text.starts_with("[1] Window \"W\"") && !s4.text.contains(axdiff::HDR_INCREMENTAL));
+        let s5 = step(key, &t1, "App", false, Baseline::Previous);
+        assert!(s5.kind == "diff" && s5.text.lines().any(|l| l.trim() == "- [3]"), "{}", s5.text);
+        reset(key);
+        let s6 = step(key, &t1, "App", false, Baseline::Previous);
+        assert_eq!((s6.kind, s6.revision, s6.snapshot_count), ("full_first", 1, 1));
+    }
+
+    #[test]
+    fn value_change_is_a_change_not_a_remove_and_add() {
+        let key = fresh_key();
+        let t1 = vec![node(Some(0), None, "Window", "W", None), node(Some(1), Some(0), "Edit", "f", Some("a"))];
+        let t2 = vec![node(Some(0), None, "Window", "W", None), node(Some(1), Some(0), "Edit", "f", Some("b"))];
+        step(key, &t1, "App", false, Baseline::Previous);
+        let s = step(key, &t2, "App", false, Baseline::Previous);
+        assert!(s.text.contains("~ ") && s.text.contains("= \"b\"") && !s.text.contains("+ ") && !s.text.contains("- ["), "{}", s.text);
+        assert_eq!(s.index_to_stable[&1], 2);
+    }
+
+    #[test]
+    fn a_platform_stable_identifier_keeps_a_relabel_as_a_change_across_oses() {
+        // The cross-OS contract: when a platform supplies a per-element stable id
+        // (macOS AXIdentifier, Windows AutomationId, Linux AT-SPI accessible-id) in
+        // RevisionNode.identity, a relabel of one node in a same-role sibling list
+        // stays a `~` change with its stable id preserved. Without an identifier the
+        // ambiguous relabel degrades to remove + add. Both platforms inherit this from
+        // the shared forest_from_nodes -> axdiff path, so filling `identity` is the only
+        // per-OS work.
+        let mk = |idx: usize, parent: Option<usize>, role: &str, label: &str, id: Option<&str>| RevisionNode {
+            element_index: Some(idx),
+            parent_element_index: parent,
+            role: role.into(),
+            label: label.into(),
+            value: None,
+            selected: false,
+            selected_state: None,
+            enabled: None,
+            in_web_content: false,
+            identity: id.map(str::to_string),
+            frame: None,
+            attrs: Default::default(),
+        };
+        // with a stable id: relabel A -> X on the identified button renders `~`
+        let key = fresh_key();
+        let t1 = vec![mk(0, None, "Window", "W", None), mk(1, Some(0), "Button", "A", Some("btn1")), mk(2, Some(0), "Button", "B", Some("btn2"))];
+        let s1 = step(key, &t1, "App", false, Baseline::Previous);
+        let a_stable = s1.index_to_stable[&1];
+        let t2 = vec![mk(0, None, "Window", "W", None), mk(1, Some(0), "Button", "X", Some("btn1")), mk(2, Some(0), "Button", "B", Some("btn2"))];
+        let s2 = step(key, &t2, "App", false, Baseline::Previous);
+        assert!(s2.text.contains("~ ") && s2.text.contains("\"X\"") && !s2.text.contains("- ["), "identified relabel must be ~ not churn:\n{}", s2.text);
+        assert_eq!(s2.index_to_stable[&1], a_stable, "the identified node keeps its stable id");
+        reset(key);
+        // without a stable id: the same relabel degrades to remove + add
+        let key2 = fresh_key();
+        let u1 = vec![mk(0, None, "Window", "W", None), mk(1, Some(0), "Button", "A", None), mk(2, Some(0), "Button", "B", None)];
+        step(key2, &u1, "App", false, Baseline::Previous);
+        let u2 = vec![mk(0, None, "Window", "W", None), mk(1, Some(0), "Button", "X", None), mk(2, Some(0), "Button", "B", None)];
+        let s = step(key2, &u2, "App", false, Baseline::Previous);
+        assert!(s.text.contains("+ ") && s.text.contains("- ["), "without an id the ambiguous relabel degrades to remove + add:\n{}", s.text);
+        reset(key2);
+    }
+
+    #[test]
+    fn cumulative_baseline_is_the_initial_snapshot_with_removed_id_ranges() {
+        let key = fresh_key();
+        let mk = |labels: &[&str]| {
+            let mut v = vec![node(Some(0), None, "Window", "W", None)];
+            for (i, l) in labels.iter().enumerate() { v.push(node(Some(i + 1), Some(0), "Row", l, None)); }
+            v
+        };
+        step(key, &mk(&["a", "b", "c", "d"]), "App", false, Baseline::Previous);
+        step(key, &mk(&["a", "b", "c"]), "App", false, Baseline::Previous);
+        let s = step(key, &mk(&["a"]), "App", false, Baseline::Initial);
+        assert_eq!((s.kind, s.baseline), ("diff", Baseline::Initial));
+        assert!(s.text.starts_with(axdiff::HDR_CUMULATIVE) && s.text.contains(axdiff::LEGEND_CUMULATIVE), "{}", s.text);
+        assert!(s.text.contains("Removed elements: 3-5") && !s.text.contains("- ["), "{}", s.text);
+        let s2 = step(key, &mk(&["a", "e"]), "App", false, Baseline::Previous);
+        assert!(s2.text.starts_with(axdiff::HDR_INCREMENTAL) && s2.text.contains("\"e\""), "{}", s2.text);
+    }
+
+    #[test]
+    fn lineages_are_independent_per_window_and_json_shape_is_stable() {
+        let (pid, w1) = fresh_key();
+        let (_, w2) = fresh_key();
+        let t = vec![node(Some(0), None, "Window", "W", None)];
+        let s = step((pid, w1), &t, "App", false, Baseline::Previous);
+        assert_eq!(step((pid, w2), &t, "App", false, Baseline::Previous).kind, "full_first");
+        assert_eq!(step((pid, w1), &t, "App", false, Baseline::Previous).kind, "no_change");
+        let j = s.to_json();
+        let mut keys: Vec<&str> = j.as_object().unwrap().keys().map(String::as_str).collect(); keys.sort();
+        assert_eq!(keys, ["_note", "accessibility_revision", "accessibility_snapshot_count", "baseline", "kind", "text"]);
+        let mut els = vec![serde_json::json!({"element_index": 0, "role": "Window"}), serde_json::json!({"element_index": 9, "role": "X"})];
+        s.attach_stable_ids(&mut els);
+        assert_eq!(els[0]["stable_id"], 1);
+        assert!(els[1].get("stable_id").is_none(), "no mapping -> no field");
+    }
+
+    #[test]
+    fn args_helpers_accept_both_spellings() {
+        assert!(disable_diff_from_args(&serde_json::json!({"disable_diff": true})));
+        assert!(disable_diff_from_args(&serde_json::json!({"disableDiff": true})));
+        assert!(!disable_diff_from_args(&serde_json::json!({})));
+        assert_eq!(Baseline::from_args(&serde_json::json!({"cumulative_diff": true})), Baseline::Initial);
+        assert_eq!(Baseline::from_args(&serde_json::json!({})), Baseline::Previous);
+        let p = schema_properties();
+        assert!(p.get("disable_diff").is_some() && p.get("disableDiff").is_some() && p.get("cumulative_diff").is_some());
+    }
+}
