 pub(crate) const PROBE_TIMEOUT: Duration = Duration::from_secs(2);
 
+pub(crate) const CONSENT_DENIED: &str = "portal_consent_denied";
+pub(crate) const REQUEST_FAILED: &str = "portal_request_failed";
+pub(crate) const SETUP_REFUSED: &str = "portal_setup_refused";
+pub(crate) const SETUP_CANCELLED: &str = "portal_setup_cancelled";
+pub(crate) const SESSION_CLOSED: &str = "portal_session_closed";
+
+/// Preserve the protocol response code, rather than guessing from translated
+/// backend messages. Response 1 is cancellation; response 2 is a backend failure.
+pub(crate) fn request_error(stage: &str, error: ashpd::Error) -> anyhow::Error {
+    use ashpd::desktop::ResponseError;
+    let reason = match error {
+        ashpd::Error::Response(ResponseError::Cancelled) => CONSENT_DENIED,
+        _ => REQUEST_FAILED,
+    };
+    anyhow::anyhow!("{reason}: {stage}: {error}")
+}
+
 pub(crate) async fn fresh_session_connection() -> anyhow::Result<zbus::Connection> {
     zbus::Connection::session()
         .await
         .map_err(|e| anyhow::anyhow!("xdg-desktop-portal session bus unreachable: {e}"))
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn cancellation_and_backend_failure_have_distinct_reasons() {
+        use ashpd::desktop::ResponseError;
+        let cancelled = request_error("Start", ResponseError::Cancelled.into());
+        let failed = request_error("Start", ResponseError::Other.into());
+        assert!(cancelled.to_string().starts_with(CONSENT_DENIED));
+        assert!(failed.to_string().starts_with(REQUEST_FAILED));
+        assert!(!failed.to_string().contains(CONSENT_DENIED));
+        assert!(request_error("Start", ashpd::Error::NoResponse)
+            .to_string().starts_with(REQUEST_FAILED));
+    }
+}
