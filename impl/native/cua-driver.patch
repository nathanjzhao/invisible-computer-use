+/// Platform-neutral projection of the AT-SPI walk for the cross-turn lineage
+/// (`cua_driver_core::element_revision`): label = name → description (the
+/// `elements[].label` chain minus the value), value kept apart so a value change
+/// renders as `~`.
+pub(crate) fn revision_nodes(nodes: &[crate::atspi::AtspiNode]) -> Vec<cua_driver_core::element_revision::RevisionNode> {
+    nodes.iter().map(|n| {
+        let name = n.name.clone().filter(|s| !s.is_empty());
+        let value = n.value.clone();
+        // Only a proven Text fallback is content rather than the accessible
+        // label. A role guess would invent a value when a named field's read fails.
+        let (label, value) = if n.name_from_text {
+            (n.description.clone().filter(|s| !s.is_empty()).unwrap_or_default(), value.or(name))
+        } else {
+            (name.or_else(|| n.description.clone().filter(|s| !s.is_empty())).unwrap_or_default(), value)
+        };
+        cua_driver_core::element_revision::RevisionNode {
+            // Linux stable id: the toolkit's AT-SPI accessible id (GTK3
+            // atk_object_set_accessible_id, Qt accessibleIdentifier). Most
+            // controls leave it empty; those keep `None`, so an unsupported
+            // relabel stays an honest remove+add. The D-Bus object path is
+            // NOT used here: it is per-process object identity for the
+            // stale-target guard, not a cross-turn product identity.
+            identity: n.accessible_id.clone().filter(|id| !id.trim().is_empty()),
+            element_index: n.element_index,
+            parent_element_index: n.parent_element_index,
+            role: n.role.clone(),
+            label,
+            value,
+            selected: n.selected == Some(true) || n.checked == Some(true),
+            selected_state: n.selected,
+            enabled: n.enabled,
+            in_web_content: n.in_web_content,
+            frame: None,
+            attrs: Default::default(),
+        }
+    }).collect()
+}
