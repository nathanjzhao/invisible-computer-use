+/// Every recent `get_window_state` frame by id, plus each window's latest
+/// capture. Screenshot pixels are only meaningful for the frame they were
+/// taken from, and any consumer (the agent, a live preview tile) can capture
+/// the same window, so a pixel action should name its frame with
+/// `screenshot_id`. The driver's own captures (recording, click evidence,
+/// zoom) are not recorded: no caller holds their pixels.
+static CAPTURES: std::sync::Mutex<Option<CaptureLog>> = std::sync::Mutex::new(None);
+
+/// Frames kept for `screenshot_id` lookups. A live preview polling a handful
+/// of windows several times a second must not evict the agent's frame before
+/// its next action; older ids fail closed as unknown.
+const CAPTURE_LOG_FRAMES: usize = 4096;
+
+#[derive(Default)]
+struct CaptureLog {
+    frames: std::collections::VecDeque<CapturedFrame>,
+    next: u64,
+}
+
+/// Which window a handle named when it was captured. Windows hands a closed
+/// window's handle value to a later window: measured, the same thread got the
+/// same HWND back after 32,766 creations, with the same size and pid. So a
+/// frame also records the owning thread, its process's start time, and a tag
+/// this driver sets on the window as a property. A new window at the same
+/// handle has no tag. The tag is 0 where the property cannot be set (a window
+/// of a higher integrity level); such a window is then told apart only by its
+/// thread and process.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub(crate) struct WindowIdentity {
+    pub(crate) pid: u32,
+    pub(crate) thread: u32,
+    pub(crate) process_started: u64,
+    pub(crate) tag: usize,
+}
+
+/// One window capture returned by `get_window_state`: the window's identity,
+/// its window-rect size, and once the caller downscales the PNG, the ratio
+/// from returned pixels to window pixels.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct CapturedFrame {
+    pub(crate) id: u64,
+    pub(crate) hwnd: u64,
+    pub(crate) identity: Option<WindowIdentity>,
+    pub(crate) size: (i32, i32),
+    pub(crate) ratio: Option<f64>,
+}
+
+impl CaptureLog {
+    /// A capture taken but not yet returned: its id names it for a bound
+    /// pixel, but no session's unbound pixel reads it until
+    /// [`finish`](Self::finish) knows its downscale. Measured before (review
+    /// R3-1): a frame published here had no ratio yet, so an unbound click
+    /// that arrived while a tile's capture was being downscaled was read at
+    /// 1:1 against a 1/3.3 capture, and 9 of 50 clicked A where the agent had
+    /// read E, with exit 0.
+    fn record(&mut self, hwnd: u64, identity: Option<WindowIdentity>, size: (i32, i32)) -> u64 {
+        self.next += 1;
+        let frame = CapturedFrame { id: self.next, hwnd, identity, size, ratio: None };
+        if self.frames.len() == CAPTURE_LOG_FRAMES {
+            self.frames.pop_front();
+        }
+        self.frames.push_back(frame);
+        self.next
+    }
+
+    /// The returned PNG's downscale is known once the caller resized it: the
+    /// finished frame, which then becomes its session's frame.
+    fn finish(&mut self, id: u64, ratio: Option<f64>) -> Option<CapturedFrame> {
+        let frame = self.frames.iter_mut().rev().find(|frame| frame.id == id)?;
+        frame.ratio = ratio;
+        Some(*frame)
+    }
+
+    fn frame(&self, id: u64) -> Option<CapturedFrame> {
+        self.frames.iter().rev().find(|frame| frame.id == id).copied()
+    }
+}
+
+/// The core's identity mark for a window: every field of its
+/// [`WindowIdentity`], hashed (the hasher's keys are fixed, so a mark taken at
+/// capture and one taken at action time compare within the daemon).
+/// `Unproven` when the window's thread could not be read.
+pub(crate) fn identity_mark(identity: Option<WindowIdentity>) -> cua_driver_core::capture_log::WindowIdentity {
+    use std::hash::{Hash, Hasher};
+    match identity {
+        Some(identity) => {
+            let mut hasher = std::collections::hash_map::DefaultHasher::new();
+            identity.hash(&mut hasher);
+            cua_driver_core::capture_log::WindowIdentity::Mark(hasher.finish())
+        }
+        None => cua_driver_core::capture_log::WindowIdentity::Unproven,
+    }
+}
+
+/// `hwnd`'s identity for a new frame (a zoom), tagging it first if needed.
+pub(crate) fn capture_identity(hwnd: u64) -> cua_driver_core::capture_log::WindowIdentity {
+    identity_mark(window_identity(hwnd, true))
+}
+
+/// The mark `hwnd` carries now (`None`: no window at the handle).
+pub(crate) fn current_identity_mark(hwnd: u64) -> Option<u64> {
+    match identity_mark(window_identity(hwnd, false)) {
+        cua_driver_core::capture_log::WindowIdentity::Mark(mark) => Some(mark),
+        _ => None,
+    }
+}
+
+/// Session keys for unbound pixels are `(0, hwnd)`: an HWND is system-wide,
+/// and the identity mark tells a reused handle apart.
+pub(crate) const UNBOUND_PID: u32 = 0;
+
+/// Ids are `w<daemon nonce>-<sequence>`, so an id from an earlier daemon
+/// cannot name a frame of this one.
+fn capture_nonce() -> u32 {
+    static NONCE: std::sync::OnceLock<u32> = std::sync::OnceLock::new();
+    *NONCE.get_or_init(|| {
+        let nanos = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|d| d.subsec_nanos())
+            .unwrap_or(0);
+        nanos ^ std::process::id().rotate_left(16)
+    })
+}
+
+pub(crate) fn screenshot_id_string(id: u64) -> String {
+    format!("w{:08x}-{id}", capture_nonce())
+}
+
+fn parse_screenshot_id(text: &str) -> Option<u64> {
+    let (nonce, sequence) = text.strip_prefix('w')?.split_once('-')?;
+    (u32::from_str_radix(nonce, 16).ok()? == capture_nonce()).then_some(())?;
+    sequence.parse().ok()
+}
+
+/// A finished frame, ready to become a session's capture of its window.
+#[derive(Debug)]
+pub(crate) struct FinishedFrame {
+    id: u64,
+    capture: cua_driver_core::capture_log::Capture,
+}
+
+/// Remember the ratio from a frame's returned (possibly downscaled) PNG pixels
+/// to window pixels, so a pixel bound to that frame's `screenshot_id` is
+/// scaled by its own capture. The frame is not yet any session's: see
+/// [`note_session_frame`].
+pub(crate) fn finish_frame(id: u64, ratio: Option<f64>) -> Option<FinishedFrame> {
+    let frame = CAPTURES.lock().unwrap().as_mut().and_then(|log| log.finish(id, ratio))?;
+    Some(FinishedFrame {
+        id: frame.id,
+        capture: cua_driver_core::capture_log::Capture {
+            pid: UNBOUND_PID,
+            window_id: frame.hwnd,
+            size: (f64::from(frame.size.0), f64::from(frame.size.1)),
+            scale: 1.0,
+            ratio: frame.ratio,
+            identity: identity_mark(frame.identity),
+        },
+    })
+}
+
+/// Make a finished frame `session`'s capture of the window for its pixels
+/// without an id (`cua_driver_core::capture_log`, review C9). Call this only
+/// once the capture's caller gets it: a `get_window_state` that timed out
+/// returned an error, and its frame must not become what the session's
+/// unbound pixels are read against (review windows-final C7).
+pub(crate) fn note_session_frame(
+    session: Option<cua_driver_core::capture_log::CaptureSession>,
+    frame: FinishedFrame,
+) {
+    cua_driver_core::capture_log::note_session_capture(session, frame.id, frame.capture);
+}
+
+/// The frame a `screenshot_id` names, or `None` when this daemon never issued
+/// it or has since dropped it.
+pub(crate) fn captured_frame(screenshot_id: &str) -> Option<CapturedFrame> {
+    let id = parse_screenshot_id(screenshot_id)?;
+    CAPTURES.lock().unwrap().as_ref()?.frame(id)
+}
+
+/// `true` when `hwnd` is still the window `frame` captured.
+pub(crate) fn same_window(frame: &CapturedFrame) -> bool {
+    frame.identity == window_identity(frame.hwnd, false)
+}
+
+const CAPTURE_TAG: windows::core::PCWSTR = windows::core::w!("CuaDriver.CaptureTag");
+
+/// `hwnd`'s identity now. With `tag`, a window this driver has not tagged
+/// gets a fresh tag first.
+fn window_identity(hwnd: u64, tag: bool) -> Option<WindowIdentity> {
+    use windows::Win32::Foundation::{CloseHandle, FILETIME, HANDLE};
+    use windows::Win32::System::Threading::{
+        GetProcessTimes, OpenProcess, PROCESS_QUERY_LIMITED_INFORMATION,
+    };
+    use windows::Win32::UI::WindowsAndMessaging::{GetPropW, GetWindowThreadProcessId, SetPropW};
+    static NEXT_TAG: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(1);
+    let window = HWND(hwnd as *mut _);
+    let mut pid = 0u32;
+    let thread = unsafe { GetWindowThreadProcessId(window, Some(&mut pid)) };
+    if thread == 0 {
+        return None;
+    }
+    let process_started = unsafe { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false, pid) }
+        .ok()
+        .map(|process| {
+            let (mut created, mut exited, mut kernel, mut user) =
+                (FILETIME::default(), FILETIME::default(), FILETIME::default(), FILETIME::default());
+            let times = unsafe { GetProcessTimes(process, &mut created, &mut exited, &mut kernel, &mut user) };
+            let _ = unsafe { CloseHandle(process) };
+            times.map(|_| (u64::from(created.dwHighDateTime) << 32) | u64::from(created.dwLowDateTime)).unwrap_or(0)
+        })
+        .unwrap_or(0);
+    // Two captures of an untagged window at once (the agent's and a tile's)
+    // would each set a tag, and the frame whose tag was overwritten would
+    // look like another window's: stale, and its history marked reused.
+    static TAGGING: std::sync::Mutex<()> = std::sync::Mutex::new(());
+    let _tagging = tag.then(|| TAGGING.lock().unwrap_or_else(|poisoned| poisoned.into_inner()));
+    let mut current = unsafe { GetPropW(window, CAPTURE_TAG) }.0 as usize;
+    if current == 0 && tag {
+        // Unique to this daemon: the nonce in the high half on 64-bit.
+        let next = NEXT_TAG.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        let fresh = ((capture_nonce() as usize) << (usize::BITS / 2)) ^ next;
+        if unsafe { SetPropW(window, CAPTURE_TAG, HANDLE(fresh as *mut _)) }.is_ok() {
+            current = fresh;
+        }
+    }
+    Some(WindowIdentity { pid, thread, process_started, tag: current })
+}
+
+pub(crate) fn window_rect_size(hwnd: u64) -> Option<(i32, i32)> {
+    use windows::Win32::Foundation::RECT;
+    use windows::Win32::UI::WindowsAndMessaging::GetWindowRect;
+    let mut rect = RECT::default();
+    unsafe { GetWindowRect(HWND(hwnd as *mut _), &mut rect) }.ok()?;
+    Some((rect.right - rect.left, rect.bottom - rect.top))
+}
+
+/// `Some((captured, current))` when the window's size differs from the
+/// size it had in `frame`, e.g. a DPI-virtualized window moved to a monitor
+/// with another scale. A pixel from that screenshot no longer names the same
+/// spot.
+pub(crate) fn size_changed_since_frame(frame: &CapturedFrame) -> Option<((i32, i32), (i32, i32))> {
+    let current = window_rect_size(frame.hwnd)?;
+    (frame.size != current).then_some((frame.size, current))
+}
