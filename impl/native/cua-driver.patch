+/// Typed reason an X11 window produced no frame. `code` is the stable,
+/// machine-readable part; the backend dump stays in `detail`.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CaptureFailure {
+    pub code: &'static str,
+    pub message: String,
+    pub suggestion: &'static str,
+}
+
+/// Classify a failed per-window capture from what the X server reports about
+/// the window afterwards. Only called once every backend has failed, so a
+/// successful capture (for example a compositor-redirected off-root window)
+/// is never second-guessed.
+pub fn classify_capture_failure(xid: u64, state: Option<&crate::x11::CaptureState>) -> CaptureFailure {
+    match state {
+        Some(state) if !state.viewable && state.iconic => CaptureFailure {
+            code: "window_minimized",
+            message: format!("window {xid} is minimized; X11 keeps no pixels for an iconified window"),
+            suggestion: "restore the window (bring_to_front, or the user un-minimizes it), then capture again",
+        },
+        Some(state) if !state.viewable => CaptureFailure {
+            code: "window_not_viewable",
+            message: format!("window {xid} is not mapped on screen (hidden, withdrawn, or on another desktop)"),
+            suggestion: "show the window on the current desktop, then capture again",
+        },
+        Some(state) if state.extends_past_root() => {
+            let (x, y, w, h) = state.rect;
+            let (rw, rh) = state.root_size;
+            CaptureFailure {
+                code: "window_offscreen",
+                message: format!(
+                    "window {xid} at {w}x{h}+{x}+{y} extends past the {rw}x{rh} screen and no compositor \
+                     keeps its off-screen pixels, so X11 GetImage refuses it"
+                ),
+                suggestion: "move the window fully on screen, or run a compositing manager, then capture again",
+            }
+        }
+        _ => CaptureFailure {
+            code: "capture_failed",
+            message: format!("window {xid} could not be captured by any X11 backend"),
+            suggestion: "re-list windows and capture again; see detail for the backend errors",
+        },
+    }
+}
