@@ -0,0 +1,99 @@
+//! Recovery queries use a short per-object AX timeout. Mutations must restore
+//! their own bounded budget on that same object before they dispatch.
+
+pub(super) const MUTATION_TIMEOUT_SECONDS: f32 = 2.0;
+
+pub(super) fn with_mutation_timeout(
+    set_timeout: impl FnOnce(f32) -> i32,
+    dispatch: impl FnOnce() -> i32,
+) -> i32 {
+    let configured = set_timeout(MUTATION_TIMEOUT_SECONDS);
+    if configured != 0 {
+        return configured;
+    }
+    dispatch()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::cell::{Cell, RefCell};
+
+    #[test]
+    fn recovery_query_timeout_cannot_carry_into_action_or_attribute_dispatch() {
+        for operation in ["AXPress", "AXValue", "AXSelected", "AXSelectedTextRange"] {
+            let timeout = Cell::new(0.15f32);
+            let calls = RefCell::new(vec!["query"]);
+            let result = with_mutation_timeout(
+                |seconds| {
+                    calls.borrow_mut().push("timeout");
+                    timeout.set(seconds);
+                    0
+                },
+                || {
+                    calls.borrow_mut().push(operation);
+                    assert_eq!(timeout.get(), 2.0);
+                    0
+                },
+            );
+            assert_eq!(result, 0);
+            assert_eq!(*calls.borrow(), ["query", "timeout", operation]);
+        }
+    }
+
+    #[test]
+    fn timeout_configuration_error_stops_before_mutation() {
+        for code in [-25201, -25202] {
+            let dispatches = Cell::new(0);
+            let result = with_mutation_timeout(
+                |_| code,
+                || {
+                    dispatches.set(dispatches.get() + 1);
+                    0
+                },
+            );
+            assert_eq!(result, code);
+            assert_eq!(dispatches.get(), 0);
+        }
+    }
+
+    #[test]
+    fn native_errors_are_preserved_without_retry_or_success_normalization() {
+        for code in [-25204, -25205, -25200, 0] {
+            let dispatches = Cell::new(0);
+            let result = with_mutation_timeout(
+                |_| 0,
+                || {
+                    dispatches.set(dispatches.get() + 1);
+                    code
+                },
+            );
+            assert_eq!(result, code);
+            assert_eq!(dispatches.get(), 1);
+        }
+    }
+
+    #[test]
+    fn every_mutation_restores_its_budget_after_another_recovery_query() {
+        let timeout = Cell::new(2.0f32);
+        let dispatches = Cell::new(0);
+        for _ in 0..2 {
+            timeout.set(0.15);
+            assert_eq!(
+                with_mutation_timeout(
+                    |seconds| {
+                        timeout.set(seconds);
+                        0
+                    },
+                    || {
+                        assert_eq!(timeout.get(), 2.0);
+                        dispatches.set(dispatches.get() + 1);
+                        0
+                    }
+                ),
+                0
+            );
+        }
+        assert_eq!(dispatches.get(), 2);
+    }
+}
