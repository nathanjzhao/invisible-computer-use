+        assert!(pids.contains(&u64::from(xw.pid)), "XWayland window missing: {pids:?}");
+        let coverage = &listed.structured()["window_coverage"];
+        assert_eq!(coverage["code"], "native_wayland_windows_not_listed", "coverage: {coverage}");
+        let backend = wayland_backend_check(&mut driver);
+        assert_eq!(backend["status"], "fail", "wayland_backend: {backend}");
+        assert_eq!(backend["data"]["error_detail"], "native_wayland_windows_not_listed", "wayland_backend: {backend}");
+        Observation::delivered(vec![OracleKind::AxState, OracleKind::ReadinessAgrees], Evidence::default())
