+#[cfg(test)]
+#[test]
+fn a_frame_whose_mark_could_not_be_written_refuses() {
+    // Round-3 O3: a failed property write used to record the frame with no
+    // mark, and the recreated-window check was skipped for it. Also for the
+    // session's own frame of an unbound pixel.
+    use cua_driver_core::capture_log::{PixelBinding, WindowIdentity};
+    let args = json!({ "_session_id": "linux-o3" });
+    let (pid, xid) = (0x7fff_0030, 7);
+    let id = record_capture(cua_driver_core::capture_log::CaptureSession::begin(&args), pid, xid, (400.0, 300.0), None, WindowIdentity::Unproven);
+    for args in [json!({ "_session_id": "linux-o3" }), json!({ "screenshot_id": id })] {
+        let binding = PixelBinding::resolve(&args, pid, xid).unwrap();
+        let refused = binding.verify_identity(|| panic!("an unmarked frame has nothing to compare")).unwrap_err();
+        let message = refused.structured_content.unwrap()["refusal"]["message"].as_str().unwrap().to_owned();
+        assert!(message.contains("could not mark window 7"), "{message}");
+    }
+    record_capture(cua_driver_core::capture_log::CaptureSession::begin(&args), pid, xid, (400.0, 300.0), None, WindowIdentity::Mark(42));
+    let binding = PixelBinding::resolve(&args, pid, xid).unwrap();
+    assert!(binding.verify_identity(|| Some(42)).is_ok());
+    assert!(binding.verify_identity(|| Some(43)).unwrap_err().structured_content.unwrap()["refusal"]["message"]
+        .as_str()
+        .unwrap()
+        .contains("newer window"));
+    assert!(binding.verify_identity(|| None).is_err(), "a window without the mark is not the captured one");
+}
