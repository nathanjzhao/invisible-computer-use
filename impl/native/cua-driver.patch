+/// The desktop mouse button held between `desktop_drag_hold` calls (Sky `drag_handle`): its button
+/// number, where it is, and when it was last touched. The X server (XTest) or the persistent
+/// virtual pointer holds the press itself; this is what the driver knows of it.
+struct DesktopHeld {
+    button: u8,
+    at: (i32, i32),
+    touched: std::time::Instant,
+}
+static DESKTOP_HELD: std::sync::Mutex<Option<DesktopHeld>> = std::sync::Mutex::new(None);
+/// The persistent virtual-pointer slot the desktop hold uses on native Wayland.
+const DESKTOP_HOLD_CURSOR: &str = "desktop-drag-hold";
+
+/// A held desktop button is let go after this long with no call touching it, so a caller that
+/// walked away cannot leave a mouse button down on the desktop. `CUA_DRIVER_RS_DRAG_HOLD_IDLE_MS`.
+fn desktop_hold_idle_limit() -> std::time::Duration {
+    let ms = std::env::var("CUA_DRIVER_RS_DRAG_HOLD_IDLE_MS")
+        .ok()
+        .and_then(|v| v.parse::<u64>().ok())
+        .filter(|ms| (100..=3_600_000).contains(ms))
+        .unwrap_or(120_000);
+    std::time::Duration::from_millis(ms)
+}
+
+/// On X11 the press lives in the X server, not in this process, so a held button outlives a driver
+/// process that exits after each call (`icu call` without a daemon). The hold is written to a file
+/// beside the X display so the next process finds it, ends it, or lets go of it when nobody came
+/// back (an idle hold older than the limit is released by whichever process looks next). On native
+/// Wayland the press belongs to the process's virtual pointer and goes with it, so there is no file.
+fn x11_hold_file() -> std::path::PathBuf {
+    let dir = std::env::var_os("XDG_RUNTIME_DIR")
+        .map(std::path::PathBuf::from)
+        .unwrap_or_else(std::env::temp_dir);
+    let display: String = std::env::var("DISPLAY")
+        .unwrap_or_default()
+        .chars()
+        .map(|c| if c.is_ascii_alphanumeric() { c } else { '_' })
+        .collect();
+    dir.join(format!("cua-driver-desktop-hold-{display}.json"))
+}
+
+fn unix_ms() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_millis() as u64)
+        .unwrap_or(0)
+}
+
+fn save_x11_hold(button: u8, at: (i32, i32)) {
+    if crate::wayland::wayland_input_enabled() {
+        return;
+    }
+    let body = json!({"button": button, "x": at.0, "y": at.1, "at_ms": unix_ms()});
+    let _ = std::fs::write(x11_hold_file(), body.to_string());
+}
+
+fn clear_x11_hold() {
+    let _ = std::fs::remove_file(x11_hold_file());
+}
+
+/// A hold an earlier driver process left on this X display, taken over by this one; or, when it has
+/// been idle past the limit, released now. No-op when this process already holds one, or on Wayland.
+fn adopt_x11_hold() {
+    if crate::wayland::wayland_input_enabled() || DESKTOP_HELD.lock().unwrap().is_some() {
+        return;
+    }
+    let Ok(text) = std::fs::read_to_string(x11_hold_file()) else {
+        return;
+    };
+    let Ok(v) = serde_json::from_str::<Value>(&text) else {
+        clear_x11_hold();
+        return;
+    };
+    let (Some(button), Some(x), Some(y), Some(at_ms)) = (
+        v["button"].as_u64(),
+        v["x"].as_i64(),
+        v["y"].as_i64(),
+        v["at_ms"].as_u64(),
+    ) else {
+        clear_x11_hold();
+        return;
+    };
+    let age = std::time::Duration::from_millis(unix_ms().saturating_sub(at_ms));
+    let held = DesktopHeld {
+        button: button as u8,
+        at: (x as i32, y as i32),
+        touched: std::time::Instant::now()
+            .checked_sub(age)
+            .unwrap_or_else(std::time::Instant::now),
+    };
+    *DESKTOP_HELD.lock().unwrap() = Some(held);
+    if age >= desktop_hold_idle_limit() {
+        let _ = release_desktop_hold();
+    }
+}
+
+/// Let go of a held desktop button nobody touches for the idle limit (a caller that walked away
+/// must not leave a mouse button down on the desktop). One task per process while a hold is held.
+fn spawn_hold_watchdog() {
+    tokio::spawn(async {
+        loop {
+            tokio::time::sleep(std::time::Duration::from_secs(1)).await;
+            let idle = {
+                let guard = DESKTOP_HELD.lock().unwrap();
+                match guard.as_ref() {
+                    None => return,
+                    Some(h) => h.touched.elapsed() >= desktop_hold_idle_limit(),
+                }
+            };
+            if idle {
+                let _ = tokio::task::spawn_blocking(release_desktop_hold).await;
+                return;
+            }
+        }
+    });
+}
+
+fn desktop_hold_step(op: crate::pointer_plan::Op, button: u8, at: &mut (i32, i32)) -> anyhow::Result<()> {
+    use crate::pointer_plan::Op;
+    let wayland = crate::wayland::wayland_input_enabled();
+    match op {
+        Op::Move(x, y) => {
+            *at = (x, y);
+            if wayland {
+                crate::wayland::persistent_vptr::move_to(DESKTOP_HOLD_CURSOR, x, y)
+            } else {
+                crate::input::send_desktop_hold_step_xtest(crate::input::DesktopHoldStep::Move(x, y), button)
+            }
+        }
+        Op::Press => {
+            if wayland {
+                crate::wayland::persistent_vptr::press_desktop(DESKTOP_HOLD_CURSOR, at.0, at.1, button)
+            } else {
+                crate::input::send_desktop_hold_step_xtest(crate::input::DesktopHoldStep::Press(at.0, at.1), button)
+            }
+        }
+        Op::Release => {
+            if wayland {
+                crate::wayland::persistent_vptr::release(DESKTOP_HOLD_CURSOR, button)
+            } else {
+                crate::input::send_desktop_hold_step_xtest(crate::input::DesktopHoldStep::Release(at.0, at.1), button)
+            }
+        }
+        Op::Sleep(ms) => {
+            std::thread::sleep(std::time::Duration::from_millis(ms));
+            Ok(())
+        }
+    }
+}
+
+/// Release a held desktop button now. `Ok(false)` when nothing is held.
+fn release_desktop_hold() -> anyhow::Result<bool> {
+    let held = DESKTOP_HELD.lock().unwrap().as_ref().map(|h| (h.button, h.at));
+    let Some((button, mut at)) = held else {
+        return Ok(false);
+    };
+    match desktop_hold_step(crate::pointer_plan::Op::Release, button, &mut at) {
+        Ok(()) => {
+            *DESKTOP_HELD.lock().unwrap() = None;
+            clear_x11_hold();
+            Ok(true)
+        }
+        Err(error) => {
+            // On X11 the hold stays recorded so the release can be retried. A virtual pointer that
+            // is gone (the compositor restarted) took the press with it: forget the hold.
+            if crate::wayland::wayland_input_enabled() {
+                let _ = crate::wayland::persistent_vptr::forget(DESKTOP_HOLD_CURSOR);
+                *DESKTOP_HELD.lock().unwrap() = None;
+            }
+            Err(error)
+        }
+    }
+}
+
+/// `drag` with `scope: desktop` and `hold` (Sky full-desktop `drag_handle`): hold a mouse button
+/// across calls. `hold=start` presses at (to_x, to_y) and leaves the button down; `hold=move_to`
+/// glides the held button to (to_x, to_y); `hold=end` releases it where it is. The schema's
+/// required from_x and from_y repeat the point. One button at a time; a button nobody touches for
+/// two minutes is released. `end` with nothing held is not an error (`held: false`).
+async fn desktop_drag_hold(args: Value) -> ToolResult {
+    {
+        use crate::pointer_plan::{glide, hold_transition, Held, HoldAction, HoldEffect, Op};
+        use cua_driver_core::tool_args::ArgsExt;
+        let action = match args.get("hold").and_then(Value::as_str) {
+            Some("start") => HoldAction::Start,
+            Some("move_to") => HoldAction::MoveTo,
+            Some("end") => HoldAction::End,
+            _ => return desktop_gesture_refusal("hold must be start, move_to or end."),
+        };
+        // a hold an earlier driver process left on this X display (X11 only)
+        let adopt = tokio::task::spawn_blocking(adopt_x11_hold).await;
+        if adopt.is_ok() && DESKTOP_HELD.lock().unwrap().is_some() {
+            spawn_hold_watchdog();
+        }
+        let held_now = DESKTOP_HELD.lock().unwrap().as_ref().map(|h| Held { at: h.at });
+        let effect = match hold_transition(held_now, action) {
+            Ok(effect) => effect,
+            Err(e) => return desktop_gesture_refusal(e.to_string()),
+        };
+        // the path names the core's action record knows
+        let path = if crate::wayland::wayland_input_enabled() { "wayland_desktop" } else { "xtest" };
+        let state_json = |held: bool, at: (i32, i32), button: u8| {
+            json!({"scope":"desktop","path":path,"held":held,"x":at.0,"y":at.1,
+                   "button":mouse_button_name(button),"effect":"unverifiable"})
+        };
+        let point = || -> Result<(i32, i32), ToolResult> {
+            let (Some(x), Some(y)) = (
+                args.get("to_x").and_then(Value::as_f64).filter(|v| v.is_finite()),
+                args.get("to_y").and_then(Value::as_f64).filter(|v| v.is_finite()),
+            ) else {
+                return Err(desktop_gesture_refusal("to_x and to_y must be finite numbers."));
