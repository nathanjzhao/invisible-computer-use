--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/ax/system_menu.rs
@@ -0,0 +1,301 @@
+//! The Apple menu is the system's, not the target application's.
+//!
+//! Every AppKit menu bar starts with the Apple menu (About This Mac, System
+//! Settings, Force Quit, Sleep, Restart, Shut Down, Lock Screen, Log Out). The
+//! target app only hosts it, and its commands act on the whole machine or the
+//! user's session. specs/14 lists changing local system settings among the
+//! actions that always need a confirmation at action time, and the Windows
+//! hard-deny list puts session and security controls outside computer use
+//! entirely. This driver has no action-time confirmation for model actions, so
+//! the Apple menu is left out of every observation and `invoke_menu` refuses a
+//! path into it, instead of offering Restart or Shut Down as ordinary targets.
+//!
+//! The Apple menu is identified by position (the first `AXMenuBarItem` of an
+//! `AXMenuBar`), not by its localized title.
+//!
+//! Leaving it out of observation does not keep input out of it. Ctrl-F2 (or a
+//! click on the Apple logo) opens it, arrow keys or typing walk it to Lock
+//! Screen, Log Out or Shut Down, and one Return, Space or click chooses. So the
+//! choosing input is refused too, in every delivery mode: key and text input
+//! while the frontmost or target app's Apple menu is highlighted or open
+//! ([`engaged_title`]), and a mouse press on the Apple menu or its open menu
+//! ([`press_refusal`]).
+
+use super::bindings::{
+    copy_bool_attr, copy_children, copy_element_attr, copy_string_attr, element_screen_rect,
+    AXUIElementCreateApplication, AXUIElementRef, AXUIElementSetMessagingTimeout,
+};
+use core_foundation::base::{CFRelease, CFTypeRef};
+
+/// How long a menu-bar read may wait on a busy app. The check runs before
+/// input, and an app too busy to answer in this time is not tracking a menu.
+const MENU_READ_TIMEOUT_S: f32 = 0.25;
+
+/// Whether the child at `index` of a `parent_role` element is the Apple menu.
+pub fn is_system_menu_item(parent_role: &str, index: usize, child_role: &str) -> bool {
+    parent_role == "AXMenuBar" && index == 0 && child_role == "AXMenuBarItem"
+}
+
+/// The title of `pid`'s Apple menu, if its menu bar exposes one.
+///
+/// # Safety
+///
+/// `app` must be a valid, live application `AXUIElementRef`.
+pub unsafe fn system_menu_title(app: AXUIElementRef) -> Option<String> {
+    let menu_bar = copy_element_attr(app, "AXMenuBar")?;
+    let children = copy_children(menu_bar);
+    CFRelease(menu_bar as CFTypeRef);
+    let mut title = None;
+    for (index, child) in children.into_iter().enumerate() {
+        if index == 0 {
+            let role = copy_string_attr(child, "AXRole").unwrap_or_default();
+            if is_system_menu_item("AXMenuBar", 0, &role) {
+                title = copy_string_attr(child, "AXTitle").map(|t| t.trim().to_owned());
+            }
+        }
+        CFRelease(child as CFTypeRef);
+    }
+    title
+}
+
+/// `pid`'s Apple menu bar item, retained; release it with `CFRelease`.
+unsafe fn apple_menu_item(pid: i32) -> Option<AXUIElementRef> {
+    let app = AXUIElementCreateApplication(pid);
+    if app.is_null() {
+        return None;
+    }
+    AXUIElementSetMessagingTimeout(app, MENU_READ_TIMEOUT_S);
+    let menu_bar = copy_element_attr(app, "AXMenuBar");
+    CFRelease(app as CFTypeRef);
+    let menu_bar = menu_bar?;
+    let children = copy_children(menu_bar);
+    CFRelease(menu_bar as CFTypeRef);
+    let mut item = None;
+    for (index, child) in children.into_iter().enumerate() {
+        if index == 0 && is_system_menu_item("AXMenuBar", 0, &copy_string_attr(child, "AXRole").unwrap_or_default()) {
+            item = Some(child);
+        } else {
+            CFRelease(child as CFTypeRef);
+        }
+    }
+    item
+}
+
+/// The Apple menu's open `AXMenu` under its menu bar item, retained.
+unsafe fn open_menu(item: AXUIElementRef) -> Option<AXUIElementRef> {
+    let mut menu = None;
+    for child in copy_children(item) {
+        if menu.is_none() && copy_string_attr(child, "AXRole").as_deref() == Some("AXMenu") {
+            menu = Some(child);
+        } else {
+            CFRelease(child as CFTypeRef);
+        }
+    }
+    menu
+}
+
+/// When `pid`'s Apple menu is highlighted in the menu bar or open: the title
+/// of its highlighted item, or the menu's own title when none is.
+pub fn engaged_title(pid: i32) -> Option<String> {
+    // Unit tests never read a real menu bar: they script it per pid.
+    #[cfg(test)]
+    return test_menus::engaged(pid);
+    #[cfg(not(test))]
+    unsafe {
+        let item = apple_menu_item(pid)?;
+        let mut engaged = None;
+        if copy_bool_attr(item, "AXSelected") == Some(true) {
+            let mut title = copy_string_attr(item, "AXTitle").unwrap_or_default();
+            if let Some(menu) = open_menu(item) {
+                for child in copy_children(menu) {
+                    if copy_bool_attr(child, "AXSelected") == Some(true) {
+                        title = copy_string_attr(child, "AXTitle").unwrap_or(title);
+                    }
+                    CFRelease(child as CFTypeRef);
+                }
+                CFRelease(menu as CFTypeRef);
+            }
+            engaged = Some(title);
+        }
+        CFRelease(item as CFTypeRef);
+        engaged
+    }
+}
+
+/// The first of `pids` whose Apple menu is engaged, with its highlighted title.
+pub fn engaged_in(pids: impl IntoIterator<Item = i32>) -> Option<(i32, String)> {
+    let mut seen = Vec::new();
+    for pid in pids {
+        if pid <= 0 || seen.contains(&pid) {
+            continue;
+        }
+        seen.push(pid);
+        if let Some(title) = engaged_title(pid) {
+            return Some((pid, title));
+        }
+    }
+    None
+}
+
+fn contains(rect: [f64; 4], x: f64, y: f64) -> bool {
+    x >= rect[0] && y >= rect[1] && x < rect[0] + rect[2] && y < rect[1] + rect[3]
+}
+
+/// Whether a mouse press at screen point `(x, y)` lands on the frontmost app's
+/// Apple menu: its menu bar item, or the open menu under it. Only the frontmost
+/// app has a menu bar on screen.
+pub fn press_hits_apple_menu(x: f64, y: f64) -> bool {
+    #[cfg(test)]
+    return test_menus::logo().is_some_and(|rect| contains(rect, x, y));
+    #[cfg(not(test))]
+    let Some(pid) = crate::apps::frontmost_pid() else { return false };
+    #[cfg(not(test))]
+    unsafe {
+        let Some(item) = apple_menu_item(pid) else { return false };
+        let mut hit = element_screen_rect(item).is_some_and(|rect| contains(rect, x, y));
+        if !hit {
+            if let Some(menu) = open_menu(item) {
+                hit = element_screen_rect(menu).is_some_and(|rect| contains(rect, x, y));
+                CFRelease(menu as CFTypeRef);
+            }
+        }
+        CFRelease(item as CFTypeRef);
+        hit
+    }
+}
+
+/// The refusal message for input that would choose from the Apple menu.
+pub fn refusal_message(what: &str, title: &str) -> String {
+    format!(
+        "{what}: the Apple menu is open or highlighted ({title:?}). Its items (Lock Screen, \
+         Log Out, Restart, Shut Down, Force Quit, System Settings) act on the whole machine or \
+         session and are not available to computer use. Press Escape to close it."
+    )
+}
+
+/// Refuse a mouse press at screen point `(x, y)` on the Apple menu, or while it
+/// is open. Called by every press path in `input::mouse` before posting.
+pub fn press_refusal(x: f64, y: f64) -> anyhow::Result<()> {
+    #[cfg(test)]
+    let frontmost = test_menus::frontmost();
+    #[cfg(not(test))]
+    let frontmost = crate::apps::frontmost_pid();
+    press_refusal_for(frontmost, x, y)
+}
+
+fn press_refusal_for(frontmost: Option<i32>, x: f64, y: f64) -> anyhow::Result<()> {
+    if let Some((_, title)) = frontmost.and_then(|pid| engaged_in([pid])) {
+        anyhow::bail!("refused (system_menu_refused): {}", refusal_message("mouse press", &title));
+    }
+    if press_hits_apple_menu(x, y) {
+        anyhow::bail!(
+            "refused (system_menu_refused): mouse press: ({x:.0}, {y:.0}) is on the Apple menu. Its \
+             items (Lock Screen, Log Out, Restart, Shut Down, Force Quit, System Settings) act on the \
+             whole machine or session and are not available to computer use."
+        );
+    }
+    Ok(())
+}
+
+/// Scripted menu bars for unit tests: which pids have their Apple menu engaged
+/// (and on which item), the frontmost pid, and the Apple logo's rect.
+#[cfg(test)]
+pub(crate) mod test_menus {
+    use std::collections::HashMap;
+    use std::sync::Mutex;
+
+    static ENGAGED: Mutex<Option<HashMap<i32, String>>> = Mutex::new(None);
+    static FRONTMOST: Mutex<Option<i32>> = Mutex::new(None);
+    static LOGO: Mutex<Option<[f64; 4]>> = Mutex::new(None);
+
+    pub(crate) fn engage(pid: i32, title: &str) {
+        ENGAGED.lock().unwrap().get_or_insert_with(HashMap::new).insert(pid, title.to_owned());
+    }
+    pub(crate) fn release(pid: i32) {
+        if let Some(map) = ENGAGED.lock().unwrap().as_mut() {
+            map.remove(&pid);
+        }
+    }
+    pub(crate) fn engaged(pid: i32) -> Option<String> {
+        ENGAGED.lock().unwrap().as_ref().and_then(|map| map.get(&pid).cloned())
+    }
+    pub(crate) fn frontmost() -> Option<i32> {
+        *FRONTMOST.lock().unwrap()
+    }
+    pub(crate) fn logo() -> Option<[f64; 4]> {
+        *LOGO.lock().unwrap()
+    }
+    pub(crate) fn set_frontmost(pid: Option<i32>, logo: Option<[f64; 4]>) {
+        *FRONTMOST.lock().unwrap() = pid;
+        *LOGO.lock().unwrap() = logo;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_the_first_menu_bar_item_is_the_system_menu() {
+        assert!(is_system_menu_item("AXMenuBar", 0, "AXMenuBarItem"));
+        assert!(!is_system_menu_item("AXMenuBar", 1, "AXMenuBarItem"), "the app menu stays");
+        assert!(!is_system_menu_item("AXMenu", 0, "AXMenuItem"), "submenus are not filtered");
+        assert!(!is_system_menu_item("AXExtrasMenuBar", 0, "AXMenuBarItem"));
+    }
+
+    /// R4-3: a mouse press is refused while the frontmost app's Apple menu is
+    /// open, and on the Apple logo itself; elsewhere it passes.
+    #[test]
+    fn a_press_is_refused_on_the_apple_menu_or_while_it_is_open() {
+        let pid = 71_301;
+        test_menus::set_frontmost(Some(pid), Some([8.0, 0.0, 24.0, 24.0]));
+        assert!(press_refusal(400.0, 300.0).is_ok());
+        let on_logo = press_refusal(12.0, 10.0).unwrap_err().to_string();
+        assert!(on_logo.contains("system_menu_refused") && on_logo.contains("is on the Apple menu"), "{on_logo}");
+        test_menus::engage(pid, "Lock Screen");
+        let open = press_refusal(400.0, 300.0).unwrap_err().to_string();
+        assert!(open.contains("Lock Screen"), "{open}");
+        test_menus::release(pid);
+        // another app's state does not matter: only the frontmost has a menu bar
+        test_menus::engage(pid + 1, "Lock Screen");
+        assert!(press_refusal_for(Some(pid), 400.0, 300.0).is_ok());
+        test_menus::release(pid + 1);
+        test_menus::set_frontmost(None, None);
+    }
+
+    /// Structural guard: every mouse press path in `input::mouse` refuses the
+    /// Apple menu before it builds an event.
+    #[test]
+    fn every_mouse_press_path_checks_the_apple_menu_first() {
+        let source = include_str!("../input/mouse.rs");
+        for name in [
+            "fn click_at_xy_desktop_inner(",
+            "fn click_at_xy_inner(",
+            "pub fn click_at_xy_chromium(",
+            "pub fn drag_at_xy_observed<F>(",
+            "pub fn drag_at_xy_foreground_observed<F>(",
+            "fn middle_click_at_xy_inner(",
+            "fn right_click_at_xy_inner(",
+        ] {
+            let start = source.find(name).unwrap_or_else(|| panic!("{name} is gone"));
+            let body = &source[start..];
+            let end = body[1..].find("\nfn ").or_else(|| body[1..].find("\npub fn ")).unwrap_or(body.len() - 1);
+            let body = &body[..end];
+            let guard = body.find("system_menu::press_refusal(").unwrap_or_else(|| panic!("{name} never checks"));
+            for post in ["CGEvent::new", "post_to_pid", "SLEventPostToPid", ".post("] {
+                if let Some(at) = body.find(post) {
+                    assert!(guard < at, "{name} posts ({post}) before checking");
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn a_rect_contains_its_top_left_but_not_its_far_edges() {
+        let logo = [8.0, 0.0, 24.0, 24.0];
+        assert!(contains(logo, 8.0, 0.0));
+        assert!(contains(logo, 20.0, 12.0));
+        assert!(!contains(logo, 32.0, 12.0));
+        assert!(!contains(logo, 20.0, 24.0));
+    }
+}
diff --git a/libs/cua-driver/rust/crates/platform-macos/src/host_state.rs b/libs/cua-driver/rust/crates/platform-macos/src/host_state.rs
new file mode 100644
index 00000000..a9a2deb3
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/host_state.rs
@@ -0,0 +1,121 @@
+//! macOS adapter for `cua_driver_core::host_state`.
+//!
+//! - lock + console: `CGSessionCopyCurrentDictionary()`; the `CGSSessionScreenIsLocked`
+//!   key is present (true) only while the login window owns the screen, and
+//!   `kCGSSessionOnConsoleKey` is false when another user holds the console
+//!   (fast user switching). A null dictionary means no window-server session.
+//! - display sleep: every display in `CGGetActiveDisplayList` reports `CGDisplayIsAsleep`.
+//! - lid: `IOPMrootDomain`'s `AppleClamshellState` (absent on desktops: `None`).
+use cua_driver_core::host_state::HostState;
+use std::ffi::{c_char, c_void, CString};
+
+type CFTypeRef = *const c_void;
+type CFStringRef = *const c_void;
+type CFDictionaryRef = *const c_void;
+type IoObject = u32;
+
+#[link(name = "CoreFoundation", kind = "framework")]
+extern "C" {
+    fn CFRelease(cf: CFTypeRef);
+    fn CFDictionaryGetValue(dict: CFDictionaryRef, key: *const c_void) -> *const c_void;
+    fn CFBooleanGetValue(b: *const c_void) -> u8;
+    fn CFGetTypeID(cf: CFTypeRef) -> usize;
+    fn CFBooleanGetTypeID() -> usize;
+    fn CFStringCreateWithCString(alloc: *const c_void, s: *const c_char, encoding: u32) -> CFStringRef;
+}
+#[link(name = "CoreGraphics", kind = "framework")]
+extern "C" {
+    fn CGSessionCopyCurrentDictionary() -> CFDictionaryRef;
+    fn CGGetActiveDisplayList(max: u32, displays: *mut u32, count: *mut u32) -> i32;
+    fn CGDisplayIsAsleep(display: u32) -> u32;
+}
+#[link(name = "IOKit", kind = "framework")]
+extern "C" {
+    fn IOServiceMatching(name: *const c_char) -> *mut c_void;
+    fn IOServiceGetMatchingService(main_port: u32, matching: *mut c_void) -> IoObject;
+    fn IORegistryEntryCreateCFProperty(entry: IoObject, key: CFStringRef, alloc: *const c_void, options: u32) -> CFTypeRef;
+    fn IOObjectRelease(obj: IoObject) -> i32;
+}
+const K_CFSTRING_ENCODING_UTF8: u32 = 0x0800_0100;
+
+struct CfStr(CFStringRef);
+impl CfStr {
+    fn new(s: &str) -> Self { let c = CString::new(s).unwrap(); unsafe { CfStr(CFStringCreateWithCString(std::ptr::null(), c.as_ptr(), K_CFSTRING_ENCODING_UTF8)) } }
+}
+impl Drop for CfStr { fn drop(&mut self) { unsafe { CFRelease(self.0) } } }
+
+unsafe fn cf_bool(v: *const c_void) -> Option<bool> {
+    if v.is_null() || CFGetTypeID(v) != CFBooleanGetTypeID() { None } else { Some(CFBooleanGetValue(v) != 0) }
+}
+
+/// (screen_locked, on_console); `None`s when there is no window-server session.
+pub fn session_flags() -> (Option<bool>, Option<bool>) {
+    unsafe {
+        let dict = CGSessionCopyCurrentDictionary();
+        if dict.is_null() { return (None, None); }
+        let locked = cf_bool(CFDictionaryGetValue(dict, CfStr::new("CGSSessionScreenIsLocked").0));
+        let on_console = cf_bool(CFDictionaryGetValue(dict, CfStr::new("kCGSSessionOnConsoleKey").0));
+        CFRelease(dict);
+        // the lock key is only written while locked; absence means unlocked
+        (Some(locked.unwrap_or(false)), on_console)
+    }
+}
+
+/// (active display count, all asleep)
+pub fn displays() -> (Option<u32>, Option<bool>) {
+    unsafe {
+        let mut ids = [0u32; 16];
+        let mut count = 0u32;
+        if CGGetActiveDisplayList(ids.len() as u32, ids.as_mut_ptr(), &mut count) != 0 { return (None, None); }
+        // no display attached: nothing to observe (not "awake")
+        let asleep = (count > 0).then(|| ids[..count as usize].iter().all(|d| CGDisplayIsAsleep(*d) != 0));
+        (Some(count), asleep)
+    }
+}
+
+pub fn lid_closed() -> Option<bool> {
+    unsafe {
+        let name = CString::new("IOPMrootDomain").unwrap();
+        let service = IOServiceGetMatchingService(0, IOServiceMatching(name.as_ptr()));
+        if service == 0 { return None; }
+        let key = CfStr::new("AppleClamshellState");
+        let value = IORegistryEntryCreateCFProperty(service, key.0, std::ptr::null(), 0);
+        let closed = cf_bool(value);
+        if !value.is_null() { CFRelease(value); }
+        IOObjectRelease(service);
+        closed
+    }
+}
+
+pub fn probe() -> HostState {
+    let (screen_locked, on_console) = session_flags();
+    let (active_displays, display_asleep) = displays();
+    HostState {
+        screen_locked, on_console, display_asleep, lid_closed: lid_closed(), active_displays,
+        probe_error: (screen_locked.is_none()).then(|| "no window-server session (CGSessionCopyCurrentDictionary returned null)".to_owned()),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn probe_reports_a_coherent_shape_on_this_host() {
+        let s = probe();
+        // With a window-server session both session flags are observable together.
+        assert_eq!(s.screen_locked.is_some(), s.on_console.is_some(), "{s:?}");
+        assert_eq!(s.screen_locked.is_none(), s.probe_error.is_some());
+        if let Some(n) = s.active_displays { assert!(n <= 16); assert_eq!(s.display_asleep.is_some(), n > 0, "asleep is observable only with a display"); }
+        // a test host is not driven from behind a lock screen
+        if s.on_console == Some(true) { assert_eq!(s.screen_locked, Some(false)); }
+    }
+
+    #[test]
+    fn lid_matches_ioreg() {
+        let out = std::process::Command::new("/usr/sbin/ioreg").args(["-r", "-k", "AppleClamshellState", "-d", "4"]).output().unwrap();
+        let text = String::from_utf8_lossy(&out.stdout);
+        let expected = if text.contains("\"AppleClamshellState\" = Yes") { Some(true) } else if text.contains("\"AppleClamshellState\" = No") { Some(false) } else { None };
+        assert_eq!(lid_closed(), expected);
+    }
+}
diff --git a/libs/cua-driver/rust/crates/platform-macos/src/test_hooks.rs b/libs/cua-driver/rust/crates/platform-macos/src/test_hooks.rs
new file mode 100644
index 00000000..2b315217
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/test_hooks.rs
@@ -0,0 +1,34 @@
+//! Test-only interception of the calls that post input or change focus.
+//!
+//! Inside [`recording`], each hooked primitive (mouse clicks, WindowServer
+//! focus changes, app activation) appends its name to a per-thread log and
+//! returns without touching the system, so a unit test can run real dispatch
+//! code and assert exactly which primitives it would have used. Outside
+//! `recording` the primitives behave normally. Compiled only for tests.
+
+use std::cell::RefCell;
+
+thread_local! {
+    static CALLS: RefCell<Option<Vec<&'static str>>> = const { RefCell::new(None) };
+}
+
+/// Record `name` when this thread is recording. Returns `true` when the
+/// caller must return without doing the real work.
+pub(crate) fn intercept(name: &'static str) -> bool {
+    CALLS.with(|calls| match calls.borrow_mut().as_mut() {
+        Some(log) => {
+            log.push(name);
+            true
+        }
+        None => false,
+    })
+}
+
+/// Run `f` with the hooked primitives recording instead of acting, and return
+/// its result with the primitives it reached, in order.
+pub(crate) fn recording<R>(f: impl FnOnce() -> R) -> (R, Vec<&'static str>) {
+    CALLS.with(|calls| *calls.borrow_mut() = Some(Vec::new()));
+    let result = f();
+    let log = CALLS.with(|calls| calls.borrow_mut().take()).unwrap_or_default();
+    (result, log)
+}
diff --git a/libs/cua-driver/rust/crates/platform-macos/src/tools/select_text.rs b/libs/cua-driver/rust/crates/platform-macos/src/tools/select_text.rs
new file mode 100644
index 00000000..fb8dfd23
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/tools/select_text.rs
@@ -0,0 +1,275 @@
+//! select_text tool (spec 06) — select a run of text inside a field by matching
+//! its content, the WRITE half of the selection surface whose READER is
+//! `read_selection` in get_window_state. Codex's `selectText:{elementID, text,
+//! prefix, suffix, selection}` sets the field's `AXSelectedTextRange`; this is
+//! the Rust port of that one genuinely new AX rung.
+
+use async_trait::async_trait;
+use cua_driver_core::{
+    protocol::ToolResult,
+    tool::{Tool, ToolDef},
+};
+use serde_json::Value;
+use std::sync::Arc;
+
+use crate::ax::bindings::{copy_string_attr, focused_element_of_pid, kAXErrorSuccess, set_cfrange_attr, AXUIElementRef};
+
+use super::ToolState;
+
+pub struct SelectTextTool {
+    state: Arc<ToolState>,
+}
+
+impl SelectTextTool {
+    pub fn new(state: Arc<ToolState>) -> Self {
+        Self { state }
+    }
+}
+
+/// Locate `text` inside `field` and return its `(location, length)` in UTF-16
+/// code units — the units `AXSelectedTextRange` uses. When `prefix` is non-empty
+/// the match must be immediately preceded by it; when `suffix` is non-empty it
+/// must be immediately followed by it. The first occurrence satisfying both
+/// neighbours wins, so prefix/suffix disambiguate a repeated substring.
+pub(crate) fn find_utf16_range(
+    field: &str,
+    text: &str,
+    prefix: &str,
+    suffix: &str,
+) -> Option<(isize, isize)> {
+    if text.is_empty() {
+        return None;
+    }
+    let mut from = 0usize;
+    while let Some(rel) = field[from..].find(text) {
+        let start = from + rel;
+        let end = start + text.len();
+        let prefix_ok = prefix.is_empty() || field[..start].ends_with(prefix);
+        let suffix_ok = suffix.is_empty() || field[end..].starts_with(suffix);
+        if prefix_ok && suffix_ok {
+            let loc = field[..start].encode_utf16().count() as isize;
+            let len = text.encode_utf16().count() as isize;
+            return Some((loc, len));
+        }
+        // advance one byte past this start to find the next occurrence
+        from = match field[start..].char_indices().nth(1) {
+            Some((next, _)) => start + next,
+            None => break,
+        };
+    }
+    None
+}
+
+static DEF: std::sync::OnceLock<ToolDef> = std::sync::OnceLock::new();
+
+fn def() -> &'static ToolDef {
+    DEF.get_or_init(|| ToolDef {
+        name: "select_text".into(),
+        description:
+            "Select a run of text inside an editable/text element by matching its \
+             content (spec 06). Sets the element's AXSelectedTextRange to the range \
+             of `text`; pass `prefix` and/or `suffix` (the immediate neighbouring \
+             text) to disambiguate a repeated substring. Prefer this over pixel \
+             drag-selection: it works on backgrounded windows and never steals \
+             focus. Address the field by element_index/element_token, or omit \
+             both to select within the app's currently focused text element. \
+             Selection on rendered web content (WebKit/Chromium/Electron) \
+             may be echoed but not applied; native text views are reliable."
+                .into(),
+        input_schema: serde_json::json!({
+            "type": "object",
+            "required": ["pid", "text"],
+            "properties": {
+                "session": { "type": "string", "description": "Optional public session label; repeat it across calls." },
+                "pid": { "type": "integer" },
+                "window_id": {
+                    "type": "integer",
+                    "description": "CGWindowID whose get_window_state produced the element_index. Required with element_index; optional with element_token."
+                },
+                "element_index": cua_driver_core::tool_schema::element_index_schema(),
+                "element_token": cua_driver_core::tool_schema::element_token_schema(),
+                "snapshot_id": cua_driver_core::tool_schema::snapshot_id_schema(),
+                "text": { "type": "string", "description": "The substring to select within the element's text." },
+                "prefix": { "type": "string", "description": "Text that must immediately precede the match (disambiguates repeats)." },
+                "suffix": { "type": "string", "description": "Text that must immediately follow the match (disambiguates repeats)." }
+            },
+            "additionalProperties": false
+        }),
+        read_only: false,
+        destructive: false,
+        idempotent: true,
+        open_world: true,
+    })
+}
+
+#[async_trait]
+impl Tool for SelectTextTool {
+    fn def(&self) -> &ToolDef {
+        def()
+    }
+
+    async fn invoke(&self, args: Value) -> ToolResult {
+        use cua_driver_core::tool_args::ArgsExt;
+        let pid = match args.require_i32("pid") {
+            Ok(v) => v,
+            Err(e) => return e,
+        };
+        let text = match args.require_str("text") {
+            Ok(v) => v,
+            Err(e) => return e,
+        };
+        let prefix = args.opt_str("prefix").unwrap_or_default();
+        let suffix = args.opt_str("suffix").unwrap_or_default();
+
+        let element_token_arg = args.opt_str("element_token");
+        let window_id_arg = args.opt_u64("window_id").map(|v| v as u32);
+        let element_index_arg = args.opt_u64("element_index").map(|v| v as usize);
+        let resolved = match cua_driver_core::element_token::resolve_element_args(
+            pid,
+            element_index_arg,
+            element_token_arg.as_deref(),
+            args.opt_str("snapshot_id").as_deref(),
+            window_id_arg,
+            "select_text",
+        ) {
+            Ok(r) => r,
+            Err(e) => return e,
+        };
+        // Addressing: an explicit element (index/token) uses the retained-cache
+        // path with the full background-window gate; omitting both selects within
+        // the app's currently focused text element (mirrors read_selection), which
+        // is the common case for a plain text field whose AXTextArea the tree does
+        // not enumerate as its own actionable row.
+        let addressed: Option<(usize, u32)> = match resolved {
+            cua_driver_core::element_token::ResolvedElement::Element {
+                window_id: Some(wid),
+                element_index: idx,
+                via_token: _,
+            } => Some((idx, wid)),
+            cua_driver_core::element_token::ResolvedElement::Element { window_id: None, .. } => {
+                return ToolResult::error(
+                    "select_text requires window_id when element_index is used \
+                     (omit only when supplying element_token, which carries it).",
+                )
+            }
+            cua_driver_core::element_token::ResolvedElement::None => None,
+        };
+
+        let text_c = text.clone();
+        let prefix_c = prefix.clone();
+        let suffix_c = suffix.clone();
+
+        // Shared closure: read the element's text, find the run, set AXSelectedTextRange.
+        fn do_select(el: AXUIElementRef, text: &str, prefix: &str, suffix: &str) -> Result<(isize, isize), String> {
+            let field = unsafe { copy_string_attr(el, "AXValue") }
+                .filter(|s| !s.is_empty())
+                .or_else(|| unsafe { copy_string_attr(el, "AXSelectedText") })
+                .ok_or_else(|| "the element exposes no readable text (AXValue) to select within".to_string())?;
+            let (loc, len) = find_utf16_range(&field, text, prefix, suffix).ok_or_else(|| {
+                let ctx = if prefix.is_empty() && suffix.is_empty() {
+                    String::new()
+                } else {
+                    format!(" (with prefix {prefix:?} / suffix {suffix:?})")
+                };
+                format!("text {text:?}{ctx} not found in the element's value")
+            })?;
+            let err = unsafe { set_cfrange_attr(el, "AXSelectedTextRange", loc, len) };
+            if err != kAXErrorSuccess {
+                return Err(format!(
+                    "AXSelectedTextRange write returned AX error {err}; the element may not accept a text selection"
+                ));
+            }
+            Ok((loc, len))
+        }
+
+        let outcome = if let Some((element_index, window_id)) = addressed {
+            let element_guard = match self
+                .state
+                .element_cache
+                .resolve(pid, window_id, element_index, false).await
+            {
+                Ok(e) => e,
+                Err(error) => return error
+            };
+            let element_ptr = element_guard.as_ptr();
+            // re-prove the retained element still belongs to the requested window.
+            let _mutation_lease = match super::gate_background_window_action(
+                pid,
+                window_id,
+                Some(element_ptr),
+                cua_driver_core::background_input::BackgroundAction::AxSemantic,
+            )
+            .await
+            {
+                Ok(lease) => lease,
+                Err(refusal) => return refusal,
+            };
+            let ptr = element_ptr as usize;
+            tokio::task::spawn_blocking(move || do_select(ptr as AXUIElementRef, &text_c, &prefix_c, &suffix_c)).await
+        } else {
+            // focused-element fallback: resolve + act entirely inside the blocking
+            // task so the (non-cached) focused element pointer never crosses an await.
+            tokio::task::spawn_blocking(move || -> Result<(isize, isize), String> {
+                use core_foundation::base::CFRelease;
+                // focused_element_of_pid returns an owned ref we must release.
+                let el = unsafe { focused_element_of_pid(pid) }
+                    .ok_or_else(|| "no focused text element in this app; give element_index/element_token or focus a field".to_string())?;
+                let r = do_select(el, &text_c, &prefix_c, &suffix_c);
+                unsafe { CFRelease(el as _) };
+                r
+            })
+            .await
+        };
+
+        match outcome {
+            Ok(Ok((loc, len))) => ToolResult::text(format!(
+                "Selected {len} UTF-16 units at offset {loc}."
+            ))
+            .with_structured(serde_json::json!({
+                "selected": true,
+                "location": loc,
+                "length": len,
+                "text": text
+            })),
+            Ok(Err(msg)) => ToolResult::error(msg),
+            Err(join) => ToolResult::error(format!("select_text task error: {join}")),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::find_utf16_range;
+
+    #[test]
+    fn finds_plain_substring_in_utf16_units() {
+        // ASCII: byte offset == utf-16 offset
+        assert_eq!(find_utf16_range("hello world", "world", "", ""), Some((6, 5)));
+        assert_eq!(find_utf16_range("hello world", "hello", "", ""), Some((0, 5)));
+        assert_eq!(find_utf16_range("hello", "xyz", "", ""), None);
+        assert_eq!(find_utf16_range("hello", "", "", ""), None);
+    }
+
+    #[test]
+    fn prefix_and_suffix_disambiguate_a_repeated_substring() {
+        let field = "cat dog cat bird cat";
+        // three "cat"s: pick the one preceded by "dog "
+        assert_eq!(find_utf16_range(field, "cat", "dog ", ""), Some((8, 3)));
+        // pick the one followed by " bird"
+        assert_eq!(find_utf16_range(field, "cat", "", " bird"), Some((8, 3)));
+        // first occurrence with no anchors
+        assert_eq!(find_utf16_range(field, "cat", "", ""), Some((0, 3)));
+        // an anchor that never holds -> no match
+        assert_eq!(find_utf16_range(field, "cat", "fish ", ""), None);
+    }
+
+    #[test]
+    fn offsets_are_utf16_code_units_not_bytes_or_chars() {
+        // "😀" is 1 char, 4 UTF-8 bytes, 2 UTF-16 code units (a surrogate pair).
+        // "ab" after it must be located at UTF-16 offset 2, length 2.
+        let field = "😀ab";
+        assert_eq!(find_utf16_range(field, "ab", "", ""), Some((2, 2)));
+        // selecting the emoji itself is length 2 in UTF-16
+        assert_eq!(find_utf16_range(field, "😀", "", ""), Some((0, 2)));
+    }
+}
diff --git a/libs/cua-driver/rust/crates/platform-macos/src/tools/system_hotkey.rs b/libs/cua-driver/rust/crates/platform-macos/src/tools/system_hotkey.rs
new file mode 100644
index 00000000..287a2b85
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/tools/system_hotkey.rs
@@ -0,0 +1,447 @@
+//! Session-control shortcuts are the system's, not the target application's.
+//!
+//! macOS handles a few chords itself whatever app is in front: Lock Screen
+//! (Ctrl-Cmd-Q), Log Out (Shift-Cmd-Q, Opt-Shift-Cmd-Q), Force Quit
+//! (Opt-Cmd-Esc) and the power chords (Sleep, Restart, Shut Down on the power
+//! or eject key). They are the keyboard route to the Apple menu's session
+//! items, which `ax::system_menu` already keeps out of computer use, and a
+//! locked or logged-out session is one the driver cannot operate or give back
+//! (specs/11: only an unlocked desktop). `press_key` and `hotkey` refuse them
+//! in every delivery mode, before any focus change. Cmd-Q (quit the target)
+//! and other app shortcuts are unaffected.
+//!
+//! Ctrl-F2 ("Move focus to the menu bar", with or without Fn) and Ctrl-F8
+//! ("Move focus to the status menus") are refused with them: from the menu
+//! bar, arrow keys walk the Apple menu to Lock Screen. That is one route of
+//! several (a click on the Apple logo, a remapped shortcut), so the choosing
+//! input is refused too: Return, Enter and Space from `press_key` and
+//! `hotkey`, any `type_text`, and any `click`, `double_click`, `right_click`
+//! or `drag`, while the target's or the frontmost app's Apple menu is
+//! highlighted or open (`ax::system_menu`). That is checked before the tool
+//! runs, so before a foreground action fronts its window. Every mouse press is
+//! checked again as it is posted, in `input::mouse`, which also covers a press
+//! on the Apple logo itself.
+//!
+//! The daemon wraps these tools in a pid-only window-target guard, which lists
+//! the pid's windows before the tool runs. [`SessionChordGuard`] sits outside
+//! that guard, so a session chord is refused before any target resolution and
+//! a pid with no window gets the same refusal as one with a window.
+
+use async_trait::async_trait;
+use cua_driver_core::protocol::ToolResult;
+use cua_driver_core::tool::{ProtectedResourceOwnership, Tool, ToolDef};
+use serde_json::Value;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Mod {
+    Cmd,
+    Ctrl,
+    Opt,
+    Shift,
+}
+
+fn modifier(token: &str) -> Option<Option<Mod>> {
+    Some(Some(match token {
+        "cmd" | "command" | "meta" | "super" => Mod::Cmd,
+        "ctrl" | "control" => Mod::Ctrl,
+        "opt" | "option" | "alt" => Mod::Opt,
+        "shift" => Mod::Shift,
+        // fn does not change which system chord this is.
+        "fn" | "function" => return Some(None),
+        _ => return None,
+    }))
+}
+
+/// The system action a chord performs, if it is a session-control chord.
+/// `tokens` are key names in any order and case; `+`-joined tokens are split.
+pub(crate) fn session_control_action(tokens: &[String]) -> Option<&'static str> {
+    let mut mods: Vec<Mod> = Vec::new();
+    let mut keys: Vec<String> = Vec::new();
+    for token in tokens.iter().flat_map(|t| t.split('+')) {
+        let token = token.trim().to_ascii_lowercase();
+        if token.is_empty() {
+            continue;
+        }
+        match modifier(&token) {
+            Some(Some(m)) => {
+                if !mods.contains(&m) {
+                    mods.push(m);
+                }
+            }
+            Some(None) => {}
+            None => keys.push(token),
+        }
+    }
+    let has = |m: Mod| mods.contains(&m);
+    let only = |set: &[Mod]| mods.len() == set.len() && set.iter().all(|m| has(*m));
+    let key = keys.last()?.as_str();
+    match key {
+        "power" | "eject" | "media_eject" => Some("sleep, restart or shut down"),
+        "q" if only(&[Mod::Ctrl, Mod::Cmd]) => Some("Lock Screen"),
+        "q" if only(&[Mod::Shift, Mod::Cmd]) || only(&[Mod::Opt, Mod::Shift, Mod::Cmd]) => {
+            Some("Log Out")
+        }
+        "escape" | "esc"
+            if only(&[Mod::Opt, Mod::Cmd]) || only(&[Mod::Opt, Mod::Shift, Mod::Cmd]) =>
+        {
+            Some("Force Quit")
+        }
+        "f2" if only(&[Mod::Ctrl]) => Some("Move focus to the menu bar (the Apple menu's session items)"),
+        "f8" if only(&[Mod::Ctrl]) => Some("Move focus to the status menus"),
+        _ => None,
+    }
+}
+
+/// Whether a key chooses the highlighted item of an open menu.
+fn chooses_menu_item(key: &str) -> bool {
+    key == " " || matches!(key.trim().to_ascii_lowercase().as_str(), "return" | "enter" | "space" | "kp_enter" | "keypad_enter")
+}
+
+/// The non-modifier keys of a `press_key` or `hotkey` call.
+fn keys_of(tool: &str, args: &Value) -> Vec<String> {
+    let tokens: Vec<String> = match tool {
+        "press_key" => args.get("key").and_then(Value::as_str).map(str::to_owned).into_iter().collect(),
+        _ => args
+            .get("keys")
+            .and_then(Value::as_array)
+            .map(|a| a.iter().filter_map(Value::as_str).map(str::to_owned).collect())
+            .unwrap_or_default(),
+    };
+    tokens
+        .iter()
+        .flat_map(|t| t.split('+').map(str::to_owned).collect::<Vec<_>>())
+        .filter(|t| modifier(&t.trim().to_ascii_lowercase()).is_none())
+        .collect()
+}
+
+/// Whether this call is input that could choose an item of an open Apple
+/// menu, so the menu's state must be read before it is posted.
+pub(crate) fn could_choose_menu_item(tool: &str, args: &Value) -> bool {
+    match tool {
+        "type_text" => args.get("text").and_then(Value::as_str).is_some_and(|t| !t.is_empty()),
+        "click" | "double_click" | "right_click" | "drag" => true,
+        _ => keys_of(tool, args).iter().any(|k| chooses_menu_item(k)),
+    }
+}
+
+/// The refusal for input posted while the Apple menu of `pid` (the target) or
+/// of the frontmost app is highlighted or open. Blocking: reads their menu bars.
+pub(crate) fn system_menu_refusal(tool: &str, args: &Value) -> Option<ToolResult> {
+    if !could_choose_menu_item(tool, args) {
+        return None;
+    }
+    let pid = args.get("pid").and_then(Value::as_i64).map(|p| p as i32).unwrap_or(0);
+    let (_, title) = crate::ax::system_menu::engaged_in([pid, crate::apps::frontmost_pid().unwrap_or(0)])?;
+    let message = crate::ax::system_menu::refusal_message(tool, &title);
+    Some(
+        ToolResult::error(format!("refused (system_menu_refused): {message}")).with_structured(serde_json::json!({
+            "status": "refused",
+            "refusal": { "code": "system_menu_refused", "message": message, "highlighted": title }
+        })),
+    )
+}
+
+/// The refusal for a `press_key` (`key` + `modifiers`) or `hotkey` (`keys`)
+/// call whose chord is a session-control shortcut.
+pub(crate) fn refusal(tool: &str, args: &Value) -> Option<ToolResult> {
+    let strings = |value: Option<&Value>| -> Vec<String> {
+        value
+            .and_then(Value::as_array)
+            .map(|a| a.iter().filter_map(Value::as_str).map(str::to_owned).collect())
+            .unwrap_or_default()
+    };
+    let tokens: Vec<String> = match tool {
+        "press_key" => {
+            let mut tokens = strings(args.get("modifiers"));
+            tokens.extend(args.get("key").and_then(Value::as_str).map(str::to_owned));
+            tokens
+        }
+        _ => strings(args.get("keys")),
+    };
+    let action = session_control_action(&tokens)?;
+    let message = format!(
+        "{tool}: this shortcut is macOS {action}, which acts on the whole session, \
+         and is not available to computer use"
+    );
+    Some(
+        ToolResult::error(message.clone()).with_structured(serde_json::json!({
+            "status": "refused",
+            "refusal": { "code": "system_hotkey_refused", "message": message }
+        })),
+    )
+}
+
+/// Refuses a session chord before the wrapped tool, including any target
+/// resolution it wraps, sees the call.
+pub(crate) struct SessionChordGuard {
+    tool: &'static str,
+    inner: Box<dyn Tool>,
+}
+
+impl SessionChordGuard {
+    pub(crate) fn new(tool: &'static str, inner: Box<dyn Tool>) -> Self {
+        Self { tool, inner }
+    }
+}
+
+#[async_trait]
+impl Tool for SessionChordGuard {
+    fn def(&self) -> &ToolDef {
+        self.inner.def()
+    }
+
+    fn has_independent_input_lane(&self, args: &Value) -> bool {
+        self.inner.has_independent_input_lane(args)
+    }
+
+    async fn protected_resource_ownership(
+        &self,
+        adapter_id: &str,
+        args: &Value,
+    ) -> ProtectedResourceOwnership {
+        self.inner.protected_resource_ownership(adapter_id, args).await
+    }
+
+    async fn protected_resource_scope(
+        &self,
+        adapter_id: &str,
+        args: &Value,
+    ) -> Result<Option<Value>, String> {
+        self.inner.protected_resource_scope(adapter_id, args).await
+    }
+
+    async fn validate_protected_resource_scope(
+        &self,
+        adapter_id: &str,
+        args: &Value,
+        approved_scope: &Value,
+    ) -> Result<(), String> {
+        self.inner
+            .validate_protected_resource_scope(adapter_id, args, approved_scope)
+            .await
+    }
+
+    async fn invoke(&self, args: Value) -> ToolResult {
+        if matches!(self.tool, "press_key" | "hotkey") {
+            if let Some(refused) = refusal(self.tool, &args) {
+                return refused;
+            }
+        }
+        if could_choose_menu_item(self.tool, &args) {
+            let (tool, probe) = (self.tool, args.clone());
+            match tokio::task::spawn_blocking(move || system_menu_refusal(tool, &probe)).await {
+                Ok(Some(refused)) => return refused,
+                Ok(None) => {}
+                Err(e) => return ToolResult::error(format!("{tool}: Apple menu check failed: {e}. Not posting.")),
+            }
+        }
+        self.inner.invoke(args).await
+    }
+}
+
+#[cfg(test)]
