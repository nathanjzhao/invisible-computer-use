+// ── Popup surfaces ───────────────────────────────────────────────────────────
+
+/// An open GTK3 context menu is `screenshots[1]` at the X server's geometry,
+/// another process's popup over the same window is not, and no menu item
+/// gets a token. Red under `popupoff` (no surfaces) and `popupanypid` (the
+/// foreign popup is included).
+#[test]
+#[ignore]
+fn harness_gtk3_popup_surface_capture() {
+    let case = native_readonly_case(
+        "gtk3",
+        "popup_surface_capture",
+        Targeting::Ax,
+        DriverRoute::WindowState,
+        vec![OracleKind::AxState, OracleKind::SurfaceGeometry],
+    );
+    run_case(case, |pid, window_id, driver| {
+        let window = linux_x11::window_rect(window_id).expect("harness window geometry");
+        let foreign = Receiver::spawn(
+            driver,
+            &format!("foreign-popup:{}:{}", window.x + 40, window.y + 420),
+            &[],
+            &[],
+        );
+        let state = snapshot(driver, pid, window_id);
+        let (x, y, width, height) = element_rect(driver, pid, window_id, &state, "btn-context");
+        let opened = driver.call(
+            "right_click",
+            serde_json::json!({
+                "pid": pid as i64, "window_id": window_id,
+                "x": x + width / 2.0, "y": y + height / 2.0,
+                "delivery_mode": "foreground"
+            }),
+        );
+        assert!(!opened.is_error(), "could not open the context menu: {}", opened.text());
+        let mut menu = None;
+        wait_until("the GTK3 menu to map", Duration::from_secs(5), || {
+            menu = linux_x11::override_redirect_windows()
+                .unwrap_or_default()
+                .into_iter()
+                .find(|(_, owner, rect)| *owner == Some(pid) && rect.width > 20 && rect.height > 20);
+            menu.is_some()
+        });
+        let (menu_xid, _, menu_rect) = menu.unwrap();
+        let foreign_xid = linux_x11::override_redirect_windows()
+            .unwrap_or_default()
+            .into_iter()
+            .find(|(_, owner, _)| *owner == Some(foreign.pid))
+            .map(|(xid, _, _)| xid)
+            .expect("the foreign popup is mapped");
+
+        let state = driver.call(
+            "get_window_state",
+            serde_json::json!({ "pid": pid as i64, "window_id": window_id, "include_screenshot": true }),
+        );
+        assert!(!state.is_error(), "window state with a menu open failed: {}", state.text());
+        let surfaces = state.structured()["screenshots"]
+            .as_array()
+            .cloned()
+            .unwrap_or_else(|| panic!("no screenshots[] with a menu open: {}", state.structured()));
+        let surface = surfaces
+            .iter()
+            .find(|surface| surface["window_id"].as_u64() == Some(menu_xid))
+            .unwrap_or_else(|| panic!("menu {menu_xid} is not a surface: {surfaces:?}"));
+        assert_eq!(surface["zIndex"].as_u64(), Some(1), "menu surface: {surface}");
+        assert_eq!(
+            (
+                surface["originX"].as_i64(),
+                surface["originY"].as_i64(),
+                surface["width"].as_u64(),
+                surface["height"].as_u64()
+            ),
+            (
+                Some(i64::from(menu_rect.x)),
+                Some(i64::from(menu_rect.y)),
+                Some(u64::from(menu_rect.width)),
+                Some(u64::from(menu_rect.height))
+            ),
+            "menu surface geometry differs from the X server's"
+        );
+        assert!(
+            surfaces
+                .iter()
+                .all(|surface| surface["window_id"].as_u64() != Some(foreign_xid)),
+            "another process's popup was returned as a surface of this window: {surfaces:?}"
+        );
+        let item_tokens = state.structured()["elements"]
+            .as_array()
+            .map(|elements| {
+                elements
+                    .iter()
+                    .filter(|element| {
+                        matches!(element["label"].as_str(), Some("Cut" | "Copy" | "Paste"))
+                            && element["element_token"].is_string()
+                    })
+                    .count()
+            })
+            .unwrap_or(0);
+        assert_eq!(item_tokens, 0, "menu items received element tokens");
+        let _ = driver.call(
+            "press_key",
+            serde_json::json!({ "pid": pid as i64, "window_id": window_id, "key": "escape", "delivery_mode": "foreground" }),
+        );
+        Observation::delivered(
+            vec![OracleKind::AxState, OracleKind::SurfaceGeometry],
+            Evidence::default(),
+        )
+    });
+}
