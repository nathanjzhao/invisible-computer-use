+                return SemanticAttempt::NotAttempted;
+            }
+            dispatches.push(action);
+            SemanticAttempt::dispatched(action, Ok::<_, &str>(()))
+        });
+        assert_eq!(dispatches, [SemanticAction::Toggle]);
+        assert!(matches!(
+            result,
+            SemanticAttempt::Completed(SemanticAction::Toggle)
+        ));
+    }
+
+    #[test]
+    fn no_supported_pattern_is_the_only_empty_sequence_outcome() {
+        let result = choose_action(&SemanticAction::CLICK_ORDER, |_| {
