+/// Prepare feedback before starting the actuator, and await the actuator's real
+/// result. The closure is lazy: constructing spawn_blocking before this call
+/// would start input early in attached mode.
+pub async fn run_action_after_feedback<P, A, F>(feedback: P, action: A) -> F::Output
+where P: std::future::Future<Output = ()>, A: FnOnce() -> F, F: std::future::Future {
+    feedback.await;
+    action().await
+}
+
+/// Indexed right/double-click feedback, including successful AXShowMenu/AXOpen
+/// early returns. The invoking tool retains the AX element until this completes.
+pub async fn animate_cursor_at_element(registry: &super::state::CursorRegistry, key: CursorKey, wid: u32, element_ptr: usize) {
+    let center = tokio::task::spawn_blocking(move || unsafe {
+        crate::ax::bindings::element_screen_center(element_ptr as crate::ax::bindings::AXUIElementRef)
+    }).await.ok().flatten();
+    if let Some((x, y)) = center {
+        send_command(key.clone(), OverlayCommand::PinAbove(wid as u64));
+        animate_cursor_for_action(registry, key.clone(), x, y).await;
+        registry.update_position(&key, x, y);
+    }
+}
