+/// Opt-in: one process owns a toplevel (moved to workspace 2) and an overlay
+/// layer surface over the native window, which grim shows in the window's
+/// rect. The capture is refused for sway's reason and readiness agrees.
+/// Round-2 review B1 and O2: red on the
+/// `fix/audit-backlog` driver at f40d24c (a frame with the overlay's pixels,
+/// and readiness `compositor_attested_output_crop`).
+#[test]
+#[ignore]
+fn harness_sway_layer_overlay_from_windowed_client_capture() {
+    let case = wayland_case(
+        "linux-sway-layer-overlay-windowed-client-capture-ax-not-applicable",
+        "layer_overlay_windowed_client_capture",
+        DriverRoute::WindowState,
+        vec![OracleKind::AxState, OracleKind::TypedRefusal, OracleKind::Pixels, OracleKind::ReadinessAgrees],
+    )
+    .expecting_refusal(vec![RefusalCode::SurfaceIdentityUnproven]);
+    run_nested(case, Nested::sway, |sway, recorder| {
+        let wl = Receiver::spawn(recorder, "wayland:WL", &sway.client_env(), &["DISPLAY"]);
+        let mut driver = sway.driver(true);
+        let mut window = None;
+        wait_until("the native window to be listed", Duration::from_secs(10), || {
+            window = wl_window(&mut driver, wl.pid);
+            window.is_some()
+        });
+        let window = window.unwrap();
+        let dir = tempfile::tempdir().unwrap();
+        let (x, y, w, h) = sway.container_rect(wl.pid);
+        let mode = format!("layer-overlay:{}:{}:{}:{}", x + w / 4, y + h / 4, w / 2, h / 2);
+        let owner = Receiver::spawn(recorder, &mode, &sway.client_env(), &["DISPLAY"]);
+        sway.swaymsg(&[&format!("[pid={}] move container to workspace 2", owner.pid)])
+            .expect("move the owner's toplevel away");
+        std::thread::sleep(Duration::from_millis(1500));
+        let grim_png = dir.path().join("grim.png");
+        sway.grim((x, y, w, h), &grim_png);
+        let magenta = image::open(&grim_png)
+            .unwrap()
+            .to_rgb8()
+            .pixels()
+            .filter(|p| p[0] > 240 && p[1] < 20 && p[2] > 240)
+            .count();
+        assert!(magenta > 1000, "the overlay is not over the window ({magenta} magenta px)");
+        assert_sway_capture_refused(&mut driver, wl.pid, window, &dir.path().join("after.png"), "under the overlay");
+        sway_readiness_refuses_window_capture(&mut driver);
+        Observation::refused(
+            RefusalCode::SurfaceIdentityUnproven,
+            vec![OracleKind::AxState, OracleKind::TypedRefusal, OracleKind::Pixels, OracleKind::ReadinessAgrees],
+            format!("overlay from a client with a toplevel ({magenta} px in the window rect) refused; readiness agrees"),
+            Evidence::default(),
+        )
