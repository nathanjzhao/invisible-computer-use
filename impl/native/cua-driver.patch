+/// A minimized window has no on-screen pixels, so a screenshot point cannot
+/// name a target in it. Without this check the pixel route's accessibility
+/// hit test was measured invoking a stale control in a minimized window.
+fn minimized_pixel_refusal(hwnd: u64, px: f64, py: f64) -> Option<ToolResult> {
+    crate::input::window_is_iconic(hwnd).then(|| {
+        let message = format!(
+            "window 0x{hwnd:x} is minimized, so screenshot pixel ({px}, {py}) does not \
+             identify an on-screen target. Call bring_to_front with this window_id, \
+             then re-snapshot with get_window_state before retrying."
+        );
+        ToolResult::error(format!("refused (window_minimized): {message}")).with_structured(json!({
+            "status": "refused",
+            "code": "window_minimized",
+            "effect": "refused",
+            "refusal": {
+                "code": "window_minimized",
+                "message": message,
+            }
+        }))
+    })
+}
+
+fn stale_frame_refusal(hwnd: u64, message: String) -> ToolResult {
+    ToolResult::error(format!("refused (stale_capture): {message}")).with_structured(json!({
+        "status": "refused",
+        "code": "stale_capture",
+        "effect": "refused",
+        "refusal": {
+            "code": "stale_capture",
+            "message": message,
+            "window_id": hwnd,
+        }
+    }))
+}
+
+/// A malformed or misdirected `screenshot_id`, shaped like every other
+/// refusal here so a consumer reading `effect` sees that nothing happened.
+fn invalid_screenshot_id(message: String) -> ToolResult {
+    ToolResult::error(format!("refused (invalid_arguments): {message}")).with_structured(json!({
+        "status": "refused",
+        "code": "invalid_arguments",
+        "effect": "refused",
+        "refusal": { "code": "invalid_arguments", "message": message }
+    }))
+}
+
+/// Check a pixel target before any input. A minimized window has no pixels.
+/// With `screenshot_id` the pixel must come from that capture of this window,
+/// taken at the window's current size. Returns the frame whose ratio scales
+/// the pixel. See [`pixel_frame_for`] for a pixel without an id.
+fn pixel_frame(
+    args: &Value,
+    hwnd: u64,
+    px: f64,
+    py: f64,
+) -> Result<Option<crate::capture::CapturedFrame>, ToolResult> {
+    pixel_frame_for(args, args.get("screenshot_id"), "screenshot_id", hwnd, px, py)
+}
+
+/// [`pixel_frame`] for the id in `field` (`drag` binds each endpoint).
+///
+/// Without an id, the pixel is read against the calling session's own latest
+/// finished capture of this window, and nothing else
+/// (`cua_driver_core::capture_log`, review C9): any consumer can capture the
+/// window (the app's live tile polls it at another size), and only the
+/// caller's own capture is the one its pixel came from. A capture counts once
+/// it is returned, with its downscale known (round 3 W8). The session having
+/// no capture of the window refuses `ambiguous_capture`; a window replaced at
+/// the handle (W11) or resized since that capture refuses `stale_capture`.
+fn pixel_frame_for(
+    args: &Value,
+    id: Option<&Value>,
+    field: &str,
+    hwnd: u64,
+    px: f64,
+    py: f64,
+) -> Result<Option<crate::capture::CapturedFrame>, ToolResult> {
+    if let Some(refusal) = minimized_pixel_refusal(hwnd, px, py) {
+        return Err(refusal);
+    }
+    // A `from_zoom` pixel is read through this session's own zoom of this
+    // window whatever id comes with it (review final C9 zoom items).
+    let from_zoom = args.get("from_zoom").and_then(Value::as_bool) == Some(true);
+    let Some(id) = id.filter(|v| !v.is_null() && !from_zoom) else {
+        let binding = cua_driver_core::capture_log::PixelBinding::resolve_unbound(
+            args,
+            crate::capture::UNBOUND_PID,
+            hwnd,
+        )?;
+        let Some(frame) = binding.frame().copied() else {
+            // a point the driver computed itself (an element's focus click)
+            return Ok(None);
+        };
+        binding.verify_identity(|| crate::capture::current_identity_mark(hwnd))?;
+        binding.verify(crate::capture::window_rect_size(hwnd).map(|(w, h)| {
+            cua_driver_core::capture_log::CurrentGeometry { size: (f64::from(w), f64::from(h)), scale: None }
+        }))?;
+        return Ok(Some(crate::capture::CapturedFrame {
+            id: frame.id,
+            hwnd,
+            identity: None,
+            size: (frame.size.0 as i32, frame.size.1 as i32),
+            ratio: frame.ratio,
+        }));
+    };
+    let Some(id) = id.as_str() else {
+        return Err(invalid_screenshot_id(format!(
+            "{field} must be a string from get_window_state."
+        )));
+    };
+    let Some(frame) = crate::capture::captured_frame(id) else {
+        return Err(stale_frame_refusal(
+            hwnd,
+            format!(
+                "{field} {id} is not a capture this driver still holds, so its pixels \
+                 cannot be checked against the window. Re-snapshot with get_window_state and \
+                 pass the new screenshot_id."
+            ),
+        ));
+    };
+    if frame.hwnd != hwnd {
+        return Err(invalid_screenshot_id(format!(
+            "{field} {id} is a capture of window 0x{:x}, not 0x{hwnd:x}.",
+            frame.hwnd
+        )));
+    }
+    if !crate::capture::same_window(&frame) {
+        return Err(stale_frame_refusal(
+            hwnd,
+            format!(
+                "handle 0x{hwnd:x} names another window than the one in screenshot {id} \
+                 (that window was closed and the handle reused). Re-snapshot with \
+                 get_window_state before retrying."
+            ),
+        ));
+    }
+    if let Some(((cw, ch), (w, h))) = crate::capture::size_changed_since_frame(&frame) {
+        return Err(stale_frame_refusal(
+            hwnd,
+            format!(
+                "window 0x{hwnd:x} is {w}x{h} now but was {cw}x{ch} in screenshot {id}, so \
+                 that screenshot's pixels no longer name the same place. Re-snapshot with \
+                 get_window_state before retrying."
+            ),
+        ));
+    }
+    Ok(Some(frame))
+}
+
+/// Schema for a pixel action's `screenshot_id`.
+fn screenshot_id_schema() -> Value {
+    json!({
+        "type": "string",
+        "description": "screenshot_id from the get_window_state whose screenshot x/y were read from. Binds the pixel to that capture: the action is refused with stale_capture if the window changed size or was replaced since, and the pixel is scaled by that capture's own downscale ratio. Without it, this session's own latest capture of the window is used, and the action is refused with ambiguous_capture if this session has none."
+    })
+}
+
+/// Screenshot-to-window pixel ratio: the frame's own (bound, or the session's
+/// capture). Without one (a point the driver computed from the tree) the
+/// point is already in window pixels; no other caller's capture scales it.
+fn pixel_ratio(
+    frame: Option<&crate::capture::CapturedFrame>,
+    _state: &ToolState,
+    _pid: u32,
+    _hwnd: u64,
+) -> Option<f64> {
+    frame.and_then(|frame| frame.ratio)
+}
+
+/// This session's own zoom of `hwnd`, for a `from_zoom` pixel already checked
+/// by [`pixel_frame`] (which refuses when there is none, or when the window
+/// was resized or replaced since the zoom).
+fn session_zoom(args: &Value, hwnd: u64) -> Option<cua_driver_core::capture_log::ZoomCrop> {
+    cua_driver_core::capture_log::PixelBinding::resolve_unbound(args, crate::capture::UNBOUND_PID, hwnd)
+        .ok()?
+        .zoom()
+}
+
+/// A window-local screenshot point checked by [`pixel_frame`] and scaled by
+/// its frame's ratio, as window pixels. For a tool with no `from_zoom`.
+fn bound_pixel(args: &Value, state: &ToolState, pid: u32, hwnd: u64, x: f64, y: f64) -> Result<(f64, f64), ToolResult> {
+    if args.get("from_zoom").and_then(Value::as_bool) == Some(true) {
+        return Err(invalid_screenshot_id("from_zoom is not supported by this tool.".to_owned()));
+    }
+    let frame = pixel_frame(args, hwnd, x, y)?;
+    let ratio = pixel_ratio(frame.as_ref(), state, pid, hwnd).unwrap_or(1.0);
+    Ok((x * ratio, y * ratio))
+}
+
+/// A posted-input error. A point the driver could not map to a truthful client
+/// point of the target is a typed `point_unmapped` refusal, not a failure of
+/// unknown cause.
+fn post_error_result(error: anyhow::Error) -> ToolResult {
+    post_error_result_as(error, crate::input::delivery::EventKind::MouseClick)
+}
+
+/// [`post_error_result`] for a gesture of `kind`. A target known to drop the
+/// posted messages is a `background_unavailable` refusal.
+fn post_error_result_as(error: anyhow::Error, kind: crate::input::delivery::EventKind) -> ToolResult {
+    if let Some(dropped) = error.downcast_ref::<crate::input::mouse::DroppedTarget>() {
+        return crate::input::delivery::background_unavailable_error_with_cause(
+            dropped.hwnd,
+            kind,
+            dropped.cause.clone(),
+        );
+    }
+    match error.downcast_ref::<crate::input::mouse::UnmappedPoint>() {
+        Some(unmapped) => {
+            let message = format!(
+                "{unmapped}. Nothing was posted. Re-snapshot with get_window_state; if the \
+                 target is still there, use its element_token."
+            );
+            ToolResult::error(format!("refused (point_unmapped): {message}")).with_structured(
+                json!({
+                    "status": "refused",
+                    "code": "point_unmapped",
+                    "effect": "refused",
+                    "refusal": { "code": "point_unmapped", "message": message }
+                }),
+            )
+        }
+        None => ToolResult::error(error.to_string()),
+    }
+}
+
+/// Structured route for a message posted to one window. Without it the
+/// action record falls back to `global_input` with an unknown delivery mode,
+/// which is what these replies used to say.
+fn posted_route() -> Value {
+    json!({
+        "path": "post_message",
+        "delivery_mode": "background",
+        "verified": false,
+        "effect": "unverifiable"
+    })
+}
