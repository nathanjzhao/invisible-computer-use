+#[cfg(test)]
+#[test]
+fn get_window_state_records_a_finished_frame_for_its_session() {
+    let source = include_str!("impl_.rs");
+    let body = source.split_once("fn pixel_binding(args: &Value, pid: u32, xid: u64)").unwrap().1;
+    let body = &body[..body.find("\n}\n").unwrap()];
+    assert!(body.contains("binding.verify_identity(") && body.contains("binding.verify(current_window_geometry(xid))"));
+    for gone in [concat!("fn window_scale", "_record("), concat!("fn unbound_pixel", "_ambiguity("), concat!("fn record_frame", "_generation(")] {
+        assert!(!source.contains(gone), "{gone} is back");
+    }
+    let ratio = source.find("let ratio = orig_w.filter(|_| w > 0)").unwrap();
+    let marked = source[ratio..].find("crate::x11::window_generation(xid, true)").unwrap() + ratio;
+    let recorded = source[ratio..].find(concat!("record_capture(capture_session.clone(), ", "pid, xid, size.size, ratio, identity)")).unwrap() + ratio;
+    assert!(marked < recorded);
+    // windows-final C6: the session is taken before the capture starts
+    let gws = &source[source.find(concat!("impl Tool for ", "GetWindowStateTool")).unwrap()..];
+    let begun = gws.find(concat!("CaptureSession::", "begin(&args)")).unwrap();
+    let captured = gws.find(concat!("screenshot_dispatch_with_pid", "(xid, pid)")).unwrap();
+    assert!(begun < captured, "the session is taken before the capture");
+}
