+        assert_eq!(forest_from_nodes(&empty)[0].value.as_deref(), Some(""));
+        let key = fresh_key();
+        let initial = step(key, &[node(Some(1), None, "Edit", "Draft", None)], "fixture", false, Baseline::Previous);
+        let next = step(key, &empty, "fixture", false, Baseline::Previous);
+        assert_eq!(next.kind, "diff");
