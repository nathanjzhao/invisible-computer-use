+#[cfg(test)]
+mod input_window_tests {
+    use super::input_window_at;
+    use windows::core::{w, PCWSTR};
+    use windows::Win32::Foundation::{HINSTANCE, HWND, POINT, RECT};
+    use windows::Win32::Graphics::Gdi::{CreateEllipticRgn, SetWindowRgn};
+    use windows::Win32::UI::WindowsAndMessaging::{
+        CreateWindowExW, DestroyWindow, GetWindowRect, IsWindowVisible, SetWindowPos, ShowWindow,
+        HMENU, HWND_TOP, SWP_NOACTIVATE, SWP_NOMOVE, SWP_NOSIZE, SW_SHOWNOACTIVATE,
+        WINDOW_EX_STYLE, WINDOW_STYLE, WS_CHILD, WS_EX_TRANSPARENT, WS_POPUP, WS_VISIBLE,
+    };
+
+    // Values from winuser.h. A STATIC without SS_NOTIFY answers WM_NCHITTEST
+    // with HTTRANSPARENT, one with SS_NOTIFY does not; a group box always does.
+    const SS_NOTIFY: u32 = 0x0100;
+    const BS_GROUPBOX: u32 = 0x0007;
+
+    fn create(class: PCWSTR, ex: WINDOW_EX_STYLE, style: u32, rect: (i32, i32, i32, i32), parent: HWND) -> HWND {
+        let (x, y, w, h) = rect;
+        let kind = if parent.0.is_null() { WS_POPUP } else { WS_CHILD };
+        unsafe {
+            CreateWindowExW(ex, class, w!(""), kind | WS_VISIBLE | WINDOW_STYLE(style), x, y, w, h, parent, HMENU::default(), HINSTANCE::default(), None)
+        }
+        .expect("create window")
+    }
+
+    fn centre(window: HWND) -> POINT {
+        let mut r = RECT::default();
+        unsafe { GetWindowRect(window, &mut r) }.unwrap();
+        POINT { x: (r.left + r.right) / 2, y: (r.top + r.bottom) / 2 }
+    }
+
+    fn raise(window: HWND) {
+        unsafe { SetWindowPos(window, HWND_TOP, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE) }.unwrap();
+    }
+
+    // These tests build real windows and read IsWindowVisible. Session 0 (SSM, a service, a
+    // scheduled task of SYSTEM) has no desktop, so nothing there is ever visible and they fail
+    // for the host, not the code. They skip with a message there; ICU_REQUIRE_INTERACTIVE_DESKTOP=1
+    // makes the skip a failure (for a run that is meant to be interactive). Any other session
+    // runs them, so a real failure in an interactive session is never hidden.
+    fn desktop_is_interactive(session: Option<u32>) -> bool {
+        session != Some(0)
+    }
+
+    fn skip_without_desktop(test: &str) -> bool {
+        if desktop_is_interactive(crate::diagnostics::current_session_id()) {
+            return false;
+        }
+        let message = format!("{test}: no interactive desktop in session 0 (run it in a logged-on session)");
+        assert!(std::env::var_os("ICU_REQUIRE_INTERACTIVE_DESKTOP").is_none(), "{message}");
+        eprintln!("SKIPPED {message}");
+        true
+    }
+
+    #[test]
+    fn only_session_zero_has_no_desktop() {
+        assert!(!desktop_is_interactive(Some(0)));
+        assert!(desktop_is_interactive(Some(1)));
+        assert!(desktop_is_interactive(Some(2)));
+        // An unreadable session is run, not skipped.
+        assert!(desktop_is_interactive(None));
+    }
+
+    #[test]
+    fn real_input_rules_for_group_boxes_transparent_children_and_regions() {
+        if skip_without_desktop("real_input_rules_for_group_boxes_transparent_children_and_regions") { return; }
+        let none = WINDOW_EX_STYLE(0);
+        let root = create(w!("STATIC"), none, 0, (140, 140, 400, 300), HWND::default());
+        // A process started hidden (a scheduled task) applies its startup
+        // SW_HIDE to its first top-level window, and the walk skips hidden
+        // windows; the second ShowWindow is honoured.
+        for _ in 0..2 {
+            let _ = unsafe { ShowWindow(root, SW_SHOWNOACTIVATE) };
+        }
+        assert!(unsafe { IsWindowVisible(root) }.as_bool());
+        let cell = create(w!("STATIC"), none, SS_NOTIFY, (10, 10, 100, 60), root);
+        // Created after the cell and raised above it, enclosing it, as a
+        // dialog template that lists the group box first produces.
+        let group = create(w!("BUTTON"), none, BS_GROUPBOX, (3, 3, 150, 100), root);
+        raise(group);
+        assert_eq!(input_window_at(root, centre(cell)), cell);
+
+        // A static label passes input to the window beneath it.
+        let label = create(w!("STATIC"), none, 0, (200, 10, 100, 60), root);
+        assert_eq!(input_window_at(root, centre(label)), root);
+
+        // Final review D1: an opaque child of a plain static, and of a group
+        // box, takes the point; beside it, the container passes it on.
+        let beneath = create(w!("STATIC"), none, SS_NOTIFY, (10, 220, 380, 70), root);
+        for (class, style, x) in [(w!("STATIC"), 0, 20), (w!("BUTTON"), BS_GROUPBOX, 200)] {
+            let container = create(class, none, style, (x, 225, 150, 60), root);
+            raise(container);
+            let inner = create(w!("STATIC"), none, SS_NOTIFY, (40, 15, 60, 30), container);
+            assert_eq!(input_window_at(root, centre(inner)), inner);
+            let mut r = RECT::default();
+            unsafe { GetWindowRect(container, &mut r) }.unwrap();
+            assert_eq!(input_window_at(root, POINT { x: r.left + 10, y: (r.top + r.bottom) / 2 }), beneath);
+        }
+
+        // An opaque WS_EX_TRANSPARENT child drawn over another takes the input.
+        let _under = create(w!("STATIC"), none, SS_NOTIFY, (200, 100, 100, 60), root);
+        let over = create(w!("STATIC"), WS_EX_TRANSPARENT, SS_NOTIFY, (230, 115, 40, 30), root);
+        raise(over);
+        assert_eq!(input_window_at(root, centre(over)), over);
+
+        // Outside an elliptic region, the rect's corner belongs to the parent.
+        let oval = create(w!("STATIC"), none, SS_NOTIFY, (10, 150, 100, 60), root);
+        unsafe { SetWindowRgn(oval, CreateEllipticRgn(0, 0, 100, 60), true) };
+        let mut r = RECT::default();
+        unsafe { GetWindowRect(oval, &mut r) }.unwrap();
+        assert_eq!(input_window_at(root, POINT { x: r.left + 2, y: r.top + 2 }), root);
+        assert_eq!(input_window_at(root, centre(oval)), oval);
+        assert_eq!(input_window_at(root, POINT { x: r.right - 3, y: (r.top + r.bottom) / 2 }), oval);
+
+        unsafe { DestroyWindow(root) }.unwrap();
+    }
+
+    /// A STATIC child made on a new thread that pumps messages, so a `WM_NCHITTEST`
+    /// sent to it is answered. Returns its handle and the thread, which destroys the
+    /// window and ends when `stop` is set.
+    fn child_on_new_thread(
+        style: u32,
+        rect: (i32, i32, i32, i32),
+        parent: HWND,
+        stop: std::sync::Arc<std::sync::atomic::AtomicBool>,
+    ) -> (HWND, std::thread::JoinHandle<()>) {
+        use windows::Win32::UI::WindowsAndMessaging::{DispatchMessageW, PeekMessageW, TranslateMessage, MSG, PM_REMOVE};
+        let parent = parent.0 as isize;
+        let (send, receive) = std::sync::mpsc::channel();
+        let thread = std::thread::spawn(move || {
+            let window = create(w!("STATIC"), WINDOW_EX_STYLE(0), style, rect, HWND(parent as *mut _));
+            send.send(window.0 as isize).unwrap();
+            let mut message = MSG::default();
+            while !stop.load(std::sync::atomic::Ordering::SeqCst) {
+                while unsafe { PeekMessageW(&mut message, None, 0, 0, PM_REMOVE) }.as_bool() {
+                    unsafe {
+                        let _ = TranslateMessage(&message);
+                        DispatchMessageW(&message);
+                    }
+                }
+                std::thread::sleep(std::time::Duration::from_millis(5));
+            }
+            let _ = unsafe { DestroyWindow(window) };
+        });
+        // The new window's parent is on this thread, and creating a child sends its parent a
+        // message, so this thread has to keep pumping until the child exists.
+        let mut handle = None;
+        pump_until(|| {
+            handle = receive.try_recv().ok();
+            handle.is_some()
+        });
+        (HWND(handle.unwrap() as *mut _), thread)
+    }
+
+    /// Pump this thread's messages until `done`: another thread's window with a parent here sends
+    /// that parent messages when it is created, shown or destroyed, and blocks until they are handled.
+    fn pump_until(mut done: impl FnMut() -> bool) {
+        use windows::Win32::UI::WindowsAndMessaging::{DispatchMessageW, PeekMessageW, TranslateMessage, MSG, PM_REMOVE};
+        let mut message = MSG::default();
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(20);
+        while !done() {
+            assert!(std::time::Instant::now() < deadline, "timed out waiting on another thread");
+            while unsafe { PeekMessageW(&mut message, None, 0, 0, PM_REMOVE) }.as_bool() {
+                unsafe {
+                    let _ = TranslateMessage(&message);
+                    DispatchMessageW(&message);
+                }
+            }
+            std::thread::sleep(std::time::Duration::from_millis(5));
+        }
+    }
+
+    /// Measured with real clicks (`xthread.ps1`, gaps-winsign): a window answering
+    /// HTTRANSPARENT passes the point on only inside a parent of its own thread and
+    /// only to a sibling of its own thread; otherwise nothing at all gets the click.
+    #[test]
+    fn a_transparent_window_does_not_pass_the_point_across_threads() {
+        if skip_without_desktop("a_transparent_window_does_not_pass_the_point_across_threads") { return; }
+        use std::sync::{atomic::{AtomicBool, Ordering}, Arc};
+        let none = WINDOW_EX_STYLE(0);
+        let root = create(w!("STATIC"), none, 0, (140, 140, 400, 300), HWND::default());
+        for _ in 0..2 {
+            let _ = unsafe { ShowWindow(root, SW_SHOWNOACTIVATE) };
+        }
+        assert!(unsafe { IsWindowVisible(root) }.as_bool());
+        let stop = Arc::new(AtomicBool::new(false));
+
+        // Same thread: the cell beneath gets it (the control).
+        let cell = create(w!("STATIC"), none, SS_NOTIFY, (50, 50, 200, 100), root);
+        let glass = create(w!("STATIC"), none, 0, (30, 30, 240, 140), root);
+        raise(glass);
+        assert_eq!(input_window_at(root, centre(cell)), cell);
+        unsafe { DestroyWindow(glass) }.unwrap();
+        unsafe { DestroyWindow(cell) }.unwrap();
+
+        // The transparent window on another thread than its parent and the cell.
+        let cell = create(w!("STATIC"), none, SS_NOTIFY, (50, 50, 200, 100), root);
+        let (glass, glass_thread) = child_on_new_thread(0, (30, 30, 240, 140), root, stop.clone());
+        raise(glass);
+        assert_eq!(input_window_at(root, centre(cell)), glass);
+        stop.store(true, Ordering::SeqCst);
+        pump_until(|| glass_thread.is_finished());
+        glass_thread.join().unwrap();
+        unsafe { DestroyWindow(cell) }.unwrap();
+
+        // The cell on another thread than the transparent window.
+        stop.store(false, Ordering::SeqCst);
+        let (cell, cell_thread) = child_on_new_thread(SS_NOTIFY, (50, 50, 200, 100), root, stop.clone());
+        let glass = create(w!("STATIC"), none, 0, (30, 30, 240, 140), root);
+        raise(glass);
+        assert_eq!(input_window_at(root, centre(cell)), glass);
+        stop.store(true, Ordering::SeqCst);
+        pump_until(|| cell_thread.is_finished());
+        cell_thread.join().unwrap();
+        unsafe { DestroyWindow(glass) }.unwrap();
+
+        unsafe { DestroyWindow(root) }.unwrap();
+    }
+}
