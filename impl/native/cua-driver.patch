+/// Refuse a window-local point (capture pixels, after the screenshot ratio or
+/// zoom translation) that is not on the window, before any cursor glide or
+/// input. A screenshot pixel is always inside its image, so a point outside
+/// the window was not read from one (round-4 review R4-3: (65636, 65636)
+/// wrapped to (100, 100) in the 16-bit X event and the glide to it took
+/// 190 s). A window whose size cannot be read is held to the X11 coordinate
+/// range instead.
+fn point_off_window(tool: &str, xid: u64, points: &[(f64, f64)]) -> Option<ToolResult> {
+    point_off_window_for(tool, xid, current_window_geometry(xid).map(|g| g.size), points)
