+/// Cap on transient surfaces captured per get_window_state call, so a pathological
+/// stack of accessory windows cannot blow up capture time or the response size.
+pub const MAX_OVERLAY_SURFACES: usize = 8;
+
+/// Do two window rectangles overlap? (screen points, top-left origin)
+pub(crate) fn bounds_intersect(a: &WindowBounds, b: &WindowBounds) -> bool {
+    a.x < b.x + b.width
+        && b.x < a.x + a.width
+        && a.y < b.y + b.height
+        && b.y < a.y + a.height
+}
+
+/// On-screen transient / overlay surfaces layered above `target_window_id`
+/// (spec 07 "the window and related transient UI"): open NSMenus, popovers,
+/// autocomplete dropdowns, tooltips, and the target app's own child windows
+/// (sheets) whose bounds intersect the target and that sit above it in the
+/// front-to-back order. Returned bottom-to-top (ascending z_index) so a caller
+/// assigns `zIndex` by position (larger is visually above).
+///
+/// Only surfaces owned by the target process qualify. A nonzero window layer
+/// proves stacking, not association: the Dock can own a display-sized layer-20
+/// surface, and unrelated apps can own overlapping panels on the same layer.
+/// Separate-process menus are omitted until their relationship to the target
+/// can be verified; geometry, process names and layer numbers do not prove it.
+/// Same-process sheets and menus retain their exact bounds and z-order.
+pub fn overlay_windows_over(target_window_id: u32) -> Vec<WindowInfo> {
+    select_overlays(all_windows_any_layer(), target_window_id)
+}
+
+/// Pure overlay selection over an already-enumerated any-layer window set, so the
+/// filter is unit-testable without the CGWindowList. See [`overlay_windows_over`].
+pub(crate) fn select_overlays(all: Vec<WindowInfo>, target_window_id: u32) -> Vec<WindowInfo> {
+    let Some(target) = all.iter().find(|w| w.window_id == target_window_id) else {
+        return Vec::new();
+    };
+    let target_z = (target.layer, target.z_index);
+    let target_pid = target.pid;
+    let target_bounds = target.bounds.clone();
+    let mut overlays: Vec<WindowInfo> = all
+        .into_iter()
+        .filter(|w| w.window_id != target_window_id)
+        .filter(|w| w.is_on_screen)
+        // Layer orders surfaces across groups; list order breaks ties within a layer.
+        .filter(|w| (w.layer, w.z_index) > target_z)
+        // Stacking and intersection alone cannot establish an owner relation.
+        .filter(|w| w.pid == target_pid)
+        .filter(|w| w.bounds.width > 0.0 && w.bounds.height > 0.0)
+        .filter(|w| bounds_intersect(&w.bounds, &target_bounds))
+        .collect();
+    // bottom-to-top: ascending z so the array reads target(0) < overlay < overlay
+    overlays.sort_by_key(|w| (w.layer, w.z_index));
+    overlays.truncate(MAX_OVERLAY_SURFACES);
+    overlays
+}
