--- /dev/null
+++ b/libs/cua-driver/rust/crates/cua-driver-core/src/host_state.rs
@@ -0,0 +1,230 @@
+//! Host interactivity: is there a user session that synthetic input can safely
+//! reach right now? A closed lid with no external display means the machine is
+//! asleep and nothing here runs at all; the states this module covers are the
+//! ones the daemon can observe while it is running: the screen is locked, the
+//! display is asleep, the lid is closed in clamshell mode, or the session is
+//! off the console (fast user switching).
+//!
+//! The cross-platform contract lives here; each platform crate registers a
+//! [`Probe`] and keeps its adapter thin. Anything a platform cannot observe is
+//! `None` on the wire (not a guessed `false`), so consumers can tell "unlocked"
+//! from "unknown".
+//!
+//! Policy: synthetic input is refused while the screen is locked or the session
+//! is off the console. Keystrokes posted into a lock screen land in the password
+//! field and pointer events wake the display for whoever is at the machine; both
+//! are the opposite of invisible. Observation tools are not refused: the
+//! accessibility tree of a running app stays readable and a lock-screen capture
+//! is an honest answer.
+
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use std::sync::RwLock;
+
+/// Structured `code` on the refusal.
+pub const CODE_HOST_NOT_INTERACTIVE: &str = "host_not_interactive";
+pub const REASON_SCREEN_LOCKED: &str = "screen_locked";
+pub const REASON_OFF_CONSOLE: &str = "off_console";
+
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct HostState {
+    /// The login window / lock screen owns input. `None`: not observable here.
+    pub screen_locked: Option<bool>,
+    /// The session owns the physical console (false under fast user switching).
+    pub on_console: Option<bool>,
+    /// Every active display is dark: DPMS off, macOS display sleep, or the X
+    /// server's own blanking (synthetic pixel input would light it up again).
+    pub display_asleep: Option<bool>,
+    /// Laptop lid closed. With an external display this is clamshell mode and
+    /// the session stays usable; without one the machine sleeps.
+    pub lid_closed: Option<bool>,
+    pub active_displays: Option<u32>,
+    /// Why some fields are `None`, when the platform knows.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub probe_error: Option<String>,
+}
+
+impl HostState {
+    /// Reasons synthetic input must not be delivered right now, in a fixed order.
+    pub fn refusal_reasons(&self) -> Vec<&'static str> {
+        let mut r = Vec::new();
+        if self.screen_locked == Some(true) { r.push(REASON_SCREEN_LOCKED); }
+        if self.on_console == Some(false) { r.push(REASON_OFF_CONSOLE); }
+        r
+    }
+
+    pub fn blocks_input(&self) -> bool { !self.refusal_reasons().is_empty() }
+
+    /// True when nothing was observable at all (the probe could not run).
+    pub fn is_unknown(&self) -> bool {
+        self.screen_locked.is_none() && self.on_console.is_none() && self.display_asleep.is_none()
+            && self.lid_closed.is_none() && self.active_displays.is_none()
+    }
+
+    pub fn to_json(&self) -> Value { serde_json::to_value(self).unwrap_or(Value::Null) }
+}
+
+pub type Probe = fn() -> HostState;
+
+static PROBE: RwLock<Option<Probe>> = RwLock::new(None);
+
+/// Register the platform probe (once, at tool registration).
+pub fn set_probe(probe: Probe) { *PROBE.write().unwrap_or_else(|e| e.into_inner()) = Some(probe); }
+
+/// Run the registered probe. `None` when no platform registered one.
+pub fn probe() -> Option<HostState> { (*PROBE.read().unwrap_or_else(|e| e.into_inner())).map(|p| p()) }
+
+/// Tools that deliver synthetic input (the capture-scope action list plus the
+/// stateful button primitives). Observation, session and browser tools pass.
+pub fn is_input_tool(tool_name: &str) -> bool {
+    matches!(
+        tool_name,
+        "click" | "double_click" | "right_click" | "scroll" | "drag" | "mouse_drag" | "parallel_mouse_drag"
+            | "move_cursor" | "type_text" | "type_text_chars" | "press_key" | "hotkey" | "set_value"
+            | "mouse_button_down" | "mouse_button_up" | "invoke_menu"
+    )
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct HostRefusal {
+    pub state: HostState,
+    pub reasons: Vec<&'static str>,
+}
+
+impl HostRefusal {
+    pub fn message(&self, tool_name: &str) -> String {
+        format!(
+            "{tool_name} refused: the host session is not interactive ({}). Synthetic input would reach the lock screen or another user's console, not the target window. Unlock the session (or bring it back to the console) and retry.",
+            self.reasons.join(", ")
+        )
+    }
+    pub fn structured(&self) -> Value {
+        json!({ "code": CODE_HOST_NOT_INTERACTIVE, "reasons": self.reasons, "host": self.state.to_json() })
+    }
+}
+
+/// Dispatch-boundary gate (`ToolRegistry::invoke_authorized`, which every transport
+/// reaches): refuse an input tool while the host is not interactive.
+/// Unknown state never refuses (a probe failure must not brick the driver).
+pub fn gate(tool_name: &str) -> Result<(), HostRefusal> {
+    if !is_input_tool(tool_name) { return Ok(()); }
+    let Some(state) = probe() else { return Ok(()); };
+    let reasons = state.refusal_reasons();
+    if reasons.is_empty() { Ok(()) } else { Err(HostRefusal { state, reasons }) }
+}
+
+/// The shared `health_report` entry for [`crate::health_report::NAME_HOST_INTERACTIVE`].
+pub fn health_check(state: &HostState) -> crate::health_report::CheckEntry {
+    use crate::health_report::{CheckData, CheckEntry, NAME_HOST_INTERACTIVE};
+    let data = CheckData {
+        host: Some(state.clone()),
+        display_count: state.active_displays,
+        error_detail: state.probe_error.clone(),
+        ..Default::default()
+    };
+    let reasons = state.refusal_reasons();
+    let entry = if !reasons.is_empty() {
+        CheckEntry::fail(
+            NAME_HOST_INTERACTIVE,
+            format!("Host session is not interactive ({}); input tools are refused with code {CODE_HOST_NOT_INTERACTIVE}.", reasons.join(", ")),
+            "Unlock the screen (or switch the console back to this user) and retry; observation tools keep working meanwhile.",
+        )
+    } else if state.is_unknown() {
+        CheckEntry::skip(NAME_HOST_INTERACTIVE, format!("Host interactivity is not observable here{}.", state.probe_error.as_deref().map(|e| format!(": {e}")).unwrap_or_default()))
+    } else {
+        let mut notes = Vec::new();
+        if state.display_asleep == Some(true) { notes.push("the display is asleep, so pixel-route input will wake it"); }
+        if state.lid_closed == Some(true) { notes.push("the lid is closed (clamshell mode)"); }
+        if state.active_displays == Some(0) { notes.push("no active display"); }
+        CheckEntry::pass(NAME_HOST_INTERACTIVE, if notes.is_empty() { "Host session is interactive.".to_owned() } else { format!("Host session is interactive; {}.", notes.join("; ")) })
+    };
+    entry.with_data(data)
+}
+
+/// Test-only probe shared by every test binary that needs to flip the host
+/// state: the probe is process-global, so tests install one function and drive
+/// it through a thread-local (tokio tests run on the current thread).
+#[cfg(test)]
+pub(crate) mod testing {
+    use super::HostState;
+    thread_local! { static LOCKED: std::cell::Cell<bool> = const { std::cell::Cell::new(false) }; }
+    pub fn unlocked() -> HostState { HostState { screen_locked: Some(false), on_console: Some(true), display_asleep: Some(false), lid_closed: Some(false), active_displays: Some(1), probe_error: None } }
+    pub fn locked() -> HostState { HostState { screen_locked: Some(true), ..unlocked() } }
+    fn probe() -> HostState { if LOCKED.with(|l| l.get()) { locked() } else { unlocked() } }
+    /// Install the shared probe and set this thread's lock state.
+    pub fn set_locked(locked: bool) { super::set_probe(probe); LOCKED.with(|l| l.set(locked)); }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use super::testing::{locked, set_locked, unlocked};
+    use crate::health_report::CheckStatus;
+
+    fn off_console() -> HostState { HostState { on_console: Some(false), ..unlocked() } }
+
+    #[test]
+    fn only_lock_and_console_refuse_input() {
+        assert!(!unlocked().blocks_input());
+        assert_eq!(locked().refusal_reasons(), vec![REASON_SCREEN_LOCKED]);
+        assert_eq!(off_console().refusal_reasons(), vec![REASON_OFF_CONSOLE]);
+        assert_eq!(HostState { on_console: Some(false), ..locked() }.refusal_reasons(), vec![REASON_SCREEN_LOCKED, REASON_OFF_CONSOLE]);
+        // asleep display, closed lid, zero displays: reported, not refused
+        assert!(!HostState { display_asleep: Some(true), lid_closed: Some(true), active_displays: Some(0), ..unlocked() }.blocks_input());
+        // unknown never refuses
+        assert!(!HostState::default().blocks_input());
+        assert!(HostState::default().is_unknown());
+    }
+
+    #[test]
+    fn input_tools_are_the_action_list_and_observation_is_not() {
+        for t in ["click", "double_click", "right_click", "scroll", "drag", "mouse_drag", "parallel_mouse_drag", "move_cursor", "type_text", "type_text_chars", "press_key", "hotkey", "set_value", "mouse_button_down", "mouse_button_up", "invoke_menu"] {
+            assert!(is_input_tool(t), "{t}");
+        }
+        for t in ["get_window_state", "list_windows", "get_desktop_state", "screenshot", "health_report", "get_accessibility_tree", "start_session", "browser_click", "zoom", "verify_state"] {
+            assert!(!is_input_tool(t), "{t}");
+        }
+    }
+
+    #[test]
+    fn gate_refuses_input_only_while_not_interactive_and_passes_observation() {
+        set_locked(false);
+        assert!(gate("click").is_ok());
+        set_locked(true);
+        let err = gate("type_text").unwrap_err();
+        assert_eq!(err.reasons, vec![REASON_SCREEN_LOCKED]);
+        assert_eq!(err.structured()["code"], CODE_HOST_NOT_INTERACTIVE);
+        assert_eq!(err.structured()["host"]["screen_locked"], true);
+        assert!(err.message("type_text").starts_with("type_text refused: the host session is not interactive (screen_locked)"));
+        assert!(gate("get_window_state").is_ok(), "observation is never refused");
+        assert!(gate("health_report").is_ok());
+        set_locked(false);
+        assert!(gate("type_text").is_ok());
+    }
+
+    #[test]
+    fn health_entry_mirrors_the_gate() {
+        let e = health_check(&locked());
+        assert_eq!(e.status, CheckStatus::Fail);
+        assert!(e.hint.is_some());
+        let d = e.data.as_ref().unwrap();
+        assert_eq!((d.host.as_ref().unwrap().screen_locked, d.host.as_ref().unwrap().on_console, d.display_count), (Some(true), Some(true), Some(1)));
+        // the wire shape keeps unobservable facts as explicit nulls, never drops them
+        let wire = serde_json::to_value(&health_check(&HostState { screen_locked: Some(false), ..Default::default() })).unwrap();
+        assert!(wire["data"]["host"].get("lid_closed").is_some_and(|v| v.is_null()), "{wire}");
+        assert_eq!(wire["data"]["host"]["screen_locked"], false);
+        assert!(wire["data"].get("display_count").is_none(), "absent when unknown, like every other CheckData field");
+        assert_eq!(health_check(&unlocked()).status, CheckStatus::Pass);
+        let asleep = health_check(&HostState { display_asleep: Some(true), ..unlocked() });
+        assert_eq!(asleep.status, CheckStatus::Pass);
+        assert!(asleep.message.contains("display is asleep"));
+        let unknown = health_check(&HostState { probe_error: Some("no X display".into()), ..Default::default() });
+        assert_eq!(unknown.status, CheckStatus::Skip);
+        assert!(unknown.message.ends_with(": no X display."));
+        assert_eq!(unknown.data.as_ref().unwrap().error_detail.as_deref(), Some("no X display"));
+        // serialized shape: unknowns are null, not false
+        let v = HostState { screen_locked: Some(false), ..Default::default() }.to_json();
+        assert_eq!(v["screen_locked"], false);
+        assert!(v["lid_closed"].is_null());
+    }
+}
