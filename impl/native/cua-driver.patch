+        "linux-sway-xwayland-null-app-id-capture-ax-not-applicable",
+        "xwayland_null_app_id_capture",
+        DriverRoute::WindowState,
+        vec![OracleKind::AxState, OracleKind::TypedRefusal, OracleKind::ReadinessAgrees],
+    )
+    .expecting_refusal(vec![RefusalCode::SurfaceIdentityUnproven]);
+    run_nested(case, Nested::sway, |sway, recorder| {
+        let wl = Receiver::spawn(recorder, "wayland:WL", &sway.client_env(), &["DISPLAY"]);
+        let xw_display = sway.xwayland_display.clone().expect("sway started XWayland");
+        let xw = Receiver::spawn(
+            recorder,
+            "wayland:XW",
+            &[("DISPLAY", xw_display.as_str()), ("GDK_BACKEND", "x11")],
+            &["WAYLAND_DISPLAY"],
+        );
