+    /// final-mac F2, final-linux F3, windows-final D5: a `from_zoom` pixel is
+    /// read through the calling session's own zoom of that window. Another
+    /// session's later zoom of the same window does not move it, and a
+    /// session with no zoom of its own refuses, whoever else zoomed.
+    #[test]
+    fn a_zoom_pixel_reads_only_the_sessions_own_zoom() {
+        let mut log = Log::default();
+        log.note_zoom(s("agent"), marked(90, 7, WindowIdentity::Mark(1)), crop(100.0));
+        log.note_zoom(s("tile"), marked(90, 7, WindowIdentity::Mark(1)), crop(300.0));
+        let agent = log.resolve(&zoom("agent"), 90, 7).unwrap();
+        assert_eq!(agent.zoom_to_window(28.0, 28.0), Some((128.0, 128.0)));
+        assert_eq!(log.resolve(&zoom("tile"), 90, 7).unwrap().zoom_to_window(28.0, 28.0), Some((328.0, 328.0)));
+        // a session that zoomed nothing, whoever else zoomed the window
+        let refused = log.resolve(&zoom("stranger"), 90, 7).unwrap_err().structured_content.unwrap();
+        assert_eq!(refused["code"], "invalid_arguments");
+        assert!(refused["refusal"]["message"].as_str().unwrap().contains("this session has no zoom of window 7"));
+        // no session at all
+        assert_eq!(code(log.resolve(&json!({ "from_zoom": true }), 90, 7)), "invalid_arguments");
+        // the agent's zoom of another window, or another pid's window, is not this window's
+        log.note_zoom(s("agent"), marked(90, 8, WindowIdentity::Mark(1)), crop(500.0));
+        assert_eq!(log.resolve(&zoom("agent"), 90, 7).unwrap().zoom_to_window(0.0, 0.0), Some((100.0, 100.0)));
+        assert_eq!(code(log.resolve(&zoom("agent"), 91, 7)), "invalid_arguments");
+        // an own capture does not stand in for a zoom, and a zoom is not a capture
+        log.record(s("capturer"), capture(90, 7, (400.0, 300.0), None));
+        assert_eq!(code(log.resolve(&zoom("capturer"), 90, 7)), "invalid_arguments");
+        assert_eq!(code(log.resolve(&unbound("tile"), 90, 7)), "ambiguous_capture");
+        // a screenshot_id sent with it does not turn a zoom pixel into a screenshot pixel
+        let id = id_string(log.record(s("agent"), capture(90, 7, (400.0, 300.0), Some(4.0))));
+        let with_id = json!({ "_session_id": "agent", "from_zoom": true, "screenshot_id": id });
+        assert!(matches!(log.resolve(&with_id, 90, 7).unwrap(), PixelBinding::Zoom(..)));
+    }
+
+    /// final-linux F1: the zoom carries the window as it was. A window
+    /// recreated under the same id, or resized, since the zoom refuses
+    /// `stale_capture` whether or not the session also captured it.
+    #[test]
+    fn a_zoom_of_a_replaced_or_resized_window_is_stale() {
+        let mut log = Log::default();
+        log.note_zoom(s("zx"), marked(92, 7, WindowIdentity::Mark(5)), crop(190.0));
+        let binding = log.resolve(&zoom("zx"), 92, 7).unwrap();
+        let refused = binding.verify_identity(|| Some(6)).unwrap_err().structured_content.unwrap();
+        assert_eq!(refused["code"], "stale_capture");
+        assert!(refused["refusal"]["message"].as_str().unwrap().contains("latest zoom"));
+        assert!(binding.verify_identity(|| Some(5)).is_ok());
+        assert!(binding.verify(geometry(400.0, 300.0, None)).is_ok());
+        assert_eq!(binding.verify(geometry(500.0, 300.0, None)).unwrap_err().structured_content.unwrap()["code"], "stale_capture");
+        assert_eq!(binding.bound_ratio(), Some(None), "a zoom pixel is never scaled by a capture ratio");
+        log.note_zoom(s("unmarked"), marked(92, 7, WindowIdentity::Unproven), crop(0.0));
+        assert!(log.resolve(&zoom("unmarked"), 92, 7).unwrap().verify_identity(|| panic!("not read")).is_err());
+    }
+
+    #[test]
+    fn zooms_are_bounded_per_session_like_captures() {
+        let mut log = Log::default();
+        for w in 0..WINDOWS_PER_SESSION as u64 {
+            log.note_zoom(s("agent"), capture(93, w, (1.0, 1.0), None), crop(w as f64));
+        }
+        assert!(log.resolve(&zoom("agent"), 93, 0).is_ok(), "window 0 used again");
+        log.note_zoom(s("agent"), capture(93, 9999, (1.0, 1.0), None), crop(0.0));
+        assert_eq!(log.sessions["agent"].zooms.len(), WINDOWS_PER_SESSION);
+        assert!(log.resolve(&zoom("agent"), 93, 0).is_ok());
+        assert_eq!(code(log.resolve(&zoom("agent"), 93, 1)), "invalid_arguments");
+    }
+
+    /// windows-final C6: a capture (or zoom) in flight when its session ends
+    /// finishes after `end_session` and a revival. It is not filed under the
+    /// revived session; a capture started after the revival is.
+    #[test]
+    fn a_capture_started_before_the_session_ended_does_not_revive_it() {
+        let mut log = Log::default();
+        log.record(s("agent"), capture(94, 7, (400.0, 300.0), None));
+        let in_flight = s("agent");
+        let zoom_in_flight = s("agent");
+        log.forget("agent");
+        // revived here (start_session); the stalled capture finishes now
+        let late = log.record(in_flight.clone(), capture(94, 7, (3000.0, 1800.0), Some(3.33)));
+        log.note_session(in_flight, CapturedFrame { id: late + 1, ..log.frame(late).unwrap() });
+        log.note_zoom(zoom_in_flight, capture(94, 7, (400.0, 300.0), None), crop(10.0));
+        assert_eq!(code(log.resolve(&unbound("agent"), 94, 7)), "ambiguous_capture");
+        assert_eq!(code(log.resolve(&zoom("agent"), 94, 7)), "invalid_arguments");
+        assert!(log.frame(late).is_some(), "the late frame's own id still binds");
+        // a fresh capture after the revival counts
+        log.record(s("agent"), capture(94, 7, (400.0, 300.0), Some(2.0)));
+        assert_eq!(log.resolve(&unbound("agent"), 94, 7).unwrap().bound_ratio(), Some(Some(2.0)));
+        // and the tombstone keeps refusing captures started before the end
+        let older = CaptureSession { name: "agent".into(), started: 0 };
+        log.record(Some(older), capture(94, 8, (400.0, 300.0), None));
+        assert_eq!(code(log.resolve(&unbound("agent"), 94, 8)), "ambiguous_capture");
+    }
+
+    #[test]
+    fn ended_sessions_are_remembered_up_to_a_bound() {
+        let mut log = Log::default();
+        let first = s("first-ended");
+        log.forget("first-ended");
+        for n in 0..ENDED_KEPT {
+            log.forget(&format!("e{n}"));
+        }
+        assert_eq!(log.ended.len(), ENDED_KEPT);
+        assert!(!log.ended.contains_key("first-ended"));
+        // past the bound the oldest end no longer refuses (the documented limit)
+        log.record(first, capture(95, 7, (1.0, 1.0), None));
+        assert!(log.resolve(&unbound("first-ended"), 95, 7).is_ok());
+    }
+
+    #[test]
+    fn without_an_id_the_sessions_capture_is_checked() {
+        record(s("c9-agent-2"), capture(90_002, 7, (400.0, 300.0), None));
+        let binding = PixelBinding::resolve(&json!({ "screenshot_id": null, "_session_id": "c9-agent-2" }), 90_002, 7).unwrap();
+        assert!(matches!(binding, PixelBinding::Session(_)));
+        assert_eq!(binding.bound_ratio(), Some(None));
+        let refused = binding.verify(geometry(401.0, 300.0, None)).unwrap_err();
+        assert!(refused.structured_content.unwrap()["refusal"]["message"]
+            .as_str()
+            .unwrap()
+            .contains("latest screenshot"));
+    }
+
+    /// windows-final C8: an element's focus click computed by the driver is
+    /// not a caller's pixel. Inside the scope it is neither scaled by nor
+    /// refused for want of a capture, whoever captured the window; outside
+    /// it, the same args follow the session rule.
+    #[tokio::test]
+    async fn a_driver_window_point_is_not_read_against_any_capture() {
+        record(s("c9-dp-tile"), capture(90_020, 7, (800.0, 600.0), Some(4.0)));
+        let args = json!({ "_session_id": "c9-dp-agent", "x": 10, "y": 10 });
+        let inside = with_driver_window_point(async { PixelBinding::resolve_unbound(&args, 90_020, 7) }).await.unwrap();
+        assert_eq!(inside, PixelBinding::DriverPoint);
+        assert_eq!(inside.bound_ratio(), Some(None));
+        assert!(inside.verify(geometry(1.0, 1.0, None)).is_ok());
+        let bound = with_driver_window_point(async { PixelBinding::resolve(&json!({ "screenshot_id": "junk" }), 90_020, 7) }).await;
+        assert_eq!(bound.unwrap(), PixelBinding::DriverPoint);
+        assert_eq!(code(PixelBinding::resolve_unbound(&args, 90_020, 7)), "ambiguous_capture");
+        // a spawned task does not inherit the scope
+        let spawned = with_driver_window_point(async {
+            tokio::spawn(async move { PixelBinding::resolve(&json!({ "_session_id": "c9-dp-agent" }), 90_020, 7) }).await.unwrap()
+        })
+        .await;
+        assert_eq!(code(spawned), "ambiguous_capture");
+    }
+
+    #[test]
+    fn unobserved_is_not_checked() {
+        let binding = PixelBinding::Unobserved;
+        assert_eq!(binding.bound_ratio(), None);
+        assert!(binding.verify(geometry(1.0, 1.0, Some(2.0))).is_ok());
+        assert!(binding.verify_identity(|| None).is_ok());
+    }
+
+    #[test]
+    fn a_scale_change_is_stale_and_sub_unit_size_noise_is_not() {
+        let id = record(None, Capture { scale: 2.0, ..capture(90_004, 7, (500.0, 400.0), None) });
+        let bound = PixelBinding::resolve(&json!({ "screenshot_id": id }), 90_004, 7).unwrap();
+        assert!(bound.verify(geometry(500.4, 399.6, Some(2.0))).is_ok());
+        assert!(bound.verify(geometry(500.0, 400.0, None)).is_ok());
+        let refused = bound.verify(geometry(500.0, 400.0, Some(1.0))).unwrap_err();
+        assert!(refused.structured_content.unwrap()["refusal"]["message"]
+            .as_str()
+            .unwrap()
+            .contains("scale 1 now but was at scale 2"));
+    }
+
+    #[test]
+    fn foreign_unknown_and_malformed_ids_refuse() {
+        let id = record(None, capture(90_005, 7, (1.0, 1.0), None));
+        let other_window = PixelBinding::resolve(&json!({ "screenshot_id": id }), 90_005, 8).unwrap_err();
+        assert_eq!(other_window.structured_content.unwrap()["code"], "invalid_arguments");
+        let other_pid = PixelBinding::resolve(&json!({ "screenshot_id": id }), 90_006, 7).unwrap_err();
+        assert_eq!(other_pid.structured_content.unwrap()["code"], "invalid_arguments");
+        let unknown = PixelBinding::resolve(&json!({ "screenshot_id": id_string(u64::MAX) }), 90_005, 7).unwrap_err();
+        assert_eq!(unknown.structured_content.unwrap()["code"], "stale_capture");
+        let number = PixelBinding::resolve(&json!({ "screenshot_id": 3 }), 90_005, 7).unwrap_err();
+        assert_eq!(number.structured_content.unwrap()["code"], "invalid_arguments");
+    }
+
+    #[test]
+    fn a_bound_id_ignores_the_session() {
+        // any session may pass any id; the id alone names the frame
+        let id = record(s("c9-capturer"), capture(90_009, 7, (400.0, 300.0), Some(2.0)));
+        let bound = PixelBinding::resolve(&json!({ "screenshot_id": id, "_session_id": "c9-someone-else" }), 90_009, 7).unwrap();
+        assert!(matches!(bound, PixelBinding::Bound(_)));
+        assert_eq!(bound.bound_ratio(), Some(Some(2.0)));
+    }
+}
