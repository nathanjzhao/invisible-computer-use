+/// i3lock (fullscreen override-redirect, holding the grab) refuses input.
+/// Red under `lockbroken` (the signature is never probed).
+#[test]
+#[ignore]
+fn harness_x11_locker_type_text_ax_background() {
+    host_cell("linux-x11-locker-type-text-ax-background", true);
+}
