+/// A screen-point rectangle (top-left origin, as CGWindow bounds report it).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct OccluderRect {
+    pub x: f64,
+    pub y: f64,
+    pub w: f64,
+    pub h: f64,
+}
+
+/// The whole overlay: used when the pinned target is not visible at all (off
+/// its display's current Space, minimized, closed), so the cursor is hidden
+/// entirely rather than drawn over whatever is on screen there.
+pub(crate) const HIDE_ALL: OccluderRect = OccluderRect { x: -1.0e6, y: -1.0e6, w: 2.0e6, h: 2.0e6 };
+
+/// Bounds of every on-screen layer-0 window stacked ABOVE `target_wid` — the
+/// parts of the target the user cannot see. This process's own windows (the
+/// overlay itself) never count. When the target is NOT in the on-screen
+/// listing (other Space / minimized / gone) the clip is [`HIDE_ALL`]: a cursor
+/// clipped to its target's visible region has nothing to show.
+pub(crate) fn occluder_rects(
+    target_wid: u64,
+    windows: &[crate::windows::WindowInfo],
+    self_pid: i32,
+) -> Vec<OccluderRect> {
+    let Some(target) = windows.iter().find(|w| u64::from(w.window_id) == target_wid && w.is_on_screen) else {
+        return vec![HIDE_ALL];
+    };
+    windows
+        .iter()
+        .filter(|w| {
+            w.is_on_screen
+                && w.layer == 0
+                && w.pid != self_pid
+                && u64::from(w.window_id) != target_wid
+                && w.z_index > target.z_index
+                && w.bounds.width > 0.0
+                && w.bounds.height > 0.0
+        })
+        .map(|w| OccluderRect { x: w.bounds.x, y: w.bounds.y, w: w.bounds.width, h: w.bounds.height })
+        .collect()
+}
+
+/// Clear (fully transparent) every pixel of `pm` that lies under an occluder.
+/// `scale` converts screen points to pixmap pixels (the pixmap is allocated at
+/// the screen's physical size with the same top-left origin).
+pub(crate) fn clip_pixmap_to_exposed(pm: &mut tiny_skia::Pixmap, occluders: &[OccluderRect], scale: f64) {
+    if occluders.is_empty() {
+        return;
+    }
+    let (pw, ph) = (pm.width() as i64, pm.height() as i64);
+    let px = pm.pixels_mut();
+    for r in occluders {
+        let x0 = ((r.x * scale).floor() as i64).clamp(0, pw);
+        let y0 = ((r.y * scale).floor() as i64).clamp(0, ph);
+        let x1 = (((r.x + r.w) * scale).ceil() as i64).clamp(0, pw);
+        let y1 = (((r.y + r.h) * scale).ceil() as i64).clamp(0, ph);
+        for y in y0..y1 {
+            let row = (y * pw) as usize;
+            for x in x0..x1 {
+                px[row + x as usize] = tiny_skia::PremultipliedColorU8::TRANSPARENT;
+            }
+        }
+    }
+}
