+        let state = Arc::new(ToolState::new(false, false, None));
+        let hotkey = key_input_tool("hotkey", HotkeyTool::new(state.clone()), &no_windows);
+        let press = key_input_tool("press_key", PressKeyTool::new(state), &no_windows);
+        let code = |result: ToolResult| {
