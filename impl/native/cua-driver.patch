+/// The window-local `x`/`y` of a pixel action: both numbers, or both absent.
+/// A string, a non-finite number or a lone coordinate is a typed
+/// `invalid_arguments` refusal, never "no point" (round-3 review N3: string
+/// coordinates on scroll became a window scroll at (0,0); N5: `x` without `y`
+/// was an error with no code).
+fn optional_point(tool: &str, args: &Value) -> Result<Option<(f64, f64)>, ToolResult> {
+    let invalid = |detail: String| invalid_arguments(tool, detail);
+    let coordinate = |name: &str| match args.get(name) {
+        None | Some(Value::Null) => Ok(None),
+        Some(value) => match value.as_f64().filter(|v| v.is_finite()) {
+            Some(v) => Ok(Some(v)),
+            None => Err(invalid(format!("{name} must be a number of window-local screenshot pixels, not {value}"))),
+        },
+    };
+    match (coordinate("x")?, coordinate("y")?) {
+        (Some(x), Some(y)) => Ok(Some((x, y))),
+        (None, None) => Ok(None),
+        _ => Err(invalid("pass both x and y for a pixel point, or neither".to_owned())),
+    }
+}
+
+fn invalid_arguments(tool: &str, detail: String) -> ToolResult {
+    ToolResult::error(format!("{tool}: invalid arguments: {detail}")).with_structured(json!({
+        "status": "refused",
+        "code": "invalid_arguments",
+        "tool": tool,
+        "detail": detail,
+    }))
+}
+
+/// `drag`'s four coordinates: each a finite number. A missing or non-number
+/// coordinate is a typed `invalid_arguments` refusal (round-4 review R4-5:
+/// `from_x: "10"` returned "Missing: from_x" with no code).
+fn drag_coordinates(args: &Value) -> Result<[f64; 4], ToolResult> {
+    let mut out = [0.0; 4];
+    for (slot, name) in out.iter_mut().zip(["from_x", "from_y", "to_x", "to_y"]) {
+        *slot = match args.get(name) {
+            None | Some(Value::Null) => {
+                return Err(invalid_arguments("drag", format!("{name} is required: a number of window-local screenshot pixels")))
+            }
+            Some(value) => match value.as_f64().filter(|v| v.is_finite()) {
+                Some(v) => v,
+                None => {
+                    return Err(invalid_arguments(
+                        "drag",
+                        format!("{name} must be a number of window-local screenshot pixels, not {value}"),
+                    ))
+                }
+            },
+        };
+    }
+    Ok(out)
+}
