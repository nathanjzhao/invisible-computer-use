+mod uncertain_click_outcome_tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn pixel_ax_attempt_error_or_panic_never_reaches_coordinate_dispatch() {
+        for focus_only in [false, true] {
+            for panic_after in [false, true] {
+                let effects = std::sync::Arc::new(std::sync::atomic::AtomicUsize::new(0));
+                let worker_effects = effects.clone();
+                let result = tokio::task::spawn_blocking(move || -> anyhow::Result<PixelAxAttempt> {
+                    worker_effects.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+                    if panic_after { panic!("AX worker failed after effect"); }
+                    anyhow::bail!("AXCannotComplete after receiver applied effect")
+                }).await;
+                let mut pixels = 0;
+                let outcome = pixel_ax_outcome(result, focus_only);
+                if outcome.is_none() { pixels += 1; }
+                assert_eq!(pixels, 0);
+                assert_eq!(effects.load(std::sync::atomic::Ordering::SeqCst), 1);
+                let result = outcome.unwrap();
+                assert_eq!(result.is_error, Some(true));
+                assert_eq!(result.structured_content.unwrap()["effect"], "unverifiable");
+            }
+        }
+    }
