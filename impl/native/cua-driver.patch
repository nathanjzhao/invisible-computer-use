+
+fn point_off_window_for(tool: &str, xid: u64, size: Option<(f64, f64)>, points: &[(f64, f64)]) -> Option<ToolResult> {
+    let (w, h) = size.unwrap_or((f64::from(i16::MAX), f64::from(i16::MAX)));
+    // The last pixel is w-1: a point at x == w (or y == h) is the first pixel
+    // outside the window, where a foreground XTest click lands on whatever is
+    // next to it and a posted event carries a coordinate no window pixel has.
+    let (x, y) = points.iter().copied().find(|&(x, y)| !(x >= 0.0 && y >= 0.0 && x < w && y < h))?;
+    let detail = match size {
+        Some(_) => format!(
+            "point ({x}, {y}) in window pixels is outside window {xid} (0..{w} x 0..{h}); x/y are pixels of the window's screenshot"
+        ),
+        None => format!("point ({x}, {y}) is outside the X11 coordinate range 0..{w}"),
+    };
+    Some(invalid_arguments(tool, detail))
+}
