+//! wlroots capture: verified Sway IPC identity -> ext toplevel -> own buffer.
+//! No title matching, output capture, or rectangle fallback.
+use anyhow::{ensure, Context, Result};
+use std::{
+    collections::HashMap,
+    io::{Read, Write},
+    os::{
+        fd::{AsFd, AsRawFd},
+        unix::{fs::MetadataExt, net::UnixStream},
+    },
+    time::{Duration, Instant},
+};
+use wayland_client::{
+    delegate_noop, event_created_child,
+    protocol::{wl_buffer, wl_callback, wl_registry, wl_shm, wl_shm_pool},
+    Connection, Dispatch, EventQueue, Proxy, QueueHandle,
+};
+use wayland_protocols::ext::{
+    foreign_toplevel_list::v1::client::{
+        ext_foreign_toplevel_handle_v1 as handle, ext_foreign_toplevel_list_v1 as list,
+    },
+    image_capture_source::v1::client::{
+        ext_foreign_toplevel_image_capture_source_manager_v1 as source_manager,
+        ext_image_capture_source_v1 as source,
+    },
+    image_copy_capture::v1::client::{
+        ext_image_copy_capture_frame_v1 as frame, ext_image_copy_capture_manager_v1 as manager,
+        ext_image_copy_capture_session_v1 as session,
+    },
+};
+const UNSUPPORTED: &str = "window_capture_unsupported_compositor";
+fn unsupported_reason() -> String {
+    format!("{UNSUPPORTED}: {}", super::SWAY_WINDOW_CAPTURE_REFUSED)
+}
+#[derive(Default)]
+struct State {
+    list: Option<list::ExtForeignToplevelListV1>,
+    source: Option<source_manager::ExtForeignToplevelImageCaptureSourceManagerV1>,
+    manager: Option<manager::ExtImageCopyCaptureManagerV1>,
+    shm: Option<wl_shm::WlShm>,
+    handles: HashMap<u32, (handle::ExtForeignToplevelHandleV1, String, bool)>,
+    sync: bool,
+    specs: bool,
+    width: u32,
+    height: u32,
+    format: Option<wl_shm::Format>,
+    ready: bool,
+    failed: bool,
+    transformed: bool,
+}
+#[derive(Debug, PartialEq)]
+struct Target {
+    compositor: u32,
+    identifier: String,
+    geometry: (i64, i64, u64, u64),
+}
+fn target(id: u64, pid: u32) -> Result<Target> {
+    let mut socket =
+        UnixStream::connect(std::env::var_os("SWAYSOCK").with_context(unsupported_reason)?)?;
+    socket.set_read_timeout(Some(Duration::from_millis(800)))?;
+    socket.set_write_timeout(Some(Duration::from_millis(800)))?;
+    let mut peer: libc::ucred = unsafe { std::mem::zeroed() };
+    let mut size = std::mem::size_of_val(&peer) as libc::socklen_t;
+    ensure!(
+        unsafe {
+            libc::getsockopt(
+                socket.as_raw_fd(),
+                libc::SOL_SOCKET,
+                libc::SO_PEERCRED,
+                (&mut peer as *mut libc::ucred).cast(),
+                &mut size,
+            )
+        } == 0
+            && peer.uid == unsafe { libc::geteuid() },
+        "window_capture_untrusted_sway"
+    );
+    let exe = std::fs::read_link(format!("/proc/{}/exe", peer.pid))?;
+    ensure!(
+        exe.file_name().and_then(|v| v.to_str()) == Some("sway")
+            && std::fs::metadata(exe).is_ok_and(|m| m.uid() == 0 && m.mode() & 0o022 == 0),
+        "window_capture_untrusted_sway"
+    );
+    socket.write_all(b"i3-ipc\0\0\0\0\x04\0\0\0")?;
+    let mut header = [0u8; 14];
+    socket.read_exact(&mut header)?;
+    let len = u32::from_le_bytes(header[6..10].try_into()?) as usize;
+    ensure!(
+        &header[..6] == b"i3-ipc"
+            && u32::from_le_bytes(header[10..].try_into()?) == 4
+            && len <= 1024 * 1024,
+        "window_capture_invalid_sway_reply"
+    );
+    let mut body = vec![0; len];
+    socket.read_exact(&mut body)?;
+    let tree: serde_json::Value = serde_json::from_slice(&body)?;
+    let (identifier, geometry) = selection(&tree, id, pid)?;
+    Ok(Target {
+        compositor: peer.pid as u32,
+        identifier,
+        geometry,
+    })
+}
+fn selection(
+    tree: &serde_json::Value,
+    id: u64,
+    pid: u32,
+) -> Result<(String, (i64, i64, u64, u64))> {
+    fn collect<'a>(v: &'a serde_json::Value, id: u64, out: &mut Vec<&'a serde_json::Value>) {
+        if v["id"].as_u64() == Some(id) {
+            out.push(v);
+        }
+        for key in ["nodes", "floating_nodes"] {
+            if let Some(nodes) = v[key].as_array() {
+                for n in nodes {
+                    collect(n, id, out)
+                }
+            }
+        }
+    }
+    let mut matches = Vec::new();
+    collect(tree, id, &mut matches);
+    ensure!(
+        matches.len() == 1 && matches[0]["pid"].as_u64() == Some(pid as u64),
+        "window_capture_stale_target"
+    );
+    let node = matches[0];
+    let identifier = node["foreign_toplevel_identifier"]
+        .as_str()
+        .filter(|s| !s.is_empty())
+        .with_context(unsupported_reason)?;
+    let r = &node["rect"];
+    let geometry = (
+        r["x"].as_i64().context("x")?,
+        r["y"].as_i64().context("y")?,
+        r["width"].as_u64().context("w")?,
+        r["height"].as_u64().context("h")?,
+    );
+    Ok((identifier.into(), geometry))
+}
+fn dispatch(
+    queue: &mut EventQueue<State>,
+    state: &mut State,
+    deadline: Instant,
+    done: impl Fn(&State) -> bool,
+) -> Result<()> {
+    loop {
+        queue.dispatch_pending(state)?;
+        if done(state) {
+            return Ok(());
+        }
+        let remaining = deadline.saturating_duration_since(Instant::now());
+        ensure!(!remaining.is_zero(), "window_capture_timeout");
+        queue.flush()?;
+        let Some(guard) = queue.prepare_read() else {
+            continue;
+        };
+        let mut poll = libc::pollfd {
+            fd: guard.connection_fd().as_raw_fd(),
+            events: libc::POLLIN,
+            revents: 0,
+        };
+        let n = unsafe {
+            libc::poll(
+                &mut poll,
+                1,
+                remaining.as_millis().min(i32::MAX as u128) as i32,
+            )
+        };
+        if n < 0 && std::io::Error::last_os_error().kind() == std::io::ErrorKind::Interrupted {
+            continue;
+        }
+        ensure!(n > 0, "window_capture_timeout");
+        guard.read()?;
+    }
+}
+fn roundtrip(
+    conn: &Connection,
+    queue: &mut EventQueue<State>,
+    state: &mut State,
+    deadline: Instant,
+) -> Result<()> {
+    state.sync = false;
+    conn.display().sync(&queue.handle(), ());
+    dispatch(queue, state, deadline, |s| s.sync)
+}
+struct Buffer {
+    fd: i32,
+    ptr: *mut libc::c_void,
+    size: usize,
+}
+impl Drop for Buffer {
+    fn drop(&mut self) {
+        super::cleanup_mmap(self.ptr, self.size, self.fd)
+    }
+}
+pub fn capture(id: u64, pid: u32) -> Result<Vec<u8>> {
+    let before = target(id, pid)?;
+    let conn = Connection::connect_to_env()?;
+    let mut cred: libc::ucred = unsafe { std::mem::zeroed() };
+    let mut len = std::mem::size_of_val(&cred) as libc::socklen_t;
+    ensure!(
+        unsafe {
+            libc::getsockopt(
+                conn.as_fd().as_raw_fd(),
+                libc::SOL_SOCKET,
+                libc::SO_PEERCRED,
+                (&mut cred as *mut libc::ucred).cast(),
+                &mut len,
+            )
+        } == 0
+            && cred.pid as u32 == before.compositor
+            && cred.uid == unsafe { libc::geteuid() },
+        "window_capture_compositor_mismatch"
+    );
+    let mut queue = conn.new_event_queue::<State>();
+    let qh = queue.handle();
+    let mut state = State::default();
+    let deadline = Instant::now() + Duration::from_secs(4);
+    conn.display().get_registry(&qh, ());
+    roundtrip(&conn, &mut queue, &mut state, deadline)?;
+    ensure!(
+        state.list.is_some() && state.source.is_some() && state.manager.is_some(),
+        "{}: ext per-toplevel image capture is not offered",
+        unsupported_reason()
+    );
+    roundtrip(&conn, &mut queue, &mut state, deadline)?;
+    roundtrip(&conn, &mut queue, &mut state, deadline)?;
+    let matches: Vec<_> = state
+        .handles
+        .values()
+        .filter(|(_, ident, done)| *done && ident == &before.identifier)
+        .collect();
+    ensure!(matches.len() == 1, "window_capture_stale_target");
+    let handle = matches[0].0.clone();
+    let source = state
+        .source
+        .as_ref()
+        .unwrap()
+        .create_source(&handle, &qh, ());
+    let session =
+        state
+            .manager
+            .as_ref()
+            .unwrap()
+            .create_session(&source, manager::Options::empty(), &qh, ());
+    dispatch(&mut queue, &mut state, deadline, |s| s.specs || s.failed)?;
+    ensure!(
+        !state.failed
+            && state.width > 0
+            && state.height > 0
+            && u64::from(state.width) * u64::from(state.height) <= 32 * 1024 * 1024,
+        "window_capture_invalid_dimensions"
+    );
+    let format = state.format.context("window_capture_unsupported_format")?;
+    let captured_spec = (state.width, state.height, state.format);
+    let size = state.width as usize * state.height as usize * 4;
+    let (fd, ptr) = super::anon_shm(size)?;
+    let memory = Buffer { fd, ptr, size };
+    let shared = unsafe { super::borrowed_fd(fd) };
+    let pool = state.shm.as_ref().context("wl_shm missing")?.create_pool(
+        shared.as_fd(),
+        size as i32,
+        &qh,
+        (),
+    );
+    let buffer = pool.create_buffer(
+        0,
+        state.width as i32,
+        state.height as i32,
+        (state.width * 4) as i32,
+        format,
+        &qh,
+        (),
+    );
+    let frame = session.create_frame(&qh, ());
+    frame.attach_buffer(&buffer);
+    frame.damage_buffer(0, 0, state.width as i32, state.height as i32);
+    frame.capture();
+    dispatch(&mut queue, &mut state, deadline, |s| s.ready || s.failed)?;
+    ensure!(
+        state.ready
+            && !state.failed
+            && !state.transformed
+            && state.handles.contains_key(&handle.id().protocol_id()),
+        "window_capture_stale_or_transformed_target"
+    );
+    ensure!(
+        (state.width, state.height, state.format) == captured_spec,
+        "window_capture_buffer_changed"
+    );
+    ensure!(target(id, pid)? == before, "window_capture_stale_target");
+    ensure!(
+        (u64::from(state.width), u64::from(state.height)) == (before.geometry.2, before.geometry.3),
+        "window_capture_frame_geometry_unproven"
+    );
+    let pixels = unsafe { std::slice::from_raw_parts(memory.ptr.cast::<u8>(), size) };
+    super::ext_screencopy::encode_buffer_to_png(
+        pixels,
+        state.width,
+        state.height,
+        state.width * 4,
+        format,
+    )
+}
+impl Dispatch<wl_registry::WlRegistry, ()> for State {
+    fn event(
+        s: &mut Self,
+        r: &wl_registry::WlRegistry,
+        e: wl_registry::Event,
+        _: &(),
+        _: &Connection,
+        q: &QueueHandle<Self>,
+    ) {
+        if let wl_registry::Event::Global {
+            name, interface, ..
+        } = e
+        {
+            match interface.as_str() {
+                "wl_shm" => s.shm = Some(r.bind(name, 1, q, ())),
+                "ext_foreign_toplevel_list_v1" => s.list = Some(r.bind(name, 1, q, ())),
+                "ext_foreign_toplevel_image_capture_source_manager_v1" => {
+                    s.source = Some(r.bind(name, 1, q, ()))
+                }
+                "ext_image_copy_capture_manager_v1" => s.manager = Some(r.bind(name, 1, q, ())),
+                _ => {}
+            }
+        }
+    }
+}
+impl Dispatch<wl_callback::WlCallback, ()> for State {
+    fn event(
+        s: &mut Self,
+        _: &wl_callback::WlCallback,
+        _: wl_callback::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        s.sync = true;
+    }
+}
+impl Dispatch<list::ExtForeignToplevelListV1, ()> for State {
+    fn event(
+        _: &mut Self,
+        _: &list::ExtForeignToplevelListV1,
+        _: list::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+    }
+    event_created_child!(State,list::ExtForeignToplevelListV1,[list::EVT_TOPLEVEL_OPCODE => (handle::ExtForeignToplevelHandleV1,())]);
+}
+impl Dispatch<handle::ExtForeignToplevelHandleV1, ()> for State {
+    fn event(
+        s: &mut Self,
+        h: &handle::ExtForeignToplevelHandleV1,
+        e: handle::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        let id = h.id().protocol_id();
+        match e {
+            handle::Event::Identifier { identifier } => {
+                s.handles.insert(id, (h.clone(), identifier, false));
+            }
+            handle::Event::Done => {
+                if let Some(v) = s.handles.get_mut(&id) {
+                    v.2 = true;
+                }
+            }
+            handle::Event::Closed => {
+                s.handles.remove(&id);
+            }
+            _ => {}
+        }
+    }
+}
+impl Dispatch<session::ExtImageCopyCaptureSessionV1, ()> for State {
+    fn event(
+        s: &mut Self,
+        _: &session::ExtImageCopyCaptureSessionV1,
+        e: session::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        match e {
+            session::Event::BufferSize { width, height } => {
+                s.width = width;
+                s.height = height;
+            }
+            session::Event::ShmFormat { format } => {
+                if let Ok(f) = format.into_result() {
+                    if matches!(f, wl_shm::Format::Argb8888 | wl_shm::Format::Xrgb8888) {
+                        s.format = Some(f)
+                    }
+                }
+            }
+            session::Event::Done => s.specs = true,
+            session::Event::Stopped => s.failed = true,
+            _ => {}
+        }
+    }
+}
+impl Dispatch<frame::ExtImageCopyCaptureFrameV1, ()> for State {
+    fn event(
+        s: &mut Self,
+        _: &frame::ExtImageCopyCaptureFrameV1,
+        e: frame::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        match e {
+            frame::Event::Ready => s.ready = true,
+            frame::Event::Failed { .. } => s.failed = true,
+            frame::Event::Transform { transform } => {
+                s.transformed = transform.into_result().ok()
+                    != Some(wayland_client::protocol::wl_output::Transform::Normal)
+            }
+            _ => {}
+        }
+    }
+}
+delegate_noop!(State:ignore wl_shm::WlShm);
+delegate_noop!(State:ignore wl_shm_pool::WlShmPool);
+delegate_noop!(State:ignore wl_buffer::WlBuffer);
+delegate_noop!(State:ignore manager::ExtImageCopyCaptureManagerV1);
+delegate_noop!(State:ignore source_manager::ExtForeignToplevelImageCaptureSourceManagerV1);
+delegate_noop!(State:ignore source::ExtImageCaptureSourceV1);
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn source_identity_must_come_from_the_exact_ipc_target() {
+        let mut tree = serde_json::json!({"id":7,"pid":42,"foreign_toplevel_identifier":"unique-7","rect":{"x":0,"y":0,"width":80,"height":60}});
+        assert_eq!(selection(&tree, 7, 42).unwrap().0, "unique-7");
+        assert!(selection(&tree, 7, 43).is_err());
+        assert!(selection(&tree, 8, 42).is_err());
+        tree.as_object_mut()
+            .unwrap()
+            .remove("foreign_toplevel_identifier");
+        assert!(selection(&tree, 7, 42)
+            .unwrap_err()
+            .to_string()
+            .contains(UNSUPPORTED));
+    }
+}
