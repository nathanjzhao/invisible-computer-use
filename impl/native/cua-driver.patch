+/// filter is unit-tested without AX.
+fn without_system_menu<T>(
+    parent_role: &str,
+    children: Vec<T>,
+    role_of: impl Fn(&T) -> String,
+    release: impl Fn(T),
+) -> Vec<T> {
+    let mut kept = Vec::with_capacity(children.len());
+    for (index, child) in children.into_iter().enumerate() {
+        let skip = index == 0
+            && parent_role == "AXMenuBar"
+            && super::system_menu::is_system_menu_item(parent_role, index, &role_of(&child));
+        if skip {
+            release(child);
+        } else {
+            kept.push(child);
+        }
+    }
+    kept
+}
