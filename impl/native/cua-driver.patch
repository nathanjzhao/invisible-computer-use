+/// A Wayland foreground-input failure. `foreground_unavailable` (no trusted
+/// compositor adapter can confirm the exact target, so nothing was sent) and a
+/// stale element are typed refusals; anything else stays an error.
+fn wayland_foreground_error(error: &anyhow::Error) -> ToolResult {
+    if let Some(refusal) = stale_target_refusal(error) {
+        return refusal;
+    }
+    let message = format!("{error:#}");
+    if message.starts_with(crate::wayland::portal::SETUP_REFUSED) {
+        let reason = classify_desktop_input_failure(&message).unwrap_or(crate::wayland::portal::REQUEST_FAILED);
+        return ToolResult::error(format!("foreground_input_unavailable ({reason}): {message}")).with_structured(json!({
+            "code": "foreground_input_unavailable", "reason": reason, "effect": "refused", "detail": message,
+        }));
+    }
+    if message.starts_with("foreground_unavailable") {
+        return ToolResult::error(message.clone()).with_structured(json!({
+            "code": "foreground_unavailable",
+            "detail": message,
+        }));
+    }
+    ToolResult::error(message)
+}
