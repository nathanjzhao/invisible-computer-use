+            &["WAYLAND_DISPLAY"],
+        );
+        let mut driver = sway.driver(false);
+        let listed = driver.call("list_windows", serde_json::json!({}));
+        let pids: Vec<u64> = listed.structured()["windows"]
+            .as_array()
+            .map(|windows| windows.iter().filter_map(|window| window["pid"].as_u64()).collect())
+            .unwrap_or_default();
