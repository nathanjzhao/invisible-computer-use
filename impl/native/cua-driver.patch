diff --git a/libs/cua-driver/rust/crates/platform-linux/src/wayland/window_capture.rs b/libs/cua-driver/rust/crates/platform-linux/src/wayland/window_capture.rs
new file mode 100644
index 00000000..0bc40e6d
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-linux/src/wayland/window_capture.rs
@@ -0,0 +1,294 @@
+//! Window-owned compositor pixels. No output capture or rectangle fallback.
+use anyhow::{bail, ensure, Context, Result};
+use base64::{engine::general_purpose::STANDARD, Engine};
+use serde::Deserialize;
+use std::{os::unix::fs::MetadataExt, time::Duration};
+
+const LIMIT: usize = 48 * 1024 * 1024;
+const TIMEOUT: Duration = Duration::from_secs(5);
+
+#[derive(Clone, Copy)]
+struct Helper {
+    name: &'static str,
+    path: &'static str,
+    desktop: &'static str,
+    executable: &'static str,
+    identity_version: u32,
+    capture_version: u32,
+    snapshot: &'static str,
+}
+const GNOME: Helper = Helper {
+    name: "org.cua.WinRects",
+    path: "/org/cua/WinRects",
+    desktop: "org.gnome.Shell",
+    executable: "gnome-shell",
+    identity_version: 8,
+    capture_version: 9,
+    snapshot: "GetRects",
+};
+const KWIN: Helper = Helper {
+    name: "org.cua.KWinTarget",
+    path: "/org/cua/KWinTarget",
+    desktop: "org.kde.KWin",
+    executable: "kwin_wayland",
+    identity_version: 1,
+    capture_version: 2,
+    snapshot: "GetWindows",
+};
+
+#[derive(Debug, Deserialize, PartialEq, Eq)]
+struct Window {
+    #[serde(alias = "token")]
+    id: u64,
+    pid: u32,
+    x: i32,
+    y: i32,
+    w: u32,
+    h: u32,
+    minimized: bool,
+}
+#[derive(Deserialize)]
+struct Frame {
+    version: u32,
+    id: u64,
+    pid: u32,
+    x: i32,
+    y: i32,
+    w: u32,
+    h: u32,
+    png: String,
+}
+fn select(raw: &str, id: u64, pid: u32) -> Result<Window> {
+    ensure!(
+        raw.len() <= 1024 * 1024,
+        "window_capture_snapshot_too_large"
+    );
+    let windows: Vec<Window> = serde_json::from_str(raw)?;
+    ensure!(windows.len() <= 4096, "window_capture_snapshot_too_large");
+    let mut ids = std::collections::HashSet::new();
+    ensure!(
+        windows
+            .iter()
+            .all(|w| w.id != 0 && w.pid != 0 && ids.insert(w.id)),
+        "window_capture_ambiguous_identity"
+    );
+    windows
+        .into_iter()
+        .find(|w| w.id == id && w.pid == pid && !w.minimized && w.w > 0 && w.h > 0)
+        .context("window_capture_stale_target")
+}
+fn validate(raw: &str, before: &Window, after: &Window, version: u32) -> Result<Vec<u8>> {
+    ensure!(raw.len() <= LIMIT, "window_capture_frame_too_large");
+    let frame: Frame = serde_json::from_str(raw)?;
+    ensure!(
+        before == after
+            && frame.version == version
+            && frame.id == before.id
+            && frame.pid == before.pid,
+        "window_capture_stale_target"
+    );
+    ensure!(
+        (frame.x, frame.y, frame.w, frame.h) == (before.x, before.y, before.w, before.h),
+        "window_capture_geometry_changed"
+    );
+    let png = STANDARD.decode(frame.png)?;
+    ensure!(
+        png.starts_with(b"\x89PNG\r\n\x1a\n"),
+        "window_capture_invalid_png"
+    );
+    let (w, h) = crate::capture::png_dimensions_pub(&png)?;
+    ensure!(
+        w > 0 && h > 0 && u64::from(w) * u64::from(h) <= 32 * 1024 * 1024,
+        "window_capture_invalid_dimensions"
+    );
+    ensure!(
+        u64::from(w) * u64::from(before.h) == u64::from(h) * u64::from(before.w),
+        "window_capture_invalid_scale"
+    );
+    // Return logical frame pixels so the existing screenshot/action binding is exact.
+    if (w, h) == (before.w, before.h) {
+        return Ok(png);
+    }
+    let img = image::load_from_memory(&png)?.resize_exact(
+        before.w,
+        before.h,
+        image::imageops::FilterType::Lanczos3,
+    );
+    let mut out = std::io::Cursor::new(Vec::new());
+    img.write_to(&mut out, image::ImageFormat::Png)?;
+    Ok(out.into_inner())
+}
+fn trusted_executable(pid: u32, name: &str) -> bool {
+    let Ok(path) = std::fs::read_link(format!("/proc/{pid}/exe")) else {
+        return false;
+    };
+    path.file_name().and_then(|v| v.to_str()) == Some(name)
+        && std::fs::metadata(path).is_ok_and(|m| m.uid() == 0 && m.mode() & 0o022 == 0)
+}
+
+fn verify_owner(owner: &str, desktop: &str, uid: u32, expected_uid: u32) -> Result<()> {
+    ensure!(
+        owner.starts_with(':') && owner == desktop,
+        "window_capture_untrusted_helper_owner"
+    );
+    ensure!(
+        uid == expected_uid,
+        "window_capture_untrusted_compositor_uid"
+    );
+    Ok(())
+}
+fn verify_versions(helper: Helper, identity: u32, capture: u32) -> Result<()> {
+    ensure!(
+        identity == helper.identity_version && capture == helper.capture_version,
+        "window_capture_unsupported_helper_protocol"
+    );
+    Ok(())
+}
+
+async fn capture_async(id: u64, pid: u32) -> Result<Vec<u8>> {
+    ensure!(id > 0 && pid > 0, "window_capture_stale_target");
+    let connection = zbus::Connection::session().await?;
+    let bus = zbus::fdo::DBusProxy::new(&connection).await?;
+    for helper in [GNOME, KWIN] {
+        if !bus.name_has_owner(helper.name.try_into()?).await? {
+            continue;
+        }
+        let owner = bus.get_name_owner(helper.name.try_into()?).await?;
+        let desktop_owner = bus.get_name_owner(helper.desktop.try_into()?).await?;
+
+        let uid = bus
+            .get_connection_unix_user(owner.as_str().try_into()?)
+            .await?;
+        let compositor_pid = bus
+            .get_connection_unix_process_id(owner.as_str().try_into()?)
+            .await?;
+        verify_owner(owner.as_str(), desktop_owner.as_str(), uid, unsafe {
+            libc::geteuid()
+        })?;
+        if !trusted_executable(compositor_pid, helper.executable) {
+            ensure!(
+                helper.name == KWIN.name,
+                "window_capture_untrusted_compositor"
+            );
+            super::kwin_peer::verify(compositor_pid, uid)
+                .context("window_capture_untrusted_compositor")?;
+        }
+        let proxy = zbus::Proxy::new(&connection, owner.as_str(), helper.path, helper.name).await?;
+        let identity: u32 = proxy.call("GetVersion", &()).await?;
+        let version: u32 = proxy.call("GetCaptureVersion", &()).await?;
+        verify_versions(helper, identity, version)?;
+        let raw: String = proxy.call(helper.snapshot, &()).await?;
+        let before = select(&raw, id, pid)?;
+        let pixels: String = proxy.call("CaptureWindow", &(id, pid)).await?;
+        let raw: String = proxy.call(helper.snapshot, &()).await?;
+        let after = select(&raw, id, pid)?;
+        ensure!(
+            bus.get_name_owner(helper.name.try_into()?).await? == owner
+                && bus.get_name_owner(helper.desktop.try_into()?).await? == owner,
+            "window_capture_helper_restarted"
+        );
+        return validate(&pixels, &before, &after, version);
+    }
+    bail!("window_capture_unsupported_compositor: no verified per-window source is available")
+}
+
+pub fn capture(id: u64, pid: Option<u32>) -> Result<Vec<u8>> {
+    let pid = pid.context("window_capture_pid_required")?;
+    if std::env::var_os("SWAYSOCK").is_some() {
+        return super::toplevel_capture::capture(id, pid);
+    }
+    std::thread::spawn(move || {
+        let rt = tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()?;
+        rt.block_on(async {
+            tokio::time::timeout(TIMEOUT, capture_async(id, pid))
+                .await
+                .context("window_capture_timeout")?
+        })
+    })
+    .join()
+    .map_err(|_| anyhow::anyhow!("window capture worker panicked"))?
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn helper_owner_and_capture_protocol_are_pinned() {
+        assert!(verify_owner(":1.4", ":1.4", 1000, 1000).is_ok());
+        assert!(verify_owner(":1.4", ":1.5", 1000, 1000).is_err());
+        assert!(verify_owner("org.gnome.Shell", "org.gnome.Shell", 1000, 1000).is_err());
+        assert!(verify_owner(":1.4", ":1.4", 1001, 1000).is_err());
+        for helper in [GNOME, KWIN] {
+            assert!(
+                verify_versions(helper, helper.identity_version, helper.capture_version).is_ok()
+            );
+            assert!(
+                verify_versions(helper, helper.identity_version + 1, helper.capture_version)
+                    .is_err()
+            );
+            assert!(
+                verify_versions(helper, helper.identity_version, helper.capture_version + 1)
+                    .is_err()
+            );
+        }
+        assert!(!trusted_executable(std::process::id(), "gnome-shell"));
+    }
+    fn window() -> Window {
+        Window {
+            id: 17,
+            pid: 42,
+            x: 10,
+            y: 20,
+            w: 4,
+            h: 3,
+            minimized: false,
+        }
+    }
+    fn frame() -> String {
+        let mut bytes = std::io::Cursor::new(Vec::new());
+        image::DynamicImage::ImageRgba8(image::RgbaImage::from_pixel(
+            4,
+            3,
+            image::Rgba([200, 0, 200, 255]),
+        ))
+        .write_to(&mut bytes, image::ImageFormat::Png)
+        .unwrap();
+        serde_json::json!({"id":17,"pid":42,"version":9,"x":10,"y":20,"w":4,"h":3,"png":STANDARD.encode(bytes.into_inner())}).to_string()
+    }
+    #[test]
+    fn capture_requires_same_identity_geometry_and_protocol() {
+        let w = window();
+        assert!(validate(&frame(), &w, &w, 9).is_ok());
+        for field in ["id", "pid", "version", "x", "y", "w", "h"] {
+            let mut f: serde_json::Value = serde_json::from_str(&frame()).unwrap();
+            f[field] = serde_json::json!(999);
+            assert!(validate(&f.to_string(), &w, &w, 9).is_err(), "{field}");
+        }
+        let mut changed = window();
+        changed.pid += 1;
+        assert!(validate(&frame(), &w, &changed, 9).is_err());
+        changed = window();
+        changed.x += 1;
+        assert!(validate(&frame(), &w, &changed, 9).is_err());
+    }
+    #[test]
+    fn capture_snapshot_rejects_stale_minimized_and_duplicate_targets() {
+        let raw = r#"[{"id":17,"pid":42,"x":10,"y":20,"w":4,"h":3,"minimized":false}]"#;
+        assert_eq!(select(raw, 17, 42).unwrap(), window());
+        assert!(select(raw, 17, 43).is_err());
+        assert!(select(raw, 18, 42).is_err());
+        assert!(select(&raw.replace("false", "true"), 17, 42).is_err());
+        let repeated = format!("[{},{}]", &raw[1..raw.len() - 1], &raw[1..raw.len() - 1]);
+        assert!(select(&repeated, 17, 42).is_err());
+    }
+    #[test]
+    fn capture_rejects_wrong_pixel_dimensions() {
+        let mut w = window();
+        w.w = 5;
+        let mut f: serde_json::Value = serde_json::from_str(&frame()).unwrap();
+        f["w"] = 5.into();
+        assert!(validate(&f.to_string(), &w, &w, 9).is_err());
+    }
+}
diff --git a/libs/cua-driver/rust/crates/platform-linux/src/wayland/kwin_peer.rs b/libs/cua-driver/rust/crates/platform-linux/src/wayland/kwin_peer.rs
new file mode 100644
index 00000000..f6a581b2
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-linux/src/wayland/kwin_peer.rs
@@ -0,0 +1,242 @@
+//! Attest stock file-capability KWin using its Wayland transport and launcher.
+//! /proc/PID/exe is intentionally unreadable after KWin gains CAP_SYS_NICE.
+use anyhow::{ensure, Context, Result};
+use std::{
+    io::Write,
+    os::{
+        fd::AsRawFd,
+        unix::{fs::MetadataExt, net::UnixStream},
+    },
+    path::{Path, PathBuf},
+    time::Duration,
+};
+
+fn root_program(path: &Path, name: &str) -> bool {
+    path.file_name().and_then(|s| s.to_str()) == Some(name)
+        && std::fs::metadata(path)
+            .is_ok_and(|m| m.uid() == 0 && m.mode() & 0o022 == 0 && m.is_file())
+}
+fn status(pid: u32, key: &str) -> Option<String> {
+    std::fs::read_to_string(format!("/proc/{pid}/status"))
+        .ok()?
+        .lines()
+        .find_map(|l| l.strip_prefix(key).map(|v| v.trim().to_owned()))
+}
+fn wrapper_program(pid: u32) -> Result<PathBuf> {
+    let wrapper = std::fs::read_link(format!("/proc/{pid}/exe"))?;
+    ensure!(
+        root_program(&wrapper, "kwin_wayland_wrapper"),
+        "untrusted KWin listener"
+    );
+    let env = std::fs::read(format!("/proc/{pid}/environ"))?;
+    let path = env
+        .split(|v| *v == 0)
+        .find_map(|v| v.strip_prefix(b"PATH="))
+        .context("wrapper PATH missing")?;
+    let path = std::str::from_utf8(path)?;
+    let binary = path
+        .split(':')
+        .map(|p| Path::new(p).join("kwin_wayland"))
+        .find(|p| p.is_file())
+        .context("wrapper KWin executable missing")?;
+    ensure!(
+        binary.is_absolute() && root_program(&binary, "kwin_wayland"),
+        "untrusted KWin executable"
+    );
+    // A capability exec strips loader injection variables. Require the exact
+    // root-provisioned effective CAP_SYS_NICE file capability used by stock KDE.
+    use std::os::unix::ffi::OsStrExt;
+    let cpath = std::ffi::CString::new(binary.as_os_str().as_bytes())?;
+    let mut cap = [0u8; 24];
+    let len = unsafe {
+        libc::getxattr(
+            cpath.as_ptr(),
+            c"security.capability".as_ptr(),
+            cap.as_mut_ptr().cast(),
+            cap.len(),
+        )
+    };
+    ensure!(
+        len == 20 && valid_capability(&cap[..20]),
+        "unexpected KWin file capability"
+    );
+    Ok(binary)
+}
+
+fn valid_capability(cap: &[u8]) -> bool {
+    cap.len() == 20
+        && cap[..4] == 0x02000001u32.to_le_bytes()
+        && cap[4..8] == (1u32 << 23).to_le_bytes()
+        && cap[8..20].iter().all(|v| *v == 0)
+}
+
+pub fn verify(pid: u32, uid: u32) -> Result<()> {
+    let display = std::env::var_os("WAYLAND_DISPLAY").context("Wayland socket missing")?;
+    let display = PathBuf::from(display);
+    let path = if display.is_absolute() {
+        display
+    } else {
+        PathBuf::from(std::env::var_os("XDG_RUNTIME_DIR").context("runtime directory missing")?)
+            .join(display)
+    };
+    let mut stream = UnixStream::connect(path)?;
+    stream.set_read_timeout(Some(Duration::from_millis(800)))?;
+    stream.set_write_timeout(Some(Duration::from_millis(800)))?;
+    let fd = stream.as_raw_fd();
+    let mut peer: libc::ucred = unsafe { std::mem::zeroed() };
+    let mut len = std::mem::size_of::<libc::ucred>() as libc::socklen_t;
+    ensure!(
+        unsafe {
+            libc::getsockopt(
+                fd,
+                libc::SOL_SOCKET,
+                libc::SO_PEERCRED,
+                (&mut peer as *mut libc::ucred).cast(),
+                &mut len,
+            )
+        } == 0
+            && peer.uid == uid
+            && peer.pid > 0,
+        "Wayland listener credentials differ"
+    );
+    let listener = peer.pid as u32;
+    if listener != pid {
+        wrapper_program(listener)?;
+        ensure!(
+            status(pid, "PPid:").as_deref() == Some(&listener.to_string()),
+            "KWin is not the listener's child"
+        );
+    } else {
+        let executable = std::fs::read_link(format!("/proc/{pid}/exe"))?;
+        ensure!(
+            root_program(&executable, "kwin_wayland"),
+            "untrusted direct KWin listener"
+        );
+    }
+    ensure!(
+        status(pid, "CapPrm:")
+            .as_deref()
+            .and_then(|v| u64::from_str_radix(v, 16).ok())
+            == Some(1 << 23),
+        "KWin capability identity differs"
+    );
+    enable_credentials(fd)?;
+    // wl_display.sync(new_id=2). No registry access, capture, or input.
+    let request: Vec<u8> = [1u32, 12u32 << 16, 2u32]
+        .into_iter()
+        .flat_map(u32::to_ne_bytes)
+        .collect();
+    stream.write_all(&request)?;
+    receive_reply(&stream, pid, uid)
+}
+
+fn enable_credentials(fd: std::os::fd::RawFd) -> Result<()> {
+    let enabled: libc::c_int = 1;
+    ensure!(
+        unsafe {
+            libc::setsockopt(
+                fd,
+                libc::SOL_SOCKET,
+                libc::SO_PASSCRED,
+                (&enabled as *const libc::c_int).cast(),
+                std::mem::size_of_val(&enabled) as _,
+            )
+        } == 0,
+        "credential subscription failed"
+    );
+    Ok(())
+}
+
+fn receive_reply(stream: &UnixStream, pid: u32, uid: u32) -> Result<()> {
+    let fd = stream.as_raw_fd();
+    let mut bytes = [0u8; 64];
+    let mut control = [0usize; 16];
+    let mut iov = libc::iovec {
+        iov_base: bytes.as_mut_ptr().cast(),
+        iov_len: bytes.len(),
+    };
+    let mut msg: libc::msghdr = unsafe { std::mem::zeroed() };
+    msg.msg_iov = &mut iov;
+    msg.msg_iovlen = 1;
+    msg.msg_control = control.as_mut_ptr().cast();
+    msg.msg_controllen = std::mem::size_of_val(&control);
+    let n = unsafe { libc::recvmsg(fd, &mut msg, 0) };
+    ensure!(
+        n >= 12 && msg.msg_flags & (libc::MSG_CTRUNC | libc::MSG_TRUNC) == 0,
+        "missing Wayland sync reply"
+    );
+    ensure!(
+        u32::from_ne_bytes(bytes[0..4].try_into()?) == 2
+            && u32::from_ne_bytes(bytes[4..8].try_into()?) == 12 << 16,
+        "unexpected Wayland sync reply"
+    );
+    let mut found = false;
+    unsafe {
+        let mut cmsg = libc::CMSG_FIRSTHDR(&msg);
+        while !cmsg.is_null() {
+            if (*cmsg).cmsg_level == libc::SOL_SOCKET
+                && (*cmsg).cmsg_type == libc::SCM_CREDENTIALS
+                && (*cmsg).cmsg_len
+                    >= libc::CMSG_LEN(std::mem::size_of::<libc::ucred>() as _) as usize
+            {
+                let writer = std::ptr::read_unaligned(libc::CMSG_DATA(cmsg).cast::<libc::ucred>());
+                ensure!(
+                    writer.pid == pid as i32 && writer.uid == uid,
+                    "Wayland reply is not from the helper owner"
+                );
+                found = true;
+            }
+            cmsg = libc::CMSG_NXTHDR(&msg, cmsg);
+        }
+    }
+    ensure!(found, "Wayland reply credentials missing");
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn file_capability_must_be_exact_effective_sys_nice() {
+        let cap: Vec<u8> = [0x02000001u32, 1 << 23, 0, 0, 0]
+            .into_iter()
+            .flat_map(u32::to_le_bytes)
+            .collect();
+        assert!(valid_capability(&cap));
+        assert!(!valid_capability(&cap[..19]));
+        for index in [0, 3, 4, 7, 8, 12, 16] {
+            let mut altered = cap.clone();
+            altered[index] ^= 1;
+            assert!(!valid_capability(&altered), "byte {index}");
+        }
+    }
+    fn reply(bytes: &[u8], credentials: bool, pid: u32, uid: u32) -> Result<()> {
+        let (receiver, mut sender) = UnixStream::pair()?;
+        receiver.set_read_timeout(Some(Duration::from_millis(100)))?;
+        if credentials {
+            enable_credentials(receiver.as_raw_fd())?;
+        }
+        sender.write_all(bytes)?;
+        drop(sender);
+        receive_reply(&receiver, pid, uid)
+    }
+    #[test]
+    fn sync_reply_requires_kernel_writer_identity_and_wire_header() {
+        let bytes: Vec<u8> = [2u32, 12 << 16, 123]
+            .into_iter()
+            .flat_map(u32::to_ne_bytes)
+            .collect();
+        let pid = std::process::id();
+        let uid = unsafe { libc::geteuid() };
+        assert!(reply(&bytes, true, pid, uid).is_ok());
+        assert!(reply(&bytes, true, pid + 1, uid).is_err());
+        assert!(reply(&bytes, true, pid, uid + 1).is_err());
+        assert!(reply(&bytes, false, pid, uid).is_err());
+        assert!(reply(&bytes[..8], true, pid, uid).is_err());
+        for index in [0, 4, 6] {
+            let mut bad = bytes.clone();
+            bad[index] ^= 1;
+            assert!(reply(&bad, true, pid, uid).is_err());
+        }
+    }
+}
