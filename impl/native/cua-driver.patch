+#[cfg(test)]
+mod desktop_input_refusal_tests {
+    use super::*;
+
+    #[test]
+    fn an_unanswered_remote_desktop_consent_is_typed_not_a_bare_string() {
+        let waiting = format!("{} within 20s; the desktop portal may be waiting", crate::wayland::LIBEI_READY_TIMEOUT_MARKER);
+        assert_eq!(classify_desktop_input_failure(&waiting), Some("portal_consent_timeout"));
+        let result = desktop_input_refusal("desktop-scope click", &waiting);
+        assert_eq!(result.is_error, Some(true));
+        let structured = result.structured_content.expect("a typed refusal carries structured content");
+        assert_eq!(structured["code"], DESKTOP_INPUT_UNAVAILABLE);
+        assert_eq!(structured["reason"], "portal_consent_timeout");
+        assert!(structured["detail"].as_str().unwrap().contains("within 20s"));
+    }
+
+    #[test]
+    fn window_portal_setup_refusal_preserves_reason_and_zero_effect() {
+        for detail in [crate::wayland::LIBEI_READY_TIMEOUT_MARKER, crate::wayland::portal::CONSENT_DENIED,
+                       crate::wayland::portal::REQUEST_FAILED, crate::wayland::portal::SETUP_CANCELLED] {
+            let error = anyhow::anyhow!("{}: failed to obtain EIS connection: {detail}", crate::wayland::portal::SETUP_REFUSED);
+            let result = wayland_foreground_error(&error).structured_content.unwrap();
+            assert_eq!(result["code"], "foreground_input_unavailable");
+            assert_eq!(result["reason"], classify_desktop_input_failure(detail).unwrap());
+            assert_eq!(result["effect"], "refused");
+        }
+        // An acknowledgement timeout may follow delivered frames. Never
+        // infer refusal from the timeout marker without the setup boundary.
+        assert!(wayland_foreground_error(&anyhow::anyhow!(crate::wayland::LIBEI_READY_TIMEOUT_MARKER)).structured_content.is_none());
+    }
+
+    #[test]
+    fn explicit_portal_responses_are_not_consent_timeouts() {
