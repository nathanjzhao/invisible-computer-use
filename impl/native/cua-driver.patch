@@ -0,0 +1,21 @@
+#!/usr/bin/env python3
+"""Hold an active keyboard grab on the root window, as an open menu does, with
+no fullscreen window. usage: grab_keyboard.py READY_FILE"""
+import ctypes
+import sys
+import time
+
+x = ctypes.cdll.LoadLibrary('libX11.so.6')
+x.XOpenDisplay.restype = ctypes.c_void_p
+x.XOpenDisplay.argtypes = [ctypes.c_char_p]
+x.XDefaultRootWindow.restype = ctypes.c_ulong
+x.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
+x.XGrabKeyboard.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_ulong]
+x.XFlush.argtypes = [ctypes.c_void_p]
+display = x.XOpenDisplay(None)
+status = x.XGrabKeyboard(display, x.XDefaultRootWindow(display), 0, 1, 1, 0)
+x.XFlush(display)
+with open(sys.argv[1], 'w') as f:
+    f.write(str(status))
+while True:
+    time.sleep(60)
diff --git a/libs/cua-driver/rust/crates/cua-driver/tests/linux_review/mod.rs b/libs/cua-driver/rust/crates/cua-driver/tests/linux_review/mod.rs
new file mode 100644
index 00000000..103766bb
--- /dev/null
+++ b/libs/cua-driver/rust/crates/cua-driver/tests/linux_review/mod.rs
@@ -0,0 +1,1492 @@
+//! Linux cells added after the 2026-09-25 adversarial review found behaviours
+//! the catalog could not observe: typed capture refusals, popup surfaces,
+//! window-bound pixel clicks, stale and relabelled element targets, the X11
+//! locker signature, and native Wayland sessions (nested sway and mutter).
+//! Each cell's comment names the regression it must turn red.
+//!
+//! Fixtures live beside this file: `review_gtk.py` (GTK3, one JSON event per
+//! line) and `grab_keyboard.py`. The nested compositors run inside the
+//! runner's own X display, so the cell video (recorded on that display) shows
+//! them.
+
+use super::*;
+
+use std::path::{Path, PathBuf};
+
+use cua_driver_testkit::linux_x11;
+use cua_driver_testkit::sentinel::ForegroundSentinel;
+use cua_driver_testkit::e2e::CaseSpec;
+
+fn review_dir() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/linux_review")
+}
+
+fn wait_until(what: &str, timeout: Duration, mut check: impl FnMut() -> bool) {
+    let deadline = Instant::now() + timeout;
+    while Instant::now() < deadline {
+        if check() {
+            return;
+        }
+        std::thread::sleep(Duration::from_millis(100));
+    }
+    panic!("timed out waiting for {what}");
+}
+
+fn refusal_code(response: &ToolResponse) -> Option<String> {
+    let structured = response.structured();
+    structured["code"]
+        .as_str()
+        .or_else(|| structured["refusal"]["code"].as_str())
+        .map(str::to_owned)
+}
+
+/// One `review_gtk.py` process and its event log.
+struct Receiver {
+    pid: u32,
+    log: PathBuf,
+    cmd: PathBuf,
+    _dir: tempfile::TempDir,
+}
+
+impl Receiver {
+    fn spawn(driver: &mut McpDriver, mode: &str, env: &[(&str, &str)], remove: &[&str]) -> Self {
+        let dir = tempfile::tempdir().expect("receiver directory");
+        let log = dir.path().join("events.jsonl");
+        let cmd = dir.path().join("cmd");
+        let mut command = Command::new("python3");
+        command
+            .arg(review_dir().join("review_gtk.py"))
+            .arg(mode)
+            .arg(&log)
+            .arg(&cmd)
+            .stdout(Stdio::inherit())
+            .stderr(Stdio::inherit());
+        for key in remove {
+            command.env_remove(key);
+        }
+        for (key, value) in env {
+            command.env(key, value);
+        }
+        driver
+            .reaper()
+            .spawn(&mut command)
+            .unwrap_or_else(|error| panic!("launch review fixture {mode}: {error}"));
+        let mut receiver = Self {
+            pid: 0,
+            log,
+            cmd,
+            _dir: dir,
+        };
+        wait_until(&format!("review fixture {mode} ready"), Duration::from_secs(20), || {
+            receiver.events().iter().any(|event| event["hit"] == "ready")
+        });
+        receiver.pid = receiver
+            .events()
+            .iter()
+            .find(|event| event["hit"] == "ready")
+            .and_then(|event| event["pid"].as_u64())
+            .expect("ready event carries the fixture pid") as u32;
+        driver.reaper().track_pid(receiver.pid);
+        receiver
+    }
+
+    fn events(&self) -> Vec<serde_json::Value> {
+        std::fs::read_to_string(&self.log)
+            .unwrap_or_default()
+            .lines()
+            .filter_map(|line| serde_json::from_str(line).ok())
+            .collect()
+    }
+
+    fn send(&self, command: &str) {
+        let applied = |events: &[serde_json::Value]| {
+            events
+                .iter()
+                .filter(|event| event["hit"] == "applied" || event["hit"] == "cmd_error")
+                .count()
+        };
+        let before = applied(&self.events());
+        std::fs::write(&self.cmd, format!("{command}\n")).expect("write fixture command");
+        wait_until(&format!("fixture to apply {command:?}"), Duration::from_secs(5), || {
+            applied(&self.events()) > before
+        });
+        let events = self.events();
+        let last = events
+            .iter()
+            .rev()
+            .find(|event| event["hit"] == "applied" || event["hit"] == "cmd_error")
+            .unwrap();
+        assert_eq!(last["hit"], "applied", "fixture command failed: {last}");
+        std::thread::sleep(Duration::from_millis(600));
+    }
+
+    /// `window:label:button` of every button press or release since `start`.
+    fn buttons_since(&self, start: usize, hit: &str) -> Vec<String> {
+        self.events()[start..]
+            .iter()
+            .filter(|event| event["hit"] == hit)
+            .map(|event| {
+                format!(
+                    "{}:{}:{}",
+                    event["window"].as_str().unwrap_or(""),
+                    event["label"].as_str().unwrap_or(""),
+                    event["button"]
+                )
+            })
+            .collect()
+    }
+
+    fn clicks_since(&self, start: usize) -> Vec<String> {
+        self.events()[start..]
+            .iter()
+            .filter(|event| event["hit"] == "clicked")
+            .map(|event| {
+                format!(
+                    "{}:{}",
+                    event["window"].as_str().unwrap_or(""),
+                    event["label"].as_str().unwrap_or("")
+                )
+            })
+            .collect()
+    }
+}
+
+fn window_titled(driver: &mut McpDriver, pid: u32, title: &str) -> u64 {
+    let mut found = None;
+    wait_until(&format!("window {title:?}"), Duration::from_secs(12), || {
+        let windows = driver.call("list_windows", serde_json::json!({ "pid": pid as i64 }));
+        found = windows.structured()["windows"].as_array().and_then(|windows| {
+            windows.iter().find_map(|window| {
+                window["title"]
+                    .as_str()
+                    .unwrap_or("")
+                    .contains(title)
+                    .then(|| window["window_id"].as_u64())
+                    .flatten()
+            })
+        });
+        found.is_some()
+    });
+    found.unwrap()
+}
+
+fn token_for(state: &ToolResponse, label: &str) -> String {
+    element_token(state, label)
+}
