+/// window-local pixels, so the origin is not compared.
+pub fn verify_binding(binding: &PixelBinding, frame: &WindowPxFrame) -> Result<(), ToolResult> {
+    binding.verify(Some(CurrentGeometry {
+        size: (frame.bounds.width, frame.bounds.height),
+        scale: Some(frame.scale),
+    }))
+}
