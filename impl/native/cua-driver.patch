+/// the actual rounded region used by the capture command with the bytes.
+fn capture_transient_with<F>(_window_id: u32, bounds: &crate::windows::WindowBounds, capture: F)
+    -> anyhow::Result<(Vec<u8>, crate::windows::WindowBounds)>
+where F: FnOnce(&[String]) -> anyhow::Result<Vec<u8>> {
