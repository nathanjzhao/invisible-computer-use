+/// Read the window's current text selection and focused element (spec 01/19: the system-wide
+/// selection reader Codex exposes and cua otherwise lacks). Returns a formatted focused-element
+/// line, the selected text, and the focused document/field text, each only when the focused
+/// element actually belongs to `window_id` (so a selection in another window is never reported).
+fn read_selection(pid: i32, window_id: u32) -> (Option<String>, Option<String>, Option<String>) {
+    use crate::ax::bindings::{copy_string_attr, focused_element_of_pid, AXUIElementRef};
+    use core_foundation::base::CFRelease;
+    unsafe {
+        let Some(el) = focused_element_of_pid(pid) else { return (None, None, None) };
+        if crate::ax::exact_target::element_window_id(el) != Some(window_id) {
+            CFRelease(el as _);
+            return (None, None, None);
+        }
+        let ne = |s: Option<String>| s.filter(|s| !s.is_empty());
+        let role = copy_string_attr(el, "AXRole").unwrap_or_default();
+        let title = ne(copy_string_attr(el, "AXTitle"));
+        let value = ne(copy_string_attr(el, "AXValue"));
+        let selected = ne(copy_string_attr(el, "AXSelectedText"));
+        let focused_line = Some(match &title {
+            Some(t) => format!("{role} \"{t}\""),
+            None => role.clone(),
+        });
+        // document text: the value of a text-bearing focused element, else its AXDocument
+        let is_text = matches!(role.as_str(), "AXTextArea" | "AXTextField" | "AXComboBox" | "AXSearchField" | "AXWebArea" | "AXStaticText");
+        let document_text = if is_text { value.clone() } else { ne(copy_string_attr(el, "AXDocument")) };
+        CFRelease(el as _);
+        (focused_line, selected, document_text)
+    }
+}
