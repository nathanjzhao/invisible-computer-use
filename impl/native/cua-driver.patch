+        anyhow::bail!("invalid transient capture region");
+    }
+    let region = crate::windows::WindowBounds {
+        x: bounds.x.floor(), y: bounds.y.floor(),
+        width: (bounds.x + bounds.width).ceil() - bounds.x.floor(),
+        height: (bounds.y + bounds.height).ceil() - bounds.y.floor(),
+    };
+    let args = vec!["-R".to_string(), format!("{},{},{},{}", region.x, region.y, region.width, region.height)];
+    let bytes = capture(&args)?;
+    let (w, h) = png_dimensions(&bytes)?;
+    crate::tools::px_frame::validate_capture_frame(_window_id, &region, w, h)
+        .map_err(|e| anyhow::anyhow!("transient capture frame mismatch: {e:?}"))?;
+    Ok((bytes, region))
+}
