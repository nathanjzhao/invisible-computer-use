+/// The size PrintWindow paints for a window whose DPI differs from its
+/// monitor's (DPI-unaware, or system-aware on a monitor of another scale).
+/// `None` when the window paints at its physical size.
+unsafe fn virtualized_paint_size(hwnd: HWND, w: i32, h: i32) -> Option<(i32, i32)> {
+    use windows::Win32::Graphics::Gdi::{MonitorFromWindow, MONITOR_DEFAULTTONEAREST};
+    use windows::Win32::UI::HiDpi::{GetDpiForMonitor, GetDpiForWindow, MDT_EFFECTIVE_DPI};
+    let window_dpi = GetDpiForWindow(hwnd) as i64;
+    let (mut monitor_dpi, mut unused) = (0u32, 0u32);
+    GetDpiForMonitor(
+        MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST),
+        MDT_EFFECTIVE_DPI,
+        &mut monitor_dpi,
+        &mut unused,
+    )
+    .ok()?;
+    virtualized_size(w, h, window_dpi, monitor_dpi as i64)
+}
+
+fn virtualized_size(w: i32, h: i32, window_dpi: i64, monitor_dpi: i64) -> Option<(i32, i32)> {
+    if window_dpi <= 0 || monitor_dpi <= 0 || window_dpi == monitor_dpi {
+        return None;
+    }
+    let scale = |v: i32| ((v as i64 * window_dpi + monitor_dpi / 2) / monitor_dpi).max(1) as i32;
+    Some((scale(w), scale(h)))
+}
+
