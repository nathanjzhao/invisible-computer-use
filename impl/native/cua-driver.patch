+/// Environment variable overriding the whole-call `get_desktop_state` deadline, in milliseconds.
+const DESKTOP_CAPTURE_TIMEOUT_ENV: &str = "CUA_DRIVER_RS_DESKTOP_CAPTURE_TIMEOUT_MS";
+const DESKTOP_CAPTURE_TIMEOUT_MARKER: &str = "desktop-capture-timeout";
+
+/// The `get_desktop_state` deadline: the override when it parses to a positive number of
+/// milliseconds (capped at ten minutes), else 30 s (above the 15 s portal deadline, so a
+/// portal timeout is reported as such).
+fn desktop_capture_deadline(env: Option<&str>) -> std::time::Duration {
+    let ms = env
+        .and_then(|v| v.trim().parse::<u64>().ok())
+        .filter(|ms| *ms > 0)
+        .map(|ms| ms.min(600_000))
+        .unwrap_or(30_000);
+    std::time::Duration::from_millis(ms)
+}
+
+/// `get_desktop_state` failure with a code a caller can branch on. Under
+/// rootless XWayland desktop capture cannot work at all; say so instead of
+/// passing the X server's BadMatch through.
+fn desktop_capture_error(error: &anyhow::Error) -> ToolResult {
+    desktop_capture_refusal(
+        &error.to_string(),
+        crate::wayland::is_wayland(),
+        crate::capture::is_rootless_xwayland(),
+        std::env::var_os("WAYLAND_DISPLAY").is_some(),
+    )
+}
+
+/// `(code, reason)` of a failed desktop capture, from the error text and the session kind.
+/// Pure so the classification is testable without a compositor.
+fn classify_desktop_capture_failure(
+    error: &str,
+    wayland: bool,
+    rootless_xwayland: bool,
+    wayland_display_set: bool,
+) -> (&'static str, Option<&'static str>) {
+    for reason in [crate::wayland::portal::CONSENT_DENIED, crate::wayland::portal::REQUEST_FAILED, crate::wayland::portal::SETUP_CANCELLED] {
+        if error.contains(reason) {
+            return (crate::capture::DESKTOP_CAPTURE_UNAVAILABLE, Some(reason));
+        }
+    }
+    if error.contains(DESKTOP_CAPTURE_TIMEOUT_MARKER) {
+        return (crate::capture::DESKTOP_CAPTURE_UNAVAILABLE, Some("capture_timeout"));
+    }
+    if error.contains(crate::wayland::portal_screenshot::PORTAL_TIMEOUT_MARKER) {
+        return (crate::capture::DESKTOP_CAPTURE_UNAVAILABLE, Some("portal_timeout"));
+    }
+    if rootless_xwayland {
+        return (crate::capture::DESKTOP_CAPTURE_UNAVAILABLE, Some("xwayland_root_not_capturable"));
+    }
+    if wayland {
+        // every native tier failed and the X11 fallback has no framebuffer to read
+        return (crate::capture::DESKTOP_CAPTURE_UNAVAILABLE, Some("wayland_capture_unavailable"));
+    }
+    if wayland_display_set && error.contains("DISPLAY variable not set") {
+        // a pure Wayland session (no XWayland) with the native backend off: there is nothing
+        // to capture through at all until the backend is opted in
+        return (crate::capture::DESKTOP_CAPTURE_UNAVAILABLE, Some("wayland_backend_not_enabled"));
+    }
+    ("capture_failed", None)
+}
+
+fn desktop_capture_refusal(
+    error: &str,
+    wayland: bool,
+    rootless_xwayland: bool,
+    wayland_display_set: bool,
+) -> ToolResult {
+    let (code, reason) =
+        classify_desktop_capture_failure(error, wayland, rootless_xwayland, wayland_display_set);
+    let env = crate::wayland::ENABLE_WAYLAND_ENV;
+    let (message, suggestion) = match reason {
+        Some("portal_consent_denied") | Some("portal_request_failed") => {
+            let hint = if reason == Some("portal_consent_denied") {
+                "Screenshot permission was cancelled or denied. Ask the user before requesting it again."
+            } else {
+                "The desktop portal reported a failure. Check the session's portal backend."
+            }.to_owned();
+            (format!("Desktop capture is unavailable ({error}). {hint}"), hint)
+        }
+        Some("xwayland_root_not_capturable") => {
+            let hint = format!(
+                "Set {env}=1 for compositor output capture, or capture a window with get_window_state."
+            );
+            (
+                format!(
+                    "Desktop capture is unavailable: this X server is XWayland under a Wayland \
+                     compositor, and its root window has no framebuffer. Window capture of X11 \
+                     windows still works. {hint}"
+                ),
+                hint,
+            )
+        }
+        Some("capture_timeout") | Some("portal_timeout") => {
+            let hint = "The compositor or its xdg-desktop-portal backend did not answer. A desktop \
+                        capture through the portal needs a graphical login session where the user \
+                        can grant the screenshot; capture a window with get_window_state instead."
+                .to_owned();
+            (format!("Desktop capture is unavailable: no answer in time ({error}). {hint}"), hint)
+        }
+        Some("wayland_backend_not_enabled") => {
+            let hint = format!(
+                "This is a pure Wayland session with no X server. Set {env}=1 to use the native \
+                 Wayland backend (desktop capture then needs screencopy, ext-image-copy-capture \
+                 or a granted portal screenshot)."
+            );
+            (format!("Desktop capture is unavailable: {error}. {hint}"), hint)
+        }
+        Some("wayland_capture_unavailable") => {
+            let hint = "No native screencopy, ext-image-copy-capture or portal screenshot answered. \
+                        On GNOME and KDE a desktop capture needs a real login session with portal \
+                        consent; capture a window with get_window_state instead."
+                .to_owned();
+            (format!("Desktop capture is unavailable on this Wayland session ({error}). {hint}"), hint)
+        }
+        _ => return ToolResult::error(format!("Capture error: {error}")).with_structured(json!({
+            "code": code,
+            "detail": error,
+        })),
+    };
+    ToolResult::error(message).with_structured(json!({
+        "code": code,
+        "reason": reason,
+        "detail": error,
+        "suggestion": suggestion,
+    }))
+}
+
+/// Code of a desktop-scope input call that cannot be delivered because no input route is available.
+pub(crate) const DESKTOP_INPUT_UNAVAILABLE: &str = "desktop_input_unavailable";
+
+/// `reason` of a failed desktop-scope input call, from the error text. `None` keeps the call's plain
+/// failure. Pure so it is testable without a compositor.
+fn classify_desktop_input_failure(error: &str) -> Option<&'static str> {
+    if error.contains(crate::wayland::portal::SESSION_CLOSED) {
+        return Some(crate::wayland::portal::SESSION_CLOSED);
+    }
+    for reason in [crate::wayland::portal::CONSENT_DENIED, crate::wayland::portal::REQUEST_FAILED, crate::wayland::portal::SETUP_CANCELLED] {
+        if error.contains(reason) {
+            return Some(reason);
+        }
+    }
+    if error.contains(crate::wayland::LIBEI_READY_TIMEOUT_MARKER) {
+        return Some("portal_consent_timeout");
+    }
+    if error.contains(crate::wayland::NO_VPTR_MARKER) {
+        return Some("no_input_backend");
+    }
+    None
+}
+
+/// A failed desktop-scope input call. When no route exists (no virtual-pointer protocol and no
+/// answered Remote Desktop consent) the result carries `code` `desktop_input_unavailable` and a
+/// `reason` a caller can branch on instead of a bare string.
+fn desktop_input_refusal(tool: &str, error: &str) -> ToolResult {
+    let Some(reason) = classify_desktop_input_failure(error) else {
+        return ToolResult::error(format!("{tool} failed: {error}"));
+    };
+    let suggestion = match reason {
+        "portal_session_closed" => "The desktop stopped the Remote Desktop session. Start a new driver session only after the user chooses to grant permission again.",
+        "portal_consent_denied" => "Remote Desktop permission was cancelled or denied. Start a new driver session only after the user chooses to grant permission.",
+        "portal_request_failed" => "The desktop portal could not complete the request. Check the desktop portal backend and start a new driver session.",
+        "portal_consent_timeout" => {
+            "The desktop portal did not grant Remote Desktop input in time. It raises a consent \
+             dialog the first time; a user (or a documented accessibility answer) has to accept it. \
+             Element clicks through AT-SPI need no portal."
+        }
+        _ => {
+            "This compositor has no virtual-pointer protocol and this build has no portal input. \
+             Use the portal-enabled Linux build (--features portal-input) on GNOME and KDE, or act \
+             on elements through AT-SPI."
+        }
+    };
+    ToolResult::error(format!("{tool} is unavailable: {error}")).with_structured(json!({
+        "code": DESKTOP_INPUT_UNAVAILABLE,
+        "reason": reason,
+        "detail": error,
+        "suggestion": suggestion,
+    }))
+}
