+            let result = hotkey.invoke(serde_json::json!({"pid": pid, "keys": ["cmd", "return"], "delivery_mode": mode})).await;
+            assert_eq!(code(result), "system_menu_refused", "{mode} hotkey");
+            let result = typing.invoke(serde_json::json!({"pid": pid, "text": "\n", "delivery_mode": mode})).await;
+            assert_eq!(code(result), "system_menu_refused", "{mode} type_text");
+            // before a foreground click fronts its window, which would close the menu
+            let result = click.invoke(serde_json::json!({"pid": pid, "window_id": 7, "x": 20, "y": 20, "delivery_mode": mode})).await;
+            assert_eq!(code(result), "system_menu_refused", "{mode} click");
+            let result = drag.invoke(serde_json::json!({"pid": pid, "window_id": 7, "from_x": 1, "from_y": 1, "to_x": 9, "to_y": 9, "delivery_mode": mode})).await;
+            assert_eq!(code(result), "system_menu_refused", "{mode} drag");
