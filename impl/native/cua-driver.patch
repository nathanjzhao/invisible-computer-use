+#!/usr/bin/env python3
+"""GTK3 receiver for the Linux review catalog cells.
+
+usage: review_gtk.py MODE LOG CMD
+
+MODE two-windows: one process, windows "Review Grid A" and "Review Grid B",
+  each a 3x3 grid of buttons "A-0".."A-8" / "B-0".."B-8".
+MODE stale: one window "Review Stale", buttons Alpha, Bravo, Charlie, a pool of
+  five row buttons "Item NN" rebound on scroll, and an entry.
+MODE wayland: one window "Review Wayland <name>" with a 2x2 grid and an entry,
+  logging is-active changes (the WL target under sway).
+
+Every event is one JSON line in LOG: ready (with each window's X id when on
+X11), clicked (window, label, serial), press and release (window, label,
+button), active (window, active), text.
+MODE foreign-popup:X:Y: only an override-redirect popup at root X,Y (another
+  process's menu over a target window).
+MODE layer-overlay:X:Y:W:H: a toplevel "Review Layer Owner" and a magenta
+  overlay layer-shell surface WxH at output X,Y (Wayland only).
+Commands (CMD, one per line): close B | front NAME | relabel OLD NEW | scroll N
+REVIEW_GTK_BACKGROUND=#rrggbb in the environment paints every widget of this
+process that colour (a floating window grim can find over another).
+"""
+import json
+import os
+import sys
+import time
+
+import gi
+
+gi.require_version('Gtk', '3.0')
+from gi.repository import GLib, Gtk  # noqa: E402
+
+MODE, LOG, CMD = sys.argv[1], sys.argv[2], sys.argv[3]
+serial = [0]
+windows = {}
+boxes = {}
+buttons = []
+rows = []
+first_item = [0]
+
+
+def log(**event):
+    event.update(t=time.time(), pid=os.getpid())
+    with open(LOG, 'a') as f:
+        f.write(json.dumps(event) + '\n')
+
+
+def button(name, label, box, attach=None):
+    serial[0] += 1
+    widget = Gtk.Button(label=label)
+    widget.serial = serial[0]
+    widget.window_name = name
+    widget.connect('clicked', lambda b: log(hit='clicked', window=b.window_name, label=b.get_label(), serial=b.serial))
+    for signal, hit in (('button-press-event', 'press'), ('button-release-event', 'release')):
+        widget.connect(signal, lambda b, e, hit=hit: log(hit=hit, window=b.window_name, label=b.get_label(), button=e.button) or False)
+    buttons.append(widget)
+    if attach is None:
+        box.pack_start(widget, False, False, 0)
+    else:
+        box.attach(widget, *attach)
+    return widget
+
+
+def window(name, title, x, y, width, height):
+    win = Gtk.Window(title=title)
+    win.set_default_size(width, height)
+    win.move(x, y)
+    win.connect('notify::is-active', lambda w, _p, n=name: log(hit='active', window=n, active=w.is_active()))
+    windows[name] = win
+    return win
+
+
+if MODE == 'two-windows':
+    for name, x in (('A', 60), ('B', 700)):
+        win = window(name, f'Review Grid {name}', x, 80, 480, 360)
+        grid = Gtk.Grid(row_homogeneous=True, column_homogeneous=True)
+        win.add(grid)
+        for i in range(9):
+            button(name, f'{name}-{i}', grid, (i % 3, i // 3, 1, 1))
+elif MODE == 'stale':
+    win = window('S', 'Review Stale', 60, 80, 360, 460)
+    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
+    boxes['S'] = box
+    win.add(box)
+    for label in ('Alpha', 'Bravo', 'Charlie'):
+        button('S', label, box)
+    rows.extend(button('S', f'Item {i:02d}', box) for i in range(5))
+    entry = Gtk.Entry()
+    entry.connect('changed', lambda e: log(hit='text', window='S', text=e.get_text()))
+    box.pack_start(entry, False, False, 0)
+elif MODE.startswith('wayland'):
+    name = MODE.split(':', 1)[1] if ':' in MODE else 'WL'
+    win = window(name, f'Review Wayland {name}', 0, 0, 480, 360)
+    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
+    win.add(box)
+    grid = Gtk.Grid(row_homogeneous=True, column_homogeneous=True)
+    box.pack_start(grid, True, True, 0)
+    for i in range(4):
+        button(name, f'{name}-{i}', grid, (i % 2, i // 2, 1, 1))
+    entry = Gtk.Entry()
+    entry.connect('changed', lambda e, n=name: log(hit='text', window=n, text=e.get_text()))
+    box.pack_start(entry, False, False, 0)
+    # Window-bound text goes to the focused widget; make that the entry.
+    win.set_focus(entry)
+elif MODE.startswith('layer-overlay:'):
+    # A toplevel plus a magenta overlay layer surface WxH at root X,Y, from one
+    # process: a panel or OSD of an app that also has a window.
+    gi.require_version('GtkLayerShell', '0.1')
+    from gi.repository import Gdk, GtkLayerShell  # noqa: E402
+    _, x, y, w, h = MODE.split(':')
+    window('T', 'Review Layer Owner', 0, 0, 240, 120).add(Gtk.Label(label='layer owner'))
+    layer = Gtk.Window()
+    GtkLayerShell.init_for_window(layer)
+    GtkLayerShell.set_layer(layer, GtkLayerShell.Layer.OVERLAY)
+    for edge, margin in ((GtkLayerShell.Edge.LEFT, x), (GtkLayerShell.Edge.TOP, y)):
+        GtkLayerShell.set_anchor(layer, edge, True)
+        GtkLayerShell.set_margin(layer, edge, int(margin))
+    layer.set_size_request(int(w), int(h))
+    css = Gtk.CssProvider()
+    css.load_from_data(b'window { background-color: #ff00ff; }')
+    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
+    windows['L'] = layer
+elif MODE.startswith('foreign-popup:'):
+    _, x, y = MODE.split(':')
+    popup = Gtk.Window(type=Gtk.WindowType.POPUP)
+    popup.add(Gtk.Label(label='FOREIGN POPUP'))
+    popup.set_default_size(160, 60)
+    popup.move(int(x), int(y))
+    windows['P'] = popup
+else:
+    raise SystemExit(f'unknown mode {MODE}')
+
+if os.environ.get('REVIEW_GTK_BACKGROUND'):
+    from gi.repository import Gdk  # noqa: E402
+    paint = Gtk.CssProvider()
+    paint.load_from_data(f'* {{ background-color: {os.environ["REVIEW_GTK_BACKGROUND"]}; background-image: none; }}'.encode())
+    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), paint, Gtk.STYLE_PROVIDER_PRIORITY_USER)
+
+
+def apply(command):
+    op, *args = command.split(' ', 1)
+    if op == 'close':
+        windows.pop(args[0]).destroy()
+    elif op == 'front':
+        widget = button('S', args[0], boxes['S'])
+        boxes['S'].reorder_child(widget, 0)
+        widget.show()
+    elif op == 'relabel':
+        old, new = args[0].split()
+        next(b for b in buttons if b.get_label() == old).set_label(new)
+    elif op == 'scroll':
+        first_item[0] += int(args[0])
+        for offset, row in enumerate(rows):
+            row.set_label(f'Item {first_item[0] + offset:02d}')
+    else:
+        raise ValueError(op)
+    log(hit='applied', cmd=command)
+
+
+def poll():
+    if os.path.exists(CMD):
+        lines = [line.strip() for line in open(CMD) if line.strip()]
+        os.remove(CMD)
+        for line in lines:
+            try:
+                apply(line)
+            except Exception as error:  # noqa: BLE001
+                log(hit='cmd_error', cmd=line, error=repr(error))
+    return True
+
+
+def ready():
+    xids = {}
+    for name, win in windows.items():
+        gdk = win.get_window()
+        xids[name] = gdk.get_xid() if hasattr(gdk, 'get_xid') else None
+    log(hit='ready', xids=xids)
+    return False
+
+
+GLib.timeout_add(50, poll)
+for win in windows.values():
+    win.connect('destroy', lambda *_: None if windows else Gtk.main_quit())
+    win.show_all()
+GLib.timeout_add(800, ready)
+Gtk.main()
