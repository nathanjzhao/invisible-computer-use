+/// A pixel click addressed to a closed window of a live process is refused as
+/// stale and fires nothing in the process's other window. Red under
+/// `displays` (the click lands in window A).
+#[test]
+#[ignore]
+fn harness_gtk3_closed_window_left_click_px_background() {
+    let case = two_window_case("closed_window_left_click", true);
+    let cell_id = case.cell_id.clone();
+    execute_case(case, |evidence| {
+        let mut driver = McpDriver::spawn_named(&cell_id).expect("start source-built Linux driver");
+        *evidence = recording_evidence(driver.recording_dir());
+        let fixture = Receiver::spawn(&mut driver, "two-windows", &[], &[]);
+        let pid = fixture.pid;
+        let window_a = window_titled(&mut driver, pid, "Review Grid A");
+        let window_b = window_titled(&mut driver, pid, "Review Grid B");
+        let state = snapshot(&mut driver, pid, window_b);
+        let (x, y, width, height) = element_rect(&mut driver, pid, window_b, &state, "B-4");
+        fixture.send("close B");
+        wait_until("window B to be destroyed", Duration::from_secs(5), || {
+            linux_x11::window_rect(window_b).is_err()
+        });
+        let before = fixture.events().len();
+        let (response, mut passed) = run_with_background_oracles(
+            &mut driver,
+            TargetWindow { pid, native_id: window_a },
+            |driver| {
+                driver.call(
+                    "click",
+                    serde_json::json!({
+                        "pid": pid as i64, "window_id": window_b,
+                        "x": x + width / 2.0, "y": y + height / 2.0,
+                        "delivery_mode": "background"
+                    }),
+                )
+            },
+        )
+        .unwrap_or_else(|error| panic!("background desktop contract failed: {error}"));
+        // What the cell exists to prove comes first: no click fired in the process's other window.
+        // The typed code is checked after it, so a driver that lets the click land fails here, as a
+        // landing click, and not as a different refusal code.
+        std::thread::sleep(Duration::from_millis(500));
+        assert_eq!(
+            fixture.clicks_since(before),
+            Vec::<String>::new(),
+            "a click fired after the target window was closed (response: {})",
+            response.text()
+        );
+        assert!(response.is_error(), "click on a closed window succeeded: {}", response.text());
+        assert_eq!(refusal_code(&response).as_deref(), Some("stale_window_target"), "{}", response.text());
+        passed.push(OracleKind::FixtureState);
+        Observation::refused(
+            RefusalCode::StaleWindowTarget,
+            passed,
+            "pixel click on a closed window refused as stale",
+            Evidence::default(),
+        )
+    });
+}
