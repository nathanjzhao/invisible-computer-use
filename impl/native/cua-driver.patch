+        "xkb_keymap {{\nxkb_keycodes \"cua\" {{\n{keycodes}}};\nxkb_types \"cua\" {{ include \"complete\" }};\n\
+         xkb_compatibility \"cua\" {{ include \"complete\" }};\nxkb_symbols \"cua\" {{\n{symbols}}};\n}};\n"
+    )
