+/// A bare keyboard grab (an open menu) is not a lock. Red under `lockany`
+/// (any held grab reads as locked).
+#[test]
+#[ignore]
+fn harness_x11_menu_grab_type_text_ax_background() {
+    host_cell("linux-x11-menu-grab-type-text-ax-background", false);
+}
