+/// takes no pointer input from here.
+#[cfg(target_os = "windows")]
+fn point_in_window(hwnd: u64, x: i32, y: i32) -> bool {
+    #[repr(C)]
+    struct Rect {
+        left: i32,
+        top: i32,
+        right: i32,
+        bottom: i32,
+    }
+    #[link(name = "user32")]
+    extern "system" {
+        fn GetWindowRect(hwnd: *mut std::ffi::c_void, rect: *mut Rect) -> i32;
+    }
+    let mut rect = Rect { left: 0, top: 0, right: 0, bottom: 0 };
+    let ok = unsafe { GetWindowRect(hwnd as usize as *mut std::ffi::c_void, &mut rect) };
+    ok != 0 && x >= rect.left && x < rect.right && y >= rect.top && y < rect.bottom
+}
