+pub use native::STALE_TARGET;
+
+/// What the last token-issuing snapshot per (pid, window) observed at each
+/// app-wide element index: the meaning key (accessible object, role and
+/// label). Tokens name an index; this is what lets an actuator prove the index
+/// still names the observed object and that the object still says what the
+/// model saw. Nothing rebinds a key after issue, not even this driver's own
+/// write: an element labelled by its own text (an unnamed entry) refuses
+/// `stale_element_target` on the next action once its text changed, because
+/// an app that re-sorts or recycles rows on edit changes the text in exactly
+/// the same way (round-3 review O1). The model re-observes.
+type SnapshotKeys = std::collections::HashMap<(u32, u64), std::collections::HashMap<usize, u64>>;
+fn snapshot_keys() -> &'static std::sync::Mutex<SnapshotKeys> {
+    static KEYS: std::sync::OnceLock<std::sync::Mutex<SnapshotKeys>> = std::sync::OnceLock::new();
+    KEYS.get_or_init(Default::default)
+}
+
+/// Record the objects a native AT-SPI snapshot handed out indices for.
+/// Untrusted (X11 property) snapshots carry no object identity and clear it.
+pub fn record_snapshot_keys(pid: u32, xid: u64, nodes: &[AtspiNode], trusted: bool) {
+    let mut keys = snapshot_keys().lock().unwrap_or_else(|e| e.into_inner());
+    if !trusted {
+        keys.remove(&(pid, xid));
+        return;
+    }
+    let map = nodes
+        .iter()
+        .filter(|n| n.element_key != 0)
+        .filter_map(|n| {
+            let name = n.name.as_deref().unwrap_or("");
+            let key = native::meaning_key(n.element_key, &n.role, name, n.name_from_text);
+            n.element_index.map(|idx| (idx, key))
+        })
+        .collect();
+    keys.insert((pid, xid), map);
+}
+
+/// The meaning key the current snapshot of `(pid, xid)` observed at `idx`.
+pub fn expected_key(pid: u32, xid: u64, idx: usize) -> Option<u64> {
+    snapshot_keys()
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .get(&(pid, xid))
+        .and_then(|map| map.get(&idx))
+        .copied()
+}
+
+/// Same, for call sites that may lack an exact window.
+pub fn expected_key_for(pid: u32, xid: Option<u64>, idx: usize) -> Option<u64> {
+    xid.filter(|x| *x != 0).and_then(|x| expected_key(pid, x, idx))
