index 00000000..b9cd6654
--- /dev/null
+++ b/libs/cua-driver/rust/crates/cua-driver-testkit/src/linux_x11.rs
@@ -0,0 +1,128 @@
+//! Independent X11 reads and window-manager requests for Linux E2E oracles.
+//! These talk to the X server directly, never through the driver under test.
+
+#![cfg(target_os = "linux")]
+
+use x11rb::connection::Connection;
+use x11rb::protocol::xproto::{
+    AtomEnum, ClientMessageEvent, ConnectionExt as _, EventMask, MapState, Window,
+};
+use x11rb::rust_connection::RustConnection;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct Rect {
+    pub x: i32,
+    pub y: i32,
+    pub width: u32,
+    pub height: u32,
+}
+
+fn connect() -> Result<(RustConnection, Window), String> {
+    let (conn, screen) = RustConnection::connect(None).map_err(|error| error.to_string())?;
+    let root = conn.setup().roots[screen].root;
+    Ok((conn, root))
+}
+
+fn atom(conn: &RustConnection, name: &str) -> Result<u32, String> {
+    Ok(conn
+        .intern_atom(false, name.as_bytes())
+        .map_err(|error| error.to_string())?
+        .reply()
+        .map_err(|error| error.to_string())?
+        .atom)
+}
+
+fn window_pid(conn: &RustConnection, window: Window) -> Option<u32> {
+    let pid_atom = atom(conn, "_NET_WM_PID").ok()?;
+    conn.get_property(false, window, pid_atom, AtomEnum::CARDINAL, 0, 1)
+        .ok()?
+        .reply()
+        .ok()?
+        .value32()?
+        .next()
+}
+
+/// Mapped override-redirect root children (menus, tooltips) with their owner
+/// pid (if published) and root geometry, bottom to top.
+pub fn override_redirect_windows() -> Result<Vec<(u64, Option<u32>, Rect)>, String> {
+    let (conn, root) = connect()?;
+    let children = conn
+        .query_tree(root)
+        .map_err(|error| error.to_string())?
+        .reply()
+        .map_err(|error| error.to_string())?
+        .children;
+    let mut found = Vec::new();
+    for child in children {
+        let Ok(Ok(attributes)) = conn.get_window_attributes(child).map(|cookie| cookie.reply()) else {
+            continue;
+        };
+        if !attributes.override_redirect || attributes.map_state != MapState::VIEWABLE {
+            continue;
+        }
+        let Ok(Ok(geometry)) = conn.get_geometry(child).map(|cookie| cookie.reply()) else {
+            continue;
+        };
+        found.push((
+            u64::from(child),
+            window_pid(&conn, child),
+            Rect {
+                x: i32::from(geometry.x),
+                y: i32::from(geometry.y),
+                width: u32::from(geometry.width),
+                height: u32::from(geometry.height),
+            },
+        ));
+    }
+    Ok(found)
+}
+
+/// Root-relative rectangle of a client window.
+pub fn window_rect(window: u64) -> Result<Rect, String> {
+    let (conn, root) = connect()?;
+    let window = u32::try_from(window).map_err(|_| "not an X11 window id".to_owned())?;
+    let geometry = conn
+        .get_geometry(window)
+        .map_err(|error| error.to_string())?
+        .reply()
+        .map_err(|error| error.to_string())?;
+    let origin = conn
+        .translate_coordinates(window, root, 0, 0)
+        .map_err(|error| error.to_string())?
+        .reply()
+        .map_err(|error| error.to_string())?;
+    Ok(Rect {
+        x: i32::from(origin.dst_x),
+        y: i32::from(origin.dst_y),
+        width: u32::from(geometry.width),
+        height: u32::from(geometry.height),
+    })
+}
+
+pub fn is_viewable(window: u64) -> Result<bool, String> {
+    let (conn, _) = connect()?;
+    let window = u32::try_from(window).map_err(|_| "not an X11 window id".to_owned())?;
+    let attributes = conn
+        .get_window_attributes(window)
+        .map_err(|error| error.to_string())?
+        .reply()
+        .map_err(|error| error.to_string())?;
+    Ok(attributes.map_state == MapState::VIEWABLE)
+}
+
+/// Ask the window manager to iconify `window` (ICCCM WM_CHANGE_STATE).
+pub fn iconify(window: u64) -> Result<(), String> {
+    let (conn, root) = connect()?;
+    let window = u32::try_from(window).map_err(|_| "not an X11 window id".to_owned())?;
+    let change_state = atom(&conn, "WM_CHANGE_STATE")?;
+    const ICONIC_STATE: u32 = 3;
+    let event = ClientMessageEvent::new(32, window, change_state, [ICONIC_STATE, 0, 0, 0, 0]);
+    conn.send_event(
+        false,
+        root,
+        EventMask::SUBSTRUCTURE_REDIRECT | EventMask::SUBSTRUCTURE_NOTIFY,
+        event,
+    )
+    .map_err(|error| error.to_string())?;
+    conn.flush().map_err(|error| error.to_string())
+}
diff --git a/libs/cua-driver/rust/crates/cua-driver-testkit/src/toolkit_focus.rs b/libs/cua-driver/rust/crates/cua-driver-testkit/src/toolkit_focus.rs
new file mode 100644
index 00000000..5af4b8cc
--- /dev/null
+++ b/libs/cua-driver/rust/crates/cua-driver-testkit/src/toolkit_focus.rs
@@ -0,0 +1,142 @@
+//! X11 focus events on the foreground guard, as a toolkit sees them.
+//!
+//! The polled focus oracle reads `_NET_ACTIVE_WINDOW` and the input focus.
+//! A keyboard grab taken and released between two polls changes neither, but
+//! the X server still sends the focused window a FocusOut/FocusIn pair with
+//! mode NotifyGrab/NotifyUngrab, and GTK turns that pair into
+//! `is-active: false` then `true` (the Wayland audit's guard log). A client
+//! may select FocusChange on any window, so this watcher subscribes to the
+//! guard's top-level and records every FocusOut the toolkit would see.
+
+#[cfg(target_os = "linux")]
+mod imp {
+    use std::sync::atomic::{AtomicBool, Ordering};
+    use std::sync::{Arc, Mutex};
+    use std::time::Duration;
+
+    use x11rb::connection::Connection;
+    use x11rb::protocol::xproto::{
+        ChangeWindowAttributesAux, ConnectionExt as _, EventMask, GrabMode, NotifyDetail,
+        NotifyMode,
+    };
+    use x11rb::protocol::Event;
+    use x11rb::rust_connection::RustConnection;
+
+    #[derive(Clone, Debug, Eq, PartialEq)]
+    pub struct FocusLoss {
+        pub mode: String,
+        pub detail: String,
+    }
+
+    pub struct ToolkitFocusWatch {
+        losses: Arc<Mutex<Vec<FocusLoss>>>,
+        stop: Arc<AtomicBool>,
+        worker: Option<std::thread::JoinHandle<()>>,
+    }
+
+    impl ToolkitFocusWatch {
+        /// Watch `window` (a client top-level). `None` when X11 is not reachable.
+        pub fn start(window: u32) -> Option<Self> {
+            let (conn, _) = RustConnection::connect(None).ok()?;
+            conn.change_window_attributes(
+                window,
+                &ChangeWindowAttributesAux::new().event_mask(EventMask::FOCUS_CHANGE),
+            )
+            .ok()?
+            .check()
+            .ok()?;
+            let losses = Arc::new(Mutex::new(Vec::new()));
+            let stop = Arc::new(AtomicBool::new(false));
+            let (worker_losses, worker_stop) = (losses.clone(), stop.clone());
+            let worker = std::thread::spawn(move || {
+                while !worker_stop.load(Ordering::Acquire) {
+                    match conn.poll_for_event() {
+                        Ok(Some(Event::FocusOut(event))) if event.event == window => {
+                            // Focus moving into the guard's own child window is
+                            // not a loss of the guard's activation.
+                            if event.detail == NotifyDetail::INFERIOR
+                                || event.detail == NotifyDetail::POINTER
+                            {
+                                continue;
+                            }
+                            worker_losses
+                                .lock()
+                                .unwrap_or_else(|error| error.into_inner())
+                                .push(FocusLoss {
+                                    mode: mode_name(event.mode).to_owned(),
+                                    detail: format!("{:?}", event.detail),
+                                });
+                        }
+                        Ok(Some(_)) => {}
+                        Ok(None) => std::thread::sleep(Duration::from_millis(2)),
+                        Err(_) => return,
+                    }
+                }
+            });
+            Some(Self {
+                losses,
+                stop,
+                worker: Some(worker),
+            })
+        }
+
+        pub fn reset(&self) {
+            self.losses
+                .lock()
+                .unwrap_or_else(|error| error.into_inner())
+                .clear();
+        }
+
+        pub fn losses(&self) -> Vec<FocusLoss> {
+            // Let events already queued by the server reach the worker.
+            std::thread::sleep(Duration::from_millis(100));
+            self.losses
+                .lock()
+                .unwrap_or_else(|error| error.into_inner())
+                .clone()
+        }
+    }
+
+    impl Drop for ToolkitFocusWatch {
+        fn drop(&mut self) {
+            self.stop.store(true, Ordering::Release);
+            if let Some(worker) = self.worker.take() {
+                let _ = worker.join();
+            }
+        }
+    }
+
+    fn mode_name(mode: NotifyMode) -> &'static str {
+        match mode {
+            NotifyMode::NORMAL => "normal",
+            NotifyMode::GRAB => "grab",
+            NotifyMode::UNGRAB => "ungrab",
+            NotifyMode::WHILE_GRABBED => "while_grabbed",
+            _ => "unknown",
+        }
+    }
+
+    /// Take and release a keyboard grab on the root window from a separate
+    /// client: the exact event pattern the watcher must report. Used to prove
+    /// the oracle can fail.
+    pub fn grab_canary() -> Result<(), String> {
+        let (conn, screen) = RustConnection::connect(None).map_err(|error| error.to_string())?;
+        let root = conn.setup().roots[screen].root;
+        let status = conn
+            .grab_keyboard(false, root, x11rb::CURRENT_TIME, GrabMode::ASYNC, GrabMode::ASYNC)
+            .map_err(|error| error.to_string())?
+            .reply()
+            .map_err(|error| error.to_string())?
+            .status;
+        conn.ungrab_keyboard(x11rb::CURRENT_TIME)
+            .map_err(|error| error.to_string())?;
+        conn.flush().map_err(|error| error.to_string())?;
+        if status != x11rb::protocol::xproto::GrabStatus::SUCCESS {
+            return Err(format!("canary keyboard grab was not granted: {status:?}"));
+        }
+        Ok(())
+    }
+}
+
+#[cfg(target_os = "linux")]
+pub use imp::{grab_canary, FocusLoss, ToolkitFocusWatch};
