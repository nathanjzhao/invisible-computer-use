+/// `path` on a desktop drag: two to `MAX_PATH_POINTS` points, each `{x, y}` finite numbers.
+fn desktop_path_points(value: &Value) -> Result<Vec<(i32, i32)>, ToolResult> {
+    let Some(items) = value.as_array() else {
+        return Err(desktop_gesture_refusal("path must be an array of {x, y} points."));
+    };
+    if items.len() < 2 || items.len() > crate::pointer_plan::MAX_PATH_POINTS {
+        return Err(desktop_gesture_refusal(format!(
+            "path needs 2 to {} points; got {}.",
+            crate::pointer_plan::MAX_PATH_POINTS,
+            items.len()
+        )));
+    }
+    let mut points = Vec::with_capacity(items.len());
+    for (i, item) in items.iter().enumerate() {
+        let x = item.get("x").and_then(Value::as_f64).filter(|v| v.is_finite());
+        let y = item.get("y").and_then(Value::as_f64).filter(|v| v.is_finite());
+        match (x, y) {
+            (Some(x), Some(y)) => points.push((x.round() as i32, y.round() as i32)),
+            _ => {
+                return Err(desktop_gesture_refusal(format!(
+                    "path[{i}] must be an object with finite numbers x and y."
+                )))
+            }
+        }
+    }
+    Ok(points)
+}
