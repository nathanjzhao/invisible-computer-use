+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum FocusRelation {
+    /// No element was addressed.
+    NotAddressed,
+    /// The app does not report a focused element.
+    Unknown,
+    /// Focus is on the element, inside it (a web view's focused node) or on
+    /// an ancestor that contains it.
+    Related,
+    /// Focus is on an unrelated element.
+    Other,
