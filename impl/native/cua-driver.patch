+///
+/// A driver bundled inside an app (Copilot.app/Contents/MacOS/cua-driver)
+/// inherits that bundle's Info.plist, which has no `LSUIElement` because the
+/// app itself needs its Dock icon. The first Window Server connection (the
+/// permission gate, a window list) then registers the daemon as a Foreground
+/// app, and `serve --no-overlay` got its own Dock tile named after the app.
+/// The overlay and PiP paths already set the Accessory policy; this is the
+/// same call for the UI-less path. Main thread only, and skipped without a
+/// graphic session, where touching NSApplication aborts (issue #1724).
+pub fn become_accessory_app() {
+    if !session::has_graphic_access() {
+        return;
+    }
+    use objc2::runtime::AnyObject;
+    use objc2::{class, msg_send};
+    if objc2_foundation::MainThreadMarker::new().is_none() {
+        return;
+    }
+    unsafe {
+        let app: *mut AnyObject = msg_send![class!(NSApplication), sharedApplication];
+        // NSApplicationActivationPolicyAccessory = 1: no Dock icon, no menu bar.
+        let _: bool = msg_send![app, setActivationPolicy: 1i64];
+    }
+}
