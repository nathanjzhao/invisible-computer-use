+fn capture_failure_error(
+    xid: u64,
+    failure: &crate::capture::CaptureFailure,
+    error: &anyhow::Error,
+) -> Value {
+    json!({
+        "code": failure.code,
+        "window_id": xid,
+        "message": failure.message,
+        "suggestion": failure.suggestion,
+        "detail": format!("{error:#}"),
+    })
+}
+
+/// The `screenshots` array (spec 07) for an X11 window: the target at zIndex 0
+/// plus each same-process popup above it. Returns nothing when there is no
+/// popup, so the common single-surface response is unchanged. X11 root pixels
+/// are the only screen space, so the "logical" extent equals root pixels.
+fn x11_window_surfaces(xid: u64, pid: u32, target_b64: &str, w: u32, h: u32, max_dim: u32) -> Vec<Value> {
+    let popups = crate::x11::transient_surfaces_over(xid, pid);
+    if popups.is_empty() {
+        return Vec::new();
+    }
+    let Some(target) = crate::x11::capture_state(xid) else {
+        return Vec::new();
+    };
+    let mut surfaces = vec![x11_surface(0, xid, target_b64, w, h, target.rect)];
+    for popup in popups {
+        use base64::{engine::general_purpose::STANDARD as B64, Engine as _};
+        // A popup that closes between enumeration and capture is omitted.
+        let Ok(raw) = crate::capture::screenshot_window_bytes(popup.xid) else { continue };
+        let Ok(png) = crate::capture::resize_png_if_needed(&raw, max_dim) else { continue };
+        let Ok((pw, ph)) = crate::capture::png_dimensions_pub(&png) else { continue };
+        let mut surface = x11_surface(surfaces.len(), popup.xid, &B64.encode(&png), pw, ph, popup.rect);
+        surface["capture_method"] = json!("x11_override_redirect_window");
+        surfaces.push(surface);
+    }
+    if surfaces.len() == 1 { Vec::new() } else { surfaces }
+}
+
+fn x11_surface(index: usize, window_id: u64, b64: &str, pixel_width: u32, pixel_height: u32, rect: (i32, i32, u32, u32)) -> Value {
+    let (x, y, width, height) = rect;
+    json!({
+        "id": format!("screenshot-{index}"), "zIndex": index, "window_id": window_id,
+        "originX": x, "originY": y, "width": width, "height": height,
+        "coordinate_space": "logical", "pixel_width": pixel_width, "pixel_height": pixel_height,
+        "scale_x": f64::from(pixel_width) / f64::from(width.max(1)),
+        "scale_y": f64::from(pixel_height) / f64::from(height.max(1)),
+        "mime_type": "image/png", "png_b64": b64
+    })
+}
