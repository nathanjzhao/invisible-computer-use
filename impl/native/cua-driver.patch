@@ -0,0 +1,252 @@
+//! The same public SCK discovery/capture APIs, with NSError identity intact.
+//!
+//! screencapturekit 6.0.1's Swift callbacks retain only localizedDescription.
+//! Keep that crate for video and PNG conversion; this narrow bridge preserves
+//! error domain/code for window capture without parsing localized messages.
+
+use block2::RcBlock;
+use objc2::rc::{Allocated, Retained};
+use objc2::runtime::{AnyClass, AnyObject};
+use objc2::{msg_send, msg_send_id, sel};
+use objc2_foundation::{NSArray, NSError, NSRect};
+use screencapturekit::cg::CGRect;
+use screencapturekit::screenshot_manager::CGImage;
+use std::sync::mpsc;
+
+pub(super) const ERROR_DOMAIN: &str = "com.apple.ScreenCaptureKit.SCStreamErrorDomain";
+
+#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]
+#[error("{operation}: {domain} ({code}): {description}")]
+pub(super) struct CaptureError {
+    pub operation: &'static str,
+    pub domain: String,
+    pub code: isize,
+    pub description: String,
+}
+
+impl CaptureError {
+    pub fn is_permission_denied(&self) -> bool {
+        self.domain == ERROR_DOMAIN && self.code == -3801
+    }
+
+    // The callback owns neither NSError nor its strings. Copy every field
+    // before returning to Apple; late completion never uses borrowed memory.
+    unsafe fn from_nserror(operation: &'static str, error: &NSError) -> Self {
+        Self {
+            operation,
+            domain: error.domain().to_string(),
+            code: error.code(),
+            description: error.localizedDescription().to_string(),
+        }
+    }
+}
+
+/// Retained SCK content/window/filter/config, never exposed outside this module.
+/// SCK permits these objects on worker queues. Content/windows are immutable;
+/// filter/config are configured before publication and never mutated afterward.
+struct Object(Retained<AnyObject>);
+unsafe impl Send for Object {}
+unsafe impl Sync for Object {}
+
+pub(super) struct Window {
+    object: Object,
+    pub frame: CGRect,
+    pub owner_pid: i32,
+    pub layer: i32,
+}
+
+pub(super) struct Plan {
+    filter: Object,
+    config: Object,
+    pub content_rect: CGRect,
+    pub scale: f64,
+}
+
+fn rect(rect: NSRect) -> CGRect {
+    CGRect::new(
+        rect.origin.x,
+        rect.origin.y,
+        rect.size.width,
+        rect.size.height,
+    )
+}
+
+fn required_class(name: &str) -> anyhow::Result<&'static AnyClass> {
+    AnyClass::get(name)
+        .ok_or_else(|| anyhow::anyhow!("{name} is unavailable on this macOS version"))
+}
+
+fn screenshot_class() -> anyhow::Result<&'static AnyClass> {
+    let class = required_class("SCScreenshotManager")?;
+    if !class
+        .metaclass()
+        .responds_to(sel!(captureImageWithFilter:configuration:completionHandler:))
+    {
+        anyhow::bail!("SCScreenshotManager image capture is unavailable on this macOS version");
+    }
+    Ok(class)
+}
+
+pub(super) fn window(window_id: u32) -> anyhow::Result<Window> {
+    // Check macOS 14 screenshot support before any potentially prompting
+    // discovery. Older runtimes retain their ordinary shell compatibility path.
+    screenshot_class()?;
+    let content_class = required_class("SCShareableContent")?;
+    if !content_class.metaclass().responds_to(
+        sel!(getShareableContentExcludingDesktopWindows:onScreenWindowsOnly:completionHandler:),
+    ) {
+        anyhow::bail!("SCShareableContent discovery is unavailable on this macOS version");
+    }
+    let (tx, rx) = mpsc::channel();
+    let completion = RcBlock::new(move |content: *mut AnyObject, error: *mut NSError| {
+        let result = unsafe {
+            if let Some(error) = error.as_ref() {
+                Err(anyhow::Error::new(CaptureError::from_nserror(
+                    "SCShareableContent",
+                    error,
+                )))
+            } else {
+                Retained::retain(content).map(Object).ok_or_else(|| {
+                    anyhow::anyhow!("SCShareableContent returned no content or error")
+                })
+            }
+        };
+        // Apple's API copies the escaping block. The sender lives in that
+        // owned block, not in a stack context. A closed receiver drops the
+        // retained result here, including on a late completion.
+        let _ = tx.send(result);
+    });
+    unsafe {
+        let _: () = msg_send![content_class,
+            getShareableContentExcludingDesktopWindows: false
+            onScreenWindowsOnly: false
+            completionHandler: &*completion];
+    }
+    // The outer single-worker gate bounds public waiting to three seconds.
+    // Keep its permit until Apple completes, even if the caller has left.
+    let content = rx
+        .recv()
+        .map_err(|_| anyhow::anyhow!("SCK discovery callback disconnected"))??;
+    unsafe {
+        let windows: Retained<NSArray<AnyObject>> = msg_send_id![&*content.0, windows];
+        for index in 0..windows.count() {
+            let candidate: Retained<AnyObject> = msg_send_id![&*windows, objectAtIndex: index];
+            let id: u32 = msg_send![&*candidate, windowID];
+            if id != window_id {
+                continue;
+            }
+            let frame: NSRect = msg_send![&*candidate, frame];
+            let application: Option<Retained<AnyObject>> =
+                msg_send_id![&*candidate, owningApplication];
+            let application = application
+                .ok_or_else(|| anyhow::anyhow!("SCK window {window_id} has no owner"))?;
+            let owner_pid: i32 = msg_send![&*application, processID];
+            let layer: isize = msg_send![&*candidate, windowLayer];
+            return Ok(Window {
+                object: Object(candidate),
+                frame: rect(frame),
+                owner_pid,
+                layer: i32::try_from(layer)?,
+            });
+        }
+    }
+    anyhow::bail!("ScreenCaptureKit: window id {window_id} not found in shareable content")
+}
+
+impl Plan {
+    pub fn new(window: &Window) -> anyhow::Result<Self> {
+        let filter_class = required_class("SCContentFilter")?;
+        if !filter_class.responds_to(sel!(contentRect))
+            || !filter_class.responds_to(sel!(pointPixelScale))
+        {
+            anyhow::bail!("SCK window capture geometry is unavailable on this macOS version");
+        }
+        let config_class = required_class("SCStreamConfiguration")?;
+        unsafe {
+            let filter: Allocated<AnyObject> = msg_send_id![filter_class, alloc];
+            let filter: Retained<AnyObject> = msg_send_id![filter,
+                initWithDesktopIndependentWindow: &*window.object.0];
+            let content_rect: NSRect = msg_send![&*filter, contentRect];
+            let scale: f32 = msg_send![&*filter, pointPixelScale];
+            let config: Retained<AnyObject> = msg_send_id![config_class, new];
+            // Preserve screencapturekit 6.0.1's explicit BGRA default. Apple's
+            // stock configuration can select YUV on Tahoe/Apple Silicon.
+            let _: () = msg_send![&*config, setPixelFormat: 0x42475241u32];
+            Ok(Self {
+                filter: Object(filter),
+                config: Object(config),
+                content_rect: rect(content_rect),
+                scale: f64::from(scale),
+            })
+        }
+    }
+
+    /// Called once while the plan is exclusively owned, before caching it.
+    pub fn configure(&mut self, width_pts: f64, height_pts: f64, width: u32, height: u32) {
+        unsafe {
+            let source = NSRect::new(
+                objc2_foundation::NSPoint::new(0., 0.),
+                objc2_foundation::NSSize::new(width_pts, height_pts),
+            );
+            let _: () = msg_send![&*self.config.0, setSourceRect: source];
+            let _: () = msg_send![&*self.config.0, setWidth: width as usize];
+            let _: () = msg_send![&*self.config.0, setHeight: height as usize];
+        }
+    }
+
+    pub fn capture_image(&self) -> anyhow::Result<CGImage> {
+        let manager = screenshot_class()?;
+        let (tx, rx) = mpsc::channel();
+        let completion = RcBlock::new(move |image: *mut std::ffi::c_void, error: *mut NSError| {
+            let result = unsafe {
+                if let Some(error) = error.as_ref() {
+                    Err(anyhow::Error::new(CaptureError::from_nserror(
+                        "SCScreenshotManager",
+                        error,
+                    )))
+                } else if !image.is_null() {
+                    // The completion's CGImage is borrowed. Transfer a new +1
+                    // into the same CGImage wrapper used by the existing encoder.
+                    let retained = core_foundation::base::CFRetain(image.cast_const());
+                    Ok(CGImage::from_raw(retained.cast_mut()))
+                } else {
+                    Err(anyhow::anyhow!(
+                        "SCScreenshotManager returned no image or error"
+                    ))
+                }
+            };
+            let _ = tx.send(result);
+        });
+        unsafe {
+            let _: () = msg_send![manager,
+                captureImageWithFilter: &*self.filter.0
+                configuration: &*self.config.0
+                completionHandler: &*completion];
+        }
+        rx.recv()
+            .map_err(|_| anyhow::anyhow!("SCK image callback disconnected"))?
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use objc2_foundation::NSString;
+
+    #[test]
+    fn nserror_domain_and_code_are_copied_without_message_parsing() {
+        unsafe {
+            let error = NSError::errorWithDomain_code_userInfo(
+                &NSString::from_str(ERROR_DOMAIN),
+                -3801,
+                None,
+            );
+            let captured = CaptureError::from_nserror("test", &error);
+            drop(error);
+            assert_eq!(captured.domain, ERROR_DOMAIN);
+            assert_eq!(captured.code, -3801);
+            assert!(captured.is_permission_denied());
+            assert!(!captured.description.is_empty());
+        }
+    }
+}
diff --git a/libs/cua-driver/rust/crates/platform-windows/src/pointer_outcome.rs b/libs/cua-driver/rust/crates/platform-windows/src/pointer_outcome.rs
new file mode 100644
index 00000000..cefd7e72
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-windows/src/pointer_outcome.rs
@@ -0,0 +1,245 @@
+//! Pure outcome handling for Windows coordinate injection.
+//!
+//! Admission errors occur before dispatch. Once an injection call has been
+//! attempted, an error cannot prove that no down/up or earlier tap was received.
+
+use cua_driver_core::action_record::{
+    ActionAttempt, ActionEffect, ActionExecutionRecord, ActionFallback, ActionTransport,
+    ActualDelivery, RequestedDelivery,
+};
+use cua_driver_core::protocol::ToolResult;
+use std::time::Duration;
+
+#[derive(Debug, thiserror::Error)]
+#[error("{0}")]
+pub(crate) struct PointerDispatchError(pub(crate) String);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum TapPhase {
+    Down,
+    Up,
+}
+
+/// Keep each release attempt, but stop before another tap after either half
+/// fails. A successful earlier tap and an unverified down are both possible.
+pub(crate) fn dispatch_taps<E: std::fmt::Display>(
+    count: usize,
+    mut inject: impl FnMut(TapPhase) -> Result<(), E>,
+    mut wait: impl FnMut(Duration),
+) -> Result<(), PointerDispatchError> {
+    let count = count.max(1);
+    for index in 0..count {
+        let down = inject(TapPhase::Down);
+        wait(Duration::from_millis(25));
+        let up = inject(TapPhase::Up);
+        down.and(up).map_err(|error| {
+            PointerDispatchError(format!("InjectSyntheticPointerInput(pen): {error}"))
+        })?;
+        if index + 1 < count {
+            wait(Duration::from_millis(70));
+        }
+    }
+    Ok(())
+}
+
+pub(crate) fn uncertain_dispatch_result(cause: impl Into<String>) -> ToolResult {
+    uncertain_action_result(cause.into(), ActionTransport::WindowsTargetedInjection)
+}
+
+fn uncertain_action_result(cause: String, transport: ActionTransport) -> ToolResult {
+    ToolResult::error(format!(
+        "Action outcome is uncertain: {cause}. Inspect fresh state before \
+         deciding the next action; do not repeat this action automatically."
+    ))
+    .with_structured(serde_json::json!({
+        "status": "uncertain",
+        "code": "action_outcome_unknown",
+        "effect": "unverifiable",
+        "verified": false,
+        "cause": cause,
+    }))
+    .with_action_record(
+        ActionExecutionRecord::builder(
+            ActionEffect::Unverifiable,
+            transport,
+            RequestedDelivery::Background,
+        )
+        .actual_delivery(ActualDelivery::Unknown)
+        .build()
+        .expect("uncertain pointer dispatch record is valid"),
+    )
+}
+
+/// A later preflight failure cannot erase earlier semantic action attempts.
+/// Retain their journal even when the coordinate/post route dispatched nothing.
+pub(crate) fn failure_after_prior_actions(
+    cause: impl Into<String>,
+    transport: ActionTransport,
+    prior: &[ActionTransport],
+) -> ToolResult {
+    let mut result = uncertain_action_result(cause.into(), transport);
+    let record = result.action_record.as_mut().expect("outcome has a record");
+    for (index, attempted) in prior.iter().copied().enumerate() {
+        record.attempts.push(ActionAttempt {
+            transport: attempted,
+            delivery: ActualDelivery::Background,
+            detail: Some("UIA provider action returned an error".into()),
+        });
+        record.fallbacks.push(ActionFallback {
+            from: attempted,
+            to: prior.get(index + 1).copied().unwrap_or(transport),
+            reason: "Previous UIA provider action failed".into(),
+        });
+    }
+    result
+}
+
+/// Typed errors keep dispatch history through anyhow context. Callers handle
+/// unmarked errors as admission failures from the coordinate injector.
+pub(crate) fn dispatched_failure_result(error: &anyhow::Error) -> Option<ToolResult> {
+    error
+        .downcast_ref::<PointerDispatchError>()
+        .map(|_| uncertain_dispatch_result(format!("{error:#}")))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn failing_taps(fail_at: usize) -> (Vec<TapPhase>, anyhow::Error) {
+        let mut calls = Vec::new();
+        let result = dispatch_taps(
+            3,
+            |phase| {
+                calls.push(phase);
+                if calls.len() == fail_at {
+                    Err("injected failure")
+                } else {
+                    Ok(())
+                }
+            },
+            |_| {},
+        );
+        (calls, result.unwrap_err().into())
+    }
+
+    #[test]
+    fn release_failure_after_a_down_is_uncertain_and_stops_later_taps() {
+        let (calls, error) = failing_taps(2);
+        assert_eq!(calls, [TapPhase::Down, TapPhase::Up]);
+        let result = dispatched_failure_result(&error).unwrap();
+        assert_eq!(result.is_error, Some(true));
+        let record = result.action_record.as_ref().unwrap();
+        assert_eq!(record.effect, ActionEffect::Unverifiable);
+        assert_eq!(record.actual_delivery, Some(ActualDelivery::Unknown));
+        assert_eq!(record.requested_delivery, RequestedDelivery::Background);
+        assert_eq!(record.transport, ActionTransport::WindowsTargetedInjection);
+        assert!(record.escalation.is_none());
+        let data = result.structured_content.unwrap();
+        assert_eq!(data["effect"], "unverifiable");
+        assert_eq!(data["status"], "uncertain");
+        assert_eq!(data["code"], "action_outcome_unknown");
+        assert_eq!(data["verified"], false);
+        assert!(data.get("escalation").is_none());
+        assert!(data.get("suggestion").is_none());
+    }
+
+    #[test]
+    fn a_later_tap_failure_preserves_the_completed_first_tap() {
+        let (calls, error) = failing_taps(3);
+        assert_eq!(
+            calls,
+            [TapPhase::Down, TapPhase::Up, TapPhase::Down, TapPhase::Up]
+        );
+        assert!(dispatched_failure_result(&error).is_some());
+    }
+
+    #[test]
+    fn first_down_failure_still_attempts_release_and_is_conservative() {
+        let (calls, error) = failing_taps(1);
+        assert_eq!(calls, [TapPhase::Down, TapPhase::Up]);
+        assert!(dispatched_failure_result(&error).is_some());
+    }
+
+    #[test]
+    fn successful_taps_keep_the_same_count_and_pacing() {
+        let mut calls = Vec::new();
+        let mut waits = Vec::new();
+        dispatch_taps(
+            2,
+            |phase| {
+                calls.push(phase);
+                Ok::<_, &str>(())
+            },
+            |duration| waits.push(duration.as_millis()),
+        )
+        .unwrap();
+        assert_eq!(
+            calls,
+            [TapPhase::Down, TapPhase::Up, TapPhase::Down, TapPhase::Up]
+        );
+        assert_eq!(waits, [25, 70, 25]);
+    }
+
+    #[test]
+    fn zero_count_retains_one_tap() {
+        let mut calls = Vec::new();
+        dispatch_taps(
+            0,
+            |phase| {
+                calls.push(phase);
+                Ok::<_, &str>(())
+            },
+            |_| {},
+        )
+        .unwrap();
+        assert_eq!(calls, [TapPhase::Down, TapPhase::Up]);
+    }
+
+    #[test]
+    fn typed_dispatch_survives_context_without_reparsing_error_text() {
+        let error = anyhow::Error::new(PointerDispatchError("occluded after dispatch".into()))
+            .context("outer operation");
+        let result = dispatched_failure_result(&error).unwrap();
+        let data = result.structured_content.unwrap();
+        assert_eq!(data["effect"], "unverifiable");
+        assert_eq!(data["cause"], "outer operation: occluded after dispatch");
+        assert!(data.get("escalation").is_none());
+    }
+
+    #[test]
+    fn unmarked_preflight_failures_do_not_claim_dispatch() {
+        for message in [
+            "occluded",
+            "UIPI",
+            "CreateSyntheticPointerDevice(PEN): failed",
+        ] {
+            assert!(dispatched_failure_result(&anyhow::anyhow!(message)).is_none());
+        }
+    }
+    #[test]
+    fn later_admission_failure_cannot_erase_prior_semantic_attempts() {
+        for transport in [
+            ActionTransport::WindowsTargetedInjection,
+            ActionTransport::WindowsPostMessage,
+        ] {
+            let prior = [
+                ActionTransport::WindowsUiaInvoke,
+                ActionTransport::WindowsUiaToggle,
+            ];
+            let result = failure_after_prior_actions("target became occluded", transport, &prior);
+            let data = result.structured_content.unwrap();
+            assert_eq!(data["effect"], "unverifiable");
+            assert_eq!(data["status"], "uncertain");
+            assert!(data.get("escalation").is_none());
+            let record = result.action_record.unwrap();
+            assert_eq!(record.actual_delivery, Some(ActualDelivery::Unknown));
+            assert_eq!(record.transport, transport);
+            assert_eq!(record.attempts.len(), 2);
+            assert_eq!(record.attempts[0].transport, prior[0]);
+            assert_eq!(record.attempts[1].transport, prior[1]);
+            assert_eq!(record.fallbacks.len(), 2);
+            assert_eq!(record.fallbacks[1].to, transport);
+        }
+    }
+}
