+/// Sway window captures are refused with sway's own reason, and no frame is
+/// written. The overlap, layer-shell and overlay cells below check the same
+/// refusal under a surface that grim shows over the window.
+fn assert_sway_capture_refused(driver: &mut McpDriver, pid: u32, window: u64, out: &Path, when: &str) {
+    let response = capture(driver, pid, window, out);
+    let error = &response.structured()["screenshot_error"];
+    assert_eq!(error["code"], "surface_identity_unproven", "capture {when}: {}", response.structured());
+    assert!(
+        error.to_string().contains("sway has no per-window capture"),
+        "capture {when} was not refused for sway's reason: {error}"
+    );
+    assert!(!out.exists(), "a frame was written {when}");
+}
