+#[derive(Clone, Debug, PartialEq)]
+struct MenuFocusState {
+    pid: Option<i32>,
+    window: Option<u32>,
+    owner: Option<[u8; 8]>,
+    pointer: Option<(f64, f64)>,
+    input: [u32; 9],
+}
+
+trait MenuFocusHost {
+    fn state(&self) -> MenuFocusState;
+    fn target_owner(&self, pid: i32, window: u32) -> Option<[u8; 8]>;
+    fn restore(&self, prior: &MenuFocusState) -> Result<(), String>;
+}
+
+impl MenuFocusHost for LiveMenuHost {
+    fn state(&self) -> MenuFocusState {
+        let pid = crate::apps::frontmost_pid();
+        MenuFocusState {
+            pid, window: pid.and_then(crate::ax::bindings::focused_window_id_of_pid),
+            owner: crate::input::skylight::current_front_psn(),
+            pointer: crate::input::skylight::physical_pointer(),
+            input: crate::input::skylight::physical_input_counters(),
+        }
+    }
+    fn target_owner(&self, pid: i32, window: u32) -> Option<[u8; 8]> {
+        let mut owner = [0; 8];
+        crate::input::skylight::get_process_psn_for_window(window, pid, &mut owner)
+            .then_some(owner)
+    }
+    fn restore(&self, prior: &MenuFocusState) -> Result<(), String> {
+        let pid = prior.pid.ok_or("invoke_menu: prior foreground is unknown")?;
+        if let Some(window) = prior.window {
+            focus_exact_window(pid, window)
+        } else if crate::apps::activate_pid(pid) {
+            Ok(())
+        } else {
+            Err("invoke_menu: prior foreground could not be restored".into())
+        }
+    }
+}
+
+/// Match the existing key-focus guard's ownership rule: a changed pointer,
+/// HID input, app or key window belongs to the user. Unknown state is never
+/// permission to reassert the old foreground. The guard lives in the blocking
+/// action itself, so dropping the awaiting future cannot skip cleanup.
+struct MenuFocusLease<H: MenuFocusHost> {
+    host: H,
+    before: MenuFocusState,
+    target_pid: i32,
+    target_window: u32,
+    target_owner: Option<[u8; 8]>,
+    prior_owner: Option<[u8; 8]>,
+    finished: bool,
+}
+impl<H: MenuFocusHost> MenuFocusLease<H> {
+    fn new(host: H, pid: i32, window: u32) -> Self {
+        let before = host.state();
+        let target_owner = host.target_owner(pid, window);
+        let prior_owner = before.pid.and_then(|pid| host.target_owner(pid, before.window.unwrap_or(0)));
+        Self { host, before, target_pid: pid, target_window: window, target_owner, prior_owner, finished: false }
+    }
+    fn finish(&mut self) -> Result<(), String> {
+        if self.finished { return Ok(()); }
+        self.finished = true;
+        let now = self.host.state();
+        let known_window_changed = now.pid.zip(now.window).is_some_and(|(pid, window)| {
+            let target = pid == self.target_pid && window == self.target_window;
+            let prior = Some(pid) == self.before.pid && Some(window) == self.before.window;
+            !target && !prior
+        });
+        let known_owner_changed = now.owner.is_some_and(|owner| {
+            Some(owner) != self.target_owner && Some(owner) != self.before.owner
+        });
+        if now.input != self.before.input
+            || self.before.pointer.zip(now.pointer).is_some_and(|(a, b)| a != b)
+            || now.pid.is_some_and(|pid| pid != self.target_pid && Some(pid) != self.before.pid)
+            || known_window_changed || known_owner_changed {
+            return Ok(()); // changed ownership or real input: preserve it
+        }
+        if self.before.pid.is_none() || self.before.owner.is_none()
+            || self.before.pointer.is_none() || now.pointer.is_none()
+            || now.pid.is_none() || now.window.is_none() || now.owner.is_none()
+            || self.target_owner.is_none() || self.prior_owner.is_none()
+            || self.before.owner != self.prior_owner {
+            return Err("invoke_menu: focus ownership is unknown; prior focus was not reasserted".into());
+        }
+        if now.pid == self.before.pid && now.window == self.before.window
+            && now.owner == self.before.owner { return Ok(()); }
+        self.host.restore(&self.before)
+    }
+}
+impl<H: MenuFocusHost> Drop for MenuFocusLease<H> {
+    fn drop(&mut self) {
+        if let Err(error) = self.finish() {
+            tracing::warn!(%error, "menu focus cleanup remained uncertain");
         }
     }
 }
 
+fn with_menu_focus<H: MenuFocusHost>(host: H, pid: i32, window: u32,
+    body: impl FnOnce() -> Result<(), String>) -> Result<(), String> {
+    let mut lease = MenuFocusLease::new(host, pid, window);
+    let result = body();
+    match (result, lease.finish()) {
+        (Ok(()), cleanup) => cleanup,
+        (Err(error), Ok(())) => Err(error),
+        (Err(error), Err(cleanup)) => Err(format!("{error}; {cleanup}")),
+    }
+}
+
+async fn invoke_on<H: MenuHost>(host: H, pid: i32, window_id: u32, path: Vec<String>) -> ToolResult {
+    if !host.owns_window(pid, window_id) {
+        return refusal("invoke_menu: window_id does not belong to pid".into());
+    }
+
+    // Refuse the Apple menu before any focus change; see `ax::system_menu`.
+    let first = path[0].clone();
+    let probe = host.clone();
+    let system_menu = tokio::task::spawn_blocking(move || {
+        probe.system_menu_title(pid).is_some_and(|title| title == first)
+    })
+    .await
+    .unwrap_or(true);
+    if system_menu {
+        let message = "invoke_menu: the Apple menu acts on the whole system (Restart, \
+                       Shut Down, Log Out, System Settings) and is not available to \
+                       computer use"
+            .to_owned();
+        return ToolResult::error(message.clone()).with_structured(serde_json::json!({
+            "status": "refused",
+            "refusal": { "code": "system_menu_refused", "message": message }
+        }));
+    }
+
+    let outcome =
+        tokio::task::spawn_blocking(move || host.focus_and_invoke(pid, window_id, &path)).await;
+
+    match outcome {
+        Ok(Ok(())) => ToolResult::text(
+            "Resolved the live native menu path and dispatched its final accessibility action; verify the command's semantic effect from fresh state.",
+        )
+        .with_action_record(
+            ActionExecutionRecord::builder(
+                ActionEffect::Unverifiable,
+                ActionTransport::MacosAxAction,
+                RequestedDelivery::Foreground,
+            )
+            .actual_delivery(ActualDelivery::Foreground)
+            .evidence(ActionEvidence {
+                kind: EvidenceKind::NativeApiResult,
+                detail: "Every menu hop resolved uniquely and AX accepted the final action".into(),
+            })
+            .build()
+            .expect("invoke_menu record is valid"),
+        ),
+        Ok(Err(error)) => uncertain_menu_outcome(error),
+        Err(error) => uncertain_menu_outcome(format!("invoke_menu: blocking task failed: {error}")),
+    }
+}
