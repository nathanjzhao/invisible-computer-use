+//! Windows adapter for `cua_driver_core::host_state`.
+//!
+//! - lock: `WTSQuerySessionInformationW(WTSSessionInfoEx)` `SessionFlags`
+//!   (`WTS_SESSIONSTATE_LOCK` / `_UNLOCK`), corroborated by the input desktop
+//!   being `Winlogon` (the secure desktop owns input while locked).
+//! - console: this process's session is `WTSGetActiveConsoleSessionId()`.
+//! - displays: `GetSystemMetrics(SM_CMONITORS)`.
+//! - display sleep and lid are only delivered as power-setting notifications
+//!   (`GUID_CONSOLE_DISPLAY_STATE`, `GUID_LIDSWITCH_STATE_CHANGE`) to a window
+//!   or service, and registering delivers the current value at once. A
+//!   message-only window on its own thread (`start_power_listener`, started at
+//!   tool registration) keeps the latest values; until the first delivery, or
+//!   on a machine without a lid switch, they stay `null`.
+use cua_driver_core::host_state::HostState;
+use std::sync::atomic::{AtomicI32, Ordering};
+
+/// Latest `GUID_CONSOLE_DISPLAY_STATE` (0 off, 1 on, 2 dimmed) and
+/// `GUID_LIDSWITCH_STATE_CHANGE` (0 closed, 1 open); -1 = never delivered.
+static DISPLAY_STATE: AtomicI32 = AtomicI32::new(-1);
+static LID_STATE: AtomicI32 = AtomicI32::new(-1);
+
+pub fn display_asleep() -> Option<bool> { match DISPLAY_STATE.load(Ordering::Relaxed) { -1 => None, v => Some(v == 0) } }
+pub fn lid_closed() -> Option<bool> { match LID_STATE.load(Ordering::Relaxed) { -1 => None, v => Some(v == 0) } }
+
+#[cfg(target_os = "windows")]
+mod power {
+    use super::{DISPLAY_STATE, LID_STATE};
+    use std::sync::atomic::Ordering;
+    use windows::core::{GUID, PCWSTR};
+    use windows::Win32::Foundation::{HANDLE, HWND, LPARAM, LRESULT, WPARAM};
+    use windows::Win32::System::LibraryLoader::GetModuleHandleW;
+    use windows::Win32::System::Power::{RegisterPowerSettingNotification, POWERBROADCAST_SETTING};
+    use windows::Win32::UI::WindowsAndMessaging::{
+        CreateWindowExW, DefWindowProcW, DispatchMessageW, GetMessageW, RegisterClassW, TranslateMessage,
+        DEVICE_NOTIFY_WINDOW_HANDLE, HWND_MESSAGE, MSG, PBT_POWERSETTINGCHANGE, WINDOW_EX_STYLE, WINDOW_STYLE,
+        WM_POWERBROADCAST, WNDCLASSW,
+    };
+
+    // winnt.h; not exported by the windows crate feature set this crate uses.
+    pub const GUID_CONSOLE_DISPLAY_STATE: GUID = GUID::from_u128(0x6fe69556_704a_47a0_8f24_c28d936fda47);
+    pub const GUID_LIDSWITCH_STATE_CHANGE: GUID = GUID::from_u128(0xba3e0f4d_b817_4094_a2d1_d56379e6a0f3);
+
+    unsafe extern "system" fn wnd_proc(hwnd: HWND, msg: u32, wparam: WPARAM, lparam: LPARAM) -> LRESULT {
+        if msg == WM_POWERBROADCAST && wparam.0 as u32 == PBT_POWERSETTINGCHANGE && lparam.0 != 0 {
+            let setting = &*(lparam.0 as *const POWERBROADCAST_SETTING);
+            if setting.DataLength >= 4 {
+                let value = std::ptr::read_unaligned(setting.Data.as_ptr() as *const u32) as i32;
+                if setting.PowerSetting == GUID_CONSOLE_DISPLAY_STATE {
+                    DISPLAY_STATE.store(value, Ordering::Relaxed);
+                } else if setting.PowerSetting == GUID_LIDSWITCH_STATE_CHANGE {
+                    LID_STATE.store(value, Ordering::Relaxed);
+                }
+            }
+            return LRESULT(1);
+        }
+        DefWindowProcW(hwnd, msg, wparam, lparam)
+    }
+
+    /// Returns only when the window could not be created (so the caller can
+    /// allow a retry); otherwise pumps messages for the life of the process.
+    pub fn run() -> Result<(), String> {
+        unsafe {
+            let class: Vec<u16> = "CuaHostPowerListener\0".encode_utf16().collect();
+            let hinstance = GetModuleHandleW(PCWSTR::null()).unwrap_or_default();
+            let wc = WNDCLASSW { lpfnWndProc: Some(wnd_proc), hInstance: hinstance.into(), lpszClassName: PCWSTR(class.as_ptr()), ..Default::default() };
+            // a second registration of the same class fails harmlessly; the class survives
+            let _ = RegisterClassW(&wc);
+            let hwnd = CreateWindowExW(WINDOW_EX_STYLE(0), PCWSTR(class.as_ptr()), PCWSTR::null(), WINDOW_STYLE(0), 0, 0, 0, 0, HWND_MESSAGE, None, hinstance, None).map_err(|e| format!("CreateWindowExW: {e}"))?;
+            let _ = RegisterPowerSettingNotification(HANDLE(hwnd.0), &GUID_CONSOLE_DISPLAY_STATE, DEVICE_NOTIFY_WINDOW_HANDLE);
+            let _ = RegisterPowerSettingNotification(HANDLE(hwnd.0), &GUID_LIDSWITCH_STATE_CHANGE, DEVICE_NOTIFY_WINDOW_HANDLE);
+            let mut msg = MSG::default();
+            while GetMessageW(&mut msg, None, 0, 0).as_bool() {
+                let _ = TranslateMessage(&msg);
+                DispatchMessageW(&msg);
+            }
+        }
+        Ok(())
+    }
+}
+
+/// Listener state: 0 never started, 1 starting or running, 2 failed (retry allowed).
+static LISTENER: AtomicI32 = AtomicI32::new(0);
+
+/// Start the power-setting listener (idempotent, non-blocking). A failed start
+/// (no window could be created) is retried on the next call.
+pub fn start_power_listener() {
+    let start = LISTENER.compare_exchange(0, 1, Ordering::AcqRel, Ordering::Acquire).is_ok()
+        || LISTENER.compare_exchange(2, 1, Ordering::AcqRel, Ordering::Acquire).is_ok();
+    if !start { return; }
+    #[cfg(target_os = "windows")]
+    {
+        let spawned = std::thread::Builder::new().name("cua-host-power".into()).spawn(|| {
+            if let Err(e) = power::run() {
+                tracing::warn!(target: "host_state", "power listener not running: {e}");
+                LISTENER.store(2, Ordering::Release);
+            }
+        });
+        if spawned.is_err() { LISTENER.store(2, Ordering::Release); }
+    }
+}
+
+#[cfg(target_os = "windows")]
+pub fn probe() -> HostState {
+    start_power_listener();
+    use windows::core::PWSTR;
+    use windows::Win32::System::RemoteDesktop::{
+        WTSFreeMemory, WTSGetActiveConsoleSessionId, WTSQuerySessionInformationW, WTSSessionInfoEx,
+        WTSINFOEXW, WTS_CURRENT_SERVER_HANDLE, WTS_CURRENT_SESSION, WTS_SESSIONSTATE_LOCK,
+        WTS_SESSIONSTATE_UNLOCK,
+    };
+    use windows::Win32::UI::WindowsAndMessaging::{GetSystemMetrics, SM_CMONITORS};
+
+    let mut screen_locked: Option<bool> = None;
+    let mut errors: Vec<String> = Vec::new();
+    unsafe {
+        let mut buf = PWSTR::null();
+        let mut len = 0u32;
+        match WTSQuerySessionInformationW(WTS_CURRENT_SERVER_HANDLE, WTS_CURRENT_SESSION, WTSSessionInfoEx, &mut buf, &mut len) {
+            Ok(()) => {
+                if !buf.is_null() && (len as usize) >= std::mem::size_of::<WTSINFOEXW>() {
+                    let info = &*(buf.0 as *const WTSINFOEXW);
+                    if info.Level == 1 {
+                        screen_locked = match info.Data.WTSInfoExLevel1.SessionFlags as u32 {
+                            WTS_SESSIONSTATE_LOCK => Some(true),
+                            WTS_SESSIONSTATE_UNLOCK => Some(false),
+                            _ => None,
+                        };
+                    }
+                } else {
+                    errors.push(format!("WTSSessionInfoEx returned {len} bytes"));
+                }
+                if !buf.is_null() { WTSFreeMemory(buf.0 as *mut std::ffi::c_void); }
+            }
+            Err(e) => errors.push(format!("WTSQuerySessionInformationW: {e}")),
+        }
+    }
+    let desktop = crate::diagnostics::desktop_state();
+    if desktop.input_desktop_name.as_deref() == Some("Winlogon") {
+        screen_locked = Some(true);
+    }
+    let on_console = {
+        let active = unsafe { WTSGetActiveConsoleSessionId() };
+        match (desktop.session_id, active) {
+            (_, u32::MAX) | (None, _) => None,
+            (Some(mine), active) => Some(mine == active),
+        }
+    };
+    let monitors = unsafe { GetSystemMetrics(SM_CMONITORS) };
+    HostState {
+        screen_locked,
+        on_console,
+        display_asleep: display_asleep(),
+        lid_closed: lid_closed(),
+        active_displays: Some(monitors.max(0) as u32),
+        probe_error: (!errors.is_empty()).then(|| errors.join("; ")),
+    }
+}
+
+#[cfg(not(target_os = "windows"))]
+pub fn probe() -> HostState {
+    HostState { probe_error: Some("not a Windows host".to_owned()), ..Default::default() }
+}
diff --git a/libs/cua-driver/rust/crates/platform-windows/src/uia_focus.rs b/libs/cua-driver/rust/crates/platform-windows/src/uia_focus.rs
new file mode 100644
index 00000000..59bd0eba
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-windows/src/uia_focus.rs
@@ -0,0 +1,242 @@
+//! The UIAccess worker's focus step for text or keys aimed at one element.
+//!
+//! The daemon owns the element registry. When it has to hand a typed-into-an-element request to
+//! the worker (the target window is above the daemon's integrity), it sends the element as a
+//! description it read from its own cached element (`uia_protocol::FocusSpec`): the control's own
+//! window handle, automation id, name, control type, class and the screen point of its centre.
+//! The worker finds the live element that matches the whole description and focuses it. If it
+//! cannot find exactly such an element, or focus does not land on it, it refuses and sends no
+//! input: typing into a different control than the one the model addressed is the failure this
+//! guards against.
+
+use anyhow::{bail, Result};
+use std::time::{Duration, Instant};
+use windows::Win32::Foundation::POINT;
+use windows::Win32::System::Com::{
+    CoCreateInstance, CoInitializeEx, CLSCTX_INPROC_SERVER, COINIT_MULTITHREADED,
+};
+use windows::Win32::UI::Accessibility::{
+    CUIAutomation, IUIAutomation, IUIAutomationElement, TreeScope_Subtree,
+};
+use windows::Win32::UI::WindowsAndMessaging::GetWindowThreadProcessId;
+
+use crate::uia_protocol::{element_matches, ActKind, ActOutcome, FocusSpec};
+
+/// How far above the hit-tested element the match is looked for (a text box's inner edit, a list
+/// item's text, are children of the element the model addressed).
+const MAX_PARENT_STEPS: usize = 8;
+
+/// Scanning a whole window's tree is the slow fallback for an element that moved since the
+/// snapshot; a tree larger than this is not scanned.
+const MAX_SCANNED: i32 = 20_000;
+
+/// Native window handle, automation id, name, control type name and class of `element`, or `None`
+/// when the element cannot be read.
+///
+/// # Safety
+/// `element` must be a live UIA element; COM must be initialised on this thread.
+unsafe fn describe(element: &IUIAutomationElement) -> Option<(u64, String, String, String, String)> {
+    let native = element.CurrentNativeWindowHandle().map(|h| h.0 as u64).unwrap_or(0);
+    let automation_id = element.CurrentAutomationId().map(|s| s.to_string()).unwrap_or_default();
+    let name = element.CurrentName().map(|s| s.to_string()).unwrap_or_default();
+    let control_type = crate::uia::control_type_name(element.CurrentControlType().ok()?.0);
+    let class_name = element.CurrentClassName().map(|s| s.to_string()).unwrap_or_default();
+    Some((native, automation_id, name, control_type, class_name))
+}
+
+unsafe fn matches(spec: &FocusSpec, element: &IUIAutomationElement, pid: u32) -> bool {
+    // The element has to belong to the window's own process: a hit test can land on a window in front.
+    if element.CurrentProcessId().map(|p| p as u32 != pid).unwrap_or(true) {
+        return false;
+    }
+    match describe(element) {
+        Some((native, automation_id, name, control_type, class_name)) => {
+            element_matches(spec, native, &automation_id, &name, &control_type, &class_name)
+        }
+        None => false,
+    }
+}
+
+/// The live element `spec` describes inside top-level window `top`: first by hit-testing its
+/// centre and walking up, then by scanning the window's tree.
+unsafe fn find(automation: &IUIAutomation, top: u64, spec: &FocusSpec) -> Option<IUIAutomationElement> {
+    let mut pid = 0u32;
+    GetWindowThreadProcessId(windows::Win32::Foundation::HWND(top as *mut _), Some(&mut pid));
+    if pid == 0 {
+        return None;
+    }
+    if let Ok(hit) = automation.ElementFromPoint(POINT { x: spec.x, y: spec.y }) {
+        let walker = automation.ControlViewWalker().ok()?;
+        let mut current = hit;
+        for _ in 0..MAX_PARENT_STEPS {
+            if matches(spec, &current, pid) {
+                return Some(current);
+            }
+            match walker.GetParentElement(&current) {
+                Ok(parent) => current = parent,
+                Err(_) => break,
+            }
+        }
+    }
+    // The element moved since the snapshot: look through the window.
+    let root = automation.ElementFromHandle(windows::Win32::Foundation::HWND(top as *mut _)).ok()?;
+    let all = root.FindAll(TreeScope_Subtree, &automation.CreateTrueCondition().ok()?).ok()?;
+    let count = all.Length().unwrap_or(0).min(MAX_SCANNED);
+    for i in 0..count {
+        if let Ok(candidate) = all.GetElement(i) {
+            if matches(spec, &candidate, pid) {
+                return Some(candidate);
+            }
+        }
+    }
+    None
+}
+
+fn wait_for_focus(element: &IUIAutomationElement, timeout: Duration) -> bool {
+    let deadline = Instant::now() + timeout;
+    loop {
+        if unsafe { element.CurrentHasKeyboardFocus() }.map(|v| v.as_bool()).unwrap_or(false) {
+            return true;
+        }
+        if Instant::now() >= deadline {
+            return false;
+        }
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+/// Focus the element `spec` describes inside top-level window `top`, and return only once it has
+/// keyboard focus. Called after the worker has confirmed `top` is the foreground window.
+pub fn focus_by_spec(top: u64, spec: &FocusSpec) -> Result<()> {
+    if crate::uia_protocol::parse_hwnd_id(&spec.automation_id).is_some() {
+        return crate::uia_hwnd::focus(top, spec);
+    }
+    unsafe {
+        let _ = CoInitializeEx(None, COINIT_MULTITHREADED);
+        let automation: IUIAutomation = CoCreateInstance(&CUIAutomation, None, CLSCTX_INPROC_SERVER)
+            .map_err(|e| anyhow::anyhow!("CoCreateInstance(CUIAutomation) failed: {e}"))?;
+        let Some(element) = find(&automation, top, spec) else {
+            bail!(
+                "no live element in window 0x{top:x} matches the one addressed (automation id {:?}, name {:?}, \
+                 control type {:?}); no keyboard input was sent",
+                spec.automation_id, spec.name, spec.control_type
+            );
+        };
+        let set_focus = element.SetFocus();
+        if set_focus.is_ok() && wait_for_focus(&element, Duration::from_millis(350)) {
+            return Ok(());
+        }
+        if spec.click_fallback {
+            crate::input::send_click_synthesized_active_mods(top, spec.x, spec.y, 1, "left", &[])?;
+            if wait_for_focus(&element, Duration::from_millis(500)) {
+                return Ok(());
+            }
+        }
+        let detail = set_focus.err().map(|e| format!("; UIA SetFocus failed: {e}")).unwrap_or_default();
+        bail!(
+            "foreground_unavailable: Windows did not confirm keyboard focus on the element addressed in \
+             HWND 0x{top:x}{detail}; no keyboard input was sent"
+        )
+    }
+}
+
+/// Do `act` to the element `spec` describes inside top-level window `top`, through UIA patterns: no
+/// pointer input and no change of foreground. Refuses, doing nothing, when no live element matches the
+/// whole description. The window is shielded the same way the daemon's own pattern calls are
+/// (`fg_bypass`), so a host that foregrounds itself on a pattern call cannot raise.
+pub fn act_on_element(top: u64, spec: &FocusSpec, act: &ActKind) -> Result<ActOutcome> {
+    if crate::uia_protocol::parse_hwnd_id(&spec.automation_id).is_some() {
+        bail!(
+            "the element was read from the window's child windows (its UIA tree is closed to every client), so              it has no UIA pattern to invoke or write through; use delivery_mode:\"foreground\""
+        );
+    }
+    use windows::core::{Interface, BSTR};
+    use windows::Win32::UI::Accessibility::{IUIAutomationValuePattern, UIA_ValuePatternId};
+    use crate::semantic_outcome::SemanticAttempt;
+    unsafe {
+        let _ = CoInitializeEx(None, COINIT_MULTITHREADED);
+        let automation: IUIAutomation = CoCreateInstance(&CUIAutomation, None, CLSCTX_INPROC_SERVER)
+            .map_err(|e| anyhow::anyhow!("CoCreateInstance(CUIAutomation) failed: {e}"))?;
+        let Some(element) = find(&automation, top, spec) else {
+            bail!(
+                "no live element in window 0x{top:x} matches the one addressed (automation id {:?}, name {:?}, \
+                 control type {:?}); nothing was done",
+                spec.automation_id, spec.name, spec.control_type
+            );
+        };
+        match act {
+            ActKind::Invoke => match choose_click_action(&element, top as isize) {
+                SemanticAttempt::NotAttempted => Ok(ActOutcome::not_attempted()),
+                SemanticAttempt::Completed(action) => Ok(ActOutcome {
+                    pattern: action.pattern().into(), not_attempted: false,
+                    before: None, after: None,
+                }),
+                SemanticAttempt::Uncertain(error) => Err(error.into()),
+            },
+            ActKind::SetValue { text, append } => {
+                let pattern = element
+                    .GetCurrentPattern(UIA_ValuePatternId)
+                    .map_err(|e| anyhow::anyhow!("the element has no ValuePattern: {e}"))?;
+                let value: IUIAutomationValuePattern =
+                    pattern.cast().map_err(|e| anyhow::anyhow!("the element has no ValuePattern: {e}"))?;
+                let write = crate::uia::fg_bypass::run_with_uwp_bypass(top as isize, || {
+                    crate::semantic_outcome::write_text_value(text, *append,
+                        || value.CurrentValue().map(|value| value.to_string()),
+                        |written| value.SetValue(&BSTR::from(written)),
+                    )
+                })?;
+                let after = value.CurrentValue().map(|v| v.to_string()).ok();
+                Ok(ActOutcome { pattern: "ValuePattern".into(), not_attempted: false, before: write.before, after })
+            }
+        }
+    }
+}
+
+/// Shared by the daemon and UIAccess worker. Query/cast misses are harmless;
+/// the first actual provider action is terminal even when it returns an error.
+///
+/// # Safety
+/// `element` must be a live UIA element and COM initialised on this thread.
+pub(crate) unsafe fn choose_click_action(
+    element: &IUIAutomationElement,
+    hwnd: isize,
+) -> crate::semantic_outcome::SemanticAttempt {
+    use crate::semantic_outcome::{choose_action, SemanticAction, SemanticAttempt};
+    use windows::core::Interface;
+    use windows::Win32::UI::Accessibility::{
+        IUIAutomationExpandCollapsePattern, IUIAutomationInvokePattern,
+        IUIAutomationSelectionItemPattern, IUIAutomationTogglePattern,
+        UIA_ExpandCollapsePatternId, UIA_InvokePatternId, UIA_SelectionItemPatternId,
+        UIA_TogglePatternId,
+    };
+    choose_action(&SemanticAction::CLICK_ORDER, |action| {
+        let result = match action {
+            SemanticAction::Invoke => {
+                let Ok(pattern) = element.GetCurrentPattern(UIA_InvokePatternId)
+                    .and_then(|pattern| pattern.cast::<IUIAutomationInvokePattern>())
+                else { return SemanticAttempt::NotAttempted; };
+                crate::uia::fg_bypass::run_with_uwp_bypass(hwnd, || pattern.Invoke())
+            }
+            SemanticAction::Toggle => {
+                let Ok(pattern) = element.GetCurrentPattern(UIA_TogglePatternId)
+                    .and_then(|pattern| pattern.cast::<IUIAutomationTogglePattern>())
+                else { return SemanticAttempt::NotAttempted; };
+                crate::uia::fg_bypass::run_with_uwp_bypass(hwnd, || pattern.Toggle())
+            }
+            SemanticAction::Select => {
+                let Ok(pattern) = element.GetCurrentPattern(UIA_SelectionItemPatternId)
+                    .and_then(|pattern| pattern.cast::<IUIAutomationSelectionItemPattern>())
+                else { return SemanticAttempt::NotAttempted; };
+                crate::uia::fg_bypass::run_with_uwp_bypass(hwnd, || pattern.Select())
+            }
+            SemanticAction::Expand => {
+                let Ok(pattern) = element.GetCurrentPattern(UIA_ExpandCollapsePatternId)
+                    .and_then(|pattern| pattern.cast::<IUIAutomationExpandCollapsePattern>())
+                else { return SemanticAttempt::NotAttempted; };
+                crate::uia::fg_bypass::run_with_uwp_bypass(hwnd, || pattern.Expand())
+            }
+            SemanticAction::Value | SemanticAction::RangeValue => return SemanticAttempt::NotAttempted,
+        };
+        SemanticAttempt::dispatched(action, result)
+    })
+}
diff --git a/libs/cua-driver/rust/crates/platform-windows/src/uia_hwnd.rs b/libs/cua-driver/rust/crates/platform-windows/src/uia_hwnd.rs
new file mode 100644
index 00000000..85b588ca
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-windows/src/uia_hwnd.rs
@@ -0,0 +1,214 @@
+//! The worker's child-window view of a window whose UIA tree no client can read.
+//!
+//! A window owned by a SYSTEM process shows UIA clients only its frame and title bar, even to a
+//! UIAccess client (measured: 2 nodes for a window holding a button, a text box and a list, where
+//! the same window at High integrity gives 415). Its child windows can still be enumerated, so
+//! the worker describes those instead: class, text and rectangle, with the window handle as the
+//! element's identity (`uia_protocol::hwnd_id`).
+//!
+//! What can be done to such an element is narrower than with UIA and is stated here, not hidden:
+//! there is no pattern to invoke or write through, so the element can be clicked (a pixel gesture
+//! the worker already delivers) and an edit or combo box can be focused (by that click, verified
+//! from the owning thread's focus) to type or press keys into. Nothing else is done to it.
+
+use crate::uia::UiaNode;
+use crate::uia_protocol::{control_type_for_class, hwnd_id, parse_hwnd_id, takes_typed_text, FocusSpec};
+use anyhow::{bail, Result};
+use std::time::{Duration, Instant};
+use windows::Win32::Foundation::{BOOL, HWND, LPARAM, RECT, WPARAM};
+use windows::Win32::UI::Input::KeyboardAndMouse::IsWindowEnabled;
+use windows::Win32::UI::WindowsAndMessaging::{
+    EnumChildWindows, GetAncestor, GetClassNameW, GetGUIThreadInfo, GetParent, GetWindowLongW, GetWindowRect,
+    GetWindowTextW, GetWindowThreadProcessId, IsChild, IsWindow, IsWindowVisible,
+    SendMessageTimeoutW, GA_ROOT, GUITHREADINFO, GWL_STYLE, SMTO_ABORTIFHUNG, WM_GETTEXT,
+};
+
+const ES_PASSWORD: i32 = 0x20;
+const TEXT_UNITS: usize = 512;
+
+fn class_of(hwnd: HWND) -> String {
+    let mut buf = [0u16; 256];
+    let n = unsafe { GetClassNameW(hwnd, &mut buf) };
+    String::from_utf16_lossy(&buf[..n.max(0) as usize])
+}
+
+/// The window's text. Another process's controls answer WM_GETTEXT; a hung one is given 150 ms.
+fn text_of(hwnd: HWND, control_type: &str) -> String {
+    if control_type == "Edit" && unsafe { GetWindowLongW(hwnd, GWL_STYLE) } & ES_PASSWORD != 0 {
+        return String::new();
+    }
+    let mut buf = [0u16; TEXT_UNITS];
+    let mut copied: usize = 0;
+    let sent = unsafe {
+        SendMessageTimeoutW(
+            hwnd,
+            WM_GETTEXT,
+            WPARAM(TEXT_UNITS),
+            LPARAM(buf.as_mut_ptr() as isize),
+            SMTO_ABORTIFHUNG,
+            150,
+            Some(&mut copied),
+        )
+    };
+    if sent.0 == 0 {
+        // A top-level caption can be read without the window's cooperation.
+        let n = unsafe { GetWindowTextW(hwnd, &mut buf) };
+        return String::from_utf16_lossy(&buf[..n.max(0) as usize]);
+    }
+    String::from_utf16_lossy(&buf[..copied.min(TEXT_UNITS)])
+}
+
+fn rect_of(hwnd: HWND) -> Option<(i32, i32, i32, i32)> {
+    let mut r = RECT::default();
+    unsafe { GetWindowRect(hwnd, &mut r) }.ok()?;
+    Some((r.left, r.top, r.right, r.bottom))
+}
+
+fn depth_below(top: HWND, mut hwnd: HWND) -> usize {
+    let mut depth = 0;
+    while hwnd != top && depth < 64 {
+        match unsafe { GetParent(hwnd) } {
+            Ok(parent) if !parent.0.is_null() => hwnd = parent,
+            _ => break,
+        }
+        depth += 1;
+    }
+    depth
+}
+
+unsafe extern "system" fn collect(child: HWND, lparam: LPARAM) -> BOOL {
+    let out = &mut *(lparam.0 as *mut Vec<HWND>);
+    out.push(child);
+    BOOL(1)
+}
+
+/// The window and its visible child windows as nodes with no COM object, at most `max_elements`.
+/// Index 0 is the window itself.
+pub fn hwnd_nodes(top: u64, max_elements: usize) -> Vec<UiaNode> {
+    let top_hwnd = HWND(top as *mut _);
+    let mut children: Vec<HWND> = Vec::new();
+    unsafe {
+        let _ = EnumChildWindows(top_hwnd, Some(collect), LPARAM(&mut children as *mut Vec<HWND> as isize));
+    }
+    let mut nodes: Vec<UiaNode> = Vec::new();
+    let mut handles: Vec<HWND> = Vec::new();
+    let mut push = |hwnd: HWND, control_type: &str, depth: usize, parent: Option<usize>, nodes: &mut Vec<UiaNode>| {
+        let rect = rect_of(hwnd);
+        let text = text_of(hwnd, control_type);
+        let (name, value) = match control_type {
+            "Edit" | "ComboBox" => (None, (!text.is_empty()).then_some(text)),
+            _ => ((!text.is_empty()).then_some(text), None),
+        };
+        let center = rect.map(|(l, t, r, b)| ((l + r) / 2, (t + b) / 2)).unwrap_or((0, 0));
+        let index = nodes.len();
+        nodes.push(UiaNode {
+            element_index: Some(index),
+            control_type: control_type.to_owned(),
+            name,
+            value,
+            automation_id: Some(hwnd_id(hwnd.0 as usize as u64)),
+            help_text: None,
+            actions: match control_type {
+                "Button" => vec!["Click".to_owned()],
+                "Edit" | "ComboBox" => vec!["Focus".to_owned()],
+                _ => Vec::new(),
+            },
+            enabled: Some(unsafe { IsWindowEnabled(hwnd) }.as_bool()),
+            selected: None,
+            element_ptr: 0,
+            center_x: center.0,
+            center_y: center.1,
+            rect,
+            msaa_role: None,
+            depth,
+            parent_element_index: parent,
+            in_web_content: false,
+        });
+    };
+    handles.push(top_hwnd);
+    push(top_hwnd, "Window", 0, None, &mut nodes);
+    for child in children {
+        if nodes.len() >= max_elements {
+            break;
+        }
+        if !unsafe { IsWindowVisible(child) }.as_bool() {
+            continue;
+        }
+        let class = class_of(child);
+        let kind = control_type_for_class(&class);
+        let depth = depth_below(top_hwnd, child);
+        let parent = unsafe { GetParent(child) }
+            .ok()
+            .and_then(|p| handles.iter().position(|h| *h == p));
+        push(child, kind, depth, parent, &mut nodes);
+        handles.push(child);
+    }
+    nodes
+}
+
+/// The live child window `spec` names, if it is still there and still is that kind of control
+/// inside `top`. `None` for a spec that is not a window-handle element.
+pub fn resolve(top: u64, spec: &FocusSpec) -> Option<HWND> {
+    let handle = HWND(parse_hwnd_id(&spec.automation_id)? as usize as *mut _);
+    unsafe {
+        if !IsWindow(handle).as_bool() || GetAncestor(handle, GA_ROOT) != HWND(top as *mut _) {
+            return None;
+        }
+    }
+    let class = class_of(handle);
+    let kind = control_type_for_class(&class);
+    if kind != spec.control_type {
+        return None;
+    }
+    if !spec.name.is_empty() && text_of(handle, kind) != spec.name {
+        return None;
+    }
+    Some(handle)
+}
+
+fn has_focus(handle: HWND) -> bool {
+    let mut pid = 0u32;
+    let thread = unsafe { GetWindowThreadProcessId(handle, Some(&mut pid)) };
+    let mut info = GUITHREADINFO { cbSize: std::mem::size_of::<GUITHREADINFO>() as u32, ..Default::default() };
+    if thread == 0 || unsafe { GetGUIThreadInfo(thread, &mut info) }.is_err() {
+        return false;
+    }
+    info.hwndFocus == handle || (!info.hwndFocus.0.is_null() && unsafe { IsChild(handle, info.hwndFocus) }.as_bool())
+}
+
+/// Focus the window-handle element `spec` names and return only once the owning thread reports
+/// it holds keyboard focus. Refuses, sending nothing, for anything a click would do more than focus.
+pub fn focus(top: u64, spec: &FocusSpec) -> Result<()> {
+    let Some(handle) = resolve(top, spec) else {
+        bail!(
+            "no live child window of 0x{top:x} matches the one addressed ({}, {:?}); no keyboard input was sent",
+            spec.control_type, spec.name
+        );
+    };
+    if !takes_typed_text(&spec.control_type) {
+        bail!(
+            "a {} read from this window's child windows cannot take typed text (focusing it would press or \
+             select it); no keyboard input was sent",
+            spec.control_type
+        );
+    }
+    if has_focus(handle) {
+        return Ok(());
+    }
+    // Focus it with a click at the middle of its live rectangle, not at the point the daemon sent.
+    let Some((l, t, r, b)) = rect_of(handle) else {
+        bail!("the addressed child window has no rectangle; no keyboard input was sent");
+    };
+    crate::input::send_click_synthesized_active_mods(top, (l + r) / 2, (t + b) / 2, 1, "left", &[])?;
+    let deadline = Instant::now() + Duration::from_millis(800);
+    while Instant::now() < deadline {
+        if has_focus(handle) {
+            return Ok(());
+        }
+        std::thread::sleep(Duration::from_millis(15));
+    }
+    bail!(
+        "foreground_unavailable: Windows did not confirm keyboard focus on the addressed child window of \
+         HWND 0x{top:x}; no keyboard input was sent"
+    )
+}
diff --git a/libs/cua-driver/rust/crates/platform-windows/src/uia_protocol.rs b/libs/cua-driver/rust/crates/platform-windows/src/uia_protocol.rs
new file mode 100644
index 00000000..d353610e
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-windows/src/uia_protocol.rs
@@ -0,0 +1,852 @@
+//! Pure half of the daemon-to-UIAccess-worker requests.
+//!
+//! The worker (`cua-driver-uia.exe`) is launched by the daemon and answers narrow
+//! requests about a window the daemon's own, lower-integrity process cannot reach
+//! because of UIPI (a window of a higher-integrity or SYSTEM process):
+//!
+//! * `snapshot`: read the window's UIA tree and send it back as data. A daemon
+//!   below the window's integrity reads only the window itself (measured: one element
+//!   instead of 412 for a WinForms window at High or SYSTEM integrity), so the tree
+//!   cannot be read there at all. The reply is plain data, no COM objects.
+//! * `key`, `text`, `input`: deliver one finished physical input (a key, text, a click,
+//!   a wheel notch, a posted scroll or click).
+//!
+//! It is not a second tool surface and not a second element registry. The daemon
+//! assigns the element ids, tokens and snapshot ids from the data a `snapshot`
+//! returned, checks the capture binding and the session, and decides the screen
+//! point; so the ids, the capture log and the C9 pixel binding exist in exactly one
+//! process. The one thing the worker looks up for itself is the element to focus
+//! before typing: the daemon describes it from the snapshot data it holds
+//! (automation id, name, control type and the point the element was at) and the worker
+//! refuses to type unless it finds a live element that matches all of it.
+//!
+//! This module has no Win32 calls so its tests run on any host.
+
+use serde::{Deserialize, Serialize};
+use std::time::{Duration, Instant};
+
+/// How long a failed attempt (worker missing, unsignable, unreachable) suppresses
+/// further attempts, so a key press does not wait on a launch every time. A worker
+/// that answers and refuses a request does not count: it is running.
+pub const RETRY_AFTER_FAILURE: Duration = Duration::from_secs(30);
+
+/// The element to focus before keys or text are sent, as the daemon holds it from the
+/// snapshot it took at `get_window_state` time. Screen coordinates.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct FocusSpec {
+    /// Handle of the control itself when known (0 otherwise; not compared then).
+    pub native_hwnd: u64,
+    pub automation_id: String,
+    pub name: String,
+    /// The control type's name as the snapshot printed it ("Edit", "Button"); empty when unknown.
+    pub control_type: String,
+    /// Window class when known (empty otherwise; not compared then).
+    pub class_name: String,
+    /// Where the element's centre was at capture time. The worker hit-tests here and
+    /// walks up to the element the other fields name.
+    pub x: i32,
+    pub y: i32,
+    /// When UIA `SetFocus` does not give the element keyboard focus, click the centre
+    /// once and look again (the daemon's own fallback for providers that refuse SetFocus).
+    pub click_fallback: bool,
+}
+
+/// What the live element must be, or the worker must not type. Pure so the rule is
+/// tested without UIA: every property the daemon sent has to match; empty strings and a
+/// zero native handle were not known to the daemon and are not compared.
+pub fn element_matches(spec: &FocusSpec, native_hwnd: u64, automation_id: &str, name: &str, control_type: &str, class_name: &str) -> bool {
+    if !spec.control_type.is_empty() && spec.control_type != control_type {
+        return false;
+    }
+    if spec.native_hwnd != 0 && spec.native_hwnd != native_hwnd {
+        return false;
+    }
+    if !spec.automation_id.is_empty() && spec.automation_id != automation_id {
+        return false;
+    }
+    if !spec.name.is_empty() && spec.name != name {
+        return false;
+    }
+    if !spec.class_name.is_empty() && spec.class_name != class_name {
+        return false;
+    }
+    // With nothing but a control type there is no identity to check: not enough to type on.
+    spec.native_hwnd != 0 || !spec.automation_id.is_empty() || !spec.name.is_empty()
+}
+
+/// The most elements and the deepest nesting a snapshot request may ask for.
+pub const SNAPSHOT_MAX_ELEMENTS: usize = 20_000;
+pub const SNAPSHOT_MAX_DEPTH: usize = 100;
+
+/// One node of a window's UIA tree as the worker reads it: the data fields of the driver's own
+/// node, and nothing that points into the worker's process.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct RemoteNode {
+    pub element_index: Option<usize>,
+    pub control_type: String,
+    pub name: Option<String>,
+    pub value: Option<String>,
+    pub automation_id: Option<String>,
+    pub help_text: Option<String>,
+    pub actions: Vec<String>,
+    pub enabled: Option<bool>,
+    pub selected: Option<bool>,
+    pub center_x: i32,
+    pub center_y: i32,
+    pub rect: Option<(i32, i32, i32, i32)>,
+    pub depth: usize,
+    pub parent_element_index: Option<usize>,
+    pub in_web_content: bool,
+}
+
+impl RemoteNode {
+    /// The description the worker needs to find this element again, with `point` (screen) as
+    /// the place to hit-test. `None` for a node that cannot be told from its neighbours: no
+    /// automation id and no name.
+    pub fn focus_spec(&self, point: (i32, i32)) -> Option<FocusSpec> {
+        let spec = FocusSpec {
+            native_hwnd: 0,
+            automation_id: self.automation_id.clone().unwrap_or_default(),
+            name: self.name.clone().unwrap_or_default(),
+            control_type: self.control_type.clone(),
+            class_name: String::new(),
+            x: point.0,
+            y: point.1,
+            click_fallback: true,
+        };
+        (!spec.automation_id.is_empty() || !spec.name.is_empty()).then_some(spec)
+    }
+}
+
+/// Prefix of the automation id given to an element read from a window's child-window tree instead
+/// of its UIA tree. A SYSTEM-owned window shows UIA clients only its frame and title bar (measured,
+/// with a UIAccess client: 2 nodes for a window with a button, a text box and a list), but its child
+/// windows can still be enumerated, so the worker describes those: class, text, rectangle.
+pub const HWND_ID_PREFIX: &str = "hwnd:";
+
+pub fn hwnd_id(hwnd: u64) -> String {
+    format!("{HWND_ID_PREFIX}{hwnd:x}")
+}
+
+/// The window handle in an id made by `hwnd_id`; `None` for any other automation id.
+pub fn parse_hwnd_id(id: &str) -> Option<u64> {
+    let hex = id.strip_prefix(HWND_ID_PREFIX)?;
+    u64::from_str_radix(hex, 16).ok().filter(|h| *h != 0)
+}
+
+/// The UIA control type a standard window class stands for. WinForms and MFC wrap the class name
+/// (`WindowsForms10.BUTTON.app.0.1234`), so the system class is looked for inside it.
+pub fn control_type_for_class(class: &str) -> &'static str {
+    let upper = class.to_ascii_uppercase();
+    let has = |needle: &str| {
+        upper == needle || upper.contains(&format!(".{needle}.")) || upper.ends_with(&format!(".{needle}"))
+    };
+    if has("BUTTON") {
+        "Button"
+    } else if has("EDIT") || upper.starts_with("RICHEDIT") || has("RICHEDIT20W") || has("RICHEDIT50W") {
+        "Edit"
+    } else if has("COMBOBOX") || has("COMBOBOXEX32") {
+        "ComboBox"
+    } else if has("LISTBOX") || has("SYSLISTVIEW32") {
+        "List"
+    } else if has("SYSTREEVIEW32") {
+        "Tree"
+    } else if has("STATIC") {
+        "Text"
+    } else {
+        "Pane"
+    }
+}
+
+/// Whether text can be typed into an element of this control type once it has focus. Focusing a
+/// window-handle element is a click on it, so only controls a click merely focuses qualify: a
+/// click on a button presses it.
+pub fn takes_typed_text(control_type: &str) -> bool {
+    matches!(control_type, "Edit" | "ComboBox")
+}
+
+/// The longest text a single `act` write may carry (a text a tool call could not have produced).
+pub const ACT_MAX_TEXT_BYTES: usize = 1 << 20;
+
+/// What the worker does to the element a `FocusSpec` describes, through UIA patterns (the accessibility
+/// channel: no pointer, no foreground change). The daemon cannot do this itself for an element in a
+/// window above its integrity: it holds no COM object for it.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "snake_case")]
+pub enum ActKind {
+    /// The first of Invoke, Toggle, SelectionItem, ExpandCollapse the element supports.
+    Invoke,
+    /// ValuePattern.SetValue: `text` appended to the current value, or replacing it.
+    SetValue { text: String, append: bool },
+}
+
+impl ActKind {
+    pub fn validate(&self) -> Result<(), String> {
+        match self {
+            ActKind::Invoke => Ok(()),
+            ActKind::SetValue { text, .. } if text.len() > ACT_MAX_TEXT_BYTES => {
+                Err(format!("text is {} bytes, more than {ACT_MAX_TEXT_BYTES}", text.len()))
+            }
+            ActKind::SetValue { .. } => Ok(()),
+        }
+    }
+}
+
+/// What an `act` reports: the pattern that did it, and for a write the value before and after.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ActOutcome {
+    pub pattern: String,
+    /// Only an explicit no-action reply permits a caller to choose another route.
+    /// Missing fields on older successful replies retain their original meaning.
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    pub not_attempted: bool,
+    #[serde(default)]
+    pub before: Option<String>,
+    #[serde(default)]
+    pub after: Option<String>,
+}
+
+impl ActOutcome {
+    pub fn not_attempted() -> Self {
+        Self { pattern: String::new(), not_attempted: true, before: None, after: None }
+    }
+
+    /// Older daemons interpreted every successful act reply as an effect.
+    /// Send no-action data only after the caller explicitly requests it.
+    pub fn encode_for(&self, version: Option<u8>) -> Result<serde_json::Value, String> {
+        if self.not_attempted && version != Some(1) {
+            return Err("the element exposes no supported UIA action pattern; no action was attempted".into());
+        }
+        serde_json::to_value(self).map_err(|error| format!("could not encode worker action outcome: {error}"))
+    }
+
+    pub fn validate_for(&self, action: &ActKind) -> Result<(), String> {
+        if self.not_attempted {
+            if !matches!(action, ActKind::Invoke) || !self.pattern.is_empty()
+                || self.before.is_some() || self.after.is_some()
+            {
+                return Err("worker no-action reply contradicts its action or result fields".into());
+            }
+        } else {
+            let known = match action {
+                ActKind::Invoke => matches!(self.pattern.as_str(), "Invoke" | "Toggle" | "SelectionItem" | "ExpandCollapse"),
+                ActKind::SetValue { .. } => self.pattern == "ValuePattern",
+            };
+            if !known { return Err("worker action reply has an unknown or missing pattern".into()); }
+        }
+        Ok(())
+    }
+}
+
+pub fn act_request(hwnd: u64, spec: &FocusSpec, act: &ActKind) -> String {
+    line(serde_json::json!({ "method": "act", "hwnd": hwnd, "focus": spec, "act": act, "action_outcome_version": 1 }))
+}
+
+/// What a `snapshot` request returns: the rendered tree and its nodes in walk order.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct RemoteSnapshot {
+    pub tree_markdown: String,
+    pub nodes: Vec<RemoteNode>,
+}
+
+/// Shape checks for a snapshot request. The walk caps are the tool's own (default 5000 elements,
+/// depth 25); the worker takes nothing wider than the ceilings above.
+pub fn validate_snapshot(hwnd: u64, max_elements: usize, max_depth: usize) -> Result<(), String> {
+    if hwnd == 0 {
+        return Err("needs an hwnd".into());
+    }
+    if !(1..=SNAPSHOT_MAX_ELEMENTS).contains(&max_elements) {
+        return Err(format!("max_elements {max_elements} is not 1 to {SNAPSHOT_MAX_ELEMENTS}"));
+    }
+    if !(1..=SNAPSHOT_MAX_DEPTH).contains(&max_depth) {
+        return Err(format!("max_depth {max_depth} is not 1 to {SNAPSHOT_MAX_DEPTH}"));
+    }
+    Ok(())
+}
+
+pub fn snapshot_request(hwnd: u64, query: Option<&str>, max_elements: usize, max_depth: usize) -> String {
+    line(serde_json::json!({
+        "method": "snapshot", "hwnd": hwnd, "query": query,
+        "max_elements": max_elements, "max_depth": max_depth,
+    }))
+}
+
+/// One physical gesture for the worker to deliver. Coordinates are screen pixels.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(tag = "op", rename_all = "snake_case")]
+pub enum InputOp {
+    /// `SendInput` click (`send_click_synthesized_mods`, or the activating form).
+    Click { hwnd: u64, x: i32, y: i32, count: usize, button: String, modifiers: Vec<String>, activate: bool },
+    /// Posted `WM_*BUTTON*` click resolved to the deepest child at the screen point.
+    PostClick { hwnd: u64, x: i32, y: i32, count: usize, button: String },
+    /// One `SendInput` wheel event at a screen point; `hwnd` is the top-level window under it.
+    Wheel { hwnd: u64, x: i32, y: i32, ticks: i32, horizontal: bool },
+    /// Posted `WM_VSCROLL` / `WM_HSCROLL` messages to the window's scroll target.
+    /// With `at` (screen pixels), the scrollable control under that point inside `hwnd`; without,
+    /// the window's own scroll target.
+    PostScroll {
+        hwnd: u64,
+        direction: String,
+        by: String,
+        amount: u32,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        at: Option<(i32, i32)>,
+    },
+    /// `SendInput` press, interpolated moves and release (`send_drag_synthesized`), foreground only.
+    /// Both ends are screen pixels and both have to lie inside `hwnd`.
+    Drag { hwnd: u64, from_x: i32, from_y: i32, to_x: i32, to_y: i32, duration_ms: u64, steps: usize, button: String },
+}
+
+/// The longest drag the worker will run, and the most interpolated steps (the tool's own ceiling for
+/// `duration_ms` is the same 10 s).
+pub const DRAG_MAX_DURATION_MS: u64 = 10_000;
+pub const DRAG_MAX_STEPS: usize = 500;
+
+impl InputOp {
+    pub fn hwnd(&self) -> u64 {
+        match self {
+            InputOp::Click { hwnd, .. }
+            | InputOp::PostClick { hwnd, .. }
+            | InputOp::Wheel { hwnd, .. }
+            | InputOp::PostScroll { hwnd, .. }
+            | InputOp::Drag { hwnd, .. } => *hwnd,
+        }
+    }
+
+    /// Every screen point the gesture touches. The worker requires each one to lie on the named
+    /// window, so a drag cannot start inside it and release on another window.
+    pub fn points(&self) -> Vec<(i32, i32)> {
+        match self {
+            InputOp::Drag { from_x, from_y, to_x, to_y, .. } => vec![(*from_x, *from_y), (*to_x, *to_y)],
+            other => other.point().into_iter().collect(),
+        }
+    }
+
+    /// The screen point the gesture acts on, when it has one.
+    pub fn point(&self) -> Option<(i32, i32)> {
+        match self {
+            InputOp::Click { x, y, .. } | InputOp::PostClick { x, y, .. } | InputOp::Wheel { x, y, .. } => Some((*x, *y)),
+            InputOp::PostScroll { at, .. } => *at,
+            InputOp::Drag { from_x, from_y, .. } => Some((*from_x, *from_y)),
+        }
+    }
+
+    /// Shape checks the worker applies before it touches the window: the values the
+    /// tools can produce, nothing wider. The worker is reachable only by its own daemon,
+    /// but it has a privilege the daemon lacks, so it does not take arbitrary numbers.
+    pub fn validate(&self) -> Result<(), String> {
+        if self.hwnd() == 0 {
+            return Err("needs an hwnd".into());
+        }
+        let button_ok = |b: &str| matches!(b, "left" | "right" | "middle");
+        match self {
+            InputOp::Click { count, button, modifiers, .. } => {
+                if !(1..=3).contains(count) {
+                    return Err(format!("click count {count} is not 1 to 3"));
+                }
+                if !button_ok(button) {
+                    return Err(format!("unknown button {button:?}"));
+                }
+                if let Some(m) = modifiers.iter().find(|m| !matches!(m.as_str(), "ctrl" | "control" | "shift" | "alt" | "option" | "cmd" | "command" | "win" | "super" | "meta")) {
+                    return Err(format!("unknown modifier {m:?}"));
+                }
+            }
+            InputOp::PostClick { count, button, .. } => {
+                if !(1..=3).contains(count) {
+                    return Err(format!("click count {count} is not 1 to 3"));
+                }
+                if !button_ok(button) {
+                    return Err(format!("unknown button {button:?}"));
+                }
+            }
+            InputOp::Wheel { ticks, .. } => {
+                if *ticks == 0 || ticks.unsigned_abs() > 150 {
+                    return Err(format!("wheel ticks {ticks} is not 1 to 150 in either direction"));
+                }
+            }
+            InputOp::Drag { duration_ms, steps, button, .. } => {
+                if *duration_ms > DRAG_MAX_DURATION_MS {
+                    return Err(format!("drag duration {duration_ms} ms is over {DRAG_MAX_DURATION_MS}"));
+                }
+                if !(1..=DRAG_MAX_STEPS).contains(steps) {
+                    return Err(format!("drag steps {steps} is not 1 to {DRAG_MAX_STEPS}"));
+                }
+                if !button_ok(button) {
+                    return Err(format!("unknown button {button:?}"));
+                }
+            }
+            InputOp::PostScroll { direction, by, amount, .. } => {
+                if !matches!(direction.as_str(), "up" | "down" | "left" | "right") {
+                    return Err(format!("unknown direction {direction:?}"));
+                }
+                if !matches!(by.as_str(), "line" | "page") {
+                    return Err(format!("unknown scroll unit {by:?}"));
+                }
+                if !(1..=50).contains(amount) {
+                    return Err(format!("scroll amount {amount} is not 1 to 50"));
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
+fn line(value: serde_json::Value) -> String {
+    let mut text = value.to_string();
+    text.push('\n');
+    text
+}
+
+pub fn key_request(hwnd: u64, key: &str, modifiers: &[&str], focus: Option<&FocusSpec>) -> String {
+    let mut value = serde_json::json!({ "method": "key", "hwnd": hwnd, "key": key, "modifiers": modifiers });
+    if let Some(focus) = focus {
+        value["focus"] = serde_json::to_value(focus).expect("focus spec serializes");
+    }
+    line(value)
+}
+
+pub fn text_request(hwnd: u64, text: &str, focus: Option<&FocusSpec>) -> String {
+    let mut value = serde_json::json!({ "method": "text", "hwnd": hwnd, "text": text });
+    if let Some(focus) = focus {
+        value["focus"] = serde_json::to_value(focus).expect("focus spec serializes");
+    }
+    line(value)
+}
+
+pub fn input_request(op: &InputOp) -> String {
+    line(serde_json::json!({ "method": "input", "input": op }))
+}
+
+/// Why a request did not succeed. Only `Transport` says the worker is unusable.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ReplyError {
+    /// The worker answered and declined this request (a bad handle, an element it could not match).
+    Refused(String),
+    /// No usable answer: malformed, closed, timed out, not reachable.
+    Transport(String),
+}
+
+impl std::fmt::Display for ReplyError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            ReplyError::Refused(reason) => write!(f, "worker refused: {reason}"),
+            ReplyError::Transport(reason) => f.write_str(reason),
+        }
+    }
+}
+
+/// `Ok(())` for a well-formed success reply, otherwise why not.
+pub fn parse_reply(line: &str) -> Result<(), ReplyError> {
+    let value: serde_json::Value = serde_json::from_str(line.trim())
+        .map_err(|e| ReplyError::Transport(format!("worker reply is not JSON: {e}")))?;
+    match value.get("ok").and_then(|v| v.as_bool()) {
+        Some(true) => Ok(()),
+        Some(false) => Err(ReplyError::Refused(
+            value.get("error").and_then(|v| v.as_str()).unwrap_or("no reason").to_owned(),
+        )),
+        None => Err(ReplyError::Transport("worker reply has no ok field".to_owned())),
+    }
+}
+
+/// The `result` of a well-formed success reply, otherwise why not.
+pub fn parse_reply_value(line: &str) -> Result<serde_json::Value, ReplyError> {
+    let value: serde_json::Value = serde_json::from_str(line.trim())
+        .map_err(|e| ReplyError::Transport(format!("worker reply is not JSON: {e}")))?;
+    match value.get("ok").and_then(|v| v.as_bool()) {
+        Some(true) => Ok(value.get("result").cloned().unwrap_or(serde_json::Value::Null)),
+        Some(false) => Err(ReplyError::Refused(
+            value.get("error").and_then(|v| v.as_str()).unwrap_or("no reason").to_owned(),
+        )),
+        None => Err(ReplyError::Transport("worker reply has no ok field".to_owned())),
+    }
+}
+
+/// Remembers the last failure so a missing or unreachable worker is not retried
+/// on every foreground attempt.
+#[derive(Default)]
+pub struct FailureMemo {
+    failed: Option<(Instant, String)>,
+}
+
+impl FailureMemo {
+    /// The remembered reason while the suppression window is open.
+    pub fn suppressed(&self, now: Instant) -> Option<&str> {
+        match &self.failed {
+            Some((at, reason)) if now.duration_since(*at) < RETRY_AFTER_FAILURE => Some(reason),
+            _ => None,
+        }
+    }
+    pub fn record(&mut self, now: Instant, reason: String) {
+        self.failed = Some((now, reason));
+    }
+    pub fn clear(&mut self) {
+        self.failed = None;
+    }
+    /// Update the memo with one request's outcome: a transport failure suppresses retries; a
+    /// success or a refusal by a worker that answered clears the memo, because the worker is up.
+    pub fn observe(&mut self, now: Instant, outcome: &Result<(), ReplyError>) {
+        match outcome {
+            Err(ReplyError::Transport(reason)) => self.record(now, reason.clone()),
+            Ok(()) | Err(ReplyError::Refused(_)) => self.clear(),
+        }
+    }
+}
+
+/// Pipe name the worker listens on, from the daemon's own executable name (the
+/// rule in `cua-driver-uia`'s `pipe_path`).
+pub fn worker_pipe_path(daemon_exe_file_name: &str) -> &'static str {
+    if daemon_exe_file_name.eq_ignore_ascii_case("cua-driver-local.exe") {
+        r"\\.\pipe\cua-driver-local-uia"
+    } else {
+        r"\\.\pipe\cua-driver-uia"
+    }
+}
+
+pub fn worker_exe_name(daemon_exe_file_name: &str) -> &'static str {
+    if daemon_exe_file_name.eq_ignore_ascii_case("cua-driver-local.exe") {
+        "cua-driver-uia-local.exe"
+    } else {
+        "cua-driver-uia.exe"
+    }
+}
