+            Some(position) => FIRST_TEXT_KEYCODE + position as u32,
+            None => {
+                if FIRST_TEXT_KEYCODE + assigned.len() as u32 > MAX_TEXT_KEYCODE {
+                    out.push((text_keymap(&assigned), std::mem::take(&mut codes)));
+                    assigned.clear();
+                }
+                assigned.push(ch);
+                FIRST_TEXT_KEYCODE + assigned.len() as u32 - 1
+            }
+        };
+        codes.push(code);
+    }
+    if !codes.is_empty() {
+        out.push((text_keymap(&assigned), codes));
