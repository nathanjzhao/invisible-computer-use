+/// Opt-in: a magenta floating window over the native window, which grim
+/// shows inside the window's rect: the capture is refused and no frame is
+/// written. Round-4 review G1: the cell did not check that the float was
+/// over the window, so a float placed elsewhere passed it too.
+#[test]
+#[ignore]
+fn harness_sway_floating_overlap_capture() {
+    let case = wayland_case(
+        "linux-sway-floating-overlap-capture-ax-not-applicable",
+        "floating_overlap_capture",
+        DriverRoute::WindowState,
+        vec![OracleKind::AxState, OracleKind::TypedRefusal, OracleKind::Pixels],
+    )
+    .expecting_refusal(vec![RefusalCode::SurfaceIdentityUnproven]);
+    run_nested(case, Nested::sway, |sway, recorder| {
+        let wl = Receiver::spawn(recorder, "wayland:WL", &sway.client_env(), &["DISPLAY"]);
+        let mut magenta_env = sway.client_env();
+        magenta_env.push(("REVIEW_GTK_BACKGROUND", "#ff00ff"));
+        let floating = Receiver::spawn(recorder, "wayland:FL", &magenta_env, &["DISPLAY"]);
+        sway.swaymsg(&[&format!(
+            "[pid={}] floating enable, resize set 400 300, move position 200 150",
+            floating.pid
+        )])
+        .expect("float the second window over the first");
+        std::thread::sleep(Duration::from_millis(800));
+        let mut driver = sway.driver(true);
+        let window = wl_window(&mut driver, wl.pid).expect("native window listed");
+        let dir = tempfile::tempdir().unwrap();
+        let grim_png = dir.path().join("grim.png");
+        sway.grim(sway.container_rect(wl.pid), &grim_png);
+        let magenta = image::open(&grim_png)
+            .unwrap()
+            .to_rgb8()
+            .pixels()
+            .filter(|p| p[0] > 240 && p[1] < 20 && p[2] > 240)
+            .count();
+        assert!(magenta > 1000, "the floating window is not over the window ({magenta} magenta px)");
+        assert_sway_capture_refused(&mut driver, wl.pid, window, &dir.path().join("wl.png"), "under a floating window");
+        Observation::refused(
+            RefusalCode::SurfaceIdentityUnproven,
+            vec![OracleKind::AxState, OracleKind::TypedRefusal, OracleKind::Pixels],
+            format!("floating overlap ({magenta} px in the window rect) refused"),
+            Evidence::default(),
+        )
+    });
+}
