+fn pixel_binding_refuses_a_stale_window_before_any_frame_check() {
+    // Structural guard for the round-2 review's B2: the window/pid check lives
+    // in `pixel_binding`, which every window-pixel tool calls, so no tool can
+    // deliver to another process's window or reach an X request on a closed one.
+    let source = include_str!("impl_.rs");
+    let body = source
+        .split_once("fn pixel_binding(args: &Value, pid: u32, xid: u64)")
+        .unwrap()
+        .1
+        .split_once("\n}\n")
+        .unwrap()
+        .0;
+    let stale = body.find("stale_x11_window_target(pid, xid)").expect("pixel_binding checks the window");
+    let resolve = body.find("PixelBinding::resolve").unwrap();
+    assert!(stale < resolve, "the window check runs before the frame lookup");
+    let mouse_down = source
+        .rsplit_once("impl Tool for MouseButtonDownTool {")
+        .unwrap()
+        .1
+        .split_once("impl Tool for MouseDragTool {")
+        .unwrap()
+        .0;
+    assert!(mouse_down.contains("stale_x11_window_target(pid, xid)"), "mouse_button_down");
+}
