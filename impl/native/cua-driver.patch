+    )
+    .expecting_refusal(vec![RefusalCode::SurfaceIdentityUnproven]);
+    run_nested(case, Nested::sway, |sway, recorder| {
+        let wl = Receiver::spawn(recorder, "wayland:WL", &sway.client_env(), &["DISPLAY"]);
+        let mut driver = sway.driver(true);
+        let mut window = None;
+        wait_until("the native window to be listed", Duration::from_secs(10), || {
+            window = wl_window(&mut driver, wl.pid);
+            window.is_some()
+        });
+        let window = window.unwrap();
+        let dir = tempfile::tempdir().unwrap();
+        let mako_config = dir.path().join("mako.conf");
+        std::fs::write(
+            &mako_config,
+            "anchor=top-right\nwidth=700\nheight=300\nlayer=overlay\ndefault-timeout=0\nbackground-color=#ff00ff\n",
+        )
+        .unwrap();
+        let mut env = sway.client_env();
+        env.retain(|(key, _)| *key != "GDK_BACKEND");
+        let mut mako = Command::new("mako");
+        mako.arg("-c").arg(&mako_config).env_remove("DISPLAY");
+        for (key, value) in &env {
+            mako.env(key, value);
+        }
+        recorder.reaper().spawn(&mut mako).expect("start mako");
+        std::thread::sleep(Duration::from_millis(1500));
+        let mut notify = Command::new("notify-send");
+        notify.args(["REVIEW LAYER SHELL", "non-exclusive overlay over the window"]);
+        for (key, value) in &env {
+            notify.env(key, value);
+        }
+        assert!(notify.status().expect("notify-send").success());
+        std::thread::sleep(Duration::from_millis(2000));
+        let grim_png = dir.path().join("grim.png");
+        sway.grim(sway.container_rect(wl.pid), &grim_png);
+        let magenta = image::open(&grim_png)
+            .unwrap()
+            .to_rgb8()
+            .pixels()
+            .filter(|p| p[0] > 240 && p[1] < 20 && p[2] > 240)
+            .count();
+        assert!(magenta > 1000, "the notification is not over the window ({magenta} magenta px)");
+        assert_sway_capture_refused(&mut driver, wl.pid, window, &dir.path().join("after.png"), "under a notification");
+        Observation::refused(
+            RefusalCode::SurfaceIdentityUnproven,
+            vec![OracleKind::AxState, OracleKind::TypedRefusal, OracleKind::Pixels],
