index 00000000..6a774e48
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-windows/src/semantic_outcome.rs
@@ -0,0 +1,559 @@
+//! UIA route selection distinguishes an unsupported pattern from an action
+//! whose provider returned an error after possibly applying its effect.
+
+use cua_driver_core::action_record::{
+    ActionAttempt, ActionEffect, ActionExecutionRecord, ActionTransport, ActualDelivery,
+    RequestedDelivery,
+};
+use cua_driver_core::protocol::ToolResult;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum SemanticAction {
+    Invoke,
+    Toggle,
+    Select,
+    Expand,
+    Value,
+    RangeValue,
+}
+
+impl SemanticAction {
+    pub(crate) const CLICK_ORDER: [Self; 4] =
+        [Self::Invoke, Self::Toggle, Self::Select, Self::Expand];
+
+    pub(crate) fn pattern(self) -> &'static str {
+        match self {
+            Self::Invoke => "Invoke",
+            Self::Toggle => "Toggle",
+            Self::Select => "SelectionItem",
+            Self::Expand => "ExpandCollapse",
+            Self::Value => "ValuePattern",
+            Self::RangeValue => "RangeValuePattern",
+        }
+    }
+
+    pub(crate) fn transport(self) -> ActionTransport {
+        match self {
+            Self::Invoke => ActionTransport::WindowsUiaInvoke,
+            Self::Toggle => ActionTransport::WindowsUiaToggle,
+            Self::Select => ActionTransport::WindowsUiaSelection,
+            Self::Expand => ActionTransport::WindowsUiaExpandCollapse,
+            Self::Value => ActionTransport::WindowsUiaValue,
+            Self::RangeValue => ActionTransport::WindowsUiaRangeValue,
+        }
+    }
+}
+
+#[derive(Debug, thiserror::Error)]
+#[error("{cause}")]
+pub(crate) struct SemanticFailure {
+    pub(crate) action: Option<SemanticAction>,
+    pub(crate) cause: String,
+}
+
+impl SemanticFailure {
+    pub(crate) fn unknown(cause: impl Into<String>) -> Self {
+        Self {
+            action: None,
+            cause: cause.into(),
+        }
+    }
+
+    pub(crate) fn into_result(self) -> ToolResult {
+        self.into_result_with_delivery(RequestedDelivery::Background)
+    }
+
+    pub(crate) fn into_result_with_delivery(self, requested: RequestedDelivery) -> ToolResult {
+        let mut result = ToolResult::error(format!(
+            "UIA action outcome is uncertain: {}. Inspect fresh state before choosing \
+             another action; do not repeat or switch action routes automatically.",
+            self.cause
+        ))
+        .with_structured(serde_json::json!({
+            "status": "uncertain", "code": "action_outcome_unknown",
+            "effect": "unverifiable", "verified": false,
+            "path": "ax", "cause": self.cause,
+        }));
+        if let Some(action) = self.action {
+            let transport = action.transport();
+            let mut record =
+                ActionExecutionRecord::new(ActionEffect::Unverifiable, transport, requested);
+            record.actual_delivery = Some(ActualDelivery::Unknown);
+            record.attempts.push(ActionAttempt {
+                transport,
+                delivery: ActualDelivery::Background,
+                detail: Some("UIA provider action returned an error".into()),
+            });
+            result = result.with_action_record(record);
+        }
+        result
+    }
+}
+
+#[derive(Debug)]
+pub(crate) enum SemanticAttempt {
+    NotAttempted,
+    Completed(SemanticAction),
+    Uncertain(SemanticFailure),
+}
+
+impl SemanticAttempt {
+    pub(crate) fn dispatched<E: std::fmt::Display>(
+        action: SemanticAction,
+        result: Result<(), E>,
+    ) -> Self {
+        match result {
+            Ok(()) => Self::Completed(action),
+            Err(error) => Self::Uncertain(SemanticFailure {
+                action: Some(action),
+                cause: format!("{} action failed: {error}", action.pattern()),
+            }),
+        }
+    }
+}
+
+/// Query/cast misses can select another supported pattern. A provider action
+/// returning either success or error is terminal for this requested action.
+pub(crate) fn choose_action(
+    candidates: &[SemanticAction],
+    mut attempt: impl FnMut(SemanticAction) -> SemanticAttempt,
+) -> SemanticAttempt {
+    for action in candidates.iter().copied() {
+        match attempt(action) {
+            SemanticAttempt::NotAttempted => {}
+            terminal => return terminal,
+        }
+    }
+    SemanticAttempt::NotAttempted
+}
+
+/// Repetition requested by the caller is allowed until a provider reports an
+/// error. Do not issue the remaining planned actions after an uncertain effect.
+pub(crate) fn repeat_action<E: std::fmt::Display>(
+    action: SemanticAction,
+    count: usize,
+    mut dispatch: impl FnMut() -> Result<(), E>,
+    mut between: impl FnMut(),
+) -> SemanticAttempt {
+    let count = count.max(1);
+    for index in 0..count {
+        match SemanticAttempt::dispatched(action, dispatch()) {
+            SemanticAttempt::Completed(_) => {}
+            terminal => return terminal,
+        }
+        if index + 1 < count {
+            between();
+        }
+    }
+    SemanticAttempt::Completed(action)
+}
+
+#[derive(Debug, thiserror::Error)]
+pub(crate) enum SemanticOperationFailure {
+    #[error("{reason}")]
+    Preflight { code: &'static str, reason: String },
+    #[error(transparent)]
+    Action(#[from] SemanticFailure),
+}
+
+pub(crate) type ValueWriteFailure = SemanticOperationFailure;
+
+impl SemanticOperationFailure {
+    pub(crate) fn preflight(code: &'static str, reason: impl Into<String>) -> Self {
+        Self::Preflight {
+            code,
+            reason: reason.into(),
+        }
+    }
+
+    pub(crate) fn after_action(action: SemanticAction, error: impl std::fmt::Display) -> Self {
+        Self::Action(SemanticFailure {
+            action: Some(action),
+            cause: format!("{} action failed: {error}", action.pattern()),
+        })
+    }
+
+    pub(crate) fn into_result(self, requested: RequestedDelivery) -> ToolResult {
+        match self {
+            Self::Action(failure) => failure.into_result_with_delivery(requested),
+            Self::Preflight { code, reason } => ToolResult::error(reason).with_structured(
+                serde_json::json!({"status":"refused", "effect":"refused", "code":code}),
+            ),
+        }
+    }
+}
+
+/// An explicit pattern request has no alternate mutation. Query/cast failures
+/// are preflight refusals; once dispatch begins, any error preserves effects.
+pub(crate) fn explicit_action<T, E: std::fmt::Display>(
+    action: SemanticAction,
+    resolve: impl FnOnce() -> Result<T, E>,
+    dispatch: impl FnOnce(T) -> Result<(), E>,
+) -> Result<(), SemanticOperationFailure> {
+    let pattern = resolve().map_err(|error| {
+        SemanticOperationFailure::preflight(
+            "action_pattern_unavailable",
+            format!(
+                "{} pattern is unavailable: {error}. No action was attempted.",
+                action.pattern()
+            ),
+        )
+    })?;
+    dispatch(pattern).map_err(|error| SemanticOperationFailure::after_action(action, error))
+}
+
+pub(crate) struct ValueWrite {
+    pub(crate) before: Option<String>,
+    pub(crate) expected: String,
+}
+
+/// Append must preserve an observed prior value. Reading that value is a
+/// preflight; once SetValue is called, any failure preserves possible effects.
+pub(crate) fn write_text_value<E: std::fmt::Display>(
+    text: &str,
+    append: bool,
+    read: impl FnOnce() -> Result<String, E>,
+    write: impl FnOnce(&str) -> Result<(), E>,
+) -> Result<ValueWrite, ValueWriteFailure> {
+    let before = match read() {
+        Ok(value) => Some(value),
+        Err(error) if append => return Err(ValueWriteFailure::Preflight {
+            code: "value_read_failed",
+            reason: format!("Could not read the current value before appending: {error}. No value write was attempted."),
+        }),
+        Err(_) => None,
+    };
+    let expected = if append {
+        format!(
+            "{}{text}",
+            before
+                .as_deref()
+                .expect("append preflight requires a value")
+        )
+    } else {
+        text.to_owned()
+    };
+    write(&expected)
+        .map_err(|error| ValueWriteFailure::after_action(SemanticAction::Value, error))?;
+    Ok(ValueWrite { before, expected })
+}
+
+/// Only a missing pattern can select another value route. Both preflight
+/// validation failures and errors from a setter stop this action.
+pub(crate) fn choose_value_route<T>(
+    mut attempt: impl FnMut(SemanticAction) -> Result<Option<T>, ValueWriteFailure>,
+) -> Result<Option<T>, ValueWriteFailure> {
+    for action in [SemanticAction::Value, SemanticAction::RangeValue] {
+        if let Some(value) = attempt(action)? {
+            return Ok(Some(value));
+        }
+    }
+    Ok(None)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn effect_then_provider_error_never_dispatches_another_pattern() {
+        for selected in SemanticAction::CLICK_ORDER {
+            let mut attempts = Vec::new();
+            let mut effects = 0;
+            let result = choose_action(&SemanticAction::CLICK_ORDER, |action| {
+                if action != selected && attempts.is_empty() {
+                    return SemanticAttempt::NotAttempted;
+                }
+                attempts.push(action);
+                effects += 1;
+                SemanticAttempt::dispatched(action, Err("effect applied before error"))
+            });
+            assert_eq!(effects, 1);
+            assert_eq!(attempts, [selected]);
+            let SemanticAttempt::Uncertain(failure) = result else {
+                panic!("must be uncertain")
+            };
+            let result = failure.into_result();
+            assert_eq!(result.is_error, Some(true));
+            let data = result.structured_content.unwrap();
+            assert_eq!(data["effect"], "unverifiable");
+            assert_eq!(data["status"], "uncertain");
+            assert!(data.get("escalation").is_none());
+            let record = result.action_record.unwrap();
+            assert_eq!(record.actual_delivery, Some(ActualDelivery::Unknown));
+            assert_eq!(record.attempts.len(), 1);
+            assert_eq!(record.attempts[0].transport, selected.transport());
+            assert!(record.fallbacks.is_empty());
+        }
+    }
+
