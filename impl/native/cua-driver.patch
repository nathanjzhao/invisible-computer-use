+        let mut window = None;
+        wait_until("the native window to be listed", Duration::from_secs(10), || {
+            window = wl_window(&mut driver, wl.pid);
+            window.is_some()
+        });
+        std::thread::sleep(Duration::from_millis(800));
+        let dir = tempfile::tempdir().unwrap();
+        assert_sway_capture_refused(
+            &mut driver,
+            wl.pid,
+            window.unwrap(),
+            &dir.path().join("driver.png"),
+            "with an XWayland window (null app_id) in the tree",
+        );
+        sway_readiness_refuses_window_capture(&mut driver);
+        Observation::refused(
+            RefusalCode::SurfaceIdentityUnproven,
+            vec![OracleKind::AxState, OracleKind::TypedRefusal, OracleKind::ReadinessAgrees],
+            "sway capture refused for sway's reason with a null-app_id XWayland view in the tree; readiness agreed",
+            Evidence::default(),
+        )
+    });
+}
