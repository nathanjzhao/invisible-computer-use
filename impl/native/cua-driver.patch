+}
+
+/// Opt-in mutter: every route `health_report` names agrees with its own call.
+/// A refusal code must come back as that refusal with no effect; any other
+/// route must deliver. Red under `routes` (mutter claims a virtual keyboard).
+#[test]
+#[ignore]
+fn harness_mutter_routes_readiness() {
+    let case = wayland_case(
+        "linux-mutter-routes-readiness",
+        "routes_readiness",
+        DriverRoute::Readiness,
+        vec![OracleKind::FixtureState, OracleKind::ReadinessAgrees],
+    );
+    run_nested(case, Nested::mutter, |mutter, recorder| {
+        let wl = Receiver::spawn(recorder, "wayland:WL", &mutter.client_env(), &["DISPLAY"]);
+        let mut driver = mutter.driver(true);
+        let backend = wayland_backend_check(&mut driver);
+        let routes = backend["data"]["wayland_routes"].clone();
+        assert!(routes.is_object(), "no wayland_routes: {backend}");
+        let mut window = None;
+        wait_until("the native window to be listed", Duration::from_secs(10), || {
+            window = wl_window(&mut driver, wl.pid);
+            window.is_some()
+        });
+        let window = window.unwrap();
+        let refusals = ["background_unavailable", "foreground_unavailable", "surface_identity_unproven"];
+        let mut disagreements = Vec::new();
+        let dir = tempfile::tempdir().unwrap();
+
+        let route = routes["window_capture"].as_str().unwrap_or("").to_owned();
+        let shot = capture(&mut driver, wl.pid, window, &dir.path().join("wl.png"));
+        let code = shot.structured()["screenshot_error"]["code"].as_str().map(str::to_owned);
+        let framed = dir.path().join("wl.png").exists();
+        if refusals.contains(&route.as_str()) {
+            if code.as_deref() != Some(route.as_str()) || framed {
+                disagreements.push(format!("window_capture={route} but code {code:?}, frame {framed}"));
+            }
+        } else if !framed {
+            disagreements.push(format!("window_capture={route} but no frame ({code:?})"));
+        }
+
+        let state = driver.call(
+            "get_window_state",
+            serde_json::json!({ "pid": wl.pid as i64, "window_id": window, "include_screenshot": false }),
+        );
+        let token = element_token(&state, "WL-1");
+        type Effect = Box<dyn Fn(&serde_json::Value) -> bool>;
+        let checks: Vec<(&str, serde_json::Value, Effect)> = vec![
+            (
+                "background_element_click",
+                serde_json::json!({ "tool": "click", "element_token": token, "delivery_mode": "background" }),
+                Box::new(|e: &serde_json::Value| e["hit"] == "clicked" && e["label"] == "WL-1"),
+            ),
+            (
+                "background_text",
+                serde_json::json!({ "tool": "type_text", "text": "ok", "delivery_mode": "background" }),
+                Box::new(|e: &serde_json::Value| e["hit"] == "text" && e["text"].as_str().unwrap_or("").contains("ok")),
+            ),
+            (
+                "background_keys",
+                serde_json::json!({ "tool": "press_key", "key": "a", "delivery_mode": "background" }),
+                Box::new(|e: &serde_json::Value| e["hit"] == "text" && e["text"].as_str().unwrap_or("").ends_with('a')),
+            ),
+            (
+                "foreground_keys",
+                serde_json::json!({ "tool": "press_key", "key": "b", "delivery_mode": "foreground" }),
+                Box::new(|e: &serde_json::Value| e["hit"] == "text" && e["text"].as_str().unwrap_or("").ends_with('b')),
+            ),
+        ];
+        for (class, request, effect) in checks {
+            let route = routes[class].as_str().unwrap_or("").to_owned();
+            let mut args = request.clone();
+            let tool = args["tool"].as_str().unwrap().to_owned();
+            args.as_object_mut().unwrap().remove("tool");
+            args["pid"] = serde_json::json!(wl.pid as i64);
+            args["window_id"] = serde_json::json!(window);
+            let before = wl.events().len();
+            let response = driver.call(&tool, args);
+            std::thread::sleep(Duration::from_millis(1000));
+            let landed = wl.events()[before..].iter().any(|event| effect(event));
+            let refused = refusal_code(&response);
+            if refusals.contains(&route.as_str()) {
+                if refused.as_deref() != Some(route.as_str()) || landed {
+                    disagreements.push(format!("{class}={route} but refusal {refused:?}, effect {landed}"));
+                }
+            } else if response.is_error() || !landed {
+                disagreements.push(format!("{class}={route} but error {} ({refused:?}), effect {landed}", response.is_error()));
+            }
+            eprintln!("[readiness] {class}={route}: error={} refusal={refused:?} effect={landed} text={:?}", response.is_error(), response.text());
+        }
+        assert!(disagreements.is_empty(), "readiness disagrees with the calls: {disagreements:?} routes={routes}");
+        Observation::delivered(
+            vec![OracleKind::FixtureState, OracleKind::ReadinessAgrees],
+            Evidence::default(),
+        )
+    });
+}
