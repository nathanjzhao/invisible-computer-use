+                action,
+                "error after effect",
+            ))
+        });
+        assert_eq!(stored, "applied value");
+        assert_eq!(calls, [SemanticAction::Value]);
+        let result = result
+            .unwrap_err()
+            .into_result(RequestedDelivery::Foreground);
+        assert_eq!(result.structured_content.unwrap()["effect"], "unverifiable");
+        assert_eq!(
+            result.action_record.unwrap().requested_delivery,
+            RequestedDelivery::Foreground
+        );
+    }
+
+    #[test]
+    fn absent_value_pattern_can_choose_range_pattern() {
+        let mut writes = Vec::new();
+        let selected = choose_value_route(|action| {
+            if action == SemanticAction::Value {
+                return Ok(None);
+            }
+            writes.push(action);
+            Ok(Some(action))
+        })
+        .unwrap();
+        assert_eq!(selected, Some(SemanticAction::RangeValue));
+        assert_eq!(writes, [SemanticAction::RangeValue]);
+    }
+
+    #[test]
+    fn append_read_failure_never_replaces_existing_content() {
+        let mut writes = 0;
+        let result = write_text_value(
+            "suffix",
+            true,
+            || Err("read failed"),
+            |_| {
+                writes += 1;
+                Ok(())
+            },
+        );
+        assert_eq!(writes, 0);
+        let result = result
+            .err()
+            .unwrap()
+            .into_result(RequestedDelivery::Background);
+        assert_eq!(
+            result.structured_content.unwrap()["code"],
+            "value_read_failed"
+        );
+    }
+
+    #[test]
+    fn append_applied_before_error_is_uncertain_and_called_once() {
+        let mut stored = String::from("before");
+        let mut calls = 0;
+        let result = write_text_value(
+            "suffix",
+            true,
+            || Ok("before".to_owned()),
+            |value| {
+                stored = value.to_owned();
+                calls += 1;
+                Err("setter failed after applying")
+            },
+        );
+        assert_eq!(stored, "beforesuffix");
+        assert_eq!(calls, 1);
+        let data = result
+            .err()
+            .unwrap()
+            .into_result(RequestedDelivery::Background)
+            .structured_content
+            .unwrap();
+        assert_eq!(data["effect"], "unverifiable");
+        assert!(data.get("escalation").is_none());
+    }
+
+    #[test]
+    fn successful_append_preserves_before_and_expected_values() {
+        let mut stored = String::new();
+        let write = write_text_value(
+            "suffix",
+            true,
+            || Ok::<_, &str>("before".into()),
+            |value| {
+                stored = value.to_owned();
+                Ok(())
+            },
+        )
+        .unwrap();
+        assert_eq!(write.before.as_deref(), Some("before"));
+        assert_eq!(write.expected, "beforesuffix");
+        assert_eq!(stored, write.expected);
+    }
+
+    #[test]
+    fn explicit_replacement_does_not_require_a_readable_prior_value() {
+        let mut stored = String::new();
+        let write = write_text_value(
+            "replacement",
+            false,
+            || Err("unreadable prior"),
+            |value| {
+                stored = value.to_owned();
+                Ok(())
+            },
+        )
+        .unwrap();
+        assert!(write.before.is_none());
+        assert_eq!(stored, "replacement");
+    }
+    #[test]
+    fn explicit_expand_query_error_is_a_preflight_without_dispatch() {
+        let mut dispatched = 0;
+        let result = explicit_action(
+            SemanticAction::Expand,
+            || Err::<(), _>("query failed"),
+            |_| {
+                dispatched += 1;
+                Ok(())
+            },
+        );
+        assert_eq!(dispatched, 0);
+        let result = result
+            .unwrap_err()
+            .into_result(RequestedDelivery::Foreground);
+        assert_eq!(result.structured_content.unwrap()["effect"], "refused");
+        assert!(result.action_record.is_none());
+    }
+
+    #[test]
+    fn explicit_expand_effect_then_error_is_uncertain_without_replay() {
+        let mut dispatched = 0;
+        let result = explicit_action(
+            SemanticAction::Expand,
+            || Ok(()),
+            |_| {
+                dispatched += 1;
+                Err("expanded then provider failed")
+            },
+        );
+        assert_eq!(dispatched, 1);
+        let result = result
+            .unwrap_err()
+            .into_result(RequestedDelivery::Foreground);
+        let data = result.structured_content.unwrap();
+        assert_eq!(data["status"], "uncertain");
+        assert_eq!(data["effect"], "unverifiable");
+        assert!(data.get("escalation").is_none());
+        let record = result.action_record.unwrap();
+        assert_eq!(record.transport, ActionTransport::WindowsUiaExpandCollapse);
+        assert_eq!(record.requested_delivery, RequestedDelivery::Foreground);
+        assert_eq!(record.actual_delivery, Some(ActualDelivery::Unknown));
+        assert_eq!(record.attempts.len(), 1);
+    }
+}
diff --git a/libs/cua-driver/rust/crates/platform-windows/src/borrowed_com.rs b/libs/cua-driver/rust/crates/platform-windows/src/borrowed_com.rs
new file mode 100644
index 00000000..32b41173
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-windows/src/borrowed_com.rs
@@ -0,0 +1,111 @@
+//! Scoped borrowed COM interfaces. The retained cache guard owns Release.
+
+#[cfg(target_os = "windows")]
+use windows::core::Interface;
+#[cfg(not(target_os = "windows"))]
+use windows_core::Interface;
+
+/// Invoke a closure using an interface borrowed from a retained owner.
+///
+/// # Safety
+/// `raw` must be null or a live `I` interface, kept alive by its owning guard
+/// throughout this call. This function never acquires or releases ownership.
+pub(crate) unsafe fn with_borrowed_interface<I: Interface, R>(
+    raw: *mut core::ffi::c_void,
+    operation: impl FnOnce(&I) -> R,
+) -> Option<R> {
+    I::from_raw_borrowed(&raw).map(operation)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use core::ffi::c_void;
+    use std::sync::atomic::{AtomicU32, Ordering};
+    use windows_core::{IUnknown, IUnknown_Vtbl, GUID, HRESULT};
+
+    #[repr(C)]
+    struct FakeCom {
+        vtable: *const IUnknown_Vtbl,
+        adds: AtomicU32,
+        releases: AtomicU32,
+    }
+
+    unsafe extern "system" fn query(
+        _: *mut c_void,
+        _: *const GUID,
+        out: *mut *mut c_void,
+    ) -> HRESULT {
+        *out = std::ptr::null_mut();
+        HRESULT(0x80004002u32 as i32)
+    }
+    unsafe extern "system" fn add(raw: *mut c_void) -> u32 {
+        (*(raw as *const FakeCom))
+            .adds
+            .fetch_add(1, Ordering::SeqCst)
+            + 1
+    }
+    unsafe extern "system" fn release(raw: *mut c_void) -> u32 {
+        (*(raw as *const FakeCom))
+            .releases
+            .fetch_add(1, Ordering::SeqCst)
+            + 1
+    }
+    static VTABLE: IUnknown_Vtbl = IUnknown_Vtbl {
+        QueryInterface: query,
+        AddRef: add,
+        Release: release,
+    };
+
+    fn object() -> FakeCom {
+        FakeCom {
+            vtable: &VTABLE,
+            adds: AtomicU32::new(0),
+            releases: AtomicU32::new(0),
+        }
+    }
+
+    #[test]
+    fn query_or_action_error_does_not_release_the_retained_owner() {
+        for failure in ["pattern query failed", "effect applied before action error"] {
+            let mut fake = object();
+            let raw = (&mut fake as *mut FakeCom).cast();
+            let owner = unsafe { IUnknown::from_raw(raw) };
+            let outcome = unsafe {
+                with_borrowed_interface::<IUnknown, _>(raw, |borrowed| {
+                    assert_eq!(borrowed.as_raw(), owner.as_raw());
+                    Err::<(), _>(failure)
+                })
+            };
+            assert_eq!(outcome, Some(Err(failure)));
+            assert_eq!(fake.adds.load(Ordering::SeqCst), 0);
+            assert_eq!(fake.releases.load(Ordering::SeqCst), 0);
+            drop(owner);
+            assert_eq!(fake.releases.load(Ordering::SeqCst), 1);
+        }
+    }
+
+    #[test]
+    fn unwind_does_not_release_the_borrowed_interface() {
+        let mut fake = object();
+        let raw = (&mut fake as *mut FakeCom).cast();
+        let owner = unsafe { IUnknown::from_raw(raw) };
+        let panic = std::panic::catch_unwind(|| unsafe {
+            with_borrowed_interface::<IUnknown, ()>(raw, |_| panic!("provider panic"))
+        });
+        assert!(panic.is_err());
+        assert_eq!(fake.releases.load(Ordering::SeqCst), 0);
+        drop(owner);
+        assert_eq!(fake.releases.load(Ordering::SeqCst), 1);
+    }
+
+    #[test]
+    fn null_interface_does_not_call_the_operation() {
+        let result = unsafe {
+            with_borrowed_interface::<IUnknown, ()>(std::ptr::null_mut(), |_| {
+                panic!("null interface must not be used")
+            })
+        };
+        assert!(result.is_none());
+    }
+}
