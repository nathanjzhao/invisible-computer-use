+    #[test]
+    fn get_window_state_records_each_capture_for_its_session_once_finished() {
+        let source = include_str!("get_window_state.rs");
+        assert!(!source.contains("is_preview_capture") && !source.contains("note_capture"));
+        let ratio = source.find("let ratio = orig_w").expect("ratio computed");
+        let recorded = source.find("cua_driver_core::capture_log::record(").expect("capture recorded");
+        assert!(ratio < recorded, "a frame is recorded only once its ratio is known");
+        let call = &source[recorded..recorded + source[recorded..].find("));").unwrap()];
+        assert!(call.contains("capture_session.clone(),"), "recorded for the capturing session");
+        let begun = source.find("CaptureSession::begin(&args)").expect("session taken");
+        let captured = source.find("screenshot_window_bytes").expect("capture");
+        assert!(begun < captured, "the session is taken before the capture starts");
+        assert!(call.contains("\n                                ratio,\n"), "recorded with its own ratio, not a placeholder");
+    }
