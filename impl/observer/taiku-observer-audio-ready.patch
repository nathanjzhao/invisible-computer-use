 use std::sync::{Arc, Mutex, MutexGuard};
 
 use serde::Serialize;
+
+/// A bounded multi-source capture starts its duration only after every
+/// requested source has delivered audio or explicitly reported unavailability.
+/// Each stream retains its actual first-sample timestamp and sample cap.
+#[derive(Default)]
+struct AudioStart {
+    expected: [bool; 2],
+    started: [Option<std::time::Instant>; 2],
+    failed: [bool; 2],
+}
+impl AudioStart {
+    fn index(name: &str) -> Option<usize> { match name { "mic" => Some(0), "system" => Some(1), _ => None } }
+    fn start(&mut self, name: &str, at: std::time::Instant) {
+        let Some(i) = Self::index(name) else { return };
+        if self.expected.iter().any(|v| *v) && !self.expected[i] { return; }
+        self.started[i].get_or_insert(at);
+    }
+    fn unavailable(&mut self, name: &str) {
+        if let Some(i) = Self::index(name) { self.failed[i] = true; }
+    }
+    fn elapsed_at(&self, now: std::time::Instant) -> Option<std::time::Duration> {
+        if (0..2).any(|i| self.expected[i] && self.started[i].is_none() && !self.failed[i]) { return None; }
+        self.started.iter().flatten().max().map(|at| now.saturating_duration_since(*at))
+    }
+}
+
+#[cfg(test)]
+mod audio_start_tests {
+    use super::*;
+    use std::time::{Duration, Instant};
+    #[test]
+    fn late_source_receives_its_full_bounded_capture() {
+        let at = Instant::now();
+        let mut state = AudioStart { expected: [true, true], ..Default::default() };
+        state.start("mic", at);
+        assert_eq!(state.elapsed_at(at + Duration::from_secs(2)), None);
+        state.start("system", at + Duration::from_secs(2));
+        assert_eq!(state.elapsed_at(at + Duration::from_millis(2050)), Some(Duration::from_millis(50)));
+        state.start("mic", at + Duration::from_secs(8));
+        assert_eq!(state.elapsed_at(at + Duration::from_secs(8)), Some(Duration::from_secs(6)));
+    }
+    #[test]
+    fn unavailable_source_resolves_without_restarting_the_other_clock() {
+        let at = Instant::now();
+        let mut state = AudioStart { expected: [true, true], ..Default::default() };
+        state.start("mic", at);state.unavailable("unknown");
+        assert_eq!(state.elapsed_at(at + Duration::from_secs(1)), None);
+        state.unavailable("system");
+        assert_eq!(state.elapsed_at(at + Duration::from_millis(100)), Some(Duration::from_millis(100)));
+    }
+    #[test]
+    fn unrequested_and_duplicate_sources_do_not_move_the_deadline() {
+        let at = Instant::now();
+        let mut state = AudioStart { expected: [true, false], ..Default::default() };
+        state.start("system", at);state.start("unknown", at);
+        assert_eq!(state.elapsed_at(at), None);
+        state.start("mic", at);state.start("mic", at + Duration::from_secs(1));
+        assert_eq!(state.elapsed_at(at + Duration::from_secs(1)), Some(Duration::from_secs(1)));
+    }
+}
 
