+    #[test] fn late_resolution_is_never_current_evidence(){let s=Sample{at:1,queued:Instant::now()-Duration::from_millis(251),x:0.,y:0.,kind:"ui.click",button:0,from:None,delta:(0.,0.)};assert!(s.stale());}
+    #[test] fn stale_and_invalid_gestures_are_dropped(){let mut t=Tracker::default();assert!(t.accept(Input::Down(0),f64::NAN,0.,1).is_none());t.accept(Input::Down(0),0.,0.,1);assert!(t.accept(Input::Up(0),100.,100.,61_000_000_001).is_none());}
