+//! Passive pointer observations. No key subscription, input injection or stored move stream.
+use std::time::{Duration,Instant};
+use serde_json::{json,Value};
+#[derive(Clone,Copy,Debug)]
+pub enum Input { Down(u8), Up(u8), Wheel(f64,f64) }
+#[derive(Clone,Copy,Debug)]
+pub struct Sample { pub at:i64,pub queued:Instant,pub x:f64,pub y:f64,pub kind:&'static str,pub button:u8,pub from:Option<(f64,f64)>,pub delta:(f64,f64) }
+impl Sample {
+    pub fn stale(&self)->bool {self.queued.elapsed()>Duration::from_millis(250)}
+    pub fn fields(&self,p:&mut Value){
+        if self.kind=="ui.scroll" {p.as_object_mut().unwrap().remove("button");}
+        if self.kind!="ui.scroll" {p["button"]=json!(match self.button {0=>"left",1=>"right",2=>"middle",_=>"other"});}
+        if let Some((x,y))=self.from {p["from_x"]=json!(x);p["from_y"]=json!(y);}
+        if self.kind=="ui.scroll" {p["dx"]=json!(self.delta.0);p["dy"]=json!(self.delta.1);p["units"]=json!("native");}
+        p["observed_only"]=json!(true);
+    }
+}
+#[derive(Default)]
+pub struct Tracker {downs:[Option<(f64,f64,i64)>;3]}
+impl Tracker {
+    pub fn reset(&mut self){self.downs=[None;3];}
+    pub fn accept(&mut self,input:Input,x:f64,y:f64,at:i64)->Option<Sample>{
+        if !x.is_finite()||!y.is_finite(){return None;}
+        let mut s=Sample{at,queued:Instant::now(),x,y,kind:"ui.click",button:0,from:None,delta:(0.,0.)};
+        match input {
+            Input::Down(b)=>{if b>2{return None;}self.downs[b as usize]=Some((x,y,at));s.button=b;},
+            Input::Up(b)=>{if b>2{return None;}let (a,z,t)=self.downs[b as usize].take()?;
+                if at<t||at-t>60_000_000_000||((x-a).powi(2)+(y-z).powi(2))<16.{return None;}
+                s.kind="ui.drag";s.button=b;s.from=Some((a,z));},
+            Input::Wheel(dx,dy)=>{if !dx.is_finite()||!dy.is_finite()||(dx==0.&&dy==0.){return None;}s.kind="ui.scroll";s.delta=(dx,dy);},
+        }
+        Some(s)
+    }
+}
+#[cfg(test)] mod tests {
+    use super::*;
+    #[test] fn buttons_drags_and_wheels_are_distinct(){
+        let mut t=Tracker::default();
+        for b in 0..3 {let s=t.accept(Input::Down(b),1.,2.,10).unwrap();assert_eq!(s.button,b);assert_eq!(s.kind,"ui.click");assert!(t.accept(Input::Up(b),1.,2.,20).is_none());}
+        t.accept(Input::Down(0),1.,2.,30);let s=t.accept(Input::Up(0),10.,20.,40).unwrap();assert_eq!(s.kind,"ui.drag");assert_eq!(s.from,Some((1.,2.)));
+        assert!(t.accept(Input::Up(0),50.,20.,50).is_none());
