+        while let Some(packet)=reader.read_packet().unwrap() {
+            let frames=decoder.decode(&packet.data,&mut buffer,false).unwrap();pcm.extend_from_slice(&buffer[..frames*channels]);
+            if packet.last_in_stream(){final_granule=Some(packet.absgp_page() as usize);}
+        }
+        let final_granule=final_granule.unwrap();assert!(final_granule*channels<=pcm.len());
