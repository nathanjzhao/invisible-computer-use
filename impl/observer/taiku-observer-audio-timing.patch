+fn capture_expired(audio_elapsed: Option<Duration>, startup_elapsed: Duration, limit: Duration) -> bool {
+    match audio_elapsed {
+        Some(elapsed) => elapsed >= limit,
+        None => startup_elapsed >= Duration::from_secs(10),
+    }
